  "overrides": [
   {
    "include": [
     "**/*.test.ts",
     "**/*.test.tsx"
    ],
    "options": {
     "diagnosticSeverity": {
      "globalJsonInEffect": "off",
      "effectFnOpportunity": "off"
     }
    }
   },
   {
    "include": [
     "**/*.spec.ts",
     "**/*.spec.tsx",
     "**/*.testkit.ts",
     "**/*.testkit.tsx",
