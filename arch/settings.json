 "lint": {
  "ignorePatterns": [
   "**/node_modules",
   "/dist",
   "/.build",
   "/.tools",
   "/arch/lint",
   "/scripts",
   "apps/*/dist"
  ],
  "plugins": [
   "eslint",
   "oxc",
   "typescript",
   "unicorn",
   "react",
   "import",
   "vitest"
  ],
  "jsPlugins": [
   "./arch/lint/index.ts"
  ],
  "categories": {
   "correctness": "error",
   "suspicious": "error",
   "perf": "error"
  },
  "options": {
   "typeAware": true,
   "reportUnusedDisableDirectives": "error"
  },
  "rules": {
   "typescript/no-explicit-any": "error",
   "typescript/no-non-null-assertion": "error",
   "typescript/consistent-type-assertions": [
    "error",
    {
     "assertionStyle": "never"
    }
   ],
   "typescript/no-unsafe-type-assertion": "error",
   "typescript/no-unsafe-argument": "error",
   "typescript/no-unsafe-assignment": "error",
   "typescript/no-unsafe-call": "error",
   "typescript/no-unsafe-member-access": "error",
   "typescript/no-unsafe-return": "error",
   "typescript/switch-exhaustiveness-check": [
    "error",
    {
     "allowDefaultCaseForExhaustiveSwitch": false,
     "considerDefaultExhaustiveForUnions": false,
     "requireDefaultForNonUnion": true
    }
   ],
   "typescript/no-floating-promises": [
    "error",
    {
     "ignoreVoid": false
    }
   ],
   "typescript/no-misused-promises": "error",
   "eslint/no-restricted-globals": [
    "error",
    {
     "name": "setTimeout",
     "message": "Raw timers aren't allowed: use Effect.sleep or a Schedule, which can be interrupted and tested with TestClock."
    },
    {
     "name": "setInterval",
     "message": "Raw timers aren't allowed: use Effect.repeat with a Schedule, which can be interrupted and tested with TestClock."
    },
    {
     "name": "setImmediate",
     "message": "Raw timers aren't allowed: use an Effect (Effect.yieldNow), which can be interrupted and tested."
    },
    {
     "name": "queueMicrotask",
     "message": "Raw scheduling isn't allowed: use an Effect, which can be interrupted and tested."
    }
   ],
   "typescript/ban-ts-comment": [
    "error",
    {
     "ts-expect-error": true,
     "ts-ignore": true,
     "ts-nocheck": true,
     "ts-check": false
    }
   ],
   "typescript/triple-slash-reference": [
    "error",
    {
     "lib": "never",
     "path": "never",
     "types": "never"
    }
   ],
   "typescript/no-deprecated": "error",
   "eslint/no-restricted-imports": [
    "error",
    {
     "paths": [
      {
       "name": "@effect/vitest",
       "importNames": [
        "effect",
        "live",
        "scoped",
        "flakyTest",
        "prop"
       ],
       "message": "Register Effect tests as it.effect, it.live or it.scoped, which the assertion check (vitest/expect-expect) knows; flaky tests are fixed, not retried."
      }
     ]
    }
   ],
   "bstack/module-boundaries": "error",
   "bstack/no-ambient-declarations": "error",
   "bstack/no-module-state": "error",
   "typescript/no-require-imports": "error",
   "typescript/no-namespace": "error",
   "import/no-commonjs": "error",
   "eslint/no-eval": "error",
   "eslint/no-new-func": "error",
   "typescript/no-implied-eval": "error",
   "bstack/typed-ui-identifiers": "error",
   "bstack/typed-identifiers": "error",
   "bstack/no-io-globals": "error",
   "bstack/no-unchecked-narrowing": "error",
   "vitest/no-restricted-matchers": [
    "error",
    {
     "toMatchObject": "Assert the whole value with toEqual (or toBe, toStrictEqual, toBeInstanceOf), so a change the test didn't expect fails it. If the whole value can't be pinned down, stop and report.",
     "toHaveProperty": "Assert the whole value with toEqual (or toBe, toStrictEqual, toBeInstanceOf), so a change the test didn't expect fails it. If the whole value can't be pinned down, stop and report.",
     "toBeTruthy": "Assert the whole value with toEqual (or toBe, toStrictEqual, toBeInstanceOf), so a change the test didn't expect fails it. If the whole value can't be pinned down, stop and report.",
     "toBeFalsy": "Assert the whole value with toEqual (or toBe, toStrictEqual, toBeInstanceOf), so a change the test didn't expect fails it. If the whole value can't be pinned down, stop and report.",
     "toBeDefined": "Assert the whole value with toEqual (or toBe, toStrictEqual, toBeInstanceOf), so a change the test didn't expect fails it. If the whole value can't be pinned down, stop and report.",
     "toContain": "Assert the whole value with toEqual (or toBe, toStrictEqual, toBeInstanceOf), so a change the test didn't expect fails it. If the whole value can't be pinned down, stop and report.",
     "toContainEqual": "Assert the whole value with toEqual (or toBe, toStrictEqual, toBeInstanceOf), so a change the test didn't expect fails it. If the whole value can't be pinned down, stop and report.",
     "toMatch": "Assert the whole value with toEqual (or toBe, toStrictEqual, toBeInstanceOf), so a change the test didn't expect fails it. If the whole value can't be pinned down, stop and report."
    }
   ],
   "eslint/no-restricted-properties": [
    "error",
    {
     "object": "expect",
     "property": "objectContaining",
     "message": "Assert the whole value with toEqual (or toBe, toStrictEqual, toBeInstanceOf), so a change the test didn't expect fails it. If the whole value can't be pinned down, stop and report."
    },
    {
     "object": "expect",
     "property": "arrayContaining",
     "message": "Assert the whole value with toEqual (or toBe, toStrictEqual, toBeInstanceOf), so a change the test didn't expect fails it. If the whole value can't be pinned down, stop and report."
    },
    {
     "object": "expect",
     "property": "stringContaining",
     "message": "Assert the whole value with toEqual (or toBe, toStrictEqual, toBeInstanceOf), so a change the test didn't expect fails it. If the whole value can't be pinned down, stop and report."
    },
    {
     "object": "expect",
     "property": "stringMatching",
     "message": "Assert the whole value with toEqual (or toBe, toStrictEqual, toBeInstanceOf), so a change the test didn't expect fails it. If the whole value can't be pinned down, stop and report."
    },
    {
     "object": "expect",
     "property": "any",
     "message": "Assert the whole value with toEqual (or toBe, toStrictEqual, toBeInstanceOf), so a change the test didn't expect fails it. If the whole value can't be pinned down, stop and report."
    },
    {
     "object": "expect",
     "property": "anything",
     "message": "Assert the whole value with toEqual (or toBe, toStrictEqual, toBeInstanceOf), so a change the test didn't expect fails it. If the whole value can't be pinned down, stop and report."
    }
   ],
   "vitest/expect-expect": [
    "error",
    {
     "assertFunctionNames": [
      "expect"
     ],
     "additionalTestBlockFunctions": [
      "it.effect",
      "it.live",
      "it.scoped"
     ]
    }
   ],
   "bstack/no-skipped-tests": "error",
   "vitest/no-standalone-expect": [
    "error",
    {
     "additionalTestBlockFunctions": [
      "it.effect",
      "it.live",
      "it.scoped"
     ]
    }
   ],
   "react/react-in-jsx-scope": "off",
   "typescript/consistent-return": "off",
   "eslint/no-underscore-dangle": "off",
   "eslint/no-unused-vars": [
    "error",
    {
     "argsIgnorePattern": "^_",
     "varsIgnorePattern": "^_",
     "caughtErrorsIgnorePattern": "^_"
    }
   ]
  }
 },
 "test": {
  "projects": [
   {
    "test": {
     "name": "unit",
     "include": [
      "{packages,apps}/*/tests/**/*.test.{ts,tsx}",
      "packages/*/*/tests/**/*.test.{ts,tsx}"
     ],
     "environment": "node",
     "allowOnly": false,
     "retry": 0,
     "fakeTimers": {
      "toFake": [
       "setTimeout",
       "clearTimeout",
       "setInterval",
       "clearInterval",
       "setImmediate",
       "clearImmediate",
       "Date",
       "performance"
      ]
     }
    }
   },
   {
    "test": {
     "name": "journeys",
     "include": [
      "apps/desktop/journeys/**/*.journey.ts"
     ],
     "environment": "node",
     "allowOnly": false,
     "retry": 0,
     "testTimeout": 60000,
     "fileParallelism": false
    }
   }
  ],
  "passWithNoTests": false
 },
 "workspace": {
  "hoist": false,
