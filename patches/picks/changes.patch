diff --git a/apps/web/src/components/chat/PickRequestCard.tsx b/apps/web/src/components/chat/PickRequestCard.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..bd2efb0ec87fa4eae6913239d8facdeb5cc339fa
--- /dev/null
+++ b/apps/web/src/components/chat/PickRequestCard.tsx
@@ -0,0 +1,140 @@
+import type { PickRequestItem } from "@t3tools/client-runtime/picks";
+import { type EnvironmentId, PICK_TIE, type PicksBatchView } from "@t3tools/contracts";
+import { Link } from "@tanstack/react-router";
+import { useGT } from "gt-react";
+import { ScaleIcon } from "lucide-react";
+import { useState } from "react";
+
+import { picksEnvironment } from "~/state/picks";
+import { useEnvironmentQuery } from "~/state/query";
+import { Button } from "../ui/button";
+import { WorkLogDetails, WorkLogRow } from "./WorkLog";
+
+/** Sent batches this size or smaller list their answers open. */
+const OPEN_ANSWERS_UP_TO = 5;
+
+/** The asking thread's row for a batch of picks; the answering happens in the Picks inbox. */
+export function PickRequestCard(props: {
+  readonly environmentId: EnvironmentId;
+  readonly item: PickRequestItem;
+}) {
+  const { item } = props;
+  const gt = useGT();
+  const [expanded, setExpanded] = useState(item.questionCount <= OPEN_ANSWERS_UP_TO);
+  const title = item.title ?? "";
+  const done = item.answeredCount === item.questionCount;
+  const label =
+    item.pickStatus === "answered"
+      ? item.questionCount === 1
+        ? gt("Sent 1 pick: {title}", { title })
+        : gt("Sent {count} picks: {title}", { count: item.questionCount, title })
+      : item.pickStatus === "cancelled"
+        ? gt("Picks closed: {title}", { title })
+        : done
+          ? gt("Picks requested: {title} · {answered} of {total} answered · not sent", {
+              title,
+              answered: item.answeredCount,
+              total: item.questionCount,
+            })
+          : gt("Picks requested: {title} · {answered} of {total} answered", {
+              title,
+              answered: item.answeredCount,
+              total: item.questionCount,
+            });
+  const batchLink = (text: string) => (
+    <Link
+      to="/picks"
+      search={{ environmentId: props.environmentId, threadId: item.threadId, batchId: item.id }}
+      className="text-xs font-medium text-foreground underline-offset-4 hover:underline"
+    >
+      {text}
+    </Link>
+  );
+  return (
+    <WorkLogRow
+      data-v2-item-type={item.type}
+      icon={<ScaleIcon className="size-3.5 text-icon-muted" aria-hidden />}
+      label={label}
+      trailing={
+        item.pickStatus === "pending"
+          ? batchLink(done ? gt("Review and send") : gt("Open picks"))
+          : item.pickStatus === "answered"
+            ? batchLink(gt("View"))
+            : undefined
+      }
+    >
+      {item.pickStatus !== "answered" ? null : expanded ? (
+        <WorkLogDetails kind="panel">
+          <PickAnswersQuery environmentId={props.environmentId} item={item} />
+        </WorkLogDetails>
+      ) : (
+        <WorkLogDetails kind="panel">
+          <Button
+            variant="ghost-muted"
+            size="xs"
+            className="ms-6"
+            onClick={() => setExpanded(true)}
+          >
+            {gt("Show {count} answers", { count: item.questionCount })}
+          </Button>
+        </WorkLogDetails>
+      )}
+    </WorkLogRow>
+  );
+}
+
+function PickAnswersQuery(props: {
+  readonly environmentId: EnvironmentId;
+  readonly item: PickRequestItem;
+}) {
+  const batch = useEnvironmentQuery(
+    picksEnvironment.get({
+      environmentId: props.environmentId,
+      input: { threadId: props.item.threadId, batchId: props.item.id },
+    }),
+  );
+  if (batch.data === null) {
+    return batch.error === null ? null : (
+      <p role="alert" className="ms-7 text-xs text-destructive">
+        {batch.error}
+      </p>
+    );
+  }
+  return <PickAnswersList view={batch.data} />;
+}
+
+/** A sent batch's answers, one line per question by place, with its note under it. */
+export function PickAnswersList(props: { readonly view: PicksBatchView }) {
+  const gt = useGT();
+  return (
+    <ol
+      className="ms-7 flex max-h-80 flex-col gap-1 overflow-auto py-1 text-xs"
+      data-testid="pick-answers"
+    >
+      {props.view.questions
+        .map((question, index) => ({ question, number: index + 1 }))
+        .map(({ question, number }) => {
+          const answer = question.answer;
+          return (
+            <li key={number} className="flex flex-col">
+              <span className="flex min-w-0 gap-2">
+                <span className="w-6 shrink-0 text-muted-foreground tabular-nums">{number}</span>
+                <span className="min-w-0 truncate text-foreground">{question.prompt}</span>
+                <span className="shrink-0 text-muted-foreground">→</span>
+                <span className="shrink-0 font-medium text-foreground">
+                  {answer === undefined
+                    ? gt("No answer")
+                    : answer.choice === PICK_TIE
+                      ? gt("Can't tell")
+                      : gt("Option {number}", { number: answer.choice + 1 })}
+                </span>
+              </span>
+              {answer?.note === undefined ? null : (
+                <span className="ms-8 text-muted-foreground">{answer.note}</span>
+              )}
+            </li>
+          );
+        })}
+    </ol>
+  );
+}
