index 0000000000000000000000000000000000000000..e59db52d55bc942137b9605d15205163d80f914b
--- /dev/null
+++ b/packages/client-runtime/src/picks.test.ts
@@ -0,0 +1,616 @@
+import { describe, expect, it } from "@effect/vitest";
+
+import {
+  firstUnanswered,
+  inStepTime,
+  makePickSaveQueue,
+  movedQuestion,
+  nextUnanswered,
+  type PickField,
+  pickerAnswers,
+  pickerKeyAction,
+  pickerProgress,
+  pickFrameLengths,
+  pickPlaybackPosition,
+  pickSharedSide,
+  pickSizeChip,
+  pickStageLayout,
+  pickStripCells,
+  PICK_FALLBACK_FRAME,
+  savedNote,
+  steppedTime,
+  steppedTimes,
+} from "./picks.ts";
+
+type KeyOptions = Partial<Omit<Parameters<typeof pickerKeyAction>[0], "key">>;
+
+const key = (pressed: string, options: KeyOptions = {}) =>
+  pickerKeyAction({
+    key: pressed,
+    optionCount: 3,
+    allowTie: true,
+    noteFocused: false,
+    mod: false,
+    modified: false,
+    shift: false,
+    repeat: false,
+    flip: false,
+    video: false,
+    ...options,
+  });
+
+describe("pickerKeyAction", () => {
+  it("maps the picker's keys to what they do", () => {
+    expect(
+      ["1", "2", "3", "4", "0", "n", "N", "u", "U", "ArrowLeft", "ArrowRight", "x", " "].map((k) =>
+        key(k),
+      ),
+    ).toEqual([
+      { type: "choose", choice: 0 },
+      { type: "choose", choice: 1 },
+      { type: "choose", choice: 2 },
+      null,
+      { type: "choose", choice: "tie" },
+      { type: "focus-note" },
+      { type: "focus-note" },
+      { type: "next-unanswered" },
+      { type: "next-unanswered" },
+      { type: "move", delta: -1 },
+      { type: "move", delta: 1 },
+      null,
+      null,
+    ]);
+  });
+
+  it("offers no tie when the batch allows none, and no keys past the options", () => {
+    expect([key("0", { allowTie: false }), key("3", { optionCount: 2 })]).toEqual([null, null]);
+  });
+
+  it("lets the note take typing until Escape or Enter, and ignores shortcuts with modifiers", () => {
+    expect([
+      key("1", { noteFocused: true }),
+      key("ArrowLeft", { noteFocused: true }),
+      key("Escape", { noteFocused: true }),
+      key("Enter", { noteFocused: true }),
+      key("Enter", { noteFocused: true, shift: true }),
+      key("1", { modified: true }),
+      key("1", { mod: true }),
+    ]).toEqual([null, null, { type: "leave-note" }, { type: "leave-note" }, null, null, null]);
+  });
+
+  it("sends with the send modifier and Enter, from the note too, and never on plain Enter", () => {
+    expect([
+      key("Enter", { mod: true }),
+      key("Enter", { mod: true, noteFocused: true }),
+      key("Enter"),
+      key("Enter", { mod: true, modified: true }),
+      key("Enter", { mod: true, shift: true }),
+    ]).toEqual([{ type: "send" }, { type: "send" }, null, null, null]);
+  });
+
+  it("opens the last answered question's note with Shift+N and flips with F and Shift+F", () => {
+    expect([
+      key("N", { shift: true }),
+      key("f", { flip: true }),
+      key("F", { flip: true, shift: true }),
+      key("f"),
+      key("F", { shift: true }),
+    ]).toEqual([
+      { type: "note-last-answered" },
+      { type: "flip", delta: 1 },
+      { type: "flip", delta: -1 },
+      null,
+      null,
+    ]);
+  });
+
+  it("drives videos with Space, S, R, comma and period only on a video question", () => {
+    const keys = [" ", "s", "r", ",", "."];
+    expect(keys.map((k) => key(k, { video: true }))).toEqual([
+      { type: "play-pause" },
+      { type: "half-speed" },
+      { type: "replay" },
+      { type: "step", delta: -1 },
+      { type: "step", delta: 1 },
+    ]);
+    expect(keys.map((k) => key(k))).toEqual([null, null, null, null, null]);
+  });
+
+  it("acts once on a held key, except arrows and frame steps, which repeat", () => {
+    const once = ["1", "0", "n", "u", "f", "r", "s", " ", "Enter"];
+    expect(
+      once.map((k) => key(k, { repeat: true, flip: true, video: true, mod: k === "Enter" })),
+    ).toEqual(once.map(() => null));
+    expect(
+      ["ArrowLeft", "ArrowRight", ",", "."].map((k) => key(k, { repeat: true, video: true })),
+    ).toEqual([
+      { type: "move", delta: -1 },
+      { type: "move", delta: 1 },
+      { type: "step", delta: -1 },
+      { type: "step", delta: 1 },
+    ]);
+  });
+
+  it("cancels a pending hold with Escape only when holding and not repeating", () => {
+    expect([
+      key("Escape", { holding: true }),
+      key("Escape", { holding: false }),
+      key("Escape"),
+      key("Escape", { holding: true, repeat: true }),
+      key("Escape", { holding: true, noteFocused: true }),
+    ]).toEqual([{ type: "cancel-hold" }, null, null, null, { type: "leave-note" }]);
+  });
+});
+
+describe("moving between questions", () => {
+  it("moves one question at a time and stays inside the batch", () => {
+    expect([movedQuestion(0, -1, 3), movedQuestion(1, 1, 3), movedQuestion(2, 1, 3)]).toEqual([
+      0, 2, 2,
+    ]);
+  });
+
+  it("finds the next blank after a question, wrapping past the end, and none when all are done", () => {
+    const answers = [undefined, { choice: 0 }, undefined, { choice: 1 }];
+    expect([
+      nextUnanswered(answers, 0),
+      nextUnanswered(answers, 2),
+      nextUnanswered(answers, 3),
+      nextUnanswered([{ choice: 0 }, undefined], 1),
+      nextUnanswered([{ choice: 0 }, { choice: 1 }], 0),
+      firstUnanswered(answers),
+      firstUnanswered([{ choice: 0 }]),
+    ]).toEqual([2, 0, 0, null, null, 0, null]);
+  });
+});
+
+describe("answers and progress", () => {
+  it("prefers this window's saved answers over what the server last sent", () => {
+    const answers = pickerAnswers(
+      {
+        questions: [
+          { prompt: "a", options: [], answer: { choice: 1 } },
+          { prompt: "b", options: [] },
+          { prompt: "c", options: [], answer: { choice: "tie", note: "same" } },
+        ],
+      },
+      new Map([[0, { choice: 0 }]]),
+    );
+    expect(answers).toEqual([{ choice: 0 }, undefined, { choice: "tie", note: "same" }]);
+    expect(pickerProgress(answers)).toEqual({ answered: 2, total: 3, complete: false });
+    expect(pickerProgress([{ choice: 0 }])).toEqual({ answered: 1, total: 1, complete: true });
+  });
+
+  it("saves a blank note as none", () => {
+    expect([savedNote("  too dark "), savedNote("   ")]).toEqual(["too dark", undefined]);
+  });
+});
+
+describe("pickStageLayout", () => {
+  const region = { width: 1052, height: 568 };
+  const defaultLayout = (optionCount: number, size = region, video = false) =>
+    pickStageLayout({ optionCount, display: undefined, region: size, video });
+  const exactLayout = (optionCount: number, width: number, height: number, pixelated = false) =>
+    pickStageLayout({
+      optionCount,
+      display: { width, height, pixelated },
+      region,
+      video: false,
+    });
+
+  it("gives default-size options a fixed square by count, in one row, that a bigger window doesn't grow", () => {
+    const row = (size: number) => ({
+      kind: "fit",
+      arrangement: "row",
+      width: size,
+      height: size,
+      pixelated: false,
+      oversized: false,
+    });
+    expect([
+      defaultLayout(2),
+      defaultLayout(3),
+      defaultLayout(4),
+      defaultLayout(2, { width: 1552, height: 788 }),
+    ]).toEqual([row(480), row(320), row(240), row(480)]);
+  });
+
+  it("steps down to the largest size that keeps one row on a narrower page, then flips", () => {
+    expect([
+      defaultLayout(2, { width: 800, height: 568 }).width,
+      defaultLayout(4, { width: 800, height: 568 }).width,
+      defaultLayout(4, { width: 600, height: 568 }),
+    ]).toEqual([
+      384,
+      160,
+      {
+        kind: "fit",
+        arrangement: "flip",
+        width: 240,
+        height: 240,
+        pixelated: false,
+        oversized: false,
+      },
+    ]);
+  });
+
+  it("puts exact boxes in a row, then a 2×2 grid for 3 or 4, then one at a time", () => {
+    expect([
+      exactLayout(2, 160, 160, true),
+      exactLayout(4, 300, 220).arrangement,
+      exactLayout(4, 400, 300).arrangement,
+      exactLayout(2, 640, 480).arrangement,
+      exactLayout(2, 1100, 300),
+    ]).toEqual([
+      {
+        kind: "exact",
+        arrangement: "row",
+        width: 160,
+        height: 160,
+        pixelated: true,
+        oversized: false,
+      },
+      "grid",
+      "flip",
+      "flip",
+      {
+        kind: "exact",
+        arrangement: "flip",
+        width: 1100,
+        height: 300,
+        pixelated: false,
+        oversized: true,
+      },
+    ]);
+  });
+
+  it("leaves room for the playback row on a video question", () => {
+    expect([
+      pickStageLayout({
+        optionCount: 2,
+        display: { width: 300, height: 520 },
+        region,
+        video: false,
+      }).arrangement,
+      pickStageLayout({
+        optionCount: 2,
+        display: { width: 300, height: 520 },
+        region,
+        video: true,
+      }).arrangement,
+    ]).toEqual(["row", "flip"]);
+  });
+});
+
+const defaultLayout = pickStageLayout({
+  optionCount: 2,
+  display: undefined,
+  region: { width: 1052, height: 568 },
+  video: false,
+});
+const square = (size: number) => ({ width: size, height: size });
+
+describe("pickSharedSide", () => {
+  it("draws every default-size option at the shortest longest side, never above the stage", () => {
+    expect([
+      pickSharedSide(defaultLayout, [square(96), square(1024)]),
+      pickSharedSide(defaultLayout, [square(384), square(1024)]),
+      pickSharedSide(defaultLayout, [square(1024), square(1024)]),
+      pickSharedSide(defaultLayout, [
+        { width: 320, height: 160 },
+        { width: 160, height: 320 },
+      ]),
+      pickSharedSide(defaultLayout, [square(96), null]),
+      pickSharedSide(defaultLayout, [null, null]),
+      pickSharedSide(
+        pickStageLayout({
+          optionCount: 2,
+          display: { width: 160, height: 160 },
+          region: { width: 1052, height: 568 },
+          video: false,
+        }),
+        [square(96), square(1024)],
+      ),
+      pickSharedSide(defaultLayout, undefined),
+    ]).toEqual([96, 384, 480, 320, 96, null, null, null]);
+  });
+});
+
+describe("pickSizeChip", () => {
+  it("names only sizes options are drawn at, and the exact box", () => {
+    expect([
+      pickSizeChip(defaultLayout, [square(96), square(96)]),
+      pickSizeChip(defaultLayout, [
+        { width: 1024, height: 512 },
+        { width: 1024, height: 512 },
+      ]),
+      pickSizeChip(defaultLayout, [square(384), square(1024)]),
+      pickSizeChip(defaultLayout, [square(96), square(1024)]),
+      pickSizeChip(defaultLayout, [
+        { width: 320, height: 160 },
+        { width: 160, height: 320 },
+      ]),
+      pickSizeChip(defaultLayout, [
+        { width: 640, height: 320 },
+        { width: 160, height: 320 },
+      ]),
+      pickSizeChip(defaultLayout, [square(96), null]),
+      pickSizeChip(defaultLayout, [null, null]),
+      pickSizeChip(defaultLayout, undefined),
+      pickSizeChip(
+        pickStageLayout({
+          optionCount: 2,
+          display: { width: 160, height: 160, pixelated: true },
+          region: { width: 1052, height: 568 },
+          video: false,
+        }),
