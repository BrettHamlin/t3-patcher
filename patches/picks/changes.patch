+    fg: readonly [number, number, number, number],
+    bg: readonly [number, number, number, number],
+  ) => {
+    const l1 = luminance([bg[0], bg[1], bg[2]]);
+    const l2 = luminance(composite(fg, bg));
+    return (Math.max(l1, l2) + 0.05) / (Math.min(l1, l2) + 0.05);
+  };
