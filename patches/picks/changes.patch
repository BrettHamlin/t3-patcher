--- /dev/null
+++ b/apps/web/src/components/picks/PickerView.browser.test.tsx
@@ -0,0 +1,120 @@
+import { EnvironmentId, type PicksBatchView, ThreadId, TurnItemId } from "@t3tools/contracts";
+import { expect, it, vi } from "vite-plus/test";
+import { userEvent } from "vite-plus/test/browser";
+
+import "~/index.css";
+import { render } from "../../../test/render";
+import { PickerView, type PickMediaProps, type PickOptionView } from "./PickerView";
+
+const image = (attachmentId: string): PickOptionView => ({
+  attachmentId,
+  mediaKind: "image",
+  mimeType: "image/png",
+});
+
+const view: PicksBatchView = {
+  threadId: ThreadId.make("thread:picks"),
+  batchId: TurnItemId.make("turn-item:pick-request:picks"),
+  title: "Real person, round 3",
+  threadTitle: "Art eval",
+  allowTie: true,
+  status: "pending",
+  questions: [
+    { prompt: "Which face?", options: [image("a1"), image("a2")] },
+    { prompt: "Which walk?", options: [image("b1"), image("b2"), image("b3")] },
+    {
+      prompt: "Which sprite?",
+      display: { width: 64, height: 48, pixelated: true },
+      options: [image("c1"), image("c2")],
+    },
+  ],
+};
+
+function StubMedia({ option, pixelated }: PickMediaProps) {
+  return (
+    <div data-testid={`media-${option.attachmentId}`} data-pixelated={pixelated}>
+      {option.attachmentId}
+    </div>
+  );
+}
+
+it("answers with 1–4 and 0, takes a note with N until Esc, moves with arrows, and gates Done", async () => {
+  const onAnswer = vi.fn(async () => null);
+  const onComplete = vi.fn(async () => null);
+  await using screen = await render(
+    <PickerView
+      environmentId={EnvironmentId.make("environment:picks")}
+      view={view}
+      canAnswer
+      onAnswer={onAnswer}
+      onComplete={onComplete}
+      Media={StubMedia}
+    />,
+  );
+  const progress = screen.getByTestId("picker-progress");
+  const done = screen.getByRole("button", { name: "Done" });
+  await expect.element(screen.getByTestId("picker")).toHaveFocus();
+  await expect.element(progress).toHaveTextContent("Question 1 of 3 · 0 answered");
+
+  await userEvent.keyboard("2");
+  await expect.element(progress).toHaveTextContent("Question 2 of 3 · 1 answered");
+  await userEvent.keyboard("0");
+  await expect.element(progress).toHaveTextContent("Question 3 of 3 · 2 answered");
+  // A 2-option question has no option 4.
+  await userEvent.keyboard("4");
+  await expect.element(progress).toHaveTextContent("Question 3 of 3 · 2 answered");
+  // The last box is the agent's exact size, pixelated.
+  await expect.element(screen.getByTestId("media-c1")).toHaveAttribute("data-pixelated", "true");
+  await expect.element(done).toBeDisabled();
+
+  await userEvent.keyboard("{ArrowLeft}");
+  await expect.element(progress).toHaveTextContent("Question 2 of 3 · 2 answered");
+  await userEvent.keyboard("n");
+  const note = screen.getByRole("textbox", { name: "Note" });
+  await expect.element(note).toHaveFocus();
+  // In the note, digits are text, not picks.
+  await userEvent.keyboard("1 stiff");
+  await userEvent.keyboard("{Escape}");
+  await expect.element(note).not.toHaveFocus();
+  await expect.element(note).toHaveValue("1 stiff");
+
+  // An earlier answer can change before Done.
+  await userEvent.keyboard("{ArrowLeft}");
+  await userEvent.keyboard("1");
+  await userEvent.keyboard("{ArrowRight}");
+  await expect.element(progress).toHaveTextContent("Question 3 of 3 · 2 answered");
+  await userEvent.keyboard("1");
+  await expect.element(progress).toHaveTextContent("Question 3 of 3 · 3 answered");
+  await expect.element(done).toBeEnabled();
+  // From the note, Tab reaches Done and Enter presses it.
+  await userEvent.keyboard("n");
+  await userEvent.keyboard("{Tab}");
+  await expect.element(done).toHaveFocus();
+  await userEvent.keyboard("{Enter}");
+
+  await vi.waitFor(() => expect(onComplete).toHaveBeenCalledOnce());
+  expect(onAnswer.mock.calls).toEqual([
+    [{ questionIndex: 0, choice: 1 }],
+    [{ questionIndex: 1, choice: "tie" }],
+    [{ questionIndex: 1, choice: "tie", note: "1 stiff" }],
+    [{ questionIndex: 0, choice: 0 }],
+    [{ questionIndex: 2, choice: 0 }],
+  ]);
+});
+
+it("keeps Done off and shows why when this connection can't answer", async () => {
+  const onAnswer = vi.fn(async () => null);
+  await using screen = await render(
+    <PickerView
+      environmentId={EnvironmentId.make("environment:picks")}
+      view={view}
+      canAnswer={false}
+      onAnswer={onAnswer}
+      onComplete={async () => null}
+      Media={StubMedia}
+    />,
+  );
+  await userEvent.keyboard("1");
+  await expect.element(screen.getByText("This connection can't answer picks.")).toBeInTheDocument();
+  expect(onAnswer).not.toHaveBeenCalled();
+});
diff --git a/apps/web/src/components/picks/PickerView.tsx b/apps/web/src/components/picks/PickerView.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c4d823f1b75b01a9f607ecc56585372f88544d03
--- /dev/null
+++ b/apps/web/src/components/picks/PickerView.tsx
@@ -0,0 +1,292 @@
+import {
+  movedQuestion,
+  type PickerAnswer,
+  pickerAnswers,
+  pickerKeyAction,
+  pickerProgress,
+  pickOptionBox,
+  questionAfterAnswer,
+  savedNote,
+} from "@t3tools/client-runtime/picks";
+import {
+  type EnvironmentId,
+  PICK_TIE,
+  type PickViewChoice,
+  type PicksBatchView,
+} from "@t3tools/contracts";
+import { useGT } from "gt-react";
+import { ChevronLeftIcon, ChevronRightIcon } from "lucide-react";
+import { type ComponentType, type KeyboardEvent, useRef, useState } from "react";
+
+import { useStableCallback } from "~/hooks/useStableCallback";
+import { cn } from "~/lib/utils";
+import { Button } from "../ui/button";
+import { Kbd } from "../ui/kbd";
+import { Textarea } from "../ui/textarea";
+
+export type PickOptionView = PicksBatchView["questions"][number]["options"][number];
+
+export interface PickMediaProps {
+  readonly environmentId: EnvironmentId;
+  readonly option: PickOptionView;
+  readonly label: string;
+  readonly pixelated: boolean;
+}
+
+export interface PickerViewProps {
+  readonly environmentId: EnvironmentId;
+  readonly view: PicksBatchView;
+  /** Whether this connection may answer; the server checks again. */
+  readonly canAnswer: boolean;
+  /** Saves one answer. Resolves to an error message, or null once saved. */
+  readonly onAnswer: (input: {
+    readonly questionIndex: number;
+    readonly choice: PickViewChoice;
+    readonly note?: string;
+  }) => Promise<string | null>;
+  /** Finishes the batch. Resolves to an error message, or null once done. */
+  readonly onComplete: () => Promise<string | null>;
+  readonly Media: ComponentType<PickMediaProps>;
+}
+
+const firstUnanswered = (view: PicksBatchView) =>
+  Math.max(
+    view.questions.findIndex((question) => question.answer === undefined),
+    0,
+  );
+
+/**
+ * One question at a time, its options side by side in the order the server
+ * shuffled them and labelled only by place. Keys: 1–4 pick and advance, 0
+ * can't tell, N the note, arrows move, Esc leaves the note.
+ */
+export function PickerView({
+  environmentId,
+  view,
+  canAnswer,
+  onAnswer,
+  onComplete,
+  Media,
+}: PickerViewProps) {
+  const gt = useGT();
+  const [index, setIndex] = useState(() => firstUnanswered(view));
+  const [saved, setSaved] = useState<ReadonlyMap<number, PickerAnswer>>(() => new Map());
+  const [notes, setNotes] = useState<ReadonlyMap<number, string>>(() => new Map());
+  const [error, setError] = useState<string | null>(null);
+  const [completing, setCompleting] = useState(false);
+  const containerRef = useRef<HTMLDivElement | null>(null);
+  const noteRef = useRef<HTMLTextAreaElement | null>(null);
+  // A ref callback, not an effect: keys reach the picker from the moment it shows. One
+  // identity, so a re-render (each keystroke in the note) does not take focus back.
+  const focusOnMount = useStableCallback((node: HTMLDivElement | null) => {
+    containerRef.current = node;
+    node?.focus();
+  });
+
+  const answers = pickerAnswers(view, saved);
+  const progress = pickerProgress(answers);
+  const question = view.questions[index];
+  const answer = answers[index];
+  const open = view.status === "pending" && canAnswer;
+  const note = notes.get(index) ?? answer?.note ?? "";
+
+  const save = async (questionIndex: number, next: PickerAnswer) => {
+    const previous = saved;
+    setSaved(new Map(saved).set(questionIndex, next));
+    setError(null);
+    const failure = await onAnswer({
+      questionIndex,
+      choice: next.choice,
+      ...(next.note === undefined ? {} : { note: next.note }),
+    });
+    if (failure !== null) {
+      setSaved(previous);
+      setError(failure);
+    }
+  };
+
+  const choose = (choice: PickViewChoice) => {
+    if (!open || question === undefined) return;
+    const chosen = savedNote(note);
+    void save(index, { choice, ...(chosen === undefined ? {} : { note: chosen }) });
+    setIndex(questionAfterAnswer(index, view.questions.length));
+  };
+
+  const saveNote = () => {
+    if (!open || answer === undefined || savedNote(note) === answer.note) return;
+    const chosen = savedNote(note);
+    void save(index, { choice: answer.choice, ...(chosen === undefined ? {} : { note: chosen }) });
+  };
+
+  const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {
+    const action = pickerKeyAction({
+      key: event.key,
+      optionCount: question?.options.length ?? 0,
+      allowTie: view.allowTie,
+      noteFocused: event.target === noteRef.current,
+      modified: event.metaKey || event.ctrlKey || event.altKey,
+    });
+    if (action === null) return;
+    event.preventDefault();
+    switch (action.type) {
+      case "choose":
+        choose(action.choice);
+        return;
+      case "move":
+        setIndex(movedQuestion(index, action.delta, view.questions.length));
+        return;
+      case "focus-note":
+        noteRef.current?.focus();
+        return;
+      case "leave-note":
+        containerRef.current?.focus();
+        return;
+    }
+  };
+
+  const finish = async () => {
+    setCompleting(true);
+    setError(null);
+    const failure = await onComplete();
+    setCompleting(false);
+    setError(failure);
+  };
+
+  if (question === undefined) return null;
+  const box = pickOptionBox(question.display);
+  return (
+    <div
+      ref={focusOnMount}
+      tabIndex={-1}
+      onKeyDown={onKeyDown}
+      data-testid="picker"
+      className="scrollbar-gutter-both flex min-h-0 flex-1 flex-col gap-4 overflow-y-auto p-4 outline-none sm:p-6"
+    >
+      <div className="flex flex-wrap items-baseline justify-between gap-2">
+        <div className="flex min-w-0 flex-col gap-1">
+          <h2 className="text-base font-medium text-foreground">{question.prompt}</h2>
+          {question.guidance === undefined ? null : (
+            <p className="text-sm text-muted-foreground">{question.guidance}</p>
+          )}
+        </div>
+        <p className="text-sm text-muted-foreground tabular-nums" data-testid="picker-progress">
+          {gt("Question {current} of {total} · {answered} answered", {
+            current: index + 1,
+            total: progress.total,
+            answered: progress.answered,
+          })}
+        </p>
+      </div>
+
+      <div className="flex shrink-0 flex-wrap items-start justify-center gap-4">
+        {question.options.map((option, place) => {
+          const label = gt("Option {number}", { number: place + 1 });
+          return (
+            <button
+              key={`${index}:${option.attachmentId}`}
+              type="button"
+              aria-label={label}
+              aria-pressed={answer?.choice === place}
+              disabled={!open}
+              onClick={() => choose(place)}
+              className={cn(
+                "flex flex-col items-center gap-2 rounded-xl border p-2 transition-colors",
+                box.kind === "fit" && "min-w-0 flex-1 basis-0",
+                answer?.choice === place
+                  ? "border-primary bg-primary/8"
+                  : "border-border/60 hover:border-border",
+              )}
+            >
+              <div
+                className={cn(
+                  "flex items-center justify-center overflow-hidden",
+                  box.kind === "fit" ? "h-[55vh] w-full" : "shrink-0",
+                )}
+                style={box.kind === "exact" ? { width: box.width, height: box.height } : undefined}
+              >
+                <Media
+                  environmentId={environmentId}
+                  option={option}
+                  label={label}
+                  pixelated={box.kind === "exact" && box.pixelated}
+                />
+              </div>
+              <Kbd>{place + 1}</Kbd>
+            </button>
+          );
+        })}
+      </div>
+
+      <div className="flex flex-wrap items-center justify-center gap-2">
+        <Button
+          variant="outline"
+          size="icon"
+          aria-label={gt("Previous question")}
+          disabled={index === 0}
+          onClick={() => setIndex(movedQuestion(index, -1, view.questions.length))}
+        >
+          <ChevronLeftIcon />
+        </Button>
+        {view.allowTie ? (
+          <Button
+            variant={answer?.choice === PICK_TIE ? "secondary" : "outline"}
+            aria-pressed={answer?.choice === PICK_TIE}
+            disabled={!open}
+            onClick={() => choose(PICK_TIE)}
+          >
+            {gt("Can't tell")}
+            <Kbd>0</Kbd>
+          </Button>
+        ) : null}
+        <Button
+          variant="outline"
+          size="icon"
+          aria-label={gt("Next question")}
+          disabled={index === view.questions.length - 1}
+          onClick={() => setIndex(movedQuestion(index, 1, view.questions.length))}
+        >
+          <ChevronRightIcon />
+        </Button>
+      </div>
+
+      <div className="mx-auto flex w-full max-w-xl flex-col gap-1">
+        <Textarea
+          ref={noteRef}
+          rows={2}
+          size="sm"
+          aria-label={gt("Note")}
+          placeholder={gt("Note (N)")}
+          disabled={!open}
+          value={note}
+          onChange={(event) => setNotes(new Map(notes).set(index, event.target.value))}
+          onBlur={saveNote}
+        />
+        <p className="text-xs text-muted-foreground">
+          {gt("1–4 pick · 0 can't tell · N note · ← → move · Esc leaves the note")}
+        </p>
+      </div>
+
+      {error === null ? null : (
+        <p role="alert" className="text-center text-sm text-destructive">
+          {error}
+        </p>
+      )}
+
+      <div className="flex justify-center">
+        {open ? (
+          <Button disabled={!progress.complete || completing} onClick={() => void finish()}>
+            {gt("Done")}
+          </Button>
+        ) : (
+          <p className="text-sm text-muted-foreground">
+            {view.status === "answered"
+              ? gt("These picks are answered.")
+              : view.status === "cancelled"
+                ? gt("These picks were closed.")
+                : gt("This connection can't answer picks.")}
+          </p>
+        )}
+      </div>
+    </div>
+  );
+}
diff --git a/apps/web/src/components/picks/PicksPage.tsx b/apps/web/src/components/picks/PicksPage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..9538b2bde399a7a239f40e73b4ad80b3d56f298d
--- /dev/null
+++ b/apps/web/src/components/picks/PicksPage.tsx
@@ -0,0 +1,199 @@
+import { useAtomValue } from "@effect/atom-react";
+import type { AssetResource, EnvironmentId, ThreadId, TurnItemId } from "@t3tools/contracts";
+import { Link, useSearch } from "@tanstack/react-router";
+import * as DateTime from "effect/DateTime";
+import { useGT, useMessages } from "gt-react";
+import { ScaleIcon } from "lucide-react";
+import type { CSSProperties } from "react";
+
+import { useAssetUrlState } from "~/assets/assetUrls";
+import { WorkspaceBreadcrumb, WorkspaceBreadcrumbItem } from "~/components/WorkspaceBreadcrumb";
+import { WorkspacePageHeader } from "~/components/WorkspacePageHeader";
+import { Empty, EmptyHeader, EmptyMedia, EmptyTitle } from "~/components/ui/empty";
+import { SidebarInset } from "~/components/ui/sidebar";
+import { Skeleton } from "~/components/ui/skeleton";
+import { isElectron } from "~/env";
+import { type OpenPickBatch, picksEnvironment, useOpenPicks } from "~/state/picks";
+import { useEnvironmentQuery } from "~/state/query";
+import { useAtomCommand } from "~/state/use-atom-command";
+import { formatRelativeTimeLabel } from "~/timestampFormat";
+import { PickerView, type PickMediaProps } from "./PickerView";
+
+export interface PicksSearch {
+  readonly environmentId?: EnvironmentId;
+  readonly threadId?: ThreadId;
+  readonly batchId?: TurnItemId;
+}
+
+export function PicksPage() {
+  const gt = useGT();
+  const search: PicksSearch = useSearch({ from: "/_chat/picks" });
+  const open =
+    search.environmentId !== undefined &&
+    search.threadId !== undefined &&
+    search.batchId !== undefined
+      ? { environmentId: search.environmentId, threadId: search.threadId, batchId: search.batchId }
+      : null;
+  return (
+    <SidebarInset className="h-dvh min-h-0 overflow-hidden overscroll-y-none">
+      <div className="flex min-h-0 flex-1 flex-col bg-background">
+        <WorkspacePageHeader electron={isElectron} className="relative bg-background">
+          <WorkspaceBreadcrumb ariaLabel={gt("Picks breadcrumb")}>
+            <WorkspaceBreadcrumbItem current={open === null}>
+              {open === null ? (
+                <h1 className="truncate">{gt("Picks")}</h1>
+              ) : (
+                <Link to="/picks">{gt("Picks")}</Link>
+              )}
+            </WorkspaceBreadcrumbItem>
+          </WorkspaceBreadcrumb>
+        </WorkspacePageHeader>
+        {open === null ? <PicksList /> : <PicksBatch key={open.batchId} {...open} />}
+      </div>
+    </SidebarInset>
+  );
+}
+
+function PicksList() {
+  const gt = useGT();
+  const messages = useMessages();
+  const batches = useOpenPicks();
+  if (batches.length === 0) {
+    return (
+      <Empty>
+        <EmptyMedia variant="icon">
+          <ScaleIcon />
+        </EmptyMedia>
+        <EmptyHeader>
+          <EmptyTitle>{gt("No picks waiting")}</EmptyTitle>
+        </EmptyHeader>
+      </Empty>
+    );
+  }
+  return (
+    <ul className="flex min-h-0 flex-col gap-1 overflow-y-auto p-3" data-testid="picks-list">
+      {batches.map((batch) => (
+        <PicksListRow
+          key={`${batch.environmentId}:${batch.batchId}`}
+          batch={batch}
+          age={formatRelativeTimeLabel(DateTime.formatIso(batch.createdAt), undefined, messages)}
+        />
+      ))}
+    </ul>
+  );
+}
+
+function PicksListRow({ batch, age }: { readonly batch: OpenPickBatch; readonly age: string }) {
+  const gt = useGT();
+  return (
+    <li className="flex flex-wrap items-center gap-x-3 gap-y-1 rounded-lg px-3 py-2 hover:bg-accent">
+      <Link
+        to="/picks"
+        search={{
+          environmentId: batch.environmentId,
+          threadId: batch.threadId,
+          batchId: batch.batchId,
+        }}
+        className="min-w-0 flex-1 truncate text-sm font-medium text-foreground"
+      >
+        {batch.title}
+      </Link>
+      <span className="text-xs text-muted-foreground tabular-nums">
+        {gt("{answered}/{total}", { answered: batch.answeredCount, total: batch.questionCount })}
+      </span>
+      <Link
+        to="/$environmentId/$threadId"
+        params={{ environmentId: batch.environmentId, threadId: batch.threadId }}
+        className="max-w-64 truncate text-xs text-muted-foreground hover:text-foreground"
+      >
+        {batch.threadTitle}
+      </Link>
+      <span className="text-xs text-muted-foreground">{age}</span>
+    </li>
+  );
+}
+
+function PicksBatch(props: {
+  readonly environmentId: EnvironmentId;
+  readonly threadId: ThreadId;
+  readonly batchId: TurnItemId;
+}) {
+  const gt = useGT();
+  const input = { threadId: props.threadId, batchId: props.batchId };
+  const batch = useEnvironmentQuery(
+    picksEnvironment.get({ environmentId: props.environmentId, input }),
+  );
+  const answer = useAtomCommand(picksEnvironment.answer, {
+    label: "save a pick",
+    reportFailure: false,
+  });
+  const complete = useAtomCommand(picksEnvironment.complete, {
+    label: "finish picks",
+    reportFailure: false,
+  });
+  const canAnswer = useAtomValue(picksEnvironment.answer.permissionAtom(props.environmentId));
+  if (batch.data === null) {
+    return batch.error === null ? (
+      <Skeleton className="m-6 h-96" />
+    ) : (
+      <p role="alert" className="p-6 text-sm text-destructive">
+        {batch.error}
+      </p>
+    );
+  }
+  return (
+    <PickerView
+      environmentId={props.environmentId}
+      view={batch.data}
+      canAnswer={canAnswer}
+      Media={PickMedia}
+      onAnswer={async (choice) => {
+        const result = await answer({
+          environmentId: props.environmentId,
+          input: { ...input, ...choice },
+        });
+        return result._tag === "Success" ? null : gt("The answer could not be saved.");
+      }}
+      onComplete={async () => {
+        const result = await complete({ environmentId: props.environmentId, input });
+        return result._tag === "Success" ? null : gt("The picks could not be finished.");
+      }}
+    />
+  );
+}
+
+function PickMedia({ environmentId, option, label, pixelated }: PickMediaProps) {
+  const resource: AssetResource = {
+    _tag: "attachment",
+    attachmentId: option.attachmentId,
+    mimeType: option.mimeType,
+    disposition: "inline",
+  };
+  const asset = useAssetUrlState(environmentId, resource);
+  if (asset._tag === "Loading") return <Skeleton className="size-full" />;
+  if (asset._tag === "Failure") {
+    return <p className="p-2 text-xs text-destructive">{label}</p>;
+  }
+  const style: CSSProperties | undefined = pixelated ? { imageRendering: "pixelated" } : undefined;
+  return option.mediaKind === "video" ? (
+    <video
+      src={asset.url}
+      aria-label={label}
+      autoPlay
+      muted
+      loop
+      controls
+      playsInline
+      className="size-full object-contain"
+      style={style}
+    />
+  ) : (
+    <img
+      src={asset.url}
+      alt={label}
+      draggable={false}
+      className="size-full object-contain"
+      style={style}
+    />
+  );
+}
diff --git a/apps/web/src/components/sidebar/SidebarChrome.tsx b/apps/web/src/components/sidebar/SidebarChrome.tsx
index 1dbc9b9fc6366629630f13742cf4ef9954692c81..ed10bb05cf131a331011f82211e3a6013e65b20c 100644
