+                state === "unanswered" &&
+                  (current
+                    ? "bg-primary/15 inset-ring-primary"
+                    : "border border-foreground/60 bg-muted-foreground/15"),
+                state === "answered" &&
+                  (current ? "bg-primary inset-ring-foreground/65" : "bg-primary/85"),
+                state === "tie" &&
+                  (current ? "bg-muted-foreground inset-ring-primary" : "bg-muted-foreground"),
+              )}
+            />
+          </TooltipTrigger>
+        );
+      })}
+    </div>
+  );
+}
+
+function StatusLine(props: {
+  readonly status: PicksBatchView["status"];
+  readonly open: boolean;
+  readonly completing: boolean;
+  readonly left: number;
+  readonly total: number;
+  readonly threadTitle: string;
+  readonly unsentDraftNote: boolean;
+}) {
+  const gt = useGT();
+  const text =
+    props.status === "answered"
+      ? props.total === 1
+        ? gt('Sent 1 pick to "{thread}".', { thread: props.threadTitle })
+        : gt('Sent {count} picks to "{thread}".', { count: props.total, thread: props.threadTitle })
+      : props.status === "cancelled"
+        ? gt("These picks were closed.")
+        : !props.open
+          ? gt("This connection can't answer picks.")
+          : props.completing
+            ? null
+            : props.left > 0
+              ? props.unsentDraftNote
+                ? gt("{count} left · note saves with your pick", { count: props.left })
+                : gt("{count} left · saved as you go", { count: props.left })
+              : gt('All {count} answered · resumes "{thread}"', {
+                  count: props.total,
+                  thread: props.threadTitle,
+                });
+  return text === null ? null : (
+    <Tooltip>
+      <TooltipTrigger
+        render={
+          <p className="truncate text-sm text-muted-foreground" data-testid="picker-status">
+            {text}
+          </p>
+        }
+      />
+      <TooltipPopup>{text}</TooltipPopup>
+    </Tooltip>
+  );
+}
+
+function ForwardButtons(props: {
+  /** Ring the send button once when it enables after a pick here. */
+  readonly pulse: boolean;
+  readonly environmentId: EnvironmentId;
+  readonly threadId: PicksBatchView["threadId"];
+  readonly status: PicksBatchView["status"];
+  readonly open: boolean;
+  readonly completing: boolean;
+  readonly complete: boolean;
+  readonly compact: boolean;
+  readonly sendKey: string;
+  readonly onSend: () => void;
+}) {
+  const gt = useGT();
+  const pulseOnMount = useStableCallback((node: HTMLButtonElement | null) => {
+    if (node === null || !props.pulse) return;
+    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
+    node.animate(
+      [{ boxShadow: "0 0 0 0 var(--color-ring)" }, { boxShadow: "0 0 0 8px transparent" }],
+      { duration: 700, easing: "ease-out" },
+    );
+  });
+  const openThread = (
+    <Button
+      variant={props.status === "answered" ? "default" : "outline"}
+      className="whitespace-nowrap"
+      render={
+        <Link
+          to="/$environmentId/$threadId"
+          params={{ environmentId: props.environmentId, threadId: props.threadId }}
+        />
+      }
+    >
+      {gt("Open thread")}
+    </Button>
+  );
+  if (props.status === "answered") {
+    return (
+      <>
+        {openThread}
+        <Button variant="outline" className="whitespace-nowrap" render={<Link to="/picks" />}>
+          {gt("Back to Picks")}
+        </Button>
+      </>
+    );
+  }
+  if (!props.open) return openThread;
+  if (props.completing) {
+    return (
+      <Button disabled className="whitespace-nowrap">
+        <Spinner />
+        {gt("Sending…")}
+      </Button>
+    );
+  }
+  return (
+    <Button
+      key={props.complete ? "send-ready" : "send-incomplete"}
+      ref={props.complete ? pulseOnMount : undefined}
+      variant={props.complete ? "default" : "outline"}
+      disabled={!props.complete}
+      data-testid="picker-submit"
+      className="whitespace-nowrap"
+      onClick={props.onSend}
+    >
+      {gt("Send picks")}
+      {props.compact ? null : (
+        <Kbd variant={props.complete ? "on-primary" : "default"}>{props.sendKey}</Kbd>
+      )}
+    </Button>
+  );
+}
diff --git a/apps/web/src/components/picks/PicksBatchFrame.tsx b/apps/web/src/components/picks/PicksBatchFrame.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..474ec89adc9f29d284f44f6e0a0808dfff57a39d
--- /dev/null
+++ b/apps/web/src/components/picks/PicksBatchFrame.tsx
@@ -0,0 +1,24 @@
+import type { ReactNode } from "react";
+
+import { useStableCallback } from "~/hooks/useStableCallback";
+import { useSidebar } from "../ui/sidebar";
+
+/**
+ * An open batch: the thread sidebar is hidden while it shows, without changing the stored
+ * preference, and comes back when it goes. Toggling the sidebar here ends that for this visit.
+ */
+export function PicksBatchFrame(props: { readonly children: ReactNode }) {
+  const { overrideOpen } = useSidebar();
+  // Tied to this element's life, like the picker's focus on mount; one identity, so a
+  // re-render never hides a sidebar the owner opened again.
+  const hideWhileShown = useStableCallback((node: HTMLDivElement | null) => {
+    if (node === null) return;
+    overrideOpen(false);
+    return () => overrideOpen(null);
+  });
+  return (
+    <div ref={hideWhileShown} className="flex min-h-0 flex-1 flex-col" data-testid="picks-batch">
+      {props.children}
+    </div>
+  );
+}
diff --git a/apps/web/src/components/picks/PicksHeader.tsx b/apps/web/src/components/picks/PicksHeader.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..d37aa52e96006bc688a57f9851c52a5f2eff8fe0
--- /dev/null
+++ b/apps/web/src/components/picks/PicksHeader.tsx
@@ -0,0 +1,296 @@
+import type { EnvironmentId, ThreadId } from "@t3tools/contracts";
+import { Link } from "@tanstack/react-router";
+import { useGT } from "gt-react";
+import { Columns2Icon, KeyboardIcon, LayersIcon, ZoomInIcon } from "lucide-react";
+import type { ReactNode } from "react";
+
+import {
+  WorkspaceBreadcrumb,
+  WorkspaceBreadcrumbItem,
+  WorkspaceBreadcrumbSeparator,
+} from "~/components/WorkspaceBreadcrumb";
+import { WorkspacePageHeader } from "~/components/WorkspacePageHeader";
+import { isElectron } from "~/env";
+import { cn } from "~/lib/utils";
+import { Button } from "../ui/button";
+import { Kbd } from "../ui/kbd";
+import { Popover, PopoverPopup, PopoverTitle, PopoverTrigger } from "../ui/popover";
+import { Tooltip, TooltipPopup, TooltipTrigger } from "../ui/tooltip";
+
+export interface PicksInspectorControls {
+  readonly blink: boolean;
+  readonly canToggleBlink: boolean;
+  readonly onSetBlink: (blink: boolean) => void;
+  readonly loupe: boolean;
+  readonly onToggleLoupe: () => void;
+  readonly compact: boolean;
+}
+
+export interface PicksShortcutGroup {
+  readonly optionCount: number;
+  readonly canAnswer: boolean;
+  readonly sendKey: string;
+  readonly allowTie: boolean;
+  readonly canBlink?: boolean;
+  readonly canLoupe?: boolean;
+  readonly flip: boolean;
+  readonly video: boolean;
+  readonly open: boolean;
+  readonly onOpenChange: (open: boolean) => void;
+}
+
+/** The Picks page's header: the inbox, or `Picks / {batch}` with its thread, inspector, counter and keys. */
+export function PicksHeader(props: {
+  readonly batch?:
+    | {
+        readonly environmentId: EnvironmentId;
+        readonly threadId: ThreadId;
+        readonly title: string;
+        readonly threadTitle: string;
+      }
+    | undefined;
+  readonly inspector?: PicksInspectorControls | undefined;
+  readonly counter?: ReactNode;
+  readonly shortcuts?: PicksShortcutGroup | undefined;
+}) {
+  const gt = useGT();
+  const { batch, inspector, shortcuts } = props;
+  return (
+    <WorkspacePageHeader
+      electron={isElectron}
+      className="relative border-b border-border/60 bg-background"
+    >
+      <WorkspaceBreadcrumb ariaLabel={gt("Picks breadcrumb")} className="flex-1">
+        <WorkspaceBreadcrumbItem current={batch === undefined}>
+          {batch === undefined ? (
+            <h1 className="truncate">{gt("Picks")}</h1>
+          ) : (
+            <Link
+              to="/picks"
+              className="[-webkit-app-region:no-drag] rounded-sm transition-colors hover:text-foreground"
+            >
+              {gt("Picks")}
+            </Link>
+          )}
+        </WorkspaceBreadcrumbItem>
+        {batch === undefined ? null : (
+          <>
+            <WorkspaceBreadcrumbSeparator />
+            <WorkspaceBreadcrumbItem current>
+              <h1 className="truncate">{batch.title}</h1>
+            </WorkspaceBreadcrumbItem>
+            <li className="flex min-w-0 shrink items-center">
+              <Link
+                to="/$environmentId/$threadId"
+                params={{ environmentId: batch.environmentId, threadId: batch.threadId }}
+                className="[-webkit-app-region:no-drag] truncate rounded-md bg-muted/60 px-2 py-0.5 text-xs text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
+                data-testid="picks-header-thread"
+              >
+                {gt("from {thread}", { thread: batch.threadTitle })}
+              </Link>
+            </li>
+          </>
+        )}
+      </WorkspaceBreadcrumb>
+      {inspector === undefined && props.counter === undefined && shortcuts === undefined ? null : (
+        <div className="[-webkit-app-region:no-drag] flex shrink-0 items-center gap-2">
+          {inspector === undefined ? null : <InspectorToolbar inspector={inspector} />}
+          {props.counter === undefined ? null : (
+            <div
+              className="flex items-center gap-2 text-xs text-muted-foreground tabular-nums"
+              data-testid="picker-progress"
+            >
+              {props.counter}
+            </div>
+          )}
+          {shortcuts === undefined ? null : <ShortcutsPopover shortcuts={shortcuts} />}
+        </div>
+      )}
+    </WorkspacePageHeader>
+  );
+}
+
+function InspectorToolbar({ inspector }: { readonly inspector: PicksInspectorControls }) {
+  const gt = useGT();
+  return (
+    <div className="flex items-center gap-1.5" data-testid="picker-inspector">
+      {inspector.canToggleBlink ? (
+        <div
+          role="group"
+          aria-label={gt("Compare view")}
+          data-testid="picker-mode-toggle"
+          className="inline-flex h-6 items-center rounded-md border border-border/80 bg-muted/50 p-0.5 text-xs"
+        >
+          <Tooltip>
+            <TooltipTrigger
+              render={
+                <button
+                  type="button"
+                  aria-pressed={!inspector.blink}
+                  aria-label={gt("Side by side")}
+                  data-testid="picker-mode-sbs"
+                  onClick={() => inspector.onSetBlink(false)}
+                  className={cn(
+                    "inline-flex h-full cursor-pointer items-center gap-1 rounded-sm px-1.5 font-medium transition-colors outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring",
+                    !inspector.blink
+                      ? "bg-background text-foreground shadow-2xs"
+                      : "text-muted-foreground hover:text-foreground",
+                  )}
+                />
+              }
+            >
+              <Columns2Icon className="size-3" aria-hidden />
+              {inspector.compact ? null : <span>{gt("Side by side")}</span>}
+            </TooltipTrigger>
+            <TooltipPopup>{gt("Side by side (B)")}</TooltipPopup>
+          </Tooltip>
+          <Tooltip>
+            <TooltipTrigger
+              render={
+                <button
+                  type="button"
+                  aria-pressed={inspector.blink}
+                  aria-label={gt("Blink")}
+                  data-testid="picker-mode-blink"
+                  onClick={() => inspector.onSetBlink(true)}
+                  className={cn(
+                    "inline-flex h-full cursor-pointer items-center gap-1 rounded-sm px-1.5 font-medium transition-colors outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring",
+                    inspector.blink
+                      ? "bg-background text-foreground shadow-2xs"
+                      : "text-muted-foreground hover:text-foreground",
+                  )}
+                />
+              }
+            >
+              <LayersIcon className="size-3" aria-hidden />
+              {inspector.compact ? null : <span>{gt("Blink")}</span>}
+              {inspector.compact ? null : <Kbd>B</Kbd>}
+            </TooltipTrigger>
+            <TooltipPopup>{gt("Blink view (B)")}</TooltipPopup>
+          </Tooltip>
+        </div>
+      ) : (
+        <Tooltip>
+          <TooltipTrigger
+            render={
+              <span
+                data-testid="picker-mode-forced-blink"
+                className="inline-flex h-6 items-center gap-1 rounded-md border border-border/70 bg-muted/50 px-2 text-2xs font-medium text-muted-foreground"
+              />
+            }
+          >
+            <LayersIcon className="size-3" aria-hidden />
+            {inspector.compact ? null : <span>{gt("Blink")}</span>}
+          </TooltipTrigger>
+          <TooltipPopup>{gt("Single-plate blink view: press F to cycle options")}</TooltipPopup>
+        </Tooltip>
+      )}
+      <Tooltip>
+        <TooltipTrigger
+          render={
+            <Button
+              variant={inspector.loupe ? "secondary" : "ghost-muted"}
+              size="xs"
+              aria-pressed={inspector.loupe}
+              aria-label={gt("Detail loupe")}
+              data-testid="picker-loupe-toggle"
+              onClick={inspector.onToggleLoupe}
+            />
+          }
+        >
+          <ZoomInIcon className="size-3.5" />
+          {inspector.compact ? null : gt("Loupe")}
+          {inspector.compact ? null : <Kbd>Z</Kbd>}
+        </TooltipTrigger>
+        <TooltipPopup>{gt("Detail loupe (Z)")}</TooltipPopup>
+      </Tooltip>
+    </div>
+  );
+}
+
+function ShortcutsPopover({ shortcuts }: { readonly shortcuts: PicksShortcutGroup }) {
+  const gt = useGT();
+  const optionKeys = Array.from({ length: Math.max(shortcuts.optionCount, 1) }, (_, index) =>
+    String(index + 1),
+  );
+  const rows: ReadonlyArray<{ readonly label: string; readonly keys: ReadonlyArray<string> }> = [
+    ...(shortcuts.canAnswer
+      ? [
+          { label: gt("Pick an option"), keys: optionKeys },
+          ...(shortcuts.allowTie ? [{ label: gt("Can't tell"), keys: ["0"] }] : []),
+        ]
+      : []),
+    { label: gt("Previous / next question"), keys: ["←", "→"] },
+    ...(shortcuts.canAnswer
+      ? [
+          { label: gt("Next unanswered"), keys: ["U"] },
+          { label: gt("Add note / previous pick's note"), keys: ["N", "⇧N"] },
+        ]
+      : []),
+    ...(shortcuts.canBlink ? [{ label: gt("Side by side / blink view"), keys: ["B"] }] : []),
+    ...(shortcuts.flip ? [{ label: gt("Flip options"), keys: ["F", "⇧F"] }] : []),
+    ...(shortcuts.canLoupe
+      ? [
+          { label: gt("Detail loupe"), keys: ["Z"] },
+          { label: gt("Move loupe"), keys: ["⇧←", "⇧↑", "⇧↓", "⇧→"] },
+        ]
+      : []),
+    ...(shortcuts.video
+      ? [
+          { label: gt("Play / pause · half speed · replay"), keys: [gt("Space"), "S", "R"] },
+          { label: gt("Step frame back / forward"), keys: [",", "."] },
+        ]
+      : []),
+    ...(shortcuts.canAnswer ? [{ label: gt("Send picks"), keys: [shortcuts.sendKey] }] : []),
+  ];
+  return (
+    <Popover open={shortcuts.open} onOpenChange={shortcuts.onOpenChange}>
+      <PopoverTrigger
+        render={
+          <Button
+            variant="ghost-muted"
+            size="xs"
+            aria-label={gt("Keyboard shortcuts")}
+            data-testid="picker-shortcuts-trigger"
+          />
+        }
+      >
+        <KeyboardIcon className="size-3.5" />
+        <Kbd>?</Kbd>
+      </PopoverTrigger>
+      <PopoverPopup
+        side="bottom"
+        align="end"
+        width="md"
+        padding="compact"
+        onKeyDown={(event) => {
+          if (event.nativeEvent.isComposing || event.keyCode === 229) return;
+          if (event.key === "?" && !event.repeat) {
+            event.preventDefault();
+            event.stopPropagation();
+            shortcuts.onOpenChange(false);
+          }
+        }}
+      >
+        <div className="flex flex-col gap-2 py-1" data-testid="picker-shortcuts-popup">
+          <div className="flex items-center justify-between gap-2 px-1">
+            <PopoverTitle>{gt("Keyboard shortcuts")}</PopoverTitle>
+            <Kbd>?</Kbd>
+          </div>
+          <dl className="flex flex-col gap-1.5 px-1 text-xs">
+            {rows.map((row) => (
+              <div key={row.label} className="flex items-center justify-between gap-3">
+                <dt className="text-muted-foreground">{row.label}</dt>
+                <dd className="flex shrink-0 items-center gap-1">
+                  {row.keys.map((item) => (
+                    <Kbd key={item}>{item}</Kbd>
+                  ))}
+                </dd>
+              </div>
+            ))}
+          </dl>
+        </div>
+      </PopoverPopup>
+    </Popover>
+  );
+}
diff --git a/apps/web/src/components/picks/PicksPage.tsx b/apps/web/src/components/picks/PicksPage.tsx
