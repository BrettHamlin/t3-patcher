+        ref={mountCanvas}
+        data-u={u}
+        data-v={v}
+        data-zoom={zoom}
+        data-pixelated={pixelated}
+        data-size={size}
+        data-media-w={mediaRect.width}
+        data-media-h={mediaRect.height}
