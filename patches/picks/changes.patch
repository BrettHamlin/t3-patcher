+/** A card's border (2 px each side) and its 36 px studio plinth around the stage. */
+export const PICK_CARD_CHROME = { width: 4, height: 40 } as const;
+export const PICK_CARD_GAP = 16;
+/** Neutral surround steps around exact media boxes, stepped down when space is tight. */
+const PICK_MAT_STEPS = [12, 6, 0] as const;
+/** Neutral surround steps around default-size media boxes, stepped down when space is tight. */
+const PICK_FIT_MAT_STEPS = [16, 12, 6, 0] as const;
