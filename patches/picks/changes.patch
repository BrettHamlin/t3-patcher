@@ -0,0 +1,352 @@
+import { useAtomValue } from "@effect/atom-react";
+import { pickSaveQueue } from "@t3tools/client-runtime/picks";
+import { squashAtomCommandFailure } from "@t3tools/client-runtime/state/runtime";
+import {
+  type AssetResource,
+  type EnvironmentId,
+  PicksError,
+  type ThreadId,
+  type TurnItemId,
+} from "@t3tools/contracts";
+import { Link, useSearch } from "@tanstack/react-router";
+import * as DateTime from "effect/DateTime";
+import * as Schema from "effect/Schema";
+import { useGT, useMessages } from "gt-react";
+import { ArrowRightIcon, ScaleIcon } from "lucide-react";
+import { useState } from "react";
+
+import { useAssetUrlState } from "~/assets/assetUrls";
+import { Badge } from "~/components/ui/badge";
+import {
+  Empty,
+  EmptyDescription,
+  EmptyHeader,
+  EmptyMedia,
+  EmptyTitle,
+} from "~/components/ui/empty";
+import { SidebarInset } from "~/components/ui/sidebar";
+import { Skeleton } from "~/components/ui/skeleton";
+import { cn } from "~/lib/utils";
+import { type OpenPickBatch, picksEnvironment, useOpenPicks } from "~/state/picks";
+import { useEnvironmentQuery } from "~/state/query";
+import { useAtomCommand } from "~/state/use-atom-command";
+import { formatRelativeTimeLabel } from "~/timestampFormat";
+import { PickBatchGate } from "./PickBatchGate";
+import { PickMediaElement } from "./PickMedia";
+import { PicksBatchFrame } from "./PicksBatchFrame";
+import { PicksHeader } from "./PicksHeader";
+import { PickerView, type PickMediaProps } from "./PickerView";
+
+const isPicksError = Schema.is(PicksError);
+
+export interface PicksSearch {
+  readonly environmentId?: EnvironmentId;
+  readonly threadId?: ThreadId;
+  readonly batchId?: TurnItemId;
+}
+
+export function PicksPage() {
+  const search: PicksSearch = useSearch({ from: "/_chat/picks" });
+  const open =
+    search.environmentId !== undefined &&
+    search.threadId !== undefined &&
+    search.batchId !== undefined
+      ? { environmentId: search.environmentId, threadId: search.threadId, batchId: search.batchId }
+      : null;
+  return (
+    <SidebarInset className="h-dvh min-h-0 overflow-hidden overscroll-y-none">
+      <div className="flex min-h-0 flex-1 flex-col bg-background">
+        {open === null ? (
+          <>
+            <PicksHeader />
+            <PicksList />
+          </>
+        ) : (
+          <PicksBatchFrame key={open.batchId}>
+            <PicksBatch {...open} />
+          </PicksBatchFrame>
+        )}
+      </div>
+    </SidebarInset>
+  );
+}
+
+function PicksList() {
+  const gt = useGT();
+  const messages = useMessages();
+  const batches = useOpenPicks();
+  if (batches.length === 0) {
+    return (
+      <div className="flex min-h-0 flex-1 items-center justify-center p-6">
+        <Empty>
+          <EmptyHeader>
+            <EmptyMedia variant="icon">
+              <ScaleIcon />
+            </EmptyMedia>
+            <EmptyTitle>{gt("No picks waiting")}</EmptyTitle>
+            <EmptyDescription>
+              {gt("Blind image and video comparisons requested by your agents show up here.")}
+            </EmptyDescription>
+          </EmptyHeader>
+        </Empty>
+      </div>
+    );
+  }
+  const distinctEnvironments = new Set(batches.map((batch) => batch.environmentId)).size > 1;
+  return (
+    <div className="scrollbar-gutter-both flex min-h-0 flex-1 flex-col overflow-y-auto">
+      <div className="mx-auto flex w-full max-w-3xl flex-col gap-3 px-6 py-6">
+        <p className="px-0.5 text-xs font-medium text-muted-foreground tabular-nums">
+          {batches.length === 1
+            ? gt("1 batch waiting")
+            : gt("{count} batches waiting", { count: batches.length })}
+        </p>
+        <ul className="flex flex-col gap-2.5" data-testid="picks-list">
+          {batches.map((batch) => (
+            <PicksListRow
+              key={`${batch.environmentId}:${batch.batchId}`}
+              batch={batch}
+              age={formatRelativeTimeLabel(
+                DateTime.formatIso(batch.createdAt),
+                undefined,
+                messages,
+              )}
+              showEnvironment={distinctEnvironments}
+            />
+          ))}
+        </ul>
+      </div>
+    </div>
+  );
+}
+
+/**
+ * A batch card in the inbox. The whole card opens it through its stretched title link; the thread
+ * link sits above that as its own target, since links can't nest.
+ */
+export function PicksListRow({
+  batch,
+  age,
+  showEnvironment = false,
+}: {
+  readonly batch: OpenPickBatch;
+  readonly age: string;
+  readonly showEnvironment?: boolean;
+}) {
+  const gt = useGT();
+  const done = batch.answeredCount === batch.questionCount;
+  const ratio = Math.min(Math.max(batch.answeredCount / batch.questionCount, 0), 1);
+  const action =
+    batch.answeredCount === 0 ? gt("Start") : done ? gt("Review and send") : gt("Resume");
+  return (
+    <li
+      className={cn(
+        "group relative flex flex-col gap-2 rounded-xl border bg-card px-4 py-3.5 shadow-2xs transition-colors",
+        done
+          ? "border-warning/35 hover:border-warning/55 hover:bg-accent/30"
+          : "border-border/80 hover:border-foreground/25 hover:bg-accent/35",
+      )}
+      data-testid="picks-row"
+    >
+      <div className="flex min-w-0 items-center gap-3">
+        <Link
+          to="/picks"
+          search={{
+            environmentId: batch.environmentId,
+            threadId: batch.threadId,
+            batchId: batch.batchId,
+          }}
+          className="min-w-0 flex-1 truncate text-sm font-semibold text-foreground outline-none after:absolute after:inset-0 after:rounded-xl focus-visible:after:ring-2 focus-visible:after:ring-inset focus-visible:after:ring-ring"
+        >
+          {batch.title}
+        </Link>
+        {done ? (
+          <Badge variant="warning-outline" data-testid="picks-row-not-sent">
+            {gt("Not sent")}
+          </Badge>
+        ) : null}
+        <div className="flex shrink-0 items-center gap-2">
+          <span
+            aria-hidden
+            className="hidden h-1.5 w-16 overflow-hidden rounded-full bg-muted-foreground/20 inset-ring inset-ring-foreground/55 sm:inline-flex"
+          >
+            <span
+              className={cn(
+                "h-full rounded-full transition-[width]",
+                done ? "bg-warning-foreground" : "bg-primary",
+              )}
+              style={{ width: `${Math.round(ratio * 100)}%` }}
+            />
+          </span>
+          <span className="text-xs text-muted-foreground tabular-nums">
+            {gt("{answered} of {total} answered", {
+              answered: batch.answeredCount,
+              total: batch.questionCount,
+            })}
+          </span>
+        </div>
+        <span
+          className={cn(
+            "inline-flex h-7 shrink-0 items-center gap-1 rounded-md px-2.5 text-xs font-medium transition-colors",
+            done
+              ? "bg-primary text-primary-foreground group-hover:bg-primary/90"
+              : "border border-input bg-background text-foreground group-hover:bg-accent",
+          )}
+        >
+          {action}
+          <ArrowRightIcon className="size-3.5 opacity-80" aria-hidden />
+        </span>
+      </div>
+      <div className="flex min-w-0 flex-wrap items-center gap-x-1.5 gap-y-0.5 text-xs text-muted-foreground">
+        <span className="max-w-full min-w-0 shrink truncate text-foreground/80">
+          {batch.firstPrompt}
+        </span>
+        <div className="flex max-w-full min-w-0 flex-wrap items-center gap-x-1.5 gap-y-0.5">
+          <span aria-hidden>·</span>
+          <Link
+            to="/$environmentId/$threadId"
+            params={{ environmentId: batch.environmentId, threadId: batch.threadId }}
+            style={{ minWidth: "min(5rem, max-content)" }}
+            className="relative z-10 min-w-0 shrink overflow-hidden rounded-xs underline-offset-2 outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring hover:text-foreground hover:underline"
+          >
+            <span className="block max-w-48 truncate">
+              {gt("from {thread}", { thread: batch.threadTitle })}
+            </span>
+          </Link>
+          {showEnvironment ? (
+            <>
+              <span aria-hidden>·</span>
+              <span
+                style={{ minWidth: "min(3.5rem, max-content)" }}
+                className="min-w-0 shrink overflow-hidden"
+              >
+                <span className="block max-w-32 truncate">{batch.environmentLabel}</span>
+              </span>
+            </>
+          ) : null}
+          <span aria-hidden>·</span>
+          <span className="shrink-0 tabular-nums">{age}</span>
+        </div>
+      </div>
+    </li>
+  );
+}
+
+function PicksBatch(props: {
+  readonly environmentId: EnvironmentId;
+  readonly threadId: ThreadId;
+  readonly batchId: TurnItemId;
+}) {
+  const gt = useGT();
+  const input = { threadId: props.threadId, batchId: props.batchId };
+  const batch = useEnvironmentQuery(
+    picksEnvironment.get({ environmentId: props.environmentId, input }),
+  );
+  const answer = useAtomCommand(picksEnvironment.answer, {
+    label: "save a pick",
+    reportFailure: false,
+  });
+  const complete = useAtomCommand(picksEnvironment.complete, {
+    label: "finish picks",
+    reportFailure: false,
+  });
+  const canAnswer = useAtomValue(picksEnvironment.answer.permissionAtom(props.environmentId));
+  const saveQueue = pickSaveQueue({ environmentId: props.environmentId, ...input });
+  // The picker starts from a read made after this batch's earlier saves landed, never a cached
+  // one; the queue, not this gate, keeps the saves in order.
+  return (
+    <PickBatchGate saveQueue={saveQueue} onSettled={batch.refresh}>
+      {(openedAt) =>
+        batch.data === null || batch.dataUpdatedAt < openedAt ? (
+          <>
+            <PicksHeader />
+            {batch.error === null ? (
+              <div className="mx-auto flex w-full max-w-3xl flex-1 flex-col justify-center gap-4 p-6">
+                <Skeleton className="mx-auto h-7 w-72" />
+                <div className="flex justify-center gap-4">
+                  <Skeleton className="size-64" />
+                  <Skeleton className="size-64" />
+                </div>
+              </div>
+            ) : (
+              <p role="alert" className="p-6 text-sm text-destructive">
+                {batch.error}
+              </p>
+            )}
+          </>
+        ) : (
+          <PickerView
+            environmentId={props.environmentId}
+            view={batch.data}
+            saveQueue={saveQueue}
+            canAnswer={canAnswer}
+            Media={PickMedia}
+            onAnswer={async (choice) => {
+              const result = await answer({
+                environmentId: props.environmentId,
+                input: { ...input, ...choice },
+              });
+              return result._tag === "Success" ? null : gt("The answer could not be saved.");
+            }}
+            onComplete={async () => {
+              const result = await complete({ environmentId: props.environmentId, input });
+              if (result._tag === "Success") return null;
+              const failure = squashAtomCommandFailure(result);
+              return isPicksError(failure) && failure.reason === "notes_too_long"
+                ? gt("The notes are too long to send. Shorten some and press Send picks again.")
+                : gt("The picks could not be finished.");
+            }}
+          />
+        )
+      }
+    </PickBatchGate>
+  );
+}
+
+function PickMedia({
+  environmentId,
+  option,
+  label,
+  fit,
+  pixelated,
+  longSide,
+  retryRevision,
+  onReady,
+}: PickMediaProps) {
+  const resource: AssetResource = {
+    _tag: "attachment",
+    attachmentId: option.attachmentId,
+    mimeType: option.mimeType,
+    disposition: "inline",
+  };
+  const asset = useAssetUrlState(
+    environmentId,
+    resource,
+    retryRevision === undefined ? undefined : String(retryRevision),
+  );
+  const [settledRevision, setSettledRevision] = useState<number | undefined>(undefined);
+  if (
+    retryRevision !== undefined &&
+    settledRevision !== retryRevision &&
+    asset._tag !== "Loading" &&
+    asset.waiting !== true
+  ) {
+    setSettledRevision(retryRevision);
+  }
+  const waitingForRetry =
+    retryRevision !== undefined && settledRevision !== retryRevision && asset.waiting === true;
+  if (asset._tag === "Loading" || waitingForRetry) {
+    return null;
+  }
+  return (
+    <PickMediaElement
+      url={asset._tag === "Failure" ? null : asset.url}
+      kind={option.mediaKind}
+      label={label}
+      fit={fit}
+      pixelated={pixelated}
+      longSide={longSide}
+      onReady={onReady}
+    />
+  );
+}
