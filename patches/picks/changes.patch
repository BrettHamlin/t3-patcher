new file mode 100644
index 0000000000000000000000000000000000000000..1a5293d128b844a0c8161d0e7283b84b0d489775
--- /dev/null
+++ b/apps/server/src/picks/pickWake.ts
@@ -0,0 +1,53 @@
+import {
+  type OrchestrationV2Notification,
+  PICK_TIE,
+  type PickAnswers,
+  type PickStoredQuestion,
+} from "@t3tools/contracts";
+
+/**
+ * The one message that tells the agent every answer, unblinded: a line per
+ * question for reading, and the same answers as JSON for parsing.
+ */
+export function pickRequestWake(batch: {
+  readonly batchId: string;
+  readonly title: string;
+  readonly questions: ReadonlyArray<PickStoredQuestion>;
+  readonly answers: PickAnswers;
+}): { readonly text: string; readonly notification: OrchestrationV2Notification } {
+  const answers = batch.questions.flatMap((question) => {
+    const answer = batch.answers[question.id];
+    return answer === undefined
+      ? []
+      : [
+          {
+            questionId: question.id,
+            choice: answer.choice,
+            ...(answer.note === undefined ? {} : { note: answer.note }),
+          },
+        ];
+  });
+  const lines = answers.map(
+    (answer) =>
+      `- ${answer.questionId} → ${answer.choice === PICK_TIE ? "tie (can't tell)" : answer.choice}${
+        answer.note === undefined ? "" : `. Note: ${answer.note}`
+      }`,
+  );
+  const json = JSON.stringify({ batchId: batch.batchId, title: batch.title, answers }, null, 2);
+  return {
+    text: [
+      `The user answered the picks "${batch.title}": ${answers.length} of ${batch.questions.length} questions.`,
+      "",
+      ...lines,
+      "",
+      "```json",
+      json,
+      "```",
+    ].join("\n"),
+    notification: {
+      source: { kind: "background_task" },
+      outcome: "completed",
+      summary: `Answers to picks: ${batch.title}`,
+    },
+  };
+}
