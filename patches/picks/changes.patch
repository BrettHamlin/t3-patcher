@@ -0,0 +1,208 @@
+import * as Schema from "effect/Schema";
+
+import {
+  NonNegativeInt,
+  PositiveInt,
+  ThreadId,
+  TrimmedNonEmptyString,
+  TurnItemId,
+} from "./baseSchemas.ts";
+
+const PICKS_MAX_QUESTIONS = 200;
+const PICKS_MIN_OPTIONS = 2;
+const PICKS_MAX_OPTIONS = 4;
+/** The choice an answer records when the user can't tell the options apart. */
+export const PICK_TIE = "tie";
+export const PICK_NOTE_MAX_LENGTH = 2000;
+
+const PickId = TrimmedNonEmptyString.check(Schema.isMaxLength(128));
+const PickText = (maxLength: number) => TrimmedNonEmptyString.check(Schema.isMaxLength(maxLength));
+const PickNote = Schema.String.check(Schema.isMaxLength(PICK_NOTE_MAX_LENGTH));
+
+export const PickDisplay = Schema.Struct({
+  width: PositiveInt.check(Schema.isLessThanOrEqualTo(4096)),
+  height: PositiveInt.check(Schema.isLessThanOrEqualTo(4096)),
+  pixelated: Schema.optionalKey(Schema.Boolean),
+});
+export type PickDisplay = typeof PickDisplay.Type;
+
+export const PickMediaKind = Schema.Literals(["image", "video"]);
+export type PickMediaKind = typeof PickMediaKind.Type;
+
+export const PickRequestStatus = Schema.Literals(["pending", "answered", "cancelled"]);
+export type PickRequestStatus = typeof PickRequestStatus.Type;
+
+export const PicksRequestInput = Schema.Struct({
+  title: PickText(200).annotate({ description: "The batch's name in the user's Picks inbox." }),
+  questions: Schema.Array(
+    Schema.Struct({
+      id: PickId.annotate({ description: "Unique in the batch." }),
+      prompt: PickText(500).annotate({
+        description: 'What to judge, e.g. "Which looks more like a real person?"',
+      }),
+      guidance: Schema.optionalKey(PickText(1000).annotate({ description: "How to judge." })),
+      options: Schema.Array(
+        Schema.Struct({
+          id: PickId.annotate({ description: 'Unique in the question; not "tie".' }),
+          path: PickText(1024).annotate({
+            description:
+              "Absolute path on this machine: png, jpg, webp, gif, avif or apng image, or mp4, webm or mov video.",
+          }),
+        }),
+      ).check(Schema.isMinLength(PICKS_MIN_OPTIONS), Schema.isMaxLength(PICKS_MAX_OPTIONS)),
+      display: Schema.optionalKey(
+        PickDisplay.annotate({
+          description:
+            "The CSS-pixel box each option is shown in, e.g. its size in use. Default: fit the space.",
+        }),
+      ),
+    }),
+  ).check(Schema.isMinLength(1), Schema.isMaxLength(PICKS_MAX_QUESTIONS)),
+  allowTie: Schema.optionalKey(
+    Schema.Boolean.annotate({ description: 'Offer "Can\'t tell". Default true.' }),
+  ),
+  clientRequestId: Schema.optionalKey(
+    PickText(256).annotate({
+      description: "Retry key. A repeat with the same key returns the batch already recorded.",
+    }),
+  ),
+});
+export type PicksRequestInput = typeof PicksRequestInput.Type;
+
+export const PicksRequestResult = Schema.Struct({
+  status: PickRequestStatus.annotate({
+    description:
+      "pending: in the user's inbox. Every answer arrives as one message in this thread when they finish.",
+  }),
+  batchId: TurnItemId,
+  questions: PositiveInt,
+});
+export type PicksRequestResult = typeof PicksRequestResult.Type;
+
+/** An option as stored: the file was copied into the attachments store when asked. */
+export const PickStoredOption = Schema.Struct({
+  id: PickId,
+  attachmentId: PickText(256),
+  mediaKind: PickMediaKind,
+  mimeType: PickText(100),
+});
+export type PickStoredOption = typeof PickStoredOption.Type;
+
+/** `options` is in the shuffled order the inbox shows. */
+export const PickStoredQuestion = Schema.Struct({
+  id: PickId,
+  prompt: Schema.String,
+  guidance: Schema.optionalKey(Schema.String),
+  display: Schema.optionalKey(PickDisplay),
+  options: Schema.Array(PickStoredOption),
+});
+export type PickStoredQuestion = typeof PickStoredQuestion.Type;
+
+/** `choice` is an option id or `PICK_TIE`. */
+export const PickAnswer = Schema.Struct({
+  choice: PickId,
+  note: Schema.optionalKey(PickNote),
+});
+export type PickAnswer = typeof PickAnswer.Type;
+
+export const PickAnswers = Schema.Record(Schema.String, PickAnswer);
+export type PickAnswers = typeof PickAnswers.Type;
+
+/** What the inbox sees of a choice: the option's place on screen, never its id. */
+export const PickViewChoice = Schema.Union([NonNegativeInt, Schema.Literal(PICK_TIE)]);
+export type PickViewChoice = typeof PickViewChoice.Type;
+
+export const PicksBatchInput = Schema.Struct({
+  threadId: ThreadId,
+  batchId: TurnItemId,
+});
+export type PicksBatchInput = typeof PicksBatchInput.Type;
+
+export const PicksBatchSummary = Schema.Struct({
+  threadId: ThreadId,
+  batchId: TurnItemId,
+  title: Schema.String,
+  threadTitle: Schema.String,
+  /** The first question's prompt, so the inbox row says what the batch asks. */
+  firstPrompt: Schema.String,
+  questionCount: PositiveInt,
+  answeredCount: NonNegativeInt,
+  createdAt: Schema.DateTimeUtc,
+});
+export type PicksBatchSummary = typeof PicksBatchSummary.Type;
+
+export const PicksListResult = Schema.Struct({
+  batches: Schema.Array(PicksBatchSummary),
+});
+export type PicksListResult = typeof PicksListResult.Type;
+
+export const PicksBatchView = Schema.Struct({
+  threadId: ThreadId,
+  batchId: TurnItemId,
+  title: Schema.String,
+  threadTitle: Schema.String,
+  allowTie: Schema.Boolean,
+  status: PickRequestStatus,
+  questions: Schema.Array(
+    Schema.Struct({
+      prompt: Schema.String,
+      guidance: Schema.optionalKey(Schema.String),
+      display: Schema.optionalKey(PickDisplay),
+      options: Schema.Array(
+        Schema.Struct({
+          attachmentId: Schema.String,
+          mediaKind: PickMediaKind,
+          mimeType: Schema.String,
+        }),
+      ),
+      answer: Schema.optionalKey(
+        Schema.Struct({ choice: PickViewChoice, note: Schema.optionalKey(Schema.String) }),
+      ),
+    }),
+  ),
+});
+export type PicksBatchView = typeof PicksBatchView.Type;
+
+/**
+ * Only what the owner just did. Without `choice` the stored one stays; without `note` the
+ * stored note stays, and a blank one removes it. The server merges under the batch's lock.
+ */
+export const PicksAnswerInput = Schema.Struct({
+  threadId: ThreadId,
+  batchId: TurnItemId,
+  questionIndex: NonNegativeInt,
+  choice: Schema.optionalKey(PickViewChoice),
+  note: Schema.optionalKey(PickNote),
+});
+export type PicksAnswerInput = typeof PicksAnswerInput.Type;
+
+export const PicksErrorReason = Schema.Literals([
+  "not_found",
+  "closed",
+  "invalid_answer",
+  "incomplete",
+  "notes_too_long",
+  "load_failed",
+  "record_failed",
+]);
+export type PicksErrorReason = typeof PicksErrorReason.Type;
+
+const PICKS_ERROR_MESSAGES: Record<PicksErrorReason, string> = {
+  not_found: "This batch of picks was not found.",
+  closed: "This batch of picks is closed.",
+  invalid_answer: "That answer is not one of this question's choices.",
+  incomplete: "Answer every question before finishing.",
+  notes_too_long:
+    "The notes are too long to send to the agent. Shorten some and press Send picks again.",
+  load_failed: "The picks could not be read.",
+  record_failed: "The picks could not be saved.",
+};
+
+export class PicksError extends Schema.TaggedError<PicksError>()("PicksError", {
+  reason: PicksErrorReason,
+  cause: Schema.optional(Schema.Defect()),
+}) {
+  override get message(): string {
+    return PICKS_ERROR_MESSAGES[this.reason];
+  }
+}
