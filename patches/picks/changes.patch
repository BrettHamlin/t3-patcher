+        acknowledged.current.set(questionIndex, next);
+        return;
+      }
+      const choiceStillCurrent = latest.current.get(questionIndex) === next;
+      const noteStillCurrent =
+        noteAttempt !== undefined &&
+        sentNotes.current.get(questionIndex)?.token === noteAttempt.token;
+      if (!choiceStillCurrent && !noteStillCurrent) return;
+      if (noteStillCurrent) {
+        sentNotes.current.delete(questionIndex);
+      }
+      if (choiceStillCurrent) {
+        // Only if nothing newer was chosen for it: back to the last choice the server took.
+        const confirmed = acknowledged.current.get(questionIndex);
+        if (confirmed === undefined) latest.current.delete(questionIndex);
+        else latest.current.set(questionIndex, confirmed);
+        setSaved((current) => {
+          if (current.get(questionIndex) !== next) return current;
+          const restored = new Map(current);
+          if (confirmed === undefined) restored.delete(questionIndex);
+          else restored.set(questionIndex, confirmed);
+          return restored;
+        });
+      }
+      if (holdKind.current === "send") cancelHold();
+      setError(failure);
+    });
+    setLastAnswered(questionIndex);
+    // The chosen border shows for a moment, then moves to the next blank or auto-sends if done.
+    cancelHold();
+    const after = answers.map((current, place) => (place === questionIndex ? next : current));
+    const target = at.arrivedAnswered ? null : nextUnanswered(after, questionIndex);
+    const shouldAutoSend =
+      target === null && (wasUnanswered || wasHoldingSend) && firstUnanswered(after) === null;
+    if (target !== null) {
+      holdKind.current = "move";
+      hold.current = setTimeout(() => {
+        hold.current = null;
+        holdKind.current = null;
+        go(target);
+      }, PICK_HOLD_MS);
+    } else if (shouldAutoSend) {
+      holdKind.current = "send";
+      hold.current = setTimeout(() => {
+        hold.current = null;
+        holdKind.current = null;
+        finishLatest();
+      }, PICK_HOLD_MS);
+    }
+    // The chosen option's button goes with its question; keys must keep reaching the picker.
+    containerRef.current?.focus();
+  };
+
+  const saveNote = () => {
+    if (finishing.current || !open) return;
+    flushNote(index);
+  };
+
+  const leaveNote = () => {
+    const back = noteReturn;
+    containerRef.current?.focus();
+    if (back !== null) go(back);
+  };
+
+  const flipTo = (shown: number) => {
+    cancelHold();
+    if (question === undefined) return;
+    const place = (shown + question.options.length) % question.options.length;
+    setFlip({
+      ...flipState,
+      shown: place,
+      seen: new Set(flipState.seen).add(place),
+      blocked: false,
+    });
+  };
+
+  /** This visit's clips with their places, in place order. */
+  const placedClips = () =>
+    [...stage.current.ready.entries()]
+      .toSorted(([left], [right]) => left - right)
+      .flatMap(([place, ready]) =>
+        ready._tag === "Loaded" && ready.video !== null ? [{ place, clip: ready.video }] : [],
+      );
+  const clips = () => placedClips().map(({ clip }) => clip);
+  /** Each clip's frame length, in the order `clips` gives them. */
+  const frameLengths = () =>
+    pickFrameLengths(placedClips().map(({ place }) => stage.current.frames.get(place)));
+
+  const readPlayback = (visit: number) => {
+    if (stage.current.visit !== visit) return;
+    const playing = clips();
+    const [leader] = playing;
+    setPlayback({
+      visit,
+      paused: playing.every((clip) => clip.paused),
+      half: leader?.playbackRate === 0.5,
+      position: pickPlaybackPosition(playing, frameLengths()),
+    });
+  };
+
+  const playAll = (playing: ReadonlyArray<HTMLVideoElement>) => {
+    stage.current.stepTime = null;
+    for (const clip of playing) void clip.play().catch(() => undefined);
+  };
+
+  /** Every clip from 0 together; a question opens at 1×, and Replay keeps the speed. */
+  const startClips = (rate?: number) => {
+    const playing = clips();
+    for (const clip of playing) {
+      clip.pause();
+      if (rate !== undefined) clip.playbackRate = rate;
+      clip.currentTime = 0;
+    }
+    stage.current.leaderTime = 0;
+    stage.current.stepTime = null;
+    playAll(playing);
+  };
+
+  /** Learns a clip's frame length from its presented frames: the smallest gap in media time. */
+  const watchFrames = (visit: number, place: number, clip: HTMLVideoElement) => {
+    let last: number | null = null;
+    const onFrame = (_now: number, frame: VideoFrameCallbackMetadata) => {
+      if (stage.current.visit !== visit || !clip.isConnected) return;
+      const gap = frame.mediaTime - (last ?? frame.mediaTime);
+      if (gap > 0.001) {
+        const known = stage.current.frames.get(place);
+        stage.current.frames.set(place, known === undefined ? gap : Math.min(known, gap));
+      }
+      last = frame.mediaTime;
+      clip.requestVideoFrameCallback(onFrame);
+    };
+    clip.requestVideoFrameCallback(onFrame);
+  };
+
+  const onMediaReady = (visit: number, place: number, result: PickMediaReady) => {
+    if (stage.current.visit !== visit) {
+      if (visit < stage.current.visit) return;
+      stage.current = {
+        visit,
+        ready: new Map(),
+        frames: new Map(),
+        leaderTime: 0,
+        stepTime: null,
+      };
+    }
+    if (stage.current.ready.has(place)) return;
+    stage.current.ready.set(place, result);
+    const snapshot = new Map(stage.current.ready);
+    setMedia({ visit, byPlace: snapshot });
+    if (result._tag === "Loaded" && result.video !== null) {
+      const clip = result.video;
+      watchFrames(visit, place, clip);
+      const refresh = () => readPlayback(visit);
+      for (const type of ["play", "pause", "seeked", "ratechange"]) {
+        clip.addEventListener(type, refresh);
+      }
+      clip.addEventListener("timeupdate", () => {
+        refresh();
+        if (place !== 0) return;
+        // Clip 1 wrapped: the others of its length come back into step with it.
+        if (clip.currentTime + 0.05 < stage.current.leaderTime) {
+          for (const other of clips().slice(1)) {
+            const time = inStepTime(clip, other);
+            if (time !== null) other.currentTime = time;
+          }
+        }
+        stage.current.leaderTime = clip.currentTime;
+      });
+    }
+    if (question !== undefined && snapshot.size === question.options.length) {
+      startClips(1);
+      readPlayback(visit);
+    }
+  };
+
+  const playPause = () => {
+    cancelHold();
+    const playing = clips();
+    if (playing.every((clip) => clip.paused)) playAll(playing);
+    else for (const clip of playing) clip.pause();
+  };
+  const halfSpeed = () => {
+    cancelHold();
+    const playing = clips();
+    const rate = playing[0]?.playbackRate === 0.5 ? 1 : 0.5;
+    for (const clip of playing) clip.playbackRate = rate;
+  };
+  const replay = () => {
+    cancelHold();
+    startClips();
+  };
+  const stepFrame = (delta: -1 | 1) => {
+    cancelHold();
+    const playing = clips();
+    for (const clip of playing) clip.pause();
+    const stepped = steppedTimes(
+      playing,
+      frameLengths(),
+      delta,
+      stage.current.stepTime ?? undefined,
+    );
+    stage.current.stepTime = stepped.playhead;
+    playing.forEach((clip, place) => {
+      const time = stepped.times[place];
+      if (time !== undefined) clip.currentTime = time;
+    });
+  };
+
+  const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {
+    const action = pickerKeyAction({
+      key: event.key,
+      optionCount: question?.options.length ?? 0,
+      allowTie: view.allowTie,
+      noteFocused: event.target === noteRef.current,
+      mod: mac ? event.metaKey : event.ctrlKey,
+      modified: event.altKey || (mac ? event.ctrlKey : event.metaKey),
+      shift: event.shiftKey,
+      repeat: event.repeat,
+      flip: flipping,
+      video,
+      holding: hold.current !== null,
+    });
+    if (action === null) return;
+    event.preventDefault();
+    switch (action.type) {
+      case "choose":
+        choose(action.choice);
+        return;
+      case "move":
+        moveBy(action.delta);
+        return;
+      case "next-unanswered":
+        goNextUnanswered();
+        return;
+      case "focus-note":
+        cancelHold();
+        noteRef.current?.focus();
+        return;
+      case "note-last-answered":
+        cancelHold();
+        if (lastAnswered !== null && lastAnswered !== index) {
+          setNoteReturn(index);
+          go(lastAnswered);
+        }
+        noteRef.current?.focus();
+        return;
+      case "leave-note":
+        leaveNote();
+        return;
+      case "cancel-hold":
+        cancelHold();
+        return;
+      case "flip":
+        flipTo(flipState.shown + action.delta);
+        return;
+      case "send":
+        sendPicks();
+        return;
+      case "play-pause":
+        playPause();
+        return;
+      case "half-speed":
+        halfSpeed();
+        return;
+      case "replay":
+        replay();
+        return;
+      case "step":
+        stepFrame(action.delta);
+        return;
+    }
+  };
+
+  const goNextUnanswered = () => {
+    const target = nextUnanswered(answers, index);
+    if (target !== null) go(target);
+  };
+
+  /** Sends when every question has an answer; until then, goes to the first blank. */
+  const sendPicks = () => {
+    if (!open) return;
+    cancelHold();
+    const blank = firstUnanswered(answers);
+    if (blank === null) finish();
+    else go(blank);
+    containerRef.current?.focus();
+  };
+
+  /** After a button's action, keys keep reaching the picker: focus never stays on a button. */
+  const refocus = () => containerRef.current?.focus();
+
+  if (question === undefined) return null;
+  const left = progress.total - progress.answered;
+  const lastUnanswered = open && left === 1 && answer === undefined;
+  const inputOff = !open || completing;
+  const sendKey = mac ? "⌘↵" : gt("Ctrl+↵");
+  const sizes = sizesOf(question, ready, allReady);
+  const chip = layout === null ? null : pickSizeChip(layout, sizes);
+  const longSide = layout === null ? null : pickSharedSide(layout, sizes);
+  // A blurred note shows its first line, with an ellipsis when it has more, over the textarea.
+  const [firstLine = "", ...moreLines] = note.split("\n");
+  const preview =
+    noteFocused || note.length === 0 ? null : moreLines.length > 0 ? `${firstLine} …` : firstLine;
+  const placeholder =
+    lastAnswered !== null && lastAnswered !== index && noteReturn === null
+      ? gt("Note on question {current} (N) · ⇧N for question {last}", {
+          current: index + 1,
+          last: lastAnswered + 1,
+        })
+      : gt("Note on question {current} (N)", { current: index + 1 });
+
+  // A question's options are distinct files, so each attachment names its option.
+  const options = question.options.map((option, place) => ({
+    key: option.attachmentId,
+    node: (
+      <Media
+        key={`${at.visit}:${option.attachmentId}`}
+        environmentId={environmentId}
+        option={option}
+        label={gt("Option {number}", { number: place + 1 })}
+        fit={layout?.kind ?? "fit"}
+        pixelated={layout?.pixelated ?? false}
+        longSide={longSide}
+        onReady={(result) => onMediaReady(at.visit, place, result)}
+      />
+    ),
+  }));
+
+  return (
+    <div
+      ref={focusOnMount}
+      tabIndex={-1}
+      onKeyDown={onKeyDown}
+      data-testid="picker"
+      className="flex min-h-0 flex-1 flex-col outline-none"
+    >
+      <PicksHeader
+        batch={{
+          environmentId,
+          threadId: view.threadId,
+          title: view.title,
+          threadTitle: view.threadTitle,
+        }}
+        counter={
+          <>
+            <span data-testid="picker-progress-question">
+              {gt("Question {current} of {total}", {
+                current: index + 1,
+                total: progress.total,
+              })}
+            </span>
+            {lastUnanswered ? (
+              <>
+                {" · "}
+                <span data-testid="picker-last-pick-cue">{gt("last pick sends (Esc holds)")}</span>
+              </>
+            ) : null}
+          </>
+        }
+      />
+
+      <div className="flex h-22 shrink-0 flex-col gap-1 px-6 pt-3" data-testid="picker-top">
+        <div className="flex min-w-0 items-baseline gap-4">
+          <Tooltip>
+            <TooltipTrigger
+              render={
+                <h2 className="min-w-0 flex-1 truncate text-lg leading-7 font-medium text-foreground" />
+              }
+            >
+              {question.prompt}
+            </TooltipTrigger>
+            <TooltipPopup>{question.prompt}</TooltipPopup>
+          </Tooltip>
+          {chip === null ? null : (
+            <p
+              className="shrink-0 text-xs text-muted-foreground tabular-nums"
+              data-testid="picker-size"
+            >
+              {sizeChipText(gt, chip)}
+            </p>
+          )}
+        </div>
+        {question.guidance === undefined ? null : (
+          <Tooltip>
+            <TooltipTrigger
+              render={<p className="line-clamp-2 text-sm leading-5 text-muted-foreground" />}
+            >
+              {question.guidance}
+            </TooltipTrigger>
+            <TooltipPopup>{question.guidance}</TooltipPopup>
+          </Tooltip>
+        )}
+      </div>
+
+      <div
+        ref={measureRegion}
+        data-testid="picker-stage-region"
+        className={cn(
+          "scrollbar-gutter-both flex min-h-0 flex-1 flex-col items-center-safe justify-center-safe px-6",
+          layout?.oversized ? "overflow-auto" : "overflow-hidden",
+        )}
+      >
+        {layout === null ? null : (
+          <PickCards
+            layout={layout}
+            options={options}
+            chosen={answer?.choice}
+            allReady={allReady}
+            disabled={inputOff}
+            onChoose={(place) => {
+              choose(place);
+              refocus();
+            }}
+            flip={flipState}
+            onFlip={(place) => {
+              flipTo(place);
+              refocus();
+            }}
+          />
+        )}
+        {video && layout !== null ? (
+          <PlaybackRow
+            playback={play}
+            onPlayPause={() => {
+              playPause();
+              refocus();
+            }}
+            onHalfSpeed={() => {
+              halfSpeed();
+              refocus();
+            }}
+            onReplay={() => {
+              replay();
+              refocus();
+            }}
+            onStep={(delta) => {
+              stepFrame(delta);
+              refocus();
+            }}
+          />
+        ) : null}
+      </div>
+
+      <footer className="flex h-18 shrink-0 flex-col px-6" data-testid="picker-footer">
+        <ProgressStrip
+          answers={answers}
+          failed={failedSaves}
+          current={index}
+          width={region?.width ?? null}
+          onGo={(target) => {
+            go(target);
+            refocus();
+          }}
+        />
+        <div className="flex h-13 min-w-0 items-center gap-2" data-testid="picker-bar">
+          <Button
+            variant="outline"
+            size="icon"
+            aria-label={gt("Previous question")}
+            disabled={index === 0}
+            onClick={() => {
+              moveBy(-1);
+              refocus();
+            }}
+          >
+            <ChevronLeftIcon />
+          </Button>
+          <Button
+            variant="outline"
+            size="icon"
+            aria-label={gt("Next question")}
+            disabled={index === view.questions.length - 1}
+            onClick={() => {
+              moveBy(1);
+              refocus();
+            }}
+          >
+            <ChevronRightIcon />
+          </Button>
+          <Separator orientation="vertical" className="mx-1 h-6" />
+          {view.allowTie ? (
+            <Button
+              variant={answer?.choice === PICK_TIE ? "secondary" : "outline"}
+              aria-pressed={answer?.choice === PICK_TIE}
+              disabled={inputOff}
+              onClick={() => {
+                choose(PICK_TIE);
+                refocus();
+              }}
+            >
+              {gt("Can't tell")}
+              <Kbd>0</Kbd>
+            </Button>
+          ) : null}
+          <div className="relative h-8 min-w-0 max-w-120 flex-[1_1_15rem]">
+            <div
+              className={cn(
+                "absolute",
+                noteFocused
+                  ? "bottom-full left-0 z-30 mb-9 w-full min-w-60 rounded-lg bg-background shadow-md"
+                  : "inset-x-0 bottom-0 z-10",
+              )}
+            >
+              <Textarea
+                ref={noteRef}
+                rows={noteFocused ? 3 : 1}
+                wrap={noteFocused ? "soft" : "off"}
+                maxLength={PICK_NOTE_MAX_LENGTH}
+                size="sm"
+                aria-label={gt("Note on question {current}", { current: index + 1 })}
+                placeholder={placeholder}
+                disabled={inputOff}
+                value={note}
+                style={{
+                  maxHeight: noteFocused ? "calc(6lh + 6px)" : "calc(1lh + 6px)",
+                  overflow: noteFocused ? "auto" : "hidden",
+                  resize: "none",
+                  ...(preview !== null ? { color: "transparent" } : {}),
+                }}
+                onChange={(event) => setNotes(new Map(notes).set(index, event.target.value))}
+                onFocus={() => {
+                  cancelHold();
+                  setNoteFocused(true);
+                }}
+                onBlur={() => {
+                  setNoteFocused(false);
+                  setNoteReturn(null);
+                  saveNote();
+                }}
+              />
+              {noteFocused && note.length > NOTE_COUNTER_FROM ? (
+                <span className="pointer-events-none absolute -top-5 right-2 text-xs text-muted-foreground tabular-nums">
+                  {gt("{count} / {max}", {
+                    count: note.length.toLocaleString(),
+                    max: PICK_NOTE_MAX_LENGTH.toLocaleString(),
+                  })}
+                </span>
+              ) : null}
+            </div>
+            {preview === null ? null : (
+              <span
+                aria-hidden
+                data-testid="picker-note-preview"
+                className={cn(
+                  "pointer-events-none absolute inset-x-0 bottom-0 z-20 truncate px-2.5 py-1 text-base sm:text-sm",
+                  inputOff ? "text-muted-foreground" : "text-foreground",
+                )}
+                style={{ height: "calc(1lh + 2 * var(--spacing))" }}
+              >
+                {preview}
+              </span>
+            )}
+          </div>
+          <div className="ml-auto min-w-0 flex-[0_1000_auto]">
+            {error === null ? (
+              <StatusLine
+                status={view.status}
+                open={open}
+                completing={completing}
+                lastUnanswered={lastUnanswered}
+                left={left}
+                total={progress.total}
+                threadTitle={view.threadTitle}
+              />
+            ) : (
+              <Tooltip>
+                <TooltipTrigger
+                  render={
+                    <p role="alert" className="truncate text-sm text-destructive">
+                      {error}
+                    </p>
+                  }
+                />
+                <TooltipPopup>{error}</TooltipPopup>
+              </Tooltip>
+            )}
+          </div>
+          <div className="flex shrink-0 items-center gap-2">
+            <ForwardButtons
+              pulse={lastAnswered !== null}
+              environmentId={environmentId}
+              threadId={view.threadId}
+              status={view.status}
+              open={open}
+              completing={completing}
+              complete={progress.complete}
+              sendKey={sendKey}
+              onNextUnanswered={() => {
+                goNextUnanswered();
+                refocus();
+              }}
+              onSend={() => {
+                sendPicks();
+                refocus();
+              }}
+            />
+          </div>
+        </div>
+      </footer>
+    </div>
+  );
+}
+
+/** Each option's natural size once all have loaded (null for one that failed). */
+function sizesOf(
+  question: PicksBatchView["questions"][number],
+  ready: ReadonlyMap<number, PickMediaReady>,
+  allReady: boolean,
+): ReadonlyArray<PickRegion | null> | undefined {
+  if (!allReady) return undefined;
+  return question.options.map((_, place) => {
+    const result = ready.get(place);
+    return result?._tag === "Loaded" ? { width: result.width, height: result.height } : null;
+  });
+}
+
+function sizeChipText(
+  gt: ReturnType<typeof useGT>,
+  chip: NonNullable<ReturnType<typeof pickSizeChip>>,
+): string {
+  switch (chip._tag) {
+    case "Actual":
+      return gt("Actual size · {width} × {height} px", { width: chip.width, height: chip.height });
+    case "Scaled":
+      return gt("Scaled to fit · {width} × {height} px", {
+        width: chip.width,
+        height: chip.height,
+      });
+    case "Matched":
+      return gt("Scaled to match · {width} × {height} px · options differ in size", {
+        width: chip.width,
+        height: chip.height,
+      });
+    case "Mixed":
+      return chip.scaled
+        ? gt("Scaled to match · longest side {side} px · options differ in shape", {
+            side: chip.side,
+          })
+        : gt("Actual size · longest side {side} px · options differ in shape", { side: chip.side });
+    case "Exact": {
+      const exact = gt("Exact size · {width} × {height} px", {
+        width: chip.width,
+        height: chip.height,
+      });
+      return [
+        exact,
+        ...(chip.pixelated ? [gt("pixelated")] : []),
+        ...(chip.oversized ? [gt("larger than this window")] : []),
+      ].join(" · ");
+    }
+  }
+}
+
+function PickCards(props: {
+  readonly layout: PickStageLayout;
+  readonly options: ReadonlyArray<{ readonly key: string; readonly node: ReactNode }>;
+  readonly chosen: PickViewChoice | undefined;
+  readonly allReady: boolean;
+  readonly disabled: boolean;
+  readonly onChoose: (place: number) => void;
+  readonly flip: {
+    readonly shown: number;
+    readonly seen: ReadonlySet<number>;
+    readonly blocked: boolean;
+  };
+  readonly onFlip: (place: number) => void;
+}) {
+  const gt = useGT();
+  const { layout } = props;
+  const stageStyle = {
+    width: layout.width,
+    height: layout.height,
+    backgroundColor: PICK_STAGE_COLOR,
+  };
+  const stage = (place: number) => (
+    <div
+      data-testid={`picker-stage-${place + 1}`}
+      className={cn(
+        "flex items-center justify-center overflow-hidden",
+        !props.allReady && "invisible",
+      )}
+      style={stageStyle}
+    >
+      {props.options[place]?.node}
+    </div>
+  );
+  const cardClass = (place: number) =>
+    cn(
+      "flex shrink-0 cursor-pointer flex-col rounded-lg border-2 outline-none transition-colors disabled:cursor-default",
+      props.chosen === place
+        ? "border-primary"
+        : "border-border hover:border-foreground/40 focus-visible:border-ring",
+    );
+
+  if (layout.arrangement === "flip") {
+    const unseen = props.options.findIndex((_, place) => !props.flip.seen.has(place));
+    return (
+      <div className="flex shrink-0 flex-col items-center gap-2" data-testid="picker-options">
+        <div
+          data-testid="picker-flip"
+          className={cn(
+            "flex flex-col rounded-lg border-2",
+            props.chosen === props.flip.shown ? "border-primary" : "border-border",
+          )}
+        >
+          <div className="relative mx-auto" style={{ width: layout.width, height: layout.height }}>
+            {props.options.map((option, place) => (
+              <button
+                key={option.key}
+                type="button"
+                data-testid={`picker-option-${place + 1}`}
+                aria-label={gt("Option {number}", { number: place + 1 })}
+                aria-pressed={props.chosen === place}
+                aria-hidden={props.flip.shown !== place}
+                tabIndex={props.flip.shown === place ? 0 : -1}
+                disabled={props.disabled}
+                onClick={() => props.onChoose(place)}
+                className={cn(
+                  "absolute inset-0 cursor-pointer outline-none disabled:cursor-default",
+                  props.flip.shown !== place && "invisible",
+                )}
+              >
+                {stage(place)}
+              </button>
+            ))}
+          </div>
+          <div className="flex h-7 items-center gap-2 px-2 text-xs text-muted-foreground">
+            {props.options.map((option, place) => {
+              const shown = props.flip.shown === place;
+              const chosen = props.chosen === place;
+              return (
+                <button
+                  key={option.key}
+                  type="button"
+                  aria-pressed={shown}
+                  aria-label={
+                    chosen
+                      ? gt("Show option {number}, your pick", { number: place + 1 })
+                      : gt("Show option {number}", { number: place + 1 })
+                  }
+                  data-testid={`picker-flip-tab-${place + 1}`}
+                  data-shown={shown}
+                  data-chosen={chosen}
+                  onClick={() => props.onFlip(place)}
+                  className={cn(
+                    "relative inline-flex h-5 min-w-6 cursor-pointer items-center justify-center gap-0.5 rounded px-1.5 text-xs font-medium tabular-nums",
+                    shown
+                      ? "bg-foreground text-background"
+                      : "border border-foreground/25 text-foreground hover:bg-foreground/[0.07]",
+                  )}
+                >
+                  {place + 1}
+                  {chosen ? <CheckIcon className={cn("size-3", !shown && "text-primary")} /> : null}
+                  {props.flip.seen.has(place) ? null : (
+                    <span
+                      aria-hidden
+                      className="absolute -top-0.5 -right-0.5 size-1.5 rounded-full bg-primary"
+                    />
+                  )}
+                </button>
+              );
+            })}
+            <span
+              className="text-sm font-medium text-foreground tabular-nums"
+              data-testid="picker-flip-status"
+            >
+              {gt("Option {shown} of {total}", {
+                shown: props.flip.shown + 1,
+                total: props.options.length,
+              })}
+            </span>
+            <span className="ml-auto text-xs text-muted-foreground">
+              {typeof props.chosen === "number" ? (
+                <>
+                  <span className="text-foreground" data-testid="picker-flip-pick">
+                    {gt("Your pick: option {number}", { number: props.chosen + 1 })}
+                  </span>
+                  {" · "}
+                </>
+              ) : null}
+              <span data-testid="picker-flip-hint">{gt("F flips")}</span>
+            </span>
+          </div>
+        </div>
+        {props.flip.blocked && unseen !== -1 ? (
+          <p className="text-sm text-muted-foreground" role="status">
+            {gt("Press F to see option {number} first", { number: unseen + 1 })}
+          </p>
+        ) : null}
+      </div>
+    );
+  }
+
+  const cardWidth = layout.width + PICK_CARD_CHROME.width;
+  return (
+    <div
+      data-testid="picker-options"
+      className="flex shrink-0 flex-wrap justify-center"
+      style={{
+        gap: PICK_CARD_GAP,
+        width: layout.arrangement === "grid" ? 2 * cardWidth + PICK_CARD_GAP : undefined,
+      }}
+    >
+      {props.options.map((option, place) => (
+        <button
+          key={option.key}
+          type="button"
+          data-testid={`picker-option-${place + 1}`}
+          aria-label={gt("Option {number}", { number: place + 1 })}
+          aria-pressed={props.chosen === place}
+          disabled={props.disabled}
+          onClick={() => props.onChoose(place)}
+          className={cardClass(place)}
+          style={{ minWidth: 44 }}
+        >
+          {stage(place)}
+          <span className="flex h-7 items-center justify-center gap-1">
+            <Kbd>{place + 1}</Kbd>
+            {props.chosen === place ? <CheckIcon className="size-3.5 text-primary" /> : null}
+          </span>
+        </button>
+      ))}
+    </div>
+  );
+}
+
+function PlaybackRow(props: {
+  readonly playback: Playback | null;
+  readonly onPlayPause: () => void;
+  readonly onHalfSpeed: () => void;
+  readonly onReplay: () => void;
+  readonly onStep: (delta: -1 | 1) => void;
+}) {
+  const gt = useGT();
+  const paused = props.playback?.paused ?? false;
+  const half = props.playback?.half ?? false;
+  const position = props.playback?.position ?? null;
+  const where =
+    position === null
+      ? []
+      : position._tag === "Frame"
+        ? [gt("frame {current} of {total}", { current: position.current, total: position.total })]
+        : [
+            gt("{current} / {total} s", {
+              current: position.current.toFixed(2),
+              total: position.total.toFixed(2),
+            }),
+            ...(position.mixedRates ? [gt("clips differ in frame rate")] : []),
+          ];
+  return (
+    <div className="mt-2 flex h-8 shrink-0 items-center gap-2" data-testid="picker-playback">
+      <Button variant="outline" size="sm" onClick={props.onPlayPause}>
+        {paused ? gt("Play") : gt("Pause")}
+        <Kbd>{gt("Space")}</Kbd>
+      </Button>
+      <Button
+        variant={half ? "secondary" : "outline"}
+        size="sm"
+        aria-pressed={half}
+        onClick={props.onHalfSpeed}
+      >
+        {gt("½×")}
+        <Kbd>S</Kbd>
+      </Button>
+      <Button variant="outline" size="sm" onClick={props.onReplay}>
+        {gt("Replay")}
+        <Kbd>R</Kbd>
+      </Button>
+      <Button
+        variant="outline"
+        size="sm"
+        aria-label={gt("Previous frame")}
+        onClick={() => props.onStep(-1)}
+      >
+        <ChevronLeftIcon />
+        <Kbd>,</Kbd>
+      </Button>
+      <Button
+        variant="outline"
+        size="sm"
+        aria-label={gt("Next frame")}
+        onClick={() => props.onStep(1)}
+      >
+        <Kbd>.</Kbd>
+        <ChevronRightIcon />
+      </Button>
+      <p
+        className="ml-2 text-xs text-muted-foreground tabular-nums"
+        data-testid="picker-playback-status"
+      >
+        {[paused ? gt("Paused") : gt("Playing"), half ? gt("½×") : gt("1×"), ...where].join(" · ")}
+      </p>
+    </div>
+  );
+}
+
+/** A question's place in the batch is what the strip and the server both call it by. */
+const numbered = <A,>(items: ReadonlyArray<A>) =>
+  items.map((item, index) => ({ item, index, number: index + 1 }));
+
+function ProgressStrip(props: {
+  readonly answers: ReadonlyArray<PickerAnswer | undefined>;
+  readonly failed: ReadonlySet<number>;
+  readonly current: number;
+  readonly width: number | null;
+  readonly onGo: (index: number) => void;
+}) {
+  const gt = useGT();
+  // One tooltip for every cell: a batch has up to 200.
+  const [tooltip] = useState(() => TooltipCreateHandle<string>());
+  if (props.width === null) return <div className="h-5" />;
+  const { cell, gap } = pickStripCells(props.answers.length, props.width);
+  return (
+    <div className="flex h-5 items-center" style={{ gap }} data-testid="picker-strip">
+      <Tooltip handle={tooltip}>{({ payload }) => <TooltipPopup>{payload}</TooltipPopup>}</Tooltip>
+      {numbered(props.answers).map(({ item: answer, index, number }) => {
+        const state = props.failed.has(index)
+          ? "failed"
+          : answer === undefined
+            ? "unanswered"
+            : answer.choice === PICK_TIE
+              ? "tie"
+              : "answered";
+        const label =
+          answer === undefined
+            ? gt("Question {number} · unanswered", { number })
+            : [
+                answer.choice === PICK_TIE
+                  ? gt("Question {number} · can't tell", { number })
+                  : gt("Question {number} · picked {choice}", {
+                      number,
+                      choice: answer.choice + 1,
+                    }),
+                ...(answer.note === undefined ? [] : [gt("note")]),
+              ].join(" · ");
+        const current = index === props.current;
+        return (
+          <TooltipTrigger
+            key={number}
+            handle={tooltip}
+            payload={label}
+            render={
+              <button
+                type="button"
+                data-testid={`picker-cell-${number}`}
+                data-state={state}
+                aria-label={label}
+                aria-current={current ? "step" : undefined}
+                tabIndex={current ? 0 : -1}
+                onClick={() => props.onGo(index)}
+                className="flex h-5 shrink-0 cursor-pointer items-center outline-none"
+                style={{ width: cell }}
+              />
+            }
+          >
+            <span
+              className={cn(
+                "block w-full rounded-xs",
+                current && "outline-2 outline-primary",
+                // Can't tell is answered, at half height.
+                state === "tie" ? (current ? "h-2" : "h-1") : current ? "h-3.5" : "h-2",
+                state === "failed" && "bg-destructive",
+                state === "unanswered" && "bg-muted inset-ring inset-ring-border",
+                (state === "answered" || state === "tie") && "bg-foreground/60",
+              )}
+            />
+          </TooltipTrigger>
+        );
+      })}
+    </div>
+  );
+}
+
+function StatusLine(props: {
+  readonly status: PicksBatchView["status"];
+  readonly open: boolean;
+  readonly completing: boolean;
+  readonly lastUnanswered: boolean;
+  readonly left: number;
+  readonly total: number;
+  readonly threadTitle: string;
+}) {
+  const gt = useGT();
+  const text =
+    props.status === "answered"
+      ? props.total === 1
+        ? gt('Sent 1 pick to "{thread}".', { thread: props.threadTitle })
+        : gt('Sent {count} picks to "{thread}".', { count: props.total, thread: props.threadTitle })
+      : props.status === "cancelled"
+        ? gt("These picks were closed.")
+        : !props.open
+          ? gt("This connection can't answer picks.")
+          : props.completing
+            ? null
+            : props.lastUnanswered
+              ? gt('1 left · picking sends to "{thread}" (Esc holds)', {
+                  thread: props.threadTitle,
+                })
+              : props.left > 0
+                ? gt("{count} left · saved as you go", { count: props.left })
+                : gt('All {count} answered · resumes "{thread}"', {
+                    count: props.total,
+                    thread: props.threadTitle,
+                  });
+  return text === null ? null : (
+    <Tooltip>
+      <TooltipTrigger
+        render={
+          <p className="truncate text-sm text-muted-foreground" data-testid="picker-status">
+            {text}
+          </p>
+        }
+      />
+      <TooltipPopup>{text}</TooltipPopup>
+    </Tooltip>
+  );
+}
+
+function ForwardButtons(props: {
+  /** Ring the send button once when it appears after a pick here. */
+  readonly pulse: boolean;
+  readonly environmentId: EnvironmentId;
+  readonly threadId: PicksBatchView["threadId"];
+  readonly status: PicksBatchView["status"];
+  readonly open: boolean;
+  readonly completing: boolean;
+  readonly complete: boolean;
+  readonly sendKey: string;
+  readonly onNextUnanswered: () => void;
+  readonly onSend: () => void;
+}) {
+  const gt = useGT();
+  const pulseOnMount = useStableCallback((node: HTMLButtonElement | null) => {
+    if (node === null || !props.pulse) return;
+    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
+    node.animate(
+      [{ boxShadow: "0 0 0 0 var(--color-ring)" }, { boxShadow: "0 0 0 8px transparent" }],
+      { duration: 700, easing: "ease-out" },
+    );
+  });
+  const openThread = (
+    <Button
+      variant={props.status === "answered" ? "default" : "outline"}
+      className="whitespace-nowrap"
+      render={
+        <Link
+          to="/$environmentId/$threadId"
+          params={{ environmentId: props.environmentId, threadId: props.threadId }}
+        />
+      }
+    >
+      {gt("Open thread")}
+    </Button>
+  );
+  if (props.status === "answered") {
+    return (
+      <>
+        {openThread}
+        <Button variant="outline" className="whitespace-nowrap" render={<Link to="/picks" />}>
+          {gt("Back to Picks")}
+        </Button>
+      </>
+    );
+  }
+  if (!props.open) return openThread;
+  if (props.completing) {
+    return (
+      <Button disabled className="whitespace-nowrap">
+        <Spinner />
+        {gt("Sending…")}
+      </Button>
+    );
+  }
+  return props.complete ? (
+    <Button key="send" ref={pulseOnMount} className="whitespace-nowrap" onClick={props.onSend}>
+      {gt("Send picks")}
+      <Kbd variant="on-primary">{props.sendKey}</Kbd>
+    </Button>
+  ) : (
+    <Button
+      key="next"
+      variant="outline"
+      className="whitespace-nowrap"
+      onClick={props.onNextUnanswered}
+    >
+      {gt("Next unanswered")}
+      <Kbd>U</Kbd>
+    </Button>
+  );
+}
diff --git a/apps/web/src/components/picks/PicksBatchFrame.tsx b/apps/web/src/components/picks/PicksBatchFrame.tsx
