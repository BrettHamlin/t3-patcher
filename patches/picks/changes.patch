+        } else if (type === undefined) {
+          problems.push(
+            `${where}: ${option.path} is not a supported file type (${PICK_EXTENSIONS}).`,
+          );
+        } else {
+          const info = yield* fileSystem.stat(option.path).pipe(Effect.option);
+          if (info._tag === "None") {
+            problems.push(`${where}: ${option.path} was not found.`);
+          } else if (info.value.type !== "File") {
+            problems.push(`${where}: ${option.path} is not a file.`);
+          } else {
+            media.set(option.path, type);
+          }
+        }
+      }
+    }
+    return { problems, media };
+  });
+
+  /** Copies each distinct file once, so the batch survives the agent rebuilding its outputs. */
+  const copyFiles = Effect.fn("PickRequests.copyFiles")(function* (
+    threadId: ThreadId,
+    media: ReadonlyMap<string, (typeof PICK_MEDIA)[string]>,
+    copied: Array<string>,
+  ) {
+    const stored = new Map<string, PickStoredOption["attachmentId"]>();
+    for (const [source, type] of media) {
+      const attachmentId = createAttachmentId(threadId, type.stored);
+      const target =
+        attachmentId === null
+          ? null
+          : resolveAttachmentRelativePath({
+              attachmentsDir: config.attachmentsDir,
+              relativePath: `${attachmentId}.${type.stored}`,
+            });
+      if (attachmentId === null || target === null) {
+        return yield* failed("Could not store the picks")(new Error("Invalid thread id."));
+      }
+      yield* fileSystem.makeDirectory(path.dirname(target), { recursive: true });
+      yield* fileSystem.copyFile(source, target);
+      copied.push(target);
+      stored.set(source, attachmentId);
+    }
+    return stored;
+  });
+
+  const request: PickRequests["Service"]["request"] = Effect.fn("PickRequests.request")(
+    function* (scope, input) {
+      const threadScope = yield* McpInvocationContext.requireThreadScope(scope, "request_picks");
+      const threadId = threadScope.thread.threadId;
+      const key = input.clientRequestId ?? (yield* random.uuidV4());
+      const id = batchId(threadId, scope.requestNamespace, key);
+      const unreadable = failed("Unable to read the picks");
+      if (input.clientRequestId !== undefined) {
+        const existing = yield* readBatch(threadId, id).pipe(Effect.mapError(unreadable));
+        if (existing !== undefined) return resultOf(existing.item);
+      }
+      const idProblems = pickIdProblems(input);
+      const { problems: fileProblems, media } = yield* checkFiles(input);
+      const problems = [...idProblems, ...fileProblems];
+      if (problems.length > 0) return yield* invalid(problems.join("\n"));
+      const parent = yield* threadManagement
+        .getThreadRecords(threadId, ["runs"], { messageRoles: [] })
+        .pipe(Effect.mapError(unreadable));
+      const run = ThreadManagementService.latestActiveRun(parent);
+      if (
+        run === undefined ||
+        run.rootNodeId === null ||
+        run.providerInstanceId !== threadScope.thread.providerInstanceId
+      ) {
+        return yield* new OrchestratorMcpFailure({
+          code: "parent_not_active",
+          message: "Asking for picks requires an active run owned by this MCP provider session.",
+        });
+      }
+      const rootNodeId = run.rootNodeId;
+      const copied: Array<string> = [];
+      return yield* Effect.gen(function* () {
+        const stored = yield* copyFiles(threadId, media, copied);
+        const questions: Array<PickStoredQuestion> = [];
+        for (const question of input.questions) {
+          const options = yield* random.shuffle(
+            question.options.flatMap((option): ReadonlyArray<PickStoredOption> => {
+              const type = media.get(option.path);
+              const attachmentId = stored.get(option.path);
+              return type === undefined || attachmentId === undefined
+                ? []
+                : [{ id: option.id, attachmentId, mediaKind: type.kind, mimeType: type.mimeType }];
+            }),
+          );
+          questions.push({
+            id: question.id,
+            prompt: question.prompt,
+            ...(question.guidance === undefined ? {} : { guidance: question.guidance }),
+            ...(question.display === undefined ? {} : { display: question.display }),
+            options,
+          });
+        }
+        yield* threadManagement
+          .dispatch({
+            type: "pick_request.record",
+            commandId: CommandId.make(
+              `command:mcp:${encodeURIComponent(scope.requestNamespace)}:picks:${encodeURIComponent(key)}`,
+            ),
+            threadId,
+            runId: run.id,
+            nodeId: rootNodeId,
+            turnItemId: id,
+            title: input.title,
+            allowTie: input.allowTie ?? true,
+            questions,
+          })
+          .pipe(Effect.mapError(failed("Could not record the picks")));
+        return { status: "pending", batchId: id, questions: questions.length } as const;
+      }).pipe(
+        Effect.mapError((error) =>
+          isMcpFailure(error) ? error : failed("Could not store the picks")(error),
+        ),
+        // A batch that was not recorded keeps none of its copies.
+        Effect.onError(() =>
+          Effect.forEach(copied, (file) => fileSystem.remove(file, { force: true }), {
+            discard: true,
+          }).pipe(Effect.ignore),
+        ),
+      );
+    },
+  );
+
+  const list: PickRequests["Service"]["list"] = sql`
+    SELECT
+      item.thread_id,
+      item.turn_item_id,
+      json_extract(item.payload_json, '$.title') AS title,
+      json_extract(item.payload_json, '$.questionCount') AS question_count,
+      json_extract(item.payload_json, '$.answeredCount') AS answered_count,
+      json_extract(item.payload_json, '$.startedAt') AS started_at,
+      thread.title AS thread_title
+    FROM orchestration_v2_projection_turn_items AS item INDEXED BY ${sql.literal(WAITING_PICKS_INDEX)}
+    JOIN orchestration_v2_projection_threads AS thread ON thread.thread_id = item.thread_id
+    WHERE item.type = 'pick_request' AND item.status = 'waiting'
+      AND thread.archived_at IS NULL AND thread.deleted_at IS NULL
+    ORDER BY item.updated_at DESC, item.turn_item_id DESC
+  `.pipe(
+    Effect.flatMap(decodeListRows),
+    Effect.map((rows) => ({
+      batches: rows.map((row) => ({
+        threadId: row.thread_id,
+        batchId: row.turn_item_id,
+        title: row.title,
+        threadTitle: row.thread_title,
+        questionCount: row.question_count,
+        answeredCount: row.answered_count,
+        createdAt: row.started_at,
+      })),
+    })),
+    Effect.mapError((cause) => new PicksError({ reason: "load_failed", cause })),
+    Effect.withSpan("PickRequests.list"),
+  );
+
+  const get: PickRequests["Service"]["get"] = Effect.fn("PickRequests.get")(function* (input) {
+    const { item, thread } = yield* readOpenBatch(input);
+    return {
+      threadId: input.threadId,
+      batchId: item.id,
+      title: item.title ?? "",
+      threadTitle: thread.title,
+      allowTie: item.allowTie,
+      status: item.pickStatus,
+      questions: (item.questions ?? []).map((question) => {
+        const answer = item.answers?.[question.id];
+        const place = question.options.findIndex((option) => option.id === answer?.choice);
+        const choice = answer?.choice === PICK_TIE ? PICK_TIE : place;
+        return {
+          prompt: question.prompt,
+          ...(question.guidance === undefined ? {} : { guidance: question.guidance }),
+          ...(question.display === undefined ? {} : { display: question.display }),
+          options: question.options.map((option) => ({
+            attachmentId: option.attachmentId,
+            mediaKind: option.mediaKind,
+            mimeType: option.mimeType,
+          })),
+          ...(answer === undefined || choice === -1
+            ? {}
+            : {
+                answer: { choice, ...(answer.note === undefined ? {} : { note: answer.note }) },
+              }),
+        };
+      }),
+    };
+  });
+
+  const answer: PickRequests["Service"]["answer"] = Effect.fn("PickRequests.answer")(
+    function* (input) {
+      const { item } = yield* readOpenBatch(input);
+      if (item.pickStatus !== "pending") return yield* new PicksError({ reason: "closed" });
+      const question = item.questions?.[input.questionIndex];
+      const choice =
+        input.choice === PICK_TIE
+          ? item.allowTie
+            ? PICK_TIE
+            : undefined
+          : question?.options[input.choice]?.id;
+      if (question === undefined || choice === undefined) {
+        return yield* new PicksError({ reason: "invalid_answer" });
+      }
+      const note = input.note?.trim();
+      const commandKey = yield* random.uuidV4();
+      yield* threadManagement
+        .dispatch({
+          type: "pick_request.answer",
+          commandId: CommandId.make(`pick-request:${item.id}:answer:${commandKey}`),
+          threadId: input.threadId,
+          turnItemId: item.id,
+          questionId: question.id,
+          answer: { choice, ...(note ? { note } : {}) },
+        })
+        .pipe(Effect.mapError((cause) => new PicksError({ reason: "record_failed", cause })));
+    },
+  );
+
+  const complete: PickRequests["Service"]["complete"] = Effect.fn("PickRequests.complete")(
+    function* (input) {
+      const { item } = yield* readOpenBatch(input);
+      if (item.pickStatus === "answered") return;
+      if (item.pickStatus !== "pending") return yield* new PicksError({ reason: "closed" });
+      if (item.answeredCount < item.questionCount) {
+        return yield* new PicksError({ reason: "incomplete" });
+      }
+      yield* threadManagement
+        .dispatch({
+          type: "pick_request.complete",
+          commandId: CommandId.make(`pick-request:${item.id}:answered`),
+          threadId: input.threadId,
+          turnItemId: item.id,
+          messageId: MessageId.make(`message:pick-request:${item.id}`),
+        })
+        .pipe(Effect.mapError((cause) => new PicksError({ reason: "record_failed", cause })));
+    },
+  );
+
+  return PickRequests.of({ request, list, get, answer, complete });
+});
+
+/** What a retry hears: the batch's status now. */
+const resultOf = (item: PickRequestItem): PicksRequestResult => ({
+  status: item.pickStatus,
+  batchId: item.id,
+  questions: item.questionCount,
+});
+
+export const layer = Layer.effect(PickRequests, make);
