index 0000000000000000000000000000000000000000..09d3fb0bab96694e7b05a3d8668d81f9c79fba4e
--- /dev/null
+++ b/packages/client-runtime/src/picks.test.ts
@@ -0,0 +1,108 @@
+import { describe, expect, it } from "@effect/vitest";
+
+import {
+  movedQuestion,
+  pickerAnswers,
+  pickerKeyAction,
+  pickerProgress,
+  pickOptionBox,
+  questionAfterAnswer,
+  savedNote,
+} from "./picks.ts";
+
+const key = (
+  pressed: string,
+  options: {
+    optionCount?: number;
+    allowTie?: boolean;
+    noteFocused?: boolean;
+    modified?: boolean;
+  } = {},
+) =>
+  pickerKeyAction({
+    key: pressed,
+    optionCount: options.optionCount ?? 3,
+    allowTie: options.allowTie ?? true,
+    noteFocused: options.noteFocused ?? false,
+    modified: options.modified ?? false,
+  });
+
+describe("pickerKeyAction", () => {
+  it("maps the picker's keys to what they do", () => {
+    expect(
+      ["1", "2", "3", "4", "0", "n", "N", "ArrowLeft", "ArrowRight", "x"].map((k) => key(k)),
+    ).toEqual([
+      { type: "choose", choice: 0 },
+      { type: "choose", choice: 1 },
+      { type: "choose", choice: 2 },
+      null,
+      { type: "choose", choice: "tie" },
+      { type: "focus-note" },
+      { type: "focus-note" },
+      { type: "move", delta: -1 },
+      { type: "move", delta: 1 },
+      null,
+    ]);
+  });
+
+  it("offers no tie when the batch allows none, and no keys past the options", () => {
+    expect([key("0", { allowTie: false }), key("3", { optionCount: 2 })]).toEqual([null, null]);
+  });
+
+  it("lets the note take typing until Escape, and ignores shortcuts with modifiers", () => {
+    expect([
+      key("1", { noteFocused: true }),
+      key("ArrowLeft", { noteFocused: true }),
+      key("Escape", { noteFocused: true }),
+      key("1", { modified: true }),
+    ]).toEqual([null, null, { type: "leave-note" }, null]);
+  });
+});
+
+describe("moving between questions", () => {
+  it("advances after an answer and stays inside the batch", () => {
+    expect([
+      questionAfterAnswer(0, 3),
+      questionAfterAnswer(2, 3),
+      movedQuestion(0, -1, 3),
+      movedQuestion(1, 1, 3),
+      movedQuestion(2, 1, 3),
+    ]).toEqual([1, 2, 0, 2, 2]);
+  });
+});
+
+describe("answers and progress", () => {
+  it("prefers this window's saved answers over what the server last sent", () => {
+    const answers = pickerAnswers(
+      {
+        questions: [
+          { prompt: "a", options: [], answer: { choice: 1 } },
+          { prompt: "b", options: [] },
+          { prompt: "c", options: [], answer: { choice: "tie", note: "same" } },
+        ],
+      },
+      new Map([[0, { choice: 0 }]]),
+    );
+    expect(answers).toEqual([{ choice: 0 }, undefined, { choice: "tie", note: "same" }]);
+    expect(pickerProgress(answers)).toEqual({ answered: 2, total: 3, complete: false });
+    expect(pickerProgress([{ choice: 0 }])).toEqual({ answered: 1, total: 1, complete: true });
+  });
+
+  it("saves a blank note as none", () => {
+    expect([savedNote("  too dark "), savedNote("   ")]).toEqual(["too dark", undefined]);
+  });
+});
+
+describe("pickOptionBox", () => {
+  it("uses the agent's exact box, pixelated when asked, or fits the space", () => {
+    expect([
+      pickOptionBox({ width: 64, height: 48, pixelated: true }),
+      pickOptionBox({ width: 320, height: 200 }),
+      pickOptionBox(undefined),
+    ]).toEqual([
+      { kind: "exact", width: 64, height: 48, pixelated: true },
+      { kind: "exact", width: 320, height: 200, pixelated: false },
+      { kind: "fit" },
+    ]);
+  });
+});
diff --git a/packages/client-runtime/src/picks.ts b/packages/client-runtime/src/picks.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9ca10c3234e88741f93258175cd58faabf8c5db3
--- /dev/null
+++ b/packages/client-runtime/src/picks.ts
@@ -0,0 +1,84 @@
+import {
+  PICK_TIE,
+  type OrchestrationV2TurnItem,
+  type PickDisplay,
+  type PickViewChoice,
+  type PicksBatchView,
+} from "@t3tools/contracts";
+
+export type PickRequestItem = Extract<OrchestrationV2TurnItem, { readonly type: "pick_request" }>;
+
+export type PickerAnswer = {
+  readonly choice: PickViewChoice;
+  readonly note?: string;
+};
+
+/** What a key does in the picker, given where focus is. */
+export type PickerKeyAction =
+  | { readonly type: "choose"; readonly choice: PickViewChoice }
+  | { readonly type: "move"; readonly delta: -1 | 1 }
+  | { readonly type: "focus-note" }
+  | { readonly type: "leave-note" };
+
+/**
+ * `1`–`4` pick an option and `0` can't tell; `N` focuses the note and arrows
+ * move between questions. While the note has focus, keys type text and only
+ * Escape leaves it.
+ */
+export function pickerKeyAction(input: {
+  readonly key: string;
+  readonly optionCount: number;
+  readonly allowTie: boolean;
+  readonly noteFocused: boolean;
+  readonly modified: boolean;
+}): PickerKeyAction | null {
+  if (input.noteFocused) return input.key === "Escape" ? { type: "leave-note" } : null;
+  if (input.modified) return null;
+  if (input.key === "ArrowLeft") return { type: "move", delta: -1 };
+  if (input.key === "ArrowRight") return { type: "move", delta: 1 };
+  if (input.key === "n" || input.key === "N") return { type: "focus-note" };
+  if (input.key === "0") return input.allowTie ? { type: "choose", choice: PICK_TIE } : null;
+  const place = /^[1-4]$/.test(input.key) ? Number(input.key) - 1 : -1;
+  return place >= 0 && place < input.optionCount ? { type: "choose", choice: place } : null;
+}
+
+/** The question to show after one is answered: the next, or the last one again. */
+export function questionAfterAnswer(index: number, total: number): number {
+  return Math.min(index + 1, Math.max(total - 1, 0));
+}
+
+/** Moves `delta` questions, staying inside the batch. */
+export function movedQuestion(index: number, delta: -1 | 1, total: number): number {
+  return Math.min(Math.max(index + delta, 0), Math.max(total - 1, 0));
+}
+
+/** The server's answers, with the ones this window saved since it last read them. */
+export function pickerAnswers(
+  view: Pick<PicksBatchView, "questions">,
+  saved: ReadonlyMap<number, PickerAnswer>,
+): ReadonlyArray<PickerAnswer | undefined> {
+  return view.questions.map((question, index) => saved.get(index) ?? question.answer);
+}
+
+export function pickerProgress(answers: ReadonlyArray<PickerAnswer | undefined>) {
+  const answered = answers.filter((answer) => answer !== undefined).length;
+  return { answered, total: answers.length, complete: answered === answers.length };
+}
+
+/** The box each option is shown in: exactly its size when the agent gave one. */
+export function pickOptionBox(display: PickDisplay | undefined) {
+  return display === undefined
+    ? { kind: "fit" as const }
+    : {
+        kind: "exact" as const,
+        width: display.width,
+        height: display.height,
+        pixelated: display.pixelated === true,
+      };
+}
+
+/** A note as saved: trimmed, and none when blank. */
+export function savedNote(note: string): string | undefined {
+  const trimmed = note.trim();
+  return trimmed.length === 0 ? undefined : trimmed;
+}
