+++ b/apps/web/src/components/picks/PicksPage.tsx
@@ -0,0 +1,250 @@
+import { useAtomValue } from "@effect/atom-react";
+import { pickSaveQueue } from "@t3tools/client-runtime/picks";
+import { squashAtomCommandFailure } from "@t3tools/client-runtime/state/runtime";
+import {
+  type AssetResource,
+  type EnvironmentId,
+  PicksError,
+  type ThreadId,
+  type TurnItemId,
+} from "@t3tools/contracts";
+import { Link, useSearch } from "@tanstack/react-router";
+import * as DateTime from "effect/DateTime";
+import * as Schema from "effect/Schema";
+import { useGT, useMessages } from "gt-react";
+import { ScaleIcon } from "lucide-react";
+
+import { useAssetUrlState } from "~/assets/assetUrls";
+import { Badge } from "~/components/ui/badge";
+import { Empty, EmptyHeader, EmptyMedia, EmptyTitle } from "~/components/ui/empty";
+import { SidebarInset } from "~/components/ui/sidebar";
+import { Skeleton } from "~/components/ui/skeleton";
+import { type OpenPickBatch, picksEnvironment, useOpenPicks } from "~/state/picks";
+import { useEnvironmentQuery } from "~/state/query";
+import { useAtomCommand } from "~/state/use-atom-command";
+import { formatRelativeTimeLabel } from "~/timestampFormat";
+import { PickBatchGate } from "./PickBatchGate";
+import { PickMediaElement } from "./PickMedia";
+import { PicksBatchFrame } from "./PicksBatchFrame";
+import { PicksHeader } from "./PicksHeader";
+import { PickerView, type PickMediaProps } from "./PickerView";
+
+const isPicksError = Schema.is(PicksError);
+
+export interface PicksSearch {
+  readonly environmentId?: EnvironmentId;
+  readonly threadId?: ThreadId;
+  readonly batchId?: TurnItemId;
+}
+
+export function PicksPage() {
+  const search: PicksSearch = useSearch({ from: "/_chat/picks" });
+  const open =
+    search.environmentId !== undefined &&
+    search.threadId !== undefined &&
+    search.batchId !== undefined
+      ? { environmentId: search.environmentId, threadId: search.threadId, batchId: search.batchId }
+      : null;
+  return (
+    <SidebarInset className="h-dvh min-h-0 overflow-hidden overscroll-y-none">
+      <div className="flex min-h-0 flex-1 flex-col bg-background">
+        {open === null ? (
+          <>
+            <PicksHeader />
+            <PicksList />
+          </>
+        ) : (
+          <PicksBatchFrame key={open.batchId}>
+            <PicksBatch {...open} />
+          </PicksBatchFrame>
+        )}
+      </div>
+    </SidebarInset>
+  );
+}
+
+function PicksList() {
+  const gt = useGT();
+  const messages = useMessages();
+  const batches = useOpenPicks();
+  if (batches.length === 0) {
+    return (
+      <Empty>
+        <EmptyMedia variant="icon">
+          <ScaleIcon />
+        </EmptyMedia>
+        <EmptyHeader>
+          <EmptyTitle>{gt("No picks waiting")}</EmptyTitle>
+        </EmptyHeader>
+      </Empty>
+    );
+  }
+  return (
+    <ul className="flex min-h-0 flex-col gap-1 overflow-y-auto p-3" data-testid="picks-list">
+      {batches.map((batch) => (
+        <PicksListRow
+          key={`${batch.environmentId}:${batch.batchId}`}
+          batch={batch}
+          age={formatRelativeTimeLabel(DateTime.formatIso(batch.createdAt), undefined, messages)}
+        />
+      ))}
+    </ul>
+  );
+}
+
+/**
+ * A batch in the inbox. The whole row opens it through its stretched title link; the thread
+ * link sits above that as its own target, since links can't nest.
+ */
+export function PicksListRow({
+  batch,
+  age,
+}: {
+  readonly batch: OpenPickBatch;
+  readonly age: string;
+}) {
+  const gt = useGT();
+  const done = batch.answeredCount === batch.questionCount;
+  const action =
+    batch.answeredCount === 0 ? gt("Start") : done ? gt("Review and send") : gt("Resume");
+  return (
+    <li
+      className="relative flex h-14 flex-col justify-center gap-0.5 rounded-lg px-3 hover:bg-accent"
+      data-testid="picks-row"
+    >
+      <div className="flex min-w-0 items-center gap-3">
+        <Link
+          to="/picks"
+          search={{
+            environmentId: batch.environmentId,
+            threadId: batch.threadId,
+            batchId: batch.batchId,
+          }}
+          className="min-w-0 flex-1 truncate text-sm font-medium text-foreground after:absolute after:inset-0 after:rounded-lg"
+        >
+          {batch.title}
+        </Link>
+        {done ? (
+          <Badge variant="warning-outline" data-testid="picks-row-not-sent">
+            {gt("Not sent")}
+          </Badge>
+        ) : null}
+        <span className="shrink-0 text-xs text-muted-foreground tabular-nums">
+          {gt("{answered} of {total} answered", {
+            answered: batch.answeredCount,
+            total: batch.questionCount,
+          })}
+        </span>
+        <span className="shrink-0 text-xs font-medium text-foreground">{action}</span>
+      </div>
+      <div className="flex min-w-0 items-center gap-1 text-xs text-muted-foreground">
+        <span className="min-w-0 truncate">{batch.firstPrompt}</span>
+        <span aria-hidden>·</span>
+        <Link
+          to="/$environmentId/$threadId"
+          params={{ environmentId: batch.environmentId, threadId: batch.threadId }}
+          className="relative z-10 max-w-64 shrink-0 truncate hover:text-foreground"
+        >
+          {gt("from {thread}", { thread: batch.threadTitle })}
+        </Link>
+        <span aria-hidden>·</span>
+        <span className="shrink-0">{age}</span>
+      </div>
+    </li>
+  );
+}
+
+function PicksBatch(props: {
+  readonly environmentId: EnvironmentId;
+  readonly threadId: ThreadId;
+  readonly batchId: TurnItemId;
+}) {
+  const gt = useGT();
+  const input = { threadId: props.threadId, batchId: props.batchId };
+  const batch = useEnvironmentQuery(
+    picksEnvironment.get({ environmentId: props.environmentId, input }),
+  );
+  const answer = useAtomCommand(picksEnvironment.answer, {
+    label: "save a pick",
+    reportFailure: false,
+  });
+  const complete = useAtomCommand(picksEnvironment.complete, {
+    label: "finish picks",
+    reportFailure: false,
+  });
+  const canAnswer = useAtomValue(picksEnvironment.answer.permissionAtom(props.environmentId));
+  const saveQueue = pickSaveQueue({ environmentId: props.environmentId, ...input });
+  // The picker starts from a read made after this batch's earlier saves landed, never a cached
+  // one; the queue, not this gate, keeps the saves in order.
+  return (
+    <PickBatchGate saveQueue={saveQueue} onSettled={batch.refresh}>
+      {(openedAt) =>
+        batch.data === null || batch.dataUpdatedAt < openedAt ? (
+          <>
+            <PicksHeader />
+            {batch.error === null ? (
+              <Skeleton className="m-6 h-96" />
+            ) : (
+              <p role="alert" className="p-6 text-sm text-destructive">
+                {batch.error}
+              </p>
+            )}
+          </>
+        ) : (
+          <PickerView
+            environmentId={props.environmentId}
+            view={batch.data}
+            saveQueue={saveQueue}
+            canAnswer={canAnswer}
+            Media={PickMedia}
+            onAnswer={async (choice) => {
+              const result = await answer({
+                environmentId: props.environmentId,
+                input: { ...input, ...choice },
+              });
+              return result._tag === "Success" ? null : gt("The answer could not be saved.");
+            }}
+            onComplete={async () => {
+              const result = await complete({ environmentId: props.environmentId, input });
+              if (result._tag === "Success") return null;
+              const failure = squashAtomCommandFailure(result);
+              return isPicksError(failure) && failure.reason === "notes_too_long"
+                ? gt("The notes are too long to send. Shorten some and press Send picks again.")
+                : gt("The picks could not be finished.");
+            }}
+          />
+        )
+      }
+    </PickBatchGate>
+  );
+}
+
+function PickMedia({
+  environmentId,
+  option,
+  label,
+  fit,
+  pixelated,
+  longSide,
+  onReady,
+}: PickMediaProps) {
+  const resource: AssetResource = {
+    _tag: "attachment",
+    attachmentId: option.attachmentId,
+    mimeType: option.mimeType,
+    disposition: "inline",
+  };
+  const asset = useAssetUrlState(environmentId, resource);
+  if (asset._tag === "Loading") return null;
+  return (
+    <PickMediaElement
+      url={asset._tag === "Failure" ? null : asset.url}
+      kind={option.mediaKind}
+      label={label}
+      fit={fit}
+      pixelated={pixelated}
+      longSide={longSide}
+      onReady={onReady}
+    />
+  );
+}
