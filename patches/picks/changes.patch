+/**
+ * Batches of picks an agent asks the user for: "which of these looks more like
+ * a real person?". Asking returns at once, the user answers in the Picks inbox,
+ * and finishing wakes the agent with every answer. Options are shuffled when
+ * asked and the inbox only ever sees their places, never their ids or files.
+ */
+import {
+  CommandId,
+  MessageId,
+  type OrchestrationV2TurnItem,
+  OrchestratorMcpFailure,
+  PICK_TIE,
+  type PickMediaKind,
+  type PickStoredOption,
+  type PickStoredQuestion,
+  type PicksAnswerInput,
+  type PicksBatchInput,
+  type PicksBatchView,
+  PicksError,
+  type PicksListResult,
+  type PicksRequestInput,
+  type PicksRequestResult,
+  NonNegativeInt,
+  PositiveInt,
+  ThreadId,
+  TurnItemId,
+} from "@t3tools/contracts";
+import * as Context from "effect/Context";
+import * as SecureRandom from "effect/crypto/SecureRandom";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Path from "effect/Path";
+import * as Schema from "effect/Schema";
+import * as SqlClient from "effect/sql/SqlClient";
+import * as KeyedLock from "@t3tools/shared/KeyedLock";
+
+import { resolveAttachmentRelativePath } from "../attachmentPaths.ts";
+import { createAttachmentId } from "../attachmentStore.ts";
+import * as ServerConfig from "../config.ts";
+import * as McpInvocationContext from "../mcp/McpInvocationContext.ts";
+import { pickRequestWake } from "./pickWake.ts";
+import * as ThreadManagementService from "../orchestration-v2/ThreadManagementService.ts";
+
+type PickRequestItem = Extract<OrchestrationV2TurnItem, { readonly type: "pick_request" }>;
+
+const ascii = (text: string) => Array.from(text, (char) => char.charCodeAt(0));
+/** `bytes` begins with `expected` at `offset`. */
+const startsWith = (bytes: Uint8Array, expected: ReadonlyArray<number>, offset = 0) =>
+  expected.every((byte, index) => bytes[offset + index] === byte);
+const isoMedia = (bytes: Uint8Array, boxes: ReadonlyArray<string>) =>
+  boxes.some((box) => startsWith(bytes, ascii(box), 4));
+
+/** What the file's first bytes must be for its type: its signature, not a full decode. */
+const SIGNATURES = {
+  png: (bytes: Uint8Array) => startsWith(bytes, [0x89, ...ascii("PNG\r\n"), 0x1a, 0x0a]),
+  jpeg: (bytes: Uint8Array) => startsWith(bytes, [0xff, 0xd8, 0xff]),
+  gif: (bytes: Uint8Array) =>
+    startsWith(bytes, ascii("GIF87a")) || startsWith(bytes, ascii("GIF89a")),
+  webp: (bytes: Uint8Array) =>
+    startsWith(bytes, ascii("RIFF")) && startsWith(bytes, ascii("WEBP"), 8),
+  ftyp: (bytes: Uint8Array) => isoMedia(bytes, ["ftyp"]),
+  quickTime: (bytes: Uint8Array) => isoMedia(bytes, ["ftyp", "moov", "mdat", "wide", "free"]),
+  webm: (bytes: Uint8Array) => startsWith(bytes, [0x1a, 0x45, 0xdf, 0xa3]),
+};
+
+/** What the inbox can show, by file extension. APNG is stored as PNG, which is what it is. */
+const PICK_MEDIA: Readonly<
+  Record<
+    string,
+    {
+      readonly kind: PickMediaKind;
+      readonly mimeType: string;
+      readonly stored: string;
+      readonly name: string;
+      readonly matches: (bytes: Uint8Array) => boolean;
+    }
+  >
+> = {
+  png: {
+    kind: "image",
+    mimeType: "image/png",
+    stored: "png",
+    name: "PNG",
+    matches: SIGNATURES.png,
+  },
+  apng: {
+    kind: "image",
+    mimeType: "image/png",
+    stored: "png",
+    name: "APNG",
+    matches: SIGNATURES.png,
+  },
+  jpg: {
+    kind: "image",
+    mimeType: "image/jpeg",
+    stored: "jpg",
+    name: "JPEG",
+    matches: SIGNATURES.jpeg,
+  },
+  jpeg: {
+    kind: "image",
+    mimeType: "image/jpeg",
+    stored: "jpg",
+    name: "JPEG",
+    matches: SIGNATURES.jpeg,
+  },
+  webp: {
+    kind: "image",
+    mimeType: "image/webp",
+    stored: "webp",
+    name: "WebP",
+    matches: SIGNATURES.webp,
+  },
+  gif: {
+    kind: "image",
+    mimeType: "image/gif",
+    stored: "gif",
+    name: "GIF",
+    matches: SIGNATURES.gif,
+  },
+  avif: {
+    kind: "image",
+    mimeType: "image/avif",
+    stored: "avif",
+    name: "AVIF",
+    matches: SIGNATURES.ftyp,
+  },
+  mp4: {
+    kind: "video",
+    mimeType: "video/mp4",
+    stored: "mp4",
+    name: "MP4",
+    matches: SIGNATURES.ftyp,
+  },
+  webm: {
+    kind: "video",
+    mimeType: "video/webm",
+    stored: "webm",
+    name: "WebM",
+    matches: SIGNATURES.webm,
+  },
+  mov: {
+    kind: "video",
+    mimeType: "video/quicktime",
+    stored: "mov",
+    name: "QuickTime",
+    matches: SIGNATURES.quickTime,
+  },
+};
+const PICK_EXTENSIONS = Object.keys(PICK_MEDIA).join(", ");
+
+/**
+ * Keep the predicate aligned with `listQuery`. Created here rather than in a
+ * numbered migration: the migrator refuses a database whose recorded ids
+ * differ from its own, so a migration a patch adds would stop the next
+ * upstream release (or the app without this patch) from starting.
+ */
+const WAITING_PICKS_INDEX = "orchestration_v2_projection_turn_items_waiting_picks_idx";
+
+const ListRow = Schema.Struct({
+  thread_id: ThreadId,
+  turn_item_id: TurnItemId,
+  title: Schema.String,
+  first_prompt: Schema.String,
+  question_count: PositiveInt,
+  answered_count: NonNegativeInt,
+  started_at: Schema.DateTimeUtcFromString,
+  thread_title: Schema.String,
+});
+const decodeListRows = Schema.decodeUnknownEffect(Schema.Array(ListRow));
+
+export class PickRequests extends Context.Service<
+  PickRequests,
+  {
+    /**
+     * Puts a batch in the user's inbox and returns at once. A retry with the
+     * same clientRequestId and MCP session returns the batch's current status.
+     */
+    readonly request: (
+      scope: McpInvocationContext.McpInvocationScope,
+      input: PicksRequestInput,
+    ) => Effect.Effect<PicksRequestResult, OrchestratorMcpFailure>;
+    /** Open batches in every thread that is not archived or deleted, newest first. */
+    readonly list: Effect.Effect<PicksListResult, PicksError>;
+    /** One batch as the inbox shows it: options by place, never by id. */
+    readonly get: (input: PicksBatchInput) => Effect.Effect<PicksBatchView, PicksError>;
+    /** Saves one answer, which the user may change until they finish. */
+    readonly answer: (input: PicksAnswerInput) => Effect.Effect<void, PicksError>;
+    /** Closes a fully answered batch and wakes its agent with every answer. */
+    readonly complete: (input: PicksBatchInput) => Effect.Effect<void, PicksError>;
+  }
+>()("t3/picks/PickRequests") {}
+
+const isMcpFailure = Schema.is(OrchestratorMcpFailure);
+
+const invalid = (message: string) =>
+  new OrchestratorMcpFailure({ code: "invalid_request", message });
+
+const failed = (what: string) => (error: unknown) =>
+  new OrchestratorMcpFailure({
+    code: "orchestration_error",
+    message: `${what}: ${error instanceof Error ? error.message : String(error)}`,
+  });
+
+/** Turn item ids are global; scope the key to this thread and provider session. */
+const batchId = (threadId: ThreadId, requestNamespace: string, key: string) =>
+  TurnItemId.make(
+    `turn-item:pick-request:${encodeURIComponent(threadId)}:${encodeURIComponent(requestNamespace)}:${encodeURIComponent(key)}`,
+  );
+
+/** Every problem with the batch's ids, in order, so one call fixes them all. */
+function pickIdProblems(input: PicksRequestInput): ReadonlyArray<string> {
+  const problems: Array<string> = [];
+  const questionIds = new Set<string>();
+  for (const question of input.questions) {
+    if (questionIds.has(question.id)) problems.push(`Question id "${question.id}" is repeated.`);
+    questionIds.add(question.id);
+    const optionIds = new Set<string>();
+    for (const option of question.options) {
+      if (option.id === PICK_TIE) {
+        problems.push(`Question "${question.id}": "${PICK_TIE}" is reserved; rename the option.`);
+      } else if (optionIds.has(option.id)) {
+        problems.push(`Question "${question.id}": option id "${option.id}" is repeated.`);
+      }
+      optionIds.add(option.id);
+    }
+  }
+  return problems;
+}
+
+const make = Effect.gen(function* () {
+  const threadManagement = yield* ThreadManagementService.ThreadManagementService;
+  const random = yield* SecureRandom.SecureRandom;
+  const fileSystem = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const config = yield* ServerConfig.ServerConfig;
+  const sql = yield* SqlClient.SqlClient;
+
+  yield* sql`
+    CREATE INDEX IF NOT EXISTS ${sql.literal(WAITING_PICKS_INDEX)}
+    ON orchestration_v2_projection_turn_items(updated_at DESC, turn_item_id DESC)
+    WHERE type = 'pick_request' AND status = 'waiting'
+  `;
+
+  const readBatch = (threadId: ThreadId, id: TurnItemId) =>
+    threadManagement
+      .getThreadRecords(threadId, ["turnItems"], {
+        turnItemTypes: ["pick_request"],
+        messageRoles: [],
+      })
+      .pipe(
+        Effect.map((records) => {
+          const item = records.turnItems.find((candidate) => candidate.id === id);
+          // A deleted thread's batches went with it.
+          return item?.type === "pick_request" && records.thread.deletedAt === null
+            ? { item, thread: records.thread }
+            : undefined;
+        }),
+      );
+
+  // One answer or Done per batch at a time, each read and dispatched together: Done
+  // decides from the answers that are saved, and an answer finds a closed batch closed.
+  const batchLocks = yield* KeyedLock.make<TurnItemId>();
+
+  const readOpenBatch = Effect.fn("PickRequests.readOpenBatch")(function* (input: PicksBatchInput) {
+    const batch = yield* readBatch(input.threadId, input.batchId).pipe(
+      Effect.mapError((cause) => new PicksError({ reason: "load_failed", cause })),
+    );
+    if (batch === undefined) return yield* new PicksError({ reason: "not_found" });
+    return batch;
+  });
+
+  /** A file's first bytes, enough for any signature; nothing when it can't be read. */
+  const readHead = (file: string) =>
+    Effect.scoped(
+      fileSystem.open(file).pipe(Effect.flatMap((handle) => handle.readAlloc(16))),
+    ).pipe(
+      Effect.map((head) => (head._tag === "Some" ? head.value : new Uint8Array())),
+      Effect.orElseSucceed(() => new Uint8Array()),
+    );
+
+  /** Checks every option's file before anything is copied, and says what is wrong with each. */
+  const checkFiles = Effect.fn("PickRequests.checkFiles")(function* (input: PicksRequestInput) {
+    const problems: Array<string> = [];
+    const media = new Map<string, (typeof PICK_MEDIA)[string]>();
+    // Each file is checked once, however many options use it.
+    const checked = new Set<string>();
+    for (const question of input.questions) {
+      const paths = new Set<string>();
+      for (const option of question.options) {
+        const where = `Question "${question.id}" option "${option.id}"`;
+        if (paths.has(option.path)) {
+          problems.push(`${where}: ${option.path} is already another option of this question.`);
+        }
+        paths.add(option.path);
+        if (checked.has(option.path)) continue;
+        checked.add(option.path);
+        const type = PICK_MEDIA[path.extname(option.path).slice(1).toLowerCase()];
+        if (!path.isAbsolute(option.path)) {
+          problems.push(`${where}: ${option.path} is not an absolute path.`);
+        } else if (type === undefined) {
+          problems.push(
+            `${where}: ${option.path} is not a supported file type (${PICK_EXTENSIONS}).`,
+          );
+        } else {
+          const info = yield* fileSystem.stat(option.path).pipe(Effect.option);
+          if (info._tag === "None") {
+            problems.push(`${where}: ${option.path} was not found.`);
+          } else if (info.value.type !== "File") {
+            problems.push(`${where}: ${option.path} is not a file.`);
+          } else if (Number(info.value.size) === 0) {
+            problems.push(`${where}: ${option.path} is empty.`);
+          } else if (!type.matches(yield* readHead(option.path))) {
+            problems.push(`${where}: ${option.path} isn't a valid ${type.name} file.`);
+          } else {
+            media.set(option.path, type);
+          }
+        }
+      }
+    }
+    return { problems, media };
+  });
+
+  /** Copies each distinct file once, so the batch survives the agent rebuilding its outputs. */
+  const copyFiles = Effect.fn("PickRequests.copyFiles")(function* (
+    threadId: ThreadId,
+    media: ReadonlyMap<string, (typeof PICK_MEDIA)[string]>,
+    copied: Array<string>,
+  ) {
+    const stored = new Map<string, PickStoredOption["attachmentId"]>();
+    for (const [source, type] of media) {
+      const attachmentId = createAttachmentId(threadId, type.stored);
+      const target =
+        attachmentId === null
+          ? null
+          : resolveAttachmentRelativePath({
+              attachmentsDir: config.attachmentsDir,
+              relativePath: `${attachmentId}.${type.stored}`,
+            });
+      if (attachmentId === null || target === null) {
+        return yield* failed("Could not store the picks")(new Error("Invalid thread id."));
+      }
+      yield* fileSystem.makeDirectory(path.dirname(target), { recursive: true });
+      yield* fileSystem.copyFile(source, target);
+      copied.push(target);
+      stored.set(source, attachmentId);
+    }
+    return stored;
+  });
+
+  const request: PickRequests["Service"]["request"] = Effect.fn("PickRequests.request")(
+    function* (scope, input) {
+      const threadScope = yield* McpInvocationContext.requireThreadScope(scope, "request_picks");
+      const threadId = threadScope.thread.threadId;
+      const key = input.clientRequestId ?? (yield* random.uuidV4());
+      const id = batchId(threadId, scope.requestNamespace, key);
+      const unreadable = failed("Unable to read the picks");
+      if (input.clientRequestId !== undefined) {
+        const existing = yield* readBatch(threadId, id).pipe(Effect.mapError(unreadable));
+        if (existing !== undefined) return resultOf(existing.item);
+      }
+      const idProblems = pickIdProblems(input);
+      const { problems: fileProblems, media } = yield* checkFiles(input);
+      const problems = [...idProblems, ...fileProblems];
+      if (problems.length > 0) return yield* invalid(problems.join("\n"));
+      const parent = yield* threadManagement
+        .getThreadRecords(threadId, ["runs"], { messageRoles: [] })
+        .pipe(Effect.mapError(unreadable));
+      const run = ThreadManagementService.latestActiveRun(parent);
+      if (
+        run === undefined ||
+        run.rootNodeId === null ||
+        run.providerInstanceId !== threadScope.thread.providerInstanceId
+      ) {
+        return yield* new OrchestratorMcpFailure({
+          code: "parent_not_active",
+          message: "Asking for picks requires an active run owned by this MCP provider session.",
+        });
+      }
+      const rootNodeId = run.rootNodeId;
+      const copied: Array<string> = [];
+      return yield* Effect.gen(function* () {
+        const stored = yield* copyFiles(threadId, media, copied);
+        const questions: Array<PickStoredQuestion> = [];
+        for (const question of input.questions) {
+          const options = yield* random.shuffle(
+            question.options.flatMap((option): ReadonlyArray<PickStoredOption> => {
+              const type = media.get(option.path);
+              const attachmentId = stored.get(option.path);
+              return type === undefined || attachmentId === undefined
+                ? []
+                : [{ id: option.id, attachmentId, mediaKind: type.kind, mimeType: type.mimeType }];
+            }),
+          );
+          questions.push({
+            id: question.id,
+            prompt: question.prompt,
+            ...(question.guidance === undefined ? {} : { guidance: question.guidance }),
+            ...(question.display === undefined ? {} : { display: question.display }),
+            options,
+          });
+        }
+        yield* threadManagement
+          .dispatch({
+            type: "pick_request.record",
+            commandId: CommandId.make(
+              `command:mcp:${encodeURIComponent(scope.requestNamespace)}:picks:${encodeURIComponent(key)}`,
+            ),
+            threadId,
+            runId: run.id,
+            nodeId: rootNodeId,
+            turnItemId: id,
+            title: input.title,
+            allowTie: input.allowTie ?? true,
+            questions,
+          })
+          .pipe(Effect.mapError(failed("Could not record the picks")));
+        return { status: "pending", batchId: id, questions: questions.length } as const;
+      }).pipe(
+        Effect.mapError((error) =>
+          isMcpFailure(error) ? error : failed("Could not store the picks")(error),
+        ),
+        // A batch that was not recorded keeps none of its copies.
+        Effect.onError(() =>
+          Effect.forEach(copied, (file) => fileSystem.remove(file, { force: true }), {
+            discard: true,
+          }).pipe(Effect.ignore),
+        ),
+      );
+    },
+  );
+
+  const list: PickRequests["Service"]["list"] = sql`
+    SELECT
+      item.thread_id,
+      item.turn_item_id,
+      json_extract(item.payload_json, '$.title') AS title,
+      json_extract(item.payload_json, '$.questions[0].prompt') AS first_prompt,
+      json_extract(item.payload_json, '$.questionCount') AS question_count,
+      json_extract(item.payload_json, '$.answeredCount') AS answered_count,
+      json_extract(item.payload_json, '$.startedAt') AS started_at,
+      thread.title AS thread_title
+    FROM orchestration_v2_projection_turn_items AS item INDEXED BY ${sql.literal(WAITING_PICKS_INDEX)}
+    JOIN orchestration_v2_projection_threads AS thread ON thread.thread_id = item.thread_id
+    WHERE item.type = 'pick_request' AND item.status = 'waiting'
+      AND thread.archived_at IS NULL AND thread.deleted_at IS NULL
+    ORDER BY item.updated_at DESC, item.turn_item_id DESC
+  `.pipe(
+    Effect.flatMap(decodeListRows),
+    Effect.map((rows) => ({
+      batches: rows.map((row) => ({
+        threadId: row.thread_id,
+        batchId: row.turn_item_id,
+        title: row.title,
+        threadTitle: row.thread_title,
+        firstPrompt: row.first_prompt,
+        questionCount: row.question_count,
+        answeredCount: row.answered_count,
+        createdAt: row.started_at,
+      })),
+    })),
+    Effect.mapError((cause) => new PicksError({ reason: "load_failed", cause })),
+    Effect.withSpan("PickRequests.list"),
+  );
+
+  const get: PickRequests["Service"]["get"] = Effect.fn("PickRequests.get")(function* (input) {
+    const { item, thread } = yield* readOpenBatch(input);
+    return {
+      threadId: input.threadId,
+      batchId: item.id,
+      title: item.title ?? "",
+      threadTitle: thread.title,
+      allowTie: item.allowTie,
+      status: item.pickStatus,
+      questions: (item.questions ?? []).map((question) => {
+        const answer = item.answers?.[question.id];
+        const place = question.options.findIndex((option) => option.id === answer?.choice);
+        const choice = answer?.choice === PICK_TIE ? PICK_TIE : place;
+        return {
+          prompt: question.prompt,
+          ...(question.guidance === undefined ? {} : { guidance: question.guidance }),
+          ...(question.display === undefined ? {} : { display: question.display }),
+          options: question.options.map((option) => ({
+            attachmentId: option.attachmentId,
+            mediaKind: option.mediaKind,
+            mimeType: option.mimeType,
+          })),
+          ...(answer === undefined || choice === -1
+            ? {}
+            : {
+                answer: { choice, ...(answer.note === undefined ? {} : { note: answer.note }) },
+              }),
+        };
+      }),
+    };
+  });
+
+  /** Why a dispatch was refused, from the batch as it stands now. */
+  const refusal = (input: PicksBatchInput, cause: unknown) =>
+    readOpenBatch(input).pipe(
+      Effect.flatMap(({ item }) =>
+        Effect.fail(
+          new PicksError({
+            reason: item.pickStatus === "pending" ? "record_failed" : "closed",
+            cause,
+          }),
+        ),
+      ),
+    );
+
+  const answer: PickRequests["Service"]["answer"] = Effect.fn("PickRequests.answer")(
+    function* (input) {
+      const { item } = yield* readOpenBatch(input);
+      if (item.pickStatus !== "pending") return yield* new PicksError({ reason: "closed" });
+      const question = item.questions?.[input.questionIndex];
+      if (question === undefined || (input.choice === undefined && input.note === undefined)) {
+        return yield* new PicksError({ reason: "invalid_answer" });
+      }
+      // Merged with what is stored, read under this batch's lock: a save carries only what
+      // the owner just did, never a value a client read earlier.
+      const stored = item.answers?.[question.id];
+      const choice =
+        input.choice === undefined
+          ? stored?.choice
+          : input.choice === PICK_TIE
+            ? item.allowTie
+              ? PICK_TIE
+              : undefined
+            : question.options[input.choice]?.id;
+      if (choice === undefined) return yield* new PicksError({ reason: "invalid_answer" });
+      const note = input.note === undefined ? stored?.note : input.note.trim();
+      const commandKey = yield* random.uuidV4();
+      yield* threadManagement
+        .dispatch({
+          type: "pick_request.answer",
+          commandId: CommandId.make(`pick-request:${item.id}:answer:${commandKey}`),
+          threadId: input.threadId,
+          turnItemId: item.id,
+          questionId: question.id,
+          answer: { choice, ...(note ? { note } : {}) },
+        })
+        .pipe(Effect.catch((cause) => refusal(input, cause)));
+    },
+    (effect, input) => batchLocks.withLock(input.batchId, effect),
+  );
+
+  const complete: PickRequests["Service"]["complete"] = Effect.fn("PickRequests.complete")(
+    function* (input) {
+      const { item } = yield* readOpenBatch(input);
+      if (item.pickStatus === "answered") return;
+      if (item.pickStatus !== "pending") return yield* new PicksError({ reason: "closed" });
+      const questions = item.questions ?? [];
+      const answers = item.answers ?? {};
+      if (questions.some((question) => answers[question.id] === undefined)) {
+        return yield* new PicksError({ reason: "incomplete" });
+      }
+      const wake = pickRequestWake({
+        batchId: item.id,
+        title: item.title ?? "",
+        questions,
+        answers,
+      });
+      if (wake === undefined) return yield* new PicksError({ reason: "notes_too_long" });
+      yield* threadManagement
+        .dispatch({
+          type: "pick_request.complete",
+          commandId: CommandId.make(`pick-request:${item.id}:answered`),
+          threadId: input.threadId,
+          turnItemId: item.id,
+          messageId: MessageId.make(`message:pick-request:${item.id}`),
+        })
+        .pipe(Effect.catch((cause) => refusal(input, cause)));
+    },
+    (effect, input) => batchLocks.withLock(input.batchId, effect),
+  );
+
+  return PickRequests.of({ request, list, get, answer, complete });
+});
+
+/** What a retry hears: the batch's status now. */
+const resultOf = (item: PickRequestItem): PicksRequestResult => ({
+  status: item.pickStatus,
+  batchId: item.id,
+  questions: item.questionCount,
+});
+
+export const layer = Layer.effect(PickRequests, make);
