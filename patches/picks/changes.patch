+        active = false;
+        drawRef.current = null;
+        for (const eventName of ["loadeddata", "seeked", "play", "pause"]) {
+          boundVideo.removeEventListener(eventName, draw);
+        }
+      };
+    }
+    return () => {
+      drawRef.current = null;
+    };
+  });
