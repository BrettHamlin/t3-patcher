+import * as ProviderContinuationRequests from "@t3tools/provider-core/server/ProviderContinuationRequests";
+import * as PickRequests from "./PickRequests.ts";
+
+// The agent's call goes through the real toolkit and orchestrator; the user's
+// answers go through PickRequests, as the inbox's RPCs do.
+
+const instanceId = ProviderInstanceId.make("codex");
+const driver = ProviderDriverKind.make("codex");
+const modelSelection = { instanceId, model: "gpt-5.4" };
+const threadId = ThreadId.make("thread:picks");
+const runId = RunId.make("run:picks");
+const rootNode = NodeId.make("node:picks:root");
+
+const adapter = ProviderAdapter.ProviderAdapterV2.of({
+  instanceId,
+  driver,
+  getCapabilities: () => Effect.succeed(CodexProviderCapabilitiesV2),
+  planSelectionTransition: () => Effect.succeed({ type: "apply_on_next_turn" }),
+  openSession: () => Effect.die("No provider process needed"),
+});
+
+const mcpClient = McpSchema.McpServerClient.of({
+  clientId: 1,
+  protocolVersion: "2025-06-18",
+  clientCapabilities: {},
+  clientInfo: { name: "pick-requests", version: "1" },
+  initializePayload: {
+    protocolVersion: "2025-06-18",
+    capabilities: {},
+    clientInfo: { name: "pick-requests", version: "1" },
+  },
+  getClient: Effect.die("unused"),
+});
+
+const scope: McpInvocationContext.McpInvocationScope = {
+  environmentId: EnvironmentId.make("environment:picks"),
+  requestNamespace: "provider-session:picks",
+  thread: {
+    threadId,
+    providerSessionId: "provider-session:picks",
+    providerInstanceId: instanceId,
+  },
+  client: undefined,
+  capabilities: new Set(["orchestration"]),
+  issuedAt: 1,
+};
+
+/** Stand-in media: each type's signature, then a label that tells the copies apart. */
+const PNG = "\x89PNG\r\n\x1a\n";
+const WEBM = "\x1a\x45\xdf\xa3";
+const latin1Bytes = (text: string) => Uint8Array.from(text, (char) => char.charCodeAt(0));
+const latin1Text = (bytes: Uint8Array) => String.fromCharCode(...bytes);
+
+/** Repeatable "random" bytes, so the shuffle is the same on every run. */
+const seededBytes = (seed: number) => {
+  let state = seed;
+  return (size: number) => {
+    const bytes = new Uint8Array(size);
+    for (let index = 0; index < size; index += 1) {
+      state = (Math.imul(state, 1103515245) + 12345) >>> 0;
+      bytes[index] = state >>> 24;
+    }
+    return bytes;
+  };
+};
+
+/** Each answer's dispatch waits a second (on the test clock) before it commits. */
+const slowAnswers = Layer.effect(
+  ThreadManagement.ThreadManagementService,
+  Effect.map(ThreadManagement.ThreadManagementService, (threads) =>
+    ThreadManagement.ThreadManagementService.of({
+      ...threads,
+      dispatch: (command) =>
+        command.type === "pick_request.answer"
+          ? Effect.sleep("1 second").pipe(Effect.andThen(threads.dispatch(command)))
+          : threads.dispatch(command),
+    }),
+  ),
+);
+
+const makeHarnessWith = (options: { readonly slowAnswers?: boolean } = {}) =>
+  Effect.gen(function* () {
+    const database = yield* SqlitePersistence.layerMemory.pipe(Layer.build);
