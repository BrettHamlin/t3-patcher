+  const canvas = document.createElement("canvas");
+  canvas.width = width;
+  canvas.height = height;
+  const context = canvas.getContext("2d");
+  if (context !== null) {
+    context.fillStyle = "#c0ffee";
+    context.fillRect(0, 0, width, height);
+  }
+  return canvas.toDataURL("image/png");
