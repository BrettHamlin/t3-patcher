diff --git a/patcher/journeys/fixtures/picks-agent.mjs b/patcher/journeys/fixtures/picks-agent.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..0551b510e10be4f416bc458ad62127fe427667c9
--- /dev/null
+++ b/patcher/journeys/fixtures/picks-agent.mjs
@@ -0,0 +1,166 @@
+// A minimal ACP agent for the picks journey. Its first turn asks for picks through the T3 MCP
+// server the session was given (the real /mcp endpoint, with this thread's credential); a later
+// turn that brings the answers replies that it read them. It speaks ACP on stdio.
+import * as NodeCrypto from "node:crypto";
+import * as NodeReadline from "node:readline";
+
+import { PICKS_BATCH, PICKS_REPLY } from "./picks-batch.mjs";
+
+const send = (message) =>
+  process.stdout.write(`${JSON.stringify({ jsonrpc: "2.0", ...message })}\n`);
+const log = (text) => process.stderr.write(`[picks-agent] ${text}\n`);
+
+/** The T3 MCP server the session was given: its stdio bridge entry carries the endpoint. */
+function mcpTarget(mcpServers) {
+  for (const server of mcpServers ?? []) {
+    const env = Object.fromEntries((server.env ?? []).map(({ name, value }) => [name, value]));
+    const headers = Object.fromEntries(
+      (server.headers ?? []).map(({ name, value }) => [name, value]),
+    );
+    if (env.T3_ACP_MCP_ENDPOINT) {
+      return { url: env.T3_ACP_MCP_ENDPOINT, authorization: env.T3_ACP_MCP_AUTHORIZATION };
+    }
+    if (server.url && headers.Authorization) {
+      return { url: server.url, authorization: headers.Authorization };
+    }
+  }
+  return process.env.T3_ACP_MCP_ENDPOINT
+    ? { url: process.env.T3_ACP_MCP_ENDPOINT, authorization: process.env.T3_ACP_MCP_AUTHORIZATION }
+    : undefined;
+}
+
+async function mcpPost(target, sessionId, body) {
+  const response = await fetch(target.url, {
+    method: "POST",
+    headers: {
+      authorization: target.authorization,
+      "content-type": "application/json",
+      accept: "application/json, text/event-stream",
+      "mcp-protocol-version": "2025-06-18",
+      ...(sessionId ? { "mcp-session-id": sessionId } : {}),
+    },
+    body: JSON.stringify(body),
+  });
+  const text = await response.text();
+  if (!response.ok) throw new Error(`MCP ${body.method} answered ${response.status}: ${text}`);
+  const json = response.headers.get("content-type")?.includes("text/event-stream")
+    ? text
+        .split("\n")
+        .filter((line) => line.startsWith("data:"))
+        .map((line) => JSON.parse(line.slice(5)))
+        .find((message) => message.id === body.id)
+    : text
+      ? JSON.parse(text)
+      : undefined;
+  return { sessionId: response.headers.get("mcp-session-id") ?? sessionId, json };
+}
+
+async function requestPicks(target) {
+  const init = await mcpPost(target, undefined, {
+    jsonrpc: "2.0",
+    id: 1,
+    method: "initialize",
+    params: {
+      protocolVersion: "2025-06-18",
+      capabilities: {},
+      clientInfo: { name: "picks-journey-agent", version: "1" },
+    },
+  });
+  await mcpPost(target, init.sessionId, { jsonrpc: "2.0", method: "notifications/initialized" });
+  const call = await mcpPost(target, init.sessionId, {
+    jsonrpc: "2.0",
+    id: 2,
+    method: "tools/call",
+    params: { name: "request_picks", arguments: PICKS_BATCH },
+  });
+  const result = call.json?.result;
+  if (result === undefined || result.isError) {
+    throw new Error(`request_picks failed: ${JSON.stringify(call.json)}`);
+  }
+  return result.structuredContent;
+}
+
+const sessions = new Map();
+
+async function prompt(params) {
+  const session = sessions.get(String(params.sessionId));
+  if (session === undefined) throw new Error(`Unknown session ${params.sessionId}`);
+  const text = (params.prompt ?? []).map((block) => block.text ?? "").join("\n");
+  session.prompts += 1;
+  const say = (words) =>
+    send({
+      method: "session/update",
+      params: {
+        sessionId: params.sessionId,
+        update: { sessionUpdate: "agent_message_chunk", content: { type: "text", text: words } },
+      },
+    });
+  if (text.includes("answered the picks")) {
+    // The wake's JSON block, unblinded: what each question's chosen option id was.
+    const json = JSON.parse(text.slice(text.indexOf("```json") + 7, text.lastIndexOf("```")));
+    const answers = json.answers.map(
+      (answer) => `${answer.questionId}=${answer.choice}${answer.note ? ` (${answer.note})` : ""}`,
+    );
+    say(`${PICKS_REPLY} ${answers.join(", ")}.`);
+  } else if (session.target === undefined) {
+    say("No T3 MCP server was given to this session.");
+  } else {
+    const result = await requestPicks(session.target);
+    log(`request_picks: ${JSON.stringify(result)}`);
+    say(`Asked for picks: ${result.status} (${result.questions} questions).`);
+  }
+  return { stopReason: "end_turn" };
+}
+
+async function handle(message) {
+  const params = message.params ?? {};
+  switch (message.method) {
+    case "initialize":
+      return {
+        protocolVersion: 1,
+        agentCapabilities: {
+          loadSession: true,
+          promptCapabilities: { image: false, audio: false, embeddedContext: true },
+          mcpCapabilities: { http: true, sse: false },
+        },
+        authMethods: [],
+        agentInfo: { name: "picks-journey-agent", version: "1" },
+      };
+    case "session/new":
+    case "session/load": {
+      const sessionId =
+        message.method === "session/load" ? String(params.sessionId) : NodeCrypto.randomUUID();
+      sessions.set(sessionId, { prompts: 0, target: mcpTarget(params.mcpServers) });
+      return {
+        ...(message.method === "session/new" ? { sessionId } : {}),
+        models: {
+          currentModelId: "default",
+          availableModels: [{ modelId: "default", name: "Default" }],
+        },
+      };
+    }
+    case "session/set_model":
+    case "session/set_mode":
+      return {};
+    case "session/prompt":
+      return prompt(params);
+    default:
+      throw Object.assign(new Error(`Method not found: ${message.method}`), { code: -32601 });
+  }
+}
+
+NodeReadline.createInterface({ input: process.stdin }).on("line", (line) => {
+  if (line.trim() === "") return;
+  const message = JSON.parse(line);
+  if (message.method === undefined || message.id === undefined) return;
+  handle(message).then(
+    (result) => send({ id: message.id, result }),
+    (error) => {
+      log(error instanceof Error ? (error.stack ?? error.message) : String(error));
+      send({
+        id: message.id,
+        error: { code: error.code ?? -32603, message: String(error.message) },
+      });
+    },
+  );
+});
