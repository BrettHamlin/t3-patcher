@@ -0,0 +1,24 @@
+import type { ReactNode } from "react";
+
+import { useStableCallback } from "~/hooks/useStableCallback";
+import { useSidebar } from "../ui/sidebar";
+
+/**
+ * An open batch: the thread sidebar is hidden while it shows, without changing the stored
+ * preference, and comes back when it goes. Toggling the sidebar here ends that for this visit.
+ */
+export function PicksBatchFrame(props: { readonly children: ReactNode }) {
+  const { overrideOpen } = useSidebar();
+  // Tied to this element's life, like the picker's focus on mount; one identity, so a
+  // re-render never hides a sidebar the owner opened again.
+  const hideWhileShown = useStableCallback((node: HTMLDivElement | null) => {
+    if (node === null) return;
+    overrideOpen(false);
+    return () => overrideOpen(null);
+  });
+  return (
+    <div ref={hideWhileShown} className="flex min-h-0 flex-1 flex-col" data-testid="picks-batch">
+      {props.children}
+    </div>
+  );
+}
