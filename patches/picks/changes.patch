+import type { EnvironmentId, ThreadId } from "@t3tools/contracts";
+import { Link } from "@tanstack/react-router";
+import { useGT } from "gt-react";
+import type { ReactNode } from "react";
+
+import {
+  WorkspaceBreadcrumb,
+  WorkspaceBreadcrumbItem,
+  WorkspaceBreadcrumbSeparator,
+} from "~/components/WorkspaceBreadcrumb";
+import { WorkspacePageHeader } from "~/components/WorkspacePageHeader";
+import { isElectron } from "~/env";
+
+/** The Picks page's header: the inbox, or `Picks / {batch}` with its thread and a counter. */
+export function PicksHeader(props: {
+  readonly batch?: {
+    readonly environmentId: EnvironmentId;
+    readonly threadId: ThreadId;
+    readonly title: string;
+    readonly threadTitle: string;
+  };
+  readonly counter?: ReactNode;
+}) {
+  const gt = useGT();
+  const { batch } = props;
+  return (
+    <WorkspacePageHeader electron={isElectron} className="relative bg-background">
+      <WorkspaceBreadcrumb ariaLabel={gt("Picks breadcrumb")} className="flex-1">
+        <WorkspaceBreadcrumbItem current={batch === undefined}>
+          {batch === undefined ? (
+            <h1 className="truncate">{gt("Picks")}</h1>
+          ) : (
+            <Link to="/picks">{gt("Picks")}</Link>
+          )}
+        </WorkspaceBreadcrumbItem>
+        {batch === undefined ? null : (
+          <>
+            <WorkspaceBreadcrumbSeparator />
+            <WorkspaceBreadcrumbItem current>
+              <h1 className="truncate">{batch.title}</h1>
+            </WorkspaceBreadcrumbItem>
+            <li className="flex min-w-0 shrink items-center">
+              <Link
+                to="/$environmentId/$threadId"
+                params={{ environmentId: batch.environmentId, threadId: batch.threadId }}
+                className="truncate text-sm text-muted-foreground hover:text-foreground"
+                data-testid="picks-header-thread"
+              >
+                {gt("from {thread}", { thread: batch.threadTitle })}
+              </Link>
+            </li>
+          </>
+        )}
+      </WorkspaceBreadcrumb>
+      {props.counter === undefined ? null : (
+        <p
+          className="shrink-0 text-sm text-muted-foreground tabular-nums"
+          data-testid="picker-progress"
+        >
+          {props.counter}
+        </p>
+      )}
+    </WorkspacePageHeader>
+  );
+}
diff --git a/apps/web/src/components/picks/PicksPage.tsx b/apps/web/src/components/picks/PicksPage.tsx
