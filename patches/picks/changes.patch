+import {
+  PICK_TIE,
+  type OrchestrationV2TurnItem,
+  type PickDisplay,
+  type PickViewChoice,
+  type PicksBatchView,
+} from "@t3tools/contracts";
+
+export type PickRequestItem = Extract<OrchestrationV2TurnItem, { readonly type: "pick_request" }>;
+
+export type PickerAnswer = {
+  readonly choice: PickViewChoice;
+  readonly note?: string;
+};
+
+/** What a key does in the picker, given where focus is. */
+export type PickerKeyAction =
+  | { readonly type: "choose"; readonly choice: PickViewChoice }
+  | { readonly type: "move"; readonly delta: -1 | 1 }
+  | { readonly type: "next-unanswered" }
+  | { readonly type: "focus-note" }
+  | { readonly type: "note-last-answered" }
+  | { readonly type: "leave-note" }
+  | { readonly type: "cancel-hold" }
+  | { readonly type: "flip"; readonly delta: -1 | 1 }
+  | { readonly type: "send" }
+  | { readonly type: "play-pause" }
+  | { readonly type: "half-speed" }
+  | { readonly type: "replay" }
+  | { readonly type: "step"; readonly delta: -1 | 1 };
+
+/** Keys that repeat while held; every other picker key acts once per press. */
+const REPEATING_KEYS = new Set(["ArrowLeft", "ArrowRight", ",", "."]);
+
+/**
+ * `1`–`4` pick and `0` can't tell; arrows move, `U` goes to the next blank, `N` and `Shift+N`
+ * open a note, `F` flips, and Space, `S`, `R`, `,` and `.` drive videos. `mod` is the platform's
+ * send modifier (⌘ on macOS, Ctrl elsewhere): with Enter it sends, from the note too. While the
+ * note has focus, keys type text; Escape and Enter leave it.
+ */
+export function pickerKeyAction(input: {
+  readonly key: string;
+  readonly optionCount: number;
+  readonly allowTie: boolean;
+  readonly noteFocused: boolean;
+  /** The send modifier is held. */
+  readonly mod: boolean;
+  /** Another modifier than Shift and the send modifier is held. */
+  readonly modified: boolean;
+  readonly shift: boolean;
+  readonly repeat: boolean;
+  readonly flip: boolean;
+  readonly video: boolean;
+  readonly holding?: boolean;
+}): PickerKeyAction | null {
+  if (input.repeat && !REPEATING_KEYS.has(input.key)) return null;
+  if (input.key === "Enter" && input.mod && !input.modified && !input.shift) {
+    return { type: "send" };
+  }
+  if (input.noteFocused) {
+    if (input.key === "Escape") return { type: "leave-note" };
+    const plainEnter = input.key === "Enter" && !input.shift && !input.mod && !input.modified;
+    return plainEnter ? { type: "leave-note" } : null;
+  }
+  if (input.mod || input.modified) return null;
+  const key = input.key.toLowerCase();
+  if (input.shift) {
+    if (key === "n") return { type: "note-last-answered" };
+    if (key === "f" && input.flip) return { type: "flip", delta: -1 };
+    return null;
+  }
+  switch (key) {
+    case "escape":
+      return input.holding ? { type: "cancel-hold" } : null;
+    case "arrowleft":
+      return { type: "move", delta: -1 };
+    case "arrowright":
+      return { type: "move", delta: 1 };
+    case "u":
+      return { type: "next-unanswered" };
+    case "n":
+      return { type: "focus-note" };
+    case "f":
+      return input.flip ? { type: "flip", delta: 1 } : null;
+    case "0":
+      return input.allowTie ? { type: "choose", choice: PICK_TIE } : null;
+  }
+  if (input.video) {
+    if (key === " ") return { type: "play-pause" };
+    if (key === "s") return { type: "half-speed" };
+    if (key === "r") return { type: "replay" };
+    if (key === ",") return { type: "step", delta: -1 };
+    if (key === ".") return { type: "step", delta: 1 };
+  }
+  const place = /^[1-4]$/.test(key) ? Number(key) - 1 : -1;
+  return place >= 0 && place < input.optionCount ? { type: "choose", choice: place } : null;
+}
+
+/** How long a pick shows on its question before the picker moves on. */
+export const PICK_HOLD_MS = 350;
+
+/** The first question without an answer after `index`, wrapping; null when every other one has one. */
+export function nextUnanswered(
+  answers: ReadonlyArray<PickerAnswer | undefined>,
+  index: number,
+): number | null {
+  for (let step = 1; step < answers.length; step += 1) {
+    const candidate = (index + step) % answers.length;
+    if (answers[candidate] === undefined) return candidate;
+  }
+  return null;
+}
+
+/** The first question without an answer, or null when all have one. */
+export function firstUnanswered(answers: ReadonlyArray<PickerAnswer | undefined>): number | null {
+  const index = answers.findIndex((answer) => answer === undefined);
+  return index === -1 ? null : index;
+}
+
+/** Moves `delta` questions, staying inside the batch. */
+export function movedQuestion(index: number, delta: -1 | 1, total: number): number {
+  return Math.min(Math.max(index + delta, 0), Math.max(total - 1, 0));
+}
+
+/** The server's answers, with the ones this window saved since it last read them. */
+export function pickerAnswers(
+  view: Pick<PicksBatchView, "questions">,
+  saved: ReadonlyMap<number, PickerAnswer>,
+): ReadonlyArray<PickerAnswer | undefined> {
+  return view.questions.map((question, index) => saved.get(index) ?? question.answer);
+}
+
+export function pickerProgress(answers: ReadonlyArray<PickerAnswer | undefined>) {
+  const answered = answers.filter((answer) => answer !== undefined).length;
+  return { answered, total: answers.length, complete: answered === answers.length };
+}
+
+/** The colour behind every option, in both themes. */
+export const PICK_STAGE_COLOR = "#2a2e36";
+/** A card's border (2 px each side) and its 28 px label row around the stage. */
+export const PICK_CARD_CHROME = { width: 4, height: 32 } as const;
+export const PICK_CARD_GAP = 16;
+/** The playback row under video questions, with its gap. */
+const PICK_PLAYBACK_ROW = 40;
+/** The stage at default size, by option count; sizes never grow with the window. */
+const PICK_DEFAULT_STAGE: Readonly<Record<number, number>> = { 2: 480, 3: 320, 4: 240 };
+/** Default stage sizes the picker steps down through when the content is narrower. */
+const PICK_STAGE_STEPS = [480, 384, 320, 240, 192, 160] as const;
+
+export interface PickStageLayout {
+  /** `fit`: a default-size square the media scales down into. `exact`: the agent's box. */
+  readonly kind: "fit" | "exact";
+  readonly arrangement: "row" | "grid" | "flip";
+  readonly width: number;
+  readonly height: number;
+  readonly pixelated: boolean;
+  /** One box alone is bigger than the region, which then scrolls. */
+  readonly oversized: boolean;
+}
+
+const rowFits = (count: number, width: number, height: number, region: PickRegion) =>
+  count * (width + PICK_CARD_CHROME.width) + PICK_CARD_GAP * (count - 1) <= region.width &&
+  height + PICK_CARD_CHROME.height <= region.height;
+
+export interface PickRegion {
+  readonly width: number;
+  readonly height: number;
+}
+
+/**
+ * How a question's options are laid out in the region between the prompt and the footer: one row
+ * when they fit, a 2×2 grid for 3 or 4 exact boxes, otherwise one at a time (flip). Video
+ * questions lose the playback row's height.
+ */
+export function pickStageLayout(input: {
+  readonly optionCount: number;
+  readonly display: PickDisplay | undefined;
+  readonly region: PickRegion;
+  readonly video: boolean;
+}): PickStageLayout {
+  const region = {
+    width: input.region.width,
+    height: input.region.height - (input.video ? PICK_PLAYBACK_ROW : 0),
+  };
+  const count = input.optionCount;
+  if (input.display === undefined) {
+    const largest = PICK_DEFAULT_STAGE[count] ?? 160;
+    const sizes = PICK_STAGE_STEPS.filter((size) => size <= largest);
+    const row = sizes.find((size) => rowFits(count, size, size, region));
+    const alone = sizes.find((size) => rowFits(1, size, size, region)) ?? sizes.at(-1) ?? largest;
+    const size = row ?? alone;
+    return {
+      kind: "fit",
+      arrangement: row === undefined ? "flip" : "row",
+      width: size,
+      height: size,
+      pixelated: false,
+      oversized: false,
+    };
+  }
+  const { width, height } = input.display;
+  const card = { width: width + PICK_CARD_CHROME.width, height: height + PICK_CARD_CHROME.height };
+  const grid =
+    count >= 3 &&
+    2 * card.width + PICK_CARD_GAP <= region.width &&
+    2 * card.height + PICK_CARD_GAP <= region.height;
+  return {
+    kind: "exact",
+    arrangement: rowFits(count, width, height, region) ? "row" : grid ? "grid" : "flip",
+    width,
+    height,
+    pixelated: input.display.pixelated === true,
+    oversized: card.width > region.width || card.height > region.height,
+  };
+}
+
+/** What the size chip says: the agent's box, or how default-size media was drawn. */
+export type PickSizeChip =
+  | {
+      readonly _tag: "Exact";
+      readonly width: number;
+      readonly height: number;
+      readonly pixelated: boolean;
+      readonly oversized: boolean;
+    }
+  /** Every option has this natural size and is drawn at it. */
+  | { readonly _tag: "Actual"; readonly width: number; readonly height: number }
+  /** Every option has one natural size, scaled down to this drawn size. */
+  | { readonly _tag: "Scaled"; readonly width: number; readonly height: number }
+  /** Options differ in natural size and are all drawn at this one size. */
+  | { readonly _tag: "Matched"; readonly width: number; readonly height: number }
+  /** Options differ in shape: they share only their longest side. */
+  | { readonly _tag: "Mixed"; readonly side: number; readonly scaled: boolean };
+
+const longestSide = (size: PickRegion) => Math.max(size.width, size.height);
+
+/**
+ * At default size, every option is drawn with this longest side: the stage's, or the smallest
+ * option's own if that is shorter, so options match and none is scaled up. Null for an exact
+ * box, or until some option's size is known.
+ */
+export function pickSharedSide(
+  layout: PickStageLayout,
+  sizes: ReadonlyArray<PickRegion | null> | undefined,
+): number | null {
+  if (layout.kind === "exact" || sizes === undefined) return null;
+  const loaded = sizes.filter((size) => size !== null);
+  if (loaded.length === 0) return null;
+  return Math.min(layout.width, ...loaded.map(longestSide));
+}
+
+/**
+ * The size chip, from the sizes options are drawn at (see `pickSharedSide`). `sizes` holds each
+ * option's natural size, null for one that failed; undefined until all are known. Never names a
+ * size no option is drawn at.
+ */
+export function pickSizeChip(
+  layout: PickStageLayout,
+  sizes: ReadonlyArray<PickRegion | null> | undefined,
+): PickSizeChip | null {
+  if (layout.kind === "exact") {
+    return {
+      _tag: "Exact",
+      width: layout.width,
+      height: layout.height,
+      pixelated: layout.pixelated,
+      oversized: layout.oversized,
+    };
+  }
+  const side = pickSharedSide(layout, sizes);
+  if (side === null || sizes === undefined) return null;
+  const loaded = sizes.filter((size) => size !== null);
+  const drawn = loaded.map((size) => {
+    const long = longestSide(size);
+    return {
+      width: Math.round((size.width * side) / long),
+      height: Math.round((size.height * side) / long),
+      scaled: side < long,
+    };
+  });
+  const same = (list: ReadonlyArray<PickRegion>) =>
+    list.every((size) => size.width === list[0]?.width && size.height === list[0]?.height);
+  const scaled = drawn.some((size) => size.scaled);
+  const [shown] = drawn;
+  if (shown === undefined) return null;
+  const box = { width: shown.width, height: shown.height };
+  if (same(loaded)) return scaled ? { _tag: "Scaled", ...box } : { _tag: "Actual", ...box };
+  if (same(drawn)) return { _tag: "Matched", ...box };
+  return { _tag: "Mixed", side, scaled };
+}
+
+/** One progress cell per question in a row `width` wide: 4 to 24 px, 2 px apart from 8 px up. */
+export function pickStripCells(count: number, width: number) {
+  const fitted = (gap: number) => Math.floor((width - gap * Math.max(count - 1, 0)) / count);
+  const wide = fitted(2);
+  if (wide >= 8) return { cell: Math.min(wide, 24), gap: 2 };
+  return { cell: Math.min(Math.max(fitted(1), 4), 24), gap: 1 };
+}
+
+/** The frame length used when a clip has shown fewer than two frames. */
+export const PICK_FALLBACK_FRAME = 1 / 30;
+/** Clips this close in length, or this far apart in time, count as the same. */
+const PICK_CLIP_TOLERANCE = 0.05;
+
+export interface PickClip {
+  readonly currentTime: number;
+  readonly duration: number;
+}
+
+const frameIndex = (time: number, frame: number) => Math.floor(time / frame + 1e-3);
+const frameCount = (clip: PickClip, frame: number) =>
+  Math.max(Math.round(clip.duration / frame), 1);
+
+/** Clips whose frame lengths are this close play at the same rate. */
+const PICK_RATE_TOLERANCE = 0.001;
+
+/** Each clip's frame length: one not learned yet takes the shortest learned one, or the fallback. */
+export function pickFrameLengths(
+  learned: ReadonlyArray<number | undefined>,
+): ReadonlyArray<number> {
+  const known = learned.filter((frame) => frame !== undefined);
+  const fill = known.length === 0 ? PICK_FALLBACK_FRAME : Math.min(...known);
+  return learned.map((frame) => frame ?? fill);
+}
+
+const sameRate = (frames: ReadonlyArray<number>) =>
+  frames.length === 0 || Math.max(...frames) - Math.min(...frames) <= PICK_RATE_TOLERANCE;
+
+/**
+ * Where clips are, given each clip's frame length: a frame count when they share a rate and a
+ * frame count, else the longest clip's seconds, saying whether their rates differ.
+ */
+export function pickPlaybackPosition(
+  clips: ReadonlyArray<PickClip>,
+  frames: ReadonlyArray<number>,
+):
+  | { readonly _tag: "Frame"; readonly current: number; readonly total: number }
+  | {
+      readonly _tag: "Seconds";
+      readonly current: number;
+      readonly total: number;
+      readonly mixedRates: boolean;
+    }
+  | null {
+  const [first] = clips;
+  if (first === undefined || !Number.isFinite(first.duration)) return null;
+  const mixedRates = !sameRate(frames);
+  const frame = frames.length === 0 ? PICK_FALLBACK_FRAME : Math.min(...frames);
+  const total = frameCount(first, frame);
+  if (!mixedRates && clips.every((clip) => frameCount(clip, frame) === total)) {
+    return {
+      _tag: "Frame",
+      current: Math.min(frameIndex(first.currentTime, frame), total - 1) + 1,
+      total,
+    };
+  }
+  const longest = clips.reduce((best, clip) => (clip.duration > best.duration ? clip : best));
+  return { _tag: "Seconds", current: longest.currentTime, total: longest.duration, mixedRates };
+}
+
+/** The time one frame back or forward, wrapping, at the middle of that frame so it shows. */
+export function steppedTime(clip: PickClip, frame: number, delta: -1 | 1): number {
+  const total = frameCount(clip, frame);
+  const target = (((frameIndex(clip.currentTime, frame) + delta) % total) + total) % total;
+  return Math.min((target + 0.5) * frame, Math.max(clip.duration - 0.001, 0));
+}
+
+/** The middle of the clip's own frame that holds `time`, wrapped into the clip's length. */
+function frameTimeAt(clip: PickClip, frame: number, time: number): number {
+  const wrapped = clip.duration > 0 ? ((time % clip.duration) + clip.duration) % clip.duration : 0;
+  return Math.min((frameIndex(wrapped, frame) + 0.5) * frame, Math.max(clip.duration - 0.001, 0));
+}
+
+/**
+ * Every clip's time after one frame back or forward, plus the shared playhead. At different
+ * rates the playhead steps through the longest clip at the finest frame interval.
+ */
+export function steppedTimes(
+  clips: ReadonlyArray<PickClip>,
+  frames: ReadonlyArray<number>,
+  delta: -1 | 1,
+  playhead?: number,
+): { readonly times: ReadonlyArray<number>; readonly playhead: number } {
+  if (clips.length === 0) return { times: [], playhead: 0 };
+  const frameOf = (place: number) => frames[place] ?? PICK_FALLBACK_FRAME;
+  const longestIndex = clips.reduce((best, clip, place) => {
+    const bestClip = clips[best];
+    if (bestClip === undefined) return place;
+    if (clip.duration > bestClip.duration) return place;
+    if (clip.duration === bestClip.duration && frameOf(place) < frameOf(best)) return place;
+    return best;
+  }, 0);
+  if (sameRate(frames)) {
+    const frame = frames.length === 0 ? PICK_FALLBACK_FRAME : Math.min(...frames);
+    const times = clips.map((clip) => steppedTime(clip, frame, delta));
+    return { times, playhead: times[longestIndex] ?? 0 };
+  }
+  const finestFrame = Math.min(...clips.map((_, place) => frameOf(place)));
+  const longest = clips[longestIndex];
+  if (longest === undefined) return { times: [], playhead: 0 };
+  const current = playhead ?? longest.currentTime;
+  const moment = steppedTime(
+    { currentTime: current, duration: longest.duration },
+    finestFrame,
+    delta,
+  );
+  const times = clips.map((clip, place) => frameTimeAt(clip, frameOf(place), moment));
+  return { times, playhead: moment };
+}
+
+/**
+ * When the first clip wraps: the time to move another clip to so the two stay in step, or null
+ * when it already is, or when the clips differ in length and so loop on their own.
+ */
+export function inStepTime(leader: PickClip, clip: PickClip): number | null {
+  if (Math.abs(leader.duration - clip.duration) > PICK_CLIP_TOLERANCE) return null;
+  return Math.abs(leader.currentTime - clip.currentTime) > PICK_CLIP_TOLERANCE
+    ? leader.currentTime
+    : null;
+}
+
+/** A note as saved: trimmed, and none when blank. */
+export function savedNote(note: string): string | undefined {
+  const trimmed = note.trim();
+  return trimmed.length === 0 ? undefined : trimmed;
+}
+
+/**
+ * One batch's saves, one after another, shared by every picker open on it: a save a closed
+ * picker queued still lands before a later one, and Done waits for all of them.
+ */
+/** What a save carries: the choice, the note, or both. */
+export type PickField = "choice" | "note";
+
+export interface PickSaveQueue {
+  /**
+   * Runs `save` after every save before it; resolves to its error, or null. Its outcome
+   * counts only for the fields it carries.
+   */
+  readonly enqueue: (
+    target: { readonly questionIndex: number; readonly fields: ReadonlyArray<PickField> },
+    save: () => Promise<string | null>,
+  ) => Promise<string | null>;
+  /**
+   * Done, in line with the saves: after every save before it, `complete` runs unless some
+   * field's latest save failed; saves queued after it run after it.
+   */
+  readonly finish: <A>(complete: () => Promise<A>) => Promise<PickFinishOutcome<A>>;
+  /** Waits for every queued save and Done; the questions with a field whose latest save failed. */
+  readonly settled: () => Promise<ReadonlySet<number>>;
+}
+
+/** A question whose latest save failed for these fields. */
+export interface PickUnsaved {
+  readonly questionIndex: number;
+  readonly fields: ReadonlySet<PickField>;
+}
+
+export type PickFinishOutcome<A> =
+  | { readonly _tag: "Unsaved"; readonly unsaved: ReadonlyArray<PickUnsaved> }
+  | { readonly _tag: "Completed"; readonly result: A };
+
+export function makePickSaveQueue(): PickSaveQueue {
+  let tail: Promise<unknown> = Promise.resolve();
+  // By question, the fields whose latest save failed: a choice saved later doesn't clear a note.
+  const failed = new Map<number, Set<PickField>>();
+  const unsaved = (): ReadonlyArray<PickUnsaved> =>
+    [...failed.entries()]
+      .filter(([, fields]) => fields.size > 0)
+      .map(([questionIndex, fields]) => ({ questionIndex, fields: new Set(fields) }))
+      .sort((left, right) => left.questionIndex - right.questionIndex);
+  return {
+    enqueue: ({ questionIndex, fields }, save) => {
+      const run = tail.then(save).then((failure) => {
+        const current = failed.get(questionIndex) ?? new Set<PickField>();
+        for (const field of fields) {
+          if (failure === null) current.delete(field);
+          else current.add(field);
+        }
+        failed.set(questionIndex, current);
+        return failure;
+      });
+      // A save that throws fails on its own; the ones after it still run.
+      tail = run.catch(() => undefined);
+      return run;
+    },
+    finish: <A>(complete: () => Promise<A>) => {
+      const run = tail.then(async (): Promise<PickFinishOutcome<A>> => {
+        const pending = unsaved();
+        return pending.length > 0
+          ? { _tag: "Unsaved", unsaved: pending }
+          : { _tag: "Completed", result: await complete() };
+      });
+      tail = run.catch(() => undefined);
+      return run;
+    },
+    settled: () => tail.then(() => new Set(unsaved().map(({ questionIndex }) => questionIndex))),
+  };
+}
+
+const saveQueues = new Map<string, PickSaveQueue>();
+
+/** The save queue for a batch on an environment, made on first use. */
+export function pickSaveQueue(batch: {
+  readonly environmentId: string;
+  readonly threadId: string;
+  readonly batchId: string;
+}): PickSaveQueue {
+  const key = JSON.stringify([batch.environmentId, batch.threadId, batch.batchId]);
+  const existing = saveQueues.get(key);
+  if (existing !== undefined) return existing;
+  const queue = makePickSaveQueue();
+  saveQueues.set(key, queue);
+  return queue;
+}
