@@ -0,0 +1,29 @@
+import { OrchestratorMcpFailure, PicksRequestInput, PicksRequestResult } from "@t3tools/contracts";
+import { McpSchema, Tool, Toolkit } from "effect/ai";
+
+import * as ThreadManagementService from "../../../orchestration-v2/ThreadManagementService.ts";
+import * as PickRequests from "../../../picks/PickRequests.ts";
+import * as McpInvocationContext from "../../McpInvocationContext.ts";
+
+const RequestPicksTool = Tool.make("request_picks", {
+  description:
+    "Ask the user to judge media side by side in their Picks inbox, e.g. which image looks more real. Options are shuffled and shown without ids. Returns `pending` at once; every answer arrives later as one message in this thread, with JSON. Don't wait or poll.",
+  parameters: PicksRequestInput,
+  success: PicksRequestResult,
+  failure: OrchestratorMcpFailure,
+  failureMode: "return",
+  dependencies: [
+    McpInvocationContext.McpInvocationContext,
+    ThreadManagementService.ThreadManagementService,
+    PickRequests.PickRequests,
+  ],
+})
+  .annotate(Tool.Title, "Ask the user for picks")
+  .annotate(Tool.Destructive, false)
+  .annotate(Tool.Idempotent, false)
+  .annotate(Tool.OpenWorld, false)
+  .annotate(McpSchema.EnabledWhen, McpInvocationContext.hiddenFromOutsideClients)
+  // Claude Code defers MCP tools behind ToolSearch; Anthropic says to declare this from the first request.
+  .annotate(Tool.Meta, { "anthropic/alwaysLoad": true });
+
+export const PicksToolkit = Toolkit.make(RequestPicksTool);
