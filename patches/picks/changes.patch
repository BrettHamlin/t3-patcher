+type KeyOptions = Partial<Omit<Parameters<typeof pickerKeyAction>[0], "key">>;
+
+const key = (pressed: string, options: KeyOptions = {}) =>
+  pickerKeyAction({
+    key: pressed,
+    optionCount: 3,
+    allowTie: true,
+    noteFocused: false,
+    mod: false,
+    modified: false,
+    shift: false,
+    repeat: false,
+    flip: false,
+    video: false,
+    ...options,
+  });
+
+describe("pickerKeyAction", () => {
+  it("maps the picker's keys to what they do", () => {
+    expect(
+      ["1", "2", "3", "4", "0", "n", "N", "u", "U", "ArrowLeft", "ArrowRight", "?", "x", " "].map(
+        (k) => key(k),
+      ),
+    ).toEqual([
+      { type: "choose", choice: 0 },
+      { type: "choose", choice: 1 },
+      { type: "choose", choice: 2 },
+      null,
+      { type: "choose", choice: "tie" },
+      { type: "focus-note" },
+      { type: "focus-note" },
+      { type: "next-unanswered" },
+      { type: "next-unanswered" },
+      { type: "move", delta: -1 },
+      { type: "move", delta: 1 },
+      { type: "toggle-shortcuts" },
+      null,
+      null,
+    ]);
+  });
+
+  it("offers no tie when the batch allows none, and no keys past the options", () => {
+    expect([key("0", { allowTie: false }), key("3", { optionCount: 2 })]).toEqual([null, null]);
+  });
+
+  it("lets the note take typing until Escape or Enter, and ignores shortcuts with modifiers", () => {
+    expect([
+      key("1", { noteFocused: true }),
+      key("?", { noteFocused: true }),
+      key("ArrowLeft", { noteFocused: true }),
+      key("Escape", { noteFocused: true }),
+      key("Enter", { noteFocused: true }),
+      key("Enter", { noteFocused: true, shift: true }),
+      key("1", { modified: true }),
+      key("1", { mod: true }),
+    ]).toEqual([
+      null,
+      null,
+      null,
+      { type: "leave-note" },
+      { type: "leave-note" },
+      null,
+      null,
+      null,
+    ]);
+  });
+
+  it("sends with the send modifier and Enter, from the note too, and never on plain Enter", () => {
+    expect([
+      key("Enter", { mod: true }),
+      key("Enter", { mod: true, noteFocused: true }),
+      key("Enter"),
+      key("Enter", { mod: true, modified: true }),
+      key("Enter", { mod: true, shift: true }),
+    ]).toEqual([{ type: "send" }, { type: "send" }, null, null, null]);
+  });
+
+  it("opens the last answered question's note with Shift+N, toggles blink/loupe with B and Z, and flips with F and Shift+F", () => {
+    expect([
+      key("N", { shift: true }),
+      key("b", { canBlink: true }),
+      key("b", { canBlink: false }),
+      key("B", { canBlink: true, shift: true }),
+      key("z", { canLoupe: true }),
+      key("z", { canLoupe: false }),
+      key("Z", { canLoupe: true, shift: true }),
+      key("f", { flip: true }),
+      key("F", { flip: true, shift: true }),
+      key("f"),
+      key("F", { shift: true }),
+      key("?", { shift: true }),
+    ]).toEqual([
+      { type: "note-last-answered" },
+      { type: "toggle-blink" },
+      null,
+      null,
+      { type: "toggle-loupe" },
+      null,
+      null,
+      { type: "flip", delta: 1 },
+      { type: "flip", delta: -1 },
+      null,
+      null,
+      { type: "toggle-shortcuts" },
+    ]);
+  });
+
+  it("drives videos with Space, S, R, comma and period only on a video question", () => {
+    const keys = [" ", "s", "r", ",", "."];
+    expect(keys.map((k) => key(k, { video: true }))).toEqual([
+      { type: "play-pause" },
+      { type: "half-speed" },
+      { type: "replay" },
+      { type: "step", delta: -1 },
+      { type: "step", delta: 1 },
+    ]);
+    expect(keys.map((k) => key(k))).toEqual([null, null, null, null, null]);
+    expect([
+      key(" ", { video: true, controlFocused: true }),
+      key("s", { video: true, controlFocused: true }),
+    ]).toEqual([null, { type: "half-speed" }]);
+  });
+
+  it("ignores keys during IME composition, including Enter and Escape in the note", () => {
+    expect([
+      key("Enter", { noteFocused: true, composing: true }),
+      key("Escape", { noteFocused: true, composing: true }),
+      key("Enter", { mod: true, composing: true }),
+      key("1", { composing: true }),
+    ]).toEqual([null, null, null, null]);
+  });
+
+  it("acts once on a held key, except arrows and frame steps, which repeat", () => {
+    const once = ["1", "0", "n", "u", "f", "r", "s", " ", "?", "Enter"];
+    expect(
+      once.map((k) => key(k, { repeat: true, flip: true, video: true, mod: k === "Enter" })),
+    ).toEqual(once.map(() => null));
+    expect(
+      ["ArrowLeft", "ArrowRight", ",", "."].map((k) => key(k, { repeat: true, video: true })),
+    ).toEqual([
+      { type: "move", delta: -1 },
+      { type: "move", delta: 1 },
+      { type: "step", delta: -1 },
+      { type: "step", delta: 1 },
+    ]);
+  });
+
+  it("uses Escape only to leave the note, steps radios on arrows when a radio has focus, and pans the loupe with Shift+arrows", () => {
+    expect([
+      key("Escape"),
+      key("Escape", { noteFocused: true }),
+      key("ArrowRight", { radioFocused: true }),
+      key("ArrowLeft", { radioFocused: true }),
+      key("ArrowDown", { radioFocused: true }),
+      key("ArrowUp", { radioFocused: true }),
+      key("ArrowRight", { shift: true, loupe: true, repeat: true }),
+      key("ArrowUp", { shift: true, loupe: true }),
+      key("ArrowRight", { shift: true, loupe: false }),
+    ]).toEqual([
+      null,
+      { type: "leave-note" },
+      { type: "step-radio", delta: 1 },
+      { type: "step-radio", delta: -1 },
+      { type: "step-radio", delta: 1 },
+      { type: "step-radio", delta: -1 },
+      { type: "pan-loupe", du: 0.05, dv: 0 },
+      { type: "pan-loupe", du: 0, dv: -0.05 },
+      null,
+    ]);
+  });
+});
+
+describe("moving between questions", () => {
+  it("moves one question at a time and stays inside the batch", () => {
+    expect([movedQuestion(0, -1, 3), movedQuestion(1, 1, 3), movedQuestion(2, 1, 3)]).toEqual([
+      0, 2, 2,
+    ]);
+  });
+
+  it("finds the next blank after a question, wrapping past the end, and none when all are done", () => {
+    const answers = [undefined, { choice: 0 }, undefined, { choice: 1 }];
+    expect([
+      nextUnanswered(answers, 0),
+      nextUnanswered(answers, 2),
+      nextUnanswered(answers, 3),
+      nextUnanswered([{ choice: 0 }, undefined], 1),
+      nextUnanswered([{ choice: 0 }, { choice: 1 }], 0),
+      firstUnanswered(answers),
