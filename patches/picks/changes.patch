+import { McpSchema, McpServer } from "effect/ai";
+
+import * as ServerConfig from "../config.ts";
+import * as McpHttpServer from "../mcp/McpHttpServer.ts";
+import * as McpInvocationContext from "../mcp/McpInvocationContext.ts";
+import { CodexProviderCapabilitiesV2 } from "../orchestration-v2/Adapters/CodexAdapterV2.ts";
+import * as CommandReceiptStore from "../orchestration-v2/CommandReceiptStore.ts";
+import * as EventSink from "../orchestration-v2/EventSink.ts";
+import * as Orchestrator from "../orchestration-v2/Orchestrator.ts";
+import * as ProjectionStore from "../orchestration-v2/ProjectionStore.ts";
+import * as ProviderAdapterRegistry from "../orchestration-v2/ProviderAdapterRegistry.ts";
+import * as ThreadManagement from "../orchestration-v2/ThreadManagementService.ts";
+import { projectTurnItemForWire } from "../orchestration-v2/WireProjection.ts";
+import * as ProviderReplayHarness from "../orchestration-v2/testkit/ProviderReplayHarness.ts";
+import * as SqlitePersistence from "../persistence/Sqlite.ts";
+import * as ServerSettings from "../serverSettings.ts";
+import * as ProviderAdapter from "@t3tools/provider-core/server/ProviderAdapter";
+import * as ProviderContinuationRequests from "@t3tools/provider-core/server/ProviderContinuationRequests";
+import * as PickRequests from "./PickRequests.ts";
+
+// The agent's call goes through the real toolkit and orchestrator; the user's
+// answers go through PickRequests, as the inbox's RPCs do.
+
+const instanceId = ProviderInstanceId.make("codex");
+const driver = ProviderDriverKind.make("codex");
+const modelSelection = { instanceId, model: "gpt-5.4" };
+const threadId = ThreadId.make("thread:picks");
+const runId = RunId.make("run:picks");
+const rootNode = NodeId.make("node:picks:root");
+
+const adapter = ProviderAdapter.ProviderAdapterV2.of({
+  instanceId,
+  driver,
+  getCapabilities: () => Effect.succeed(CodexProviderCapabilitiesV2),
+  planSelectionTransition: () => Effect.succeed({ type: "apply_on_next_turn" }),
+  openSession: () => Effect.die("No provider process needed"),
+});
+
+const mcpClient = McpSchema.McpServerClient.of({
+  clientId: 1,
+  protocolVersion: "2025-06-18",
+  clientCapabilities: {},
+  clientInfo: { name: "pick-requests", version: "1" },
+  initializePayload: {
+    protocolVersion: "2025-06-18",
+    capabilities: {},
+    clientInfo: { name: "pick-requests", version: "1" },
+  },
+  getClient: Effect.die("unused"),
+});
+
+const scope: McpInvocationContext.McpInvocationScope = {
+  environmentId: EnvironmentId.make("environment:picks"),
+  requestNamespace: "provider-session:picks",
+  thread: {
+    threadId,
+    providerSessionId: "provider-session:picks",
+    providerInstanceId: instanceId,
+  },
+  client: undefined,
+  capabilities: new Set(["orchestration"]),
+  issuedAt: 1,
+};
+
+/** Repeatable "random" bytes, so the shuffle is the same on every run. */
+const seededBytes = (seed: number) => {
+  let state = seed;
+  return (size: number) => {
+    const bytes = new Uint8Array(size);
+    for (let index = 0; index < size; index += 1) {
+      state = (Math.imul(state, 1103515245) + 12345) >>> 0;
+      bytes[index] = state >>> 24;
+    }
+    return bytes;
+  };
+};
+
+const makeHarness = Effect.gen(function* () {
+  const database = yield* SqlitePersistence.layerMemory.pipe(Layer.build);
+  const layerDatabase = Layer.succeedContext(database);
+  const layerOrchestrator = Layer.mergeAll(
+    layerDatabase,
+    ProjectionStore.layer.pipe(Layer.provide(layerDatabase)),
+    ProviderReplayHarness.layerWithRegistry(
+      { name: "pick-requests" },
+      ProviderAdapterRegistry.layerFromAdapters([adapter]),
+      { databaseLayer: layerDatabase, runEffectWorker: false },
+    ),
+  ).pipe(
+    Layer.provide(
+      Layer.succeed(ProviderContinuationRequests.ProviderContinuationRequests, {
+        offer: () => Effect.void,
+        take: Effect.never,
+      }),
+    ),
+  );
+  const layerThreads = ThreadManagement.layer.pipe(
+    Layer.provide(CommandReceiptStore.layer.pipe(Layer.provide(layerDatabase))),
+    Layer.provideMerge(Layer.merge(layerOrchestrator, ServerSettings.layerTest())),
+  );
+  const layerConfig = ServerConfig.layerTest(process.cwd(), { prefix: "t3-pick-requests-" }).pipe(
+    Layer.provide(NodeServices.layer),
+  );
+  const here = yield* McpHttpServer.layerPicksToolkit.pipe(
+    Layer.provideMerge(McpHttpServer.layerInProcessMcpServer),
+    Layer.provideMerge(PickRequests.layer),
+    Layer.provide(
+      Layer.succeed(SecureRandom.SecureRandom, SecureRandom.make(seededBytes(20261124))),
+    ),
+    Layer.provideMerge(layerThreads),
+    Layer.provideMerge(layerConfig),
+    Layer.provideMerge(NodeServices.layer),
+    Layer.fresh,
+    Layer.build,
+  );
+  const server = Context.get(here, McpServer.McpServer);
+  const fs = Context.get(here, FileSystem.FileSystem);
+  const path = Context.get(here, Path.Path);
+  const media = yield* fs.makeTempDirectoryScoped({ prefix: "t3-picks-media-" });
+  const file = (name: string, content: string) =>
+    fs.writeFileString(path.join(media, name), content).pipe(Effect.as(path.join(media, name)));
