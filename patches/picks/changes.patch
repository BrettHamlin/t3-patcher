--- /dev/null
+++ b/packages/client-runtime/src/state/picks.ts
@@ -0,0 +1,55 @@
+import { WS_METHODS } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import { Atom } from "effect/reactivity";
+
+import type { EnvironmentRegistry } from "../connection/registry.ts";
+import { createEnvironmentRpcCommand, createEnvironmentRpcQueryAtomFamily } from "./runtime.ts";
+
+/** Agents ask for picks without telling clients, so the open list is read again now and then. */
+const PICKS_LIST_REFRESH_MS = 15_000;
+
+export function createPicksEnvironmentAtoms<R, E>(
+  runtime: Atom.AtomRuntime<EnvironmentRegistry | R, E>,
+) {
+  const list = createEnvironmentRpcQueryAtomFamily(runtime, {
+    label: "environment-data:picks:list",
+    tag: WS_METHODS.picksList,
+    staleTimeMs: 5_000,
+    refreshIntervalMs: PICKS_LIST_REFRESH_MS,
+  });
+  // Read again on every open: another window, or this one before, may have answered since.
+  const get = createEnvironmentRpcQueryAtomFamily(runtime, {
+    label: "environment-data:picks:get",
+    tag: WS_METHODS.picksGet,
+    staleTimeMs: 0,
+  });
+  return {
+    list,
+    get,
+    answer: createEnvironmentRpcCommand(runtime, {
+      label: "environment-data:picks:answer",
+      tag: WS_METHODS.picksAnswer,
+      onSuccess: ({ environmentId, input }, registry) =>
+        Effect.sync(() => {
+          registry.refresh(list({ environmentId, input: {} }));
+          registry.refresh(
+            get({ environmentId, input: { threadId: input.threadId, batchId: input.batchId } }),
+          );
+        }),
+    }),
+    complete: createEnvironmentRpcCommand(runtime, {
+      label: "environment-data:picks:complete",
+      tag: WS_METHODS.picksComplete,
+      concurrency: {
+        mode: "singleFlight",
+        key: ({ environmentId, input }) =>
+          JSON.stringify([environmentId, input.threadId, input.batchId]),
+      },
+      onSuccess: ({ environmentId, input }, registry) =>
+        Effect.sync(() => {
+          registry.refresh(list({ environmentId, input: {} }));
+          registry.refresh(get({ environmentId, input }));
+        }),
+    }),
+  };
+}
