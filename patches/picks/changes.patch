+  readonly optionsRootRef: RefObject<HTMLDivElement | null>;
+  readonly place: number;
+  readonly u: number;
+  readonly v: number;
+  readonly zoom: number;
+  readonly pixelated: boolean;
+  readonly docked: boolean;
+  readonly compactGap?: boolean | undefined;
+  readonly sizeOverride?: number | undefined;
+  readonly stageWidth: number;
+  readonly stageHeight: number;
