+  >
+> = {
+  png: { kind: "image", mimeType: "image/png", stored: "png" },
+  apng: { kind: "image", mimeType: "image/png", stored: "png" },
+  jpg: { kind: "image", mimeType: "image/jpeg", stored: "jpg" },
