+import * as Effect from "effect/Effect";
+
+import * as PickRequests from "../../../picks/PickRequests.ts";
+import * as McpInvocationContext from "../../McpInvocationContext.ts";
+import * as McpToolAccess from "../../McpToolAccess.ts";
+import { PicksToolkit } from "./tools.ts";
+
+const handlers = {
+  request_picks: McpToolAccess.actsAsCaller((input) =>
+    Effect.gen(function* () {
+      const scope = yield* McpInvocationContext.McpInvocationContext;
+      const picks = yield* PickRequests.PickRequests;
+      return yield* picks.request(scope, input);
+    }),
+  ),
+} satisfies McpToolAccess.Handlers<typeof PicksToolkit.tools>;
+
+export const layer = McpToolAccess.toLayer(PicksToolkit, handlers);
