diff --git a/apps/web/src/components/picks/PickBatchGate.tsx b/apps/web/src/components/picks/PickBatchGate.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..508221dacc57c90d9a1bb5a3f93ca3dbf2b60adf
--- /dev/null
+++ b/apps/web/src/components/picks/PickBatchGate.tsx
@@ -0,0 +1,66 @@
+import type { PickSaveQueue } from "@t3tools/client-runtime/picks";
+import { useGT } from "gt-react";
+import { type ReactNode, Suspense, use, useState } from "react";
+
+import { Skeleton } from "../ui/skeleton";
+
+const STILL_SAVING_AFTER_MS = 10_000;
+
+/**
+ * Holds a reopened batch until every save and Done queued for it has landed, then asks for a
+ * fresh read and passes on when it opened. For display only: the queue keeps saves in order
+ * whatever this shows, so after a while it opens anyway and says they are still saving.
+ */
+export function PickBatchGate(props: {
+  readonly saveQueue: PickSaveQueue;
+  readonly onSettled: () => void;
+  readonly children: (openedAt: number) => ReactNode;
+  readonly stillSavingAfterMs?: number;
+}) {
+  const gt = useGT();
+  // Made once per mount, outside the boundary that waits on it, so waiting can't remake it.
+  const [opened] = useState(() => {
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    const timedOut = new Promise<boolean>((resolve) => {
+      timer = setTimeout(() => resolve(true), props.stillSavingAfterMs ?? STILL_SAVING_AFTER_MS);
+    });
+    return Promise.race([props.saveQueue.settled().then(() => false), timedOut]).then(
+      (stillSaving) => {
+        clearTimeout(timer);
+        const openedAt = Date.now();
+        props.onSettled();
+        return { openedAt, stillSaving };
+      },
+    );
+  });
+  return (
+    <Suspense
+      fallback={
+        <div className="flex flex-col gap-2 p-6">
+          <p className="text-sm text-muted-foreground">{gt("Saving…")}</p>
+          <Skeleton className="h-96" />
+        </div>
+      }
+    >
+      <PickBatchOpened opened={opened}>{props.children}</PickBatchOpened>
+    </Suspense>
+  );
+}
+
+function PickBatchOpened(props: {
+  readonly opened: Promise<{ readonly openedAt: number; readonly stillSaving: boolean }>;
+  readonly children: (openedAt: number) => ReactNode;
+}) {
+  const gt = useGT();
+  const { openedAt, stillSaving } = use(props.opened);
+  return (
+    <>
+      {stillSaving ? (
+        <p role="status" className="px-6 pt-4 text-sm text-muted-foreground">
+          {gt("Earlier answers are still saving…")}
+        </p>
+      ) : null}
+      {props.children(openedAt)}
+    </>
+  );
+}
diff --git a/apps/web/src/components/picks/PickMedia.tsx b/apps/web/src/components/picks/PickMedia.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..9e768eaea03dc0fe1edd70a15af3151244c095ad
--- /dev/null
+++ b/apps/web/src/components/picks/PickMedia.tsx
@@ -0,0 +1,105 @@
+import { useGT } from "gt-react";
+import { type CSSProperties, useState } from "react";
+
+import { useStableCallback } from "~/hooks/useStableCallback";
+import { cn } from "~/lib/utils";
+
+/** An option's media once it can show: its natural size, and the element when it's a video. */
+export type PickMediaReady =
+  | {
+      readonly _tag: "Loaded";
+      readonly width: number;
+      readonly height: number;
+      readonly video: HTMLVideoElement | null;
+    }
+  | { readonly _tag: "Failed" };
+
+export interface PickMediaElementProps {
+  /** The media's URL, or null when it couldn't be resolved. */
+  readonly url: string | null;
+  readonly kind: "image" | "video";
+  readonly label: string;
+  /** `fit` shows media at its own size, scaled down to the stage and never up; `exact` fills it. */
+  readonly fit: "fit" | "exact";
+  readonly pixelated: boolean;
+  /** At default size, the longest side every option is drawn at, so options match; null till known. */
+  readonly longSide: number | null;
+  readonly onReady: (ready: PickMediaReady) => void;
+}
+
+/**
+ * One option's picture or clip. Videos have no controls and never autoplay: the picker starts
+ * every clip of a question together once all can play.
+ */
+export function PickMediaElement({
+  url,
+  kind,
+  label,
+  fit,
+  pixelated,
+  longSide,
+  onReady,
+}: PickMediaElementProps) {
+  const gt = useGT();
+  const [failedUrl, setFailedUrl] = useState<string | null>(null);
+  const fail = () => {
+    setFailedUrl(url);
+    onReady({ _tag: "Failed" });
+  };
+  // Reported from the ref so a URL that never resolved still counts as ready, once.
+  const reportUnresolved = useStableCallback((node: HTMLParagraphElement | null) => {
+    if (node !== null && url === null) onReady({ _tag: "Failed" });
+  });
+  if (url === null || failedUrl === url) {
+    return (
+      <p ref={reportUnresolved} className="p-2 text-center text-xs text-white/70">
+        {gt("Couldn't load this option")}
+      </p>
+    );
+  }
+  const style: CSSProperties = {
+    ...(pixelated ? { imageRendering: "pixelated" } : {}),
+    ...(fit === "fit" && longSide !== null ? { maxWidth: longSide, maxHeight: longSide } : {}),
+  };
+  const className =
+    fit === "exact" ? "size-full object-contain" : "max-h-full max-w-full object-scale-down";
+  return kind === "video" ? (
+    <video
+      src={url}
+      aria-label={label}
+      muted
+      playsInline
+      loop
+      preload="auto"
+      disablePictureInPicture
+      onCanPlay={(event) =>
+        onReady({
+          _tag: "Loaded",
+          width: event.currentTarget.videoWidth,
+          height: event.currentTarget.videoHeight,
+          video: event.currentTarget,
+        })
+      }
+      onError={fail}
+      className={cn("pointer-events-none", className)}
+      style={style}
+    />
+  ) : (
+    <img
+      src={url}
+      alt={label}
+      draggable={false}
+      onLoad={(event) =>
+        onReady({
+          _tag: "Loaded",
+          width: event.currentTarget.naturalWidth,
+          height: event.currentTarget.naturalHeight,
+          video: null,
+        })
+      }
+      onError={fail}
+      className={cn("pointer-events-none", className)}
+      style={style}
+    />
+  );
+}
