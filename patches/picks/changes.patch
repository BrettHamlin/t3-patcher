+/** Every problem with the batch's ids, in order, so one call fixes them all. */
+function pickIdProblems(input: PicksRequestInput): ReadonlyArray<string> {
+  const problems: Array<string> = [];
+  const questionIds = new Set<string>();
+  for (const question of input.questions) {
+    if (questionIds.has(question.id)) problems.push(`Question id "${question.id}" is repeated.`);
+    questionIds.add(question.id);
+    const optionIds = new Set<string>();
+    for (const option of question.options) {
+      if (option.id === PICK_TIE) {
+        problems.push(`Question "${question.id}": "${PICK_TIE}" is reserved; rename the option.`);
+      } else if (optionIds.has(option.id)) {
+        problems.push(`Question "${question.id}": option id "${option.id}" is repeated.`);
+      }
+      optionIds.add(option.id);
+    }
+  }
+  return problems;
+}
