diff --git a/apps/web/src/routes/_chat.picks.tsx b/apps/web/src/routes/_chat.picks.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..6f363a4575d7397c81dec58325f2aab2a02c15a6
--- /dev/null
+++ b/apps/web/src/routes/_chat.picks.tsx
@@ -0,0 +1,24 @@
+import { EnvironmentId, ThreadId, TurnItemId } from "@t3tools/contracts";
+import { createFileRoute } from "@tanstack/react-router";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+
+import { PicksPage, type PicksSearch } from "../components/picks/PicksPage";
+
+const decodeEnvironmentId = Schema.decodeUnknownOption(EnvironmentId);
+const decodeThreadId = Schema.decodeUnknownOption(ThreadId);
+const decodeTurnItemId = Schema.decodeUnknownOption(TurnItemId);
+
+export const Route = createFileRoute("/_chat/picks")({
+  validateSearch: (raw: Record<string, unknown>): PicksSearch => {
+    const environmentId = Option.getOrUndefined(decodeEnvironmentId(raw.environmentId));
+    const threadId = Option.getOrUndefined(decodeThreadId(raw.threadId));
+    const batchId = Option.getOrUndefined(decodeTurnItemId(raw.batchId));
+    return {
+      ...(environmentId === undefined ? {} : { environmentId }),
+      ...(threadId === undefined ? {} : { threadId }),
+      ...(batchId === undefined ? {} : { batchId }),
+    };
+  },
+  component: PicksPage,
+});
