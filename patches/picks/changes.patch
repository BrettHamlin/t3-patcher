+    picks: Context.get(here, PickRequests.PickRequests),
+    orchestrator: Context.get(here, Orchestrator.OrchestratorV2),
+    sink: Context.get(here, EventSink.EventSinkV2),
+    projections: Context.get(here, ProjectionStore.ProjectionStoreV2),
+    sql: Context.get(database, SqlClient.SqlClient),
+    attachmentsDir: Context.get(here, ServerConfig.ServerConfig).attachmentsDir,
+    fs,
+    path,
+    files: {
+      real: yield* file("real.png", "png:real"),
+      fake: yield* file("fake.png", "png:fake"),
+      clip: yield* file("clip.webm", "webm:clip"),
+      notes: yield* file("notes.txt", "text"),
+    },
+    call: (args: Record<string, unknown>) =>
+      server
+        .callTool({ name: "request_picks", arguments: args })
+        .pipe(
+          Effect.provideService(McpInvocationContext.McpInvocationContext, scope),
+          Effect.provideService(McpSchema.McpServerClient, mcpClient),
+        ),
+  };
+});
