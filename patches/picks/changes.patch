+const batchOf = (h: Harness) =>
+  h.orchestrator
+    .getThreadProjection(threadId)
+    .pipe(
+      Effect.map((projection) =>
+        projection.turnItems.flatMap((item) => (item.type === "pick_request" ? [item] : [])),
+      ),
+    );
+
+/** The notifications the thread received: what the agent reads. */
+const wakeMessages = (h: Harness) =>
+  h.orchestrator
+    .getThreadProjection(threadId)
+    .pipe(
+      Effect.map((projection) =>
+        projection.messages
+          .filter((message) => message.notification !== undefined)
+          .map((message) => ({ text: message.text, notification: message.notification })),
+      ),
+    );
+
+const errorText = (result: McpSchema.CallToolResult) => {
+  const text = result.content[0];
+  return result.isError === true && text?.type === "text" ? JSON.parse(text.text) : undefined;
+};
+
+const twoQuestions = (h: Harness) => ({
+  title: "Real person, round 3",
+  questions: [
+    {
+      id: "face-01",
+      prompt: "Which looks more like a real person?",
+      options: [
