+// The batches the picks journey's agent asks for, and what it says once it has the answers.
+import * as NodePath from "node:path";
+
+const MEDIA = NodePath.join(import.meta.dirname, "picks");
+const media = (name) => NodePath.join(MEDIA, name);
+export const PICKS_TITLE = "Journey picks";
+export const FRAME_PICKS_TITLE = "Frame picks";
+export const PICKS_REPLY = "Thanks, I read the picks:";
+
+/** The batch the journey answers and sends: default sizes for 2 and 4 options, and video. */
+export const PICKS_BATCH = {
+  title: PICKS_TITLE,
+  clientRequestId: "journey-picks",
+  questions: [
+    {
+      id: "face",
+      prompt: "Which looks more like a real person?",
+      guidance: "Judge at the size shown.",
+      options: [
+        { id: "mandelbrot", path: media("face-a.png") },
+        { id: "gradient", path: media("face-b.png") },
+      ],
+    },
+    {
+      id: "icon",
+      prompt: "Which icon reads best?",
+      options: [
+        { id: "cells", path: media("icon-a.png") },
+        { id: "bars", path: media("icon-b.png") },
+        { id: "smpte", path: media("icon-c.png") },
+        { id: "square", path: media("icon-d.png") },
+      ],
+    },
+    {
+      id: "walk",
+      prompt: "Which walk cycle moves more naturally?",
+      display: { width: 160, height: 160, pixelated: true },
+      options: [
+        { id: "testsrc", path: media("walk-a.webm") },
+        { id: "testsrc2", path: media("walk-b.webm") },
+      ],
+    },
+  ],
+};
+
+/** The batch the journey answers and leaves unsent: an exact box too wide to show side by side. */
+export const FRAME_PICKS_BATCH = {
+  title: FRAME_PICKS_TITLE,
+  clientRequestId: "journey-frame-picks",
+  questions: [
+    {
+      id: "frame",
+      prompt: "Which game frame looks right?",
+      guidance: "Judge it in the 640x480 game frame at 1x.",
+      display: { width: 640, height: 480 },
+      options: [
+        { id: "smpte", path: media("frame-a.png") },
+        { id: "pal", path: media("frame-b.png") },
+      ],
+    },
+    {
+      id: "sprite",
+      prompt: "Which sprite reads better at use size?",
+      display: { width: 96, height: 96, pixelated: true },
+      options: [
+        { id: "cellauto", path: media("sprite-a.png") },
+        { id: "life", path: media("sprite-b.png") },
+      ],
+    },
+  ],
+};
