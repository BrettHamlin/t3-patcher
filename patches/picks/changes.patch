+interface PlaybackStore {
+  readonly getSnapshot: () => Playback;
+  readonly subscribe: (listener: () => void) => () => void;
+  readonly set: (next: Playback) => void;
+}
+
+const samePlaybackPosition = (left: Playback["position"], right: Playback["position"]): boolean => {
+  if (left === right) return true;
+  if (left === null || right === null || left._tag !== right._tag) return false;
+  if (left._tag === "Frame" && right._tag === "Frame") {
+    return left.current === right.current && left.total === right.total;
+  }
+  if (left._tag === "Seconds" && right._tag === "Seconds") {
+    return (
+      left.mixedRates === right.mixedRates &&
+      left.current.toFixed(2) === right.current.toFixed(2) &&
+      left.total.toFixed(2) === right.total.toFixed(2)
+    );
+  }
+  return false;
+};
+
+function createPlaybackStore(): PlaybackStore {
+  let current: Playback = {
+    visit: 0,
+    paused: false,
+    half: false,
+    canStep: false,
+    position: null,
+  };
+  const listeners = new Set<() => void>();
+  return {
+    getSnapshot: () => current,
+    subscribe: (listener) => {
+      listeners.add(listener);
+      return () => {
+        listeners.delete(listener);
+      };
+    },
+    set: (next) => {
+      if (
+        current.visit === next.visit &&
+        current.paused === next.paused &&
+        current.half === next.half &&
+        current.canStep === next.canStep &&
+        samePlaybackPosition(current.position, next.position)
+      ) {
+        return;
+      }
+      current = next;
+      for (const listener of listeners) listener();
+    },
+  };
