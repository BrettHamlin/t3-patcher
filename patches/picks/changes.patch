+        { id: "gpt", path: h.files.fake },
+        { id: "clip", path: h.files.clip },
+      ],
+    },
+  ],
+});
+
+const scoped = <A, E>(body: (h: Harness) => Effect.Effect<A, E, Scope.Scope>) =>
+  Effect.scoped(Effect.flatMap(makeHarness, body));
+
