+    indent,
+  );
+const full = [
+  'The user answered the picks "Round": 2 of 2 questions.',
+  "",
+  "- q1 → a",
+  "- q2 → tie (can't tell). Note: same",
+  "",
+  "```json",
+  json(2),
+  "```",
+].join("\n");
+const compact = [
+  'The user answered the picks "Round": 2 of 2 questions.',
+  "",
+  "```json",
+  json(),
+  "```",
+].join("\n");
+const notification = {
+  source: { kind: "background_task" },
+  outcome: "completed",
+  summary: "Answers to picks: Round",
+};
+
+describe("pickRequestWake", () => {
+  it("lists every answer and the same as JSON, then JSON alone past the limit, then nothing", () => {
+    expect([
+      pickRequestWake(batch, full.length),
+      pickRequestWake(batch, full.length - 1),
+      pickRequestWake(batch, compact.length - 1),
+    ]).toEqual([{ text: full, notification }, { text: compact, notification }, undefined]);
+  });
+});
diff --git a/apps/server/src/picks/pickWake.ts b/apps/server/src/picks/pickWake.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2bfd06865139c3402d6e8ed608b97cf2e68c35db
--- /dev/null
+++ b/apps/server/src/picks/pickWake.ts
@@ -0,0 +1,58 @@
+import {
+  type OrchestrationV2Notification,
+  PICK_TIE,
+  PROVIDER_SEND_TURN_MAX_INPUT_CHARS,
+  type PickAnswers,
+  type PickStoredQuestion,
+} from "@t3tools/contracts";
+
+/**
+ * The one message that tells the agent every answer, unblinded: a line per
+ * question for reading, and the same answers as JSON for parsing. Past the
+ * provider's message limit it carries the JSON alone, compact; when even that
+ * is too long it is `undefined`, and the batch must not close.
+ */
+export function pickRequestWake(
+  batch: {
+    readonly batchId: string;
+    readonly title: string;
+    readonly questions: ReadonlyArray<PickStoredQuestion>;
+    readonly answers: PickAnswers;
+  },
+  maxChars: number = PROVIDER_SEND_TURN_MAX_INPUT_CHARS,
+): { readonly text: string; readonly notification: OrchestrationV2Notification } | undefined {
+  const answers = batch.questions.flatMap((question) => {
+    const answer = batch.answers[question.id];
+    return answer === undefined
+      ? []
+      : [
+          {
+            questionId: question.id,
+            choice: answer.choice,
+            ...(answer.note === undefined ? {} : { note: answer.note }),
+          },
+        ];
+  });
+  const heading = `The user answered the picks "${batch.title}": ${answers.length} of ${batch.questions.length} questions.`;
+  const lines = answers.map(
+    (answer) =>
+      `- ${answer.questionId} → ${answer.choice === PICK_TIE ? "tie (can't tell)" : answer.choice}${
+        answer.note === undefined ? "" : `. Note: ${answer.note}`
+      }`,
+  );
+  const json = (indent?: number) =>
+    JSON.stringify({ batchId: batch.batchId, title: batch.title, answers }, null, indent);
+  const full = [heading, "", ...lines, "", "```json", json(2), "```"].join("\n");
+  const compact = [heading, "", "```json", json(), "```"].join("\n");
+  const text = full.length <= maxChars ? full : compact.length <= maxChars ? compact : undefined;
+  return text === undefined
+    ? undefined
+    : {
+        text,
+        notification: {
+          source: { kind: "background_task" },
+          outcome: "completed",
+          summary: `Answers to picks: ${batch.title}`,
+        },
+      };
+}
