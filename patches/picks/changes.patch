+  const mountCanvas = useStableCallback((canvas: HTMLCanvasElement | null) => {
+    if (canvas === null) {
+      drawRef.current = null;
+      return undefined;
+    }
+    const resolveSource = () => {
+      const stageNode = optionsRootRef.current?.querySelector<HTMLElement>(
+        `[data-testid="picker-stage-${place + 1}"]`,
+      );
+      return stageNode?.querySelector<HTMLImageElement | HTMLVideoElement>("img, video") ?? null;
+    };
+    let source = resolveSource();
+    const draw = () => {
+      if (source === null || !source.isConnected) {
+        source = resolveSource();
+      }
+      const curU = Number(canvas.dataset.u ?? 0.5);
+      const curV = Number(canvas.dataset.v ?? 0.5);
+      const curZoom = Number(canvas.dataset.zoom ?? 2.5);
+      const curPixelated = canvas.dataset.pixelated === "true";
+      const curSize = Number(canvas.dataset.size ?? 72);
