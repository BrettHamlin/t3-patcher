diff --git a/patcher/journeys/picks.mjs b/patcher/journeys/picks.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..0d002717464055ff89fb67484d96354bf0f89df2
--- /dev/null
+++ b/patcher/journeys/picks.mjs
@@ -0,0 +1,240 @@
+// Journey: an agent (fixtures/picks-agent.mjs, a provider in the journey's own T3 home) asks for two
+// batches of picks over the real MCP endpoint; the user answers one and leaves it unsent, answers
+// and sends the other with the keyboard, and the asking thread wakes with every answer.
+//   T3_PATCHER_APP=<built .app> T3_PATCHER_EVIDENCE=<dir> node patcher/journeys/picks.mjs
+import * as NodeChildProcess from "node:child_process";
+import * as NodeFS from "node:fs";
+import * as NodeOS from "node:os";
+import * as NodePath from "node:path";
+
+import { FRAME_PICKS_TITLE, PICKS_REPLY, PICKS_TITLE } from "./fixtures/picks-batch.mjs";
+import { FIXTURE_DB, STEP_TIMEOUT_MS, journey } from "./support.mjs";
+
+const repoRoot = NodePath.resolve(import.meta.dirname, "../..");
+const agent = NodePath.join(import.meta.dirname, "fixtures/picks-agent.mjs");
+const THREAD_TITLE = "Picks journey";
+
+// The journey's own T3 home, so the provider is in settings before the server starts.
+const parent = process.env.T3_PATCHER_TMP || process.env.TMPDIR || NodeOS.tmpdir();
+NodeFS.mkdirSync(parent, { recursive: true });
+const base = NodeFS.mkdtempSync(NodePath.join(parent, "t3-picks-"));
+const t3Home = NodePath.join(base, "t3");
+const workspace = NodePath.join(base, "workspace");
+NodeFS.mkdirSync(NodePath.join(t3Home, "userdata"), { recursive: true });
+NodeFS.copyFileSync(FIXTURE_DB, NodePath.join(t3Home, "userdata/statev2.sqlite"));
+NodeFS.writeFileSync(
+  NodePath.join(t3Home, "userdata/settings.json"),
+  JSON.stringify({
+    providerInstances: {
+      picksAgent: {
+        displayName: "Picks agent",
+        driver: "acpRegistry",
+        config: { source: "local", commandPath: process.execPath, commandArgs: [agent] },
+      },
+    },
+  }),
+);
+NodeFS.mkdirSync(workspace);
+NodeFS.writeFileSync(NodePath.join(workspace, "README.md"), "Picks journey\n");
+const git = (...args) =>
+  NodeChildProcess.execFileSync("git", args, { cwd: workspace, stdio: "ignore" });
+git("init", "--quiet", "--initial-branch=main");
+git("add", "--all");
+git("-c", "user.name=Journey", "-c", "user.email=journey@example.invalid", "commit", "-qm", "init");
+
+/** The server's own CLI, against the running app's T3 home. */
+function cli(...args) {
+  return NodeChildProcess.execFileSync(
+    process.execPath,
+    ["apps/server/src/bin.ts", ...args, "--base-dir", t3Home],
+    { cwd: repoRoot, encoding: "utf8", timeout: STEP_TIMEOUT_MS * 2 },
+  );
+}
+
+async function untilServerListens() {
+  const runtime = NodePath.join(t3Home, "userdata/server-runtime.json");
+  const deadline = Date.now() + STEP_TIMEOUT_MS;
+  while (!NodeFS.existsSync(runtime)) {
+    if (Date.now() > deadline) throw new Error("the app's server never wrote server-runtime.json");
+    await new Promise((resolve) => setTimeout(resolve, 250));
+  }
+}
+
+try {
+  await journey(
+    "picks",
+    async ({ app, page, screenshot }, step) => {
+      // The spec's window: every picker size is stated at 1100×780.
+      await app.evaluate(({ BrowserWindow }) => {
+        for (const window of BrowserWindow.getAllWindows()) window.setContentSize(1100, 780);
+      });
+      await page.waitForFunction(() => window.innerWidth === 1100 && window.innerHeight === 780);
+      const progress = page.getByTestId("picker-progress");
+      const status = page.getByTestId("picker-status");
+      const at = (number, total) =>
+        progress
+          .getByText(`Question ${number} of ${total}`, { exact: true })
+          .waitFor({ timeout: STEP_TIMEOUT_MS });
+      // Stages show once every option of the question has loaded; then all of them are drawn.
+      const stageShown = () =>
+        page.getByTestId("picker-stage-1").waitFor({ state: "visible", timeout: STEP_TIMEOUT_MS });
+      const settled = () =>
+        page.waitForFunction(
+          () =>
+            [...document.querySelectorAll("img")].every((image) => image.complete) &&
+            document.getAnimations().every((animation) => animation.playState !== "running"),
+          undefined,
+          { timeout: STEP_TIMEOUT_MS },
+        );
+      const toInbox = async () => {
+        await page.getByRole("link", { name: "Picks", exact: true }).click();
+        await page.getByTestId("picks-list").waitFor({ timeout: STEP_TIMEOUT_MS });
+      };
+      const row = (title) => page.getByTestId("picks-row").filter({ hasText: title });
+
+      step("waiting for the app's server");
+      await untilServerListens();
+      step("adding the workspace as a project");
+      cli("project", "add", workspace, "--title", "Picks");
+      step("starting a thread whose agent asks for two batches of picks");
+      const started = JSON.parse(
+        cli(
+          "thread",
+          "start",
+          workspace,
+          "Ask me for picks.",
+          "--title",
+          THREAD_TITLE,
+          "--provider",
+          "picksAgent",
+          "--model",
+          "default",
+          "--wait",
+          "--json",
+        ),
+      );
+      console.log(`thread ${started.threadId}`);
+
+      step("finding the waiting batches in the sidebar");
+      const picksButton = page.getByRole("button", { name: "Picks, 2 waiting" });
+      await picksButton.waitFor({ timeout: STEP_TIMEOUT_MS });
+      await picksButton.click();
+      await page.getByTestId("picks-list").waitFor({ timeout: STEP_TIMEOUT_MS });
+
+      step("opening the frame batch, whose 640×480 boxes don't fit side by side");
+      await row(FRAME_PICKS_TITLE).getByRole("link", { name: FRAME_PICKS_TITLE }).click();
+      await at(1, 2);
+      await stageShown();
+      await page
+        .getByTestId("picker-flip-status")
+        .getByText("Option 1 of 2", { exact: true })
+        .waitFor({ timeout: STEP_TIMEOUT_MS });
+      step("flipping to option 2");
+      await page.keyboard.press("f");
+      await page
+        .getByTestId("picker-flip-status")
+        .getByText("Option 2 of 2", { exact: true })
+        .waitFor({ timeout: STEP_TIMEOUT_MS });
+      await settled();
+      console.log(await screenshot("picks-flip"));
+      step("answering the frame batch and leaving it unsent");
+      await page.keyboard.press("2");
