diff --git a/apps/web/src/state/picks.ts b/apps/web/src/state/picks.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3c6ab942a049361c46ec3e5434e558c52022aac6
--- /dev/null
+++ b/apps/web/src/state/picks.ts
@@ -0,0 +1,50 @@
+import { useAtomValue } from "@effect/atom-react";
+import { createPicksEnvironmentAtoms } from "@t3tools/client-runtime/state/picks";
+import type { EnvironmentId, PicksBatchSummary } from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import { AsyncResult } from "effect/reactivity";
+
+import { connectionAtomRuntime } from "../connection/runtime";
+import { environmentAtomList, environmentIdsKey } from "./environmentAtomList";
+import { useEnvironments } from "./environments";
+
+export const picksEnvironment = createPicksEnvironmentAtoms(connectionAtomRuntime);
+
+const openPicksAtom = environmentAtomList("web-picks-list", (environmentId) =>
+  picksEnvironment.list({ environmentId, input: {} }),
+);
+
+export interface OpenPickBatch extends PicksBatchSummary {
+  readonly environmentId: EnvironmentId;
+  readonly environmentLabel: string;
+}
+
+/**
+ * Open batches on every connected environment, newest first. An environment
+ * whose server has no picks answers with an error, and lists nothing.
+ */
+export function useOpenPicks(): ReadonlyArray<OpenPickBatch> {
+  const { environments } = useEnvironments();
+  const connected = environments.filter(
+    (environment) =>
+      environment.connection.phase === "connected" && environment.serverConfig !== null,
+  );
+  const results = useAtomValue(
+    openPicksAtom(environmentIdsKey(connected.map((environment) => environment.environmentId))),
+  );
+  return connected
+    .flatMap((environment, index) => {
+      const result = results[index];
+      const batches =
+        result === undefined ? [] : (AsyncResult.getOrElse(result, () => null)?.batches ?? []);
+      return batches.map((batch) => ({
+        ...batch,
+        environmentId: environment.environmentId,
+        environmentLabel: environment.label,
+      }));
+    })
+    .toSorted(
+      (left, right) =>
+        DateTime.toEpochMillis(right.createdAt) - DateTime.toEpochMillis(left.createdAt),
+    );
+}
