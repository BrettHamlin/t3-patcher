+  readonly kind: "fit" | "exact";
+  readonly arrangement: "row" | "grid" | "flip";
+  readonly width: number;
+  readonly height: number;
+  /** Neutral `#2a2e36` mat padding on each side around the media box, so corners never clip. */
+  readonly mat: number;
+  readonly pixelated: boolean;
+  /** One box alone is bigger than the region, which then scrolls. */
+  readonly oversized: boolean;
+}
+
+const cardSize = (width: number, height: number, mat: number) => ({
+  width: width + 2 * mat + PICK_CARD_CHROME.width,
+  height: height + 2 * mat + PICK_CARD_CHROME.height,
+});
+
+const rowFits = (count: number, width: number, height: number, mat: number, region: PickRegion) => {
+  const card = cardSize(width, height, mat);
+  return (
+    count * card.width + PICK_CARD_GAP * (count - 1) <= region.width && card.height <= region.height
+  );
+};
+
+const gridFits = (
+  count: number,
+  width: number,
+  height: number,
+  mat: number,
+  region: PickRegion,
+) => {
+  const card = cardSize(width, height, mat);
+  return (
+    count >= 3 &&
+    2 * card.width + PICK_CARD_GAP <= region.width &&
+    2 * card.height + PICK_CARD_GAP <= region.height
+  );
+};
+
+export interface PickRegion {
+  readonly width: number;
+  readonly height: number;
+}
+
+const longestSide = (size: PickRegion) => Math.max(size.width, size.height);
+
+const positiveSizes = (sizes: ReadonlyArray<PickRegion | null>): ReadonlyArray<PickRegion> =>
+  sizes.filter((size): size is PickRegion => size !== null && size.width > 0 && size.height > 0);
+
+function fitInnerBox(cap: number, sizes: ReadonlyArray<PickRegion | null> | undefined): PickRegion {
+  if (sizes === undefined) return { width: cap, height: cap };
+  const loaded = positiveSizes(sizes);
+  if (loaded.length === 0) {
+    return { width: Math.min(cap, 192), height: Math.min(cap, 144) };
+  }
+  const side = Math.min(cap, ...loaded.map(longestSide));
+  const drawn = loaded.map((size) => {
+    const long = longestSide(size);
+    return {
+      width: Math.round((size.width * side) / long),
+      height: Math.round((size.height * side) / long),
+    };
+  });
+  const floor = Math.min(PICK_MIN_FIT_BOX, cap);
+  return {
+    width: Math.max(floor, ...drawn.map((box) => box.width)),
+    height: Math.max(floor, ...drawn.map((box) => box.height)),
+  };
+}
+
+/**
+ * How a question's options are laid out in the region between the prompt and the footer: one row
+ * when they fit, a 2×2 grid for 3 or 4 options, otherwise one at a time (flip). Adds a neutral
+ * `#2a2e36` mat around the media whenever that keeps the best arrangement without scrolling.
+ */
+export function pickStageLayout(input: {
+  readonly optionCount: number;
+  readonly display: PickDisplay | undefined;
+  readonly region: PickRegion;
+  readonly video: boolean;
+  readonly sizes?: ReadonlyArray<PickRegion | null> | undefined;
+  readonly forceFlip?: boolean | undefined;
+}): PickStageLayout {
+  const region = {
+    width: input.region.width,
+    height: input.region.height - (input.video ? PICK_PLAYBACK_ROW : 0),
+  };
+  const count = input.optionCount;
+  if (input.display === undefined) {
+    const largest = PICK_DEFAULT_STAGE[count] ?? 160;
+    const caps = PICK_STAGE_STEPS.filter((size) => size <= largest);
+    const rowCap = input.forceFlip
+      ? undefined
+      : caps.find((cap) => {
+          const box = fitInnerBox(cap, input.sizes);
+          return rowFits(count, box.width, box.height, 0, region);
+        });
+    const gridCap =
+      input.forceFlip || rowCap !== undefined || count < 3
+        ? undefined
+        : caps.find((cap) => {
+            const box = fitInnerBox(cap, input.sizes);
+            return gridFits(count, box.width, box.height, 0, region);
+          });
+    const aloneCap =
+      caps.find((cap) => {
+        const box = fitInnerBox(cap, input.sizes);
+        return rowFits(1, box.width, box.height, 0, region);
+      }) ??
+      caps.at(-1) ??
+      largest;
+    const size = rowCap ?? gridCap ?? aloneCap;
+    const arrangement = rowCap !== undefined ? "row" : gridCap !== undefined ? "grid" : "flip";
+    const box = fitInnerBox(size, input.sizes);
+    const mat =
+      PICK_FIT_MAT_STEPS.find((pad) =>
+        arrangement === "row"
+          ? rowFits(count, box.width, box.height, pad, region)
+          : arrangement === "grid"
+            ? gridFits(count, box.width, box.height, pad, region)
+            : rowFits(1, box.width, box.height, pad, region),
+      ) ?? 0;
+    return {
+      kind: "fit",
+      arrangement,
+      width: size,
+      height: size,
+      mat,
+      pixelated: false,
+      oversized: false,
+    };
+  }
+  const { width, height } = input.display;
+  const arrangement = input.forceFlip
+    ? "flip"
+    : rowFits(count, width, height, 0, region)
+      ? "row"
+      : gridFits(count, width, height, 0, region)
+        ? "grid"
+        : "flip";
+  const bare = cardSize(width, height, 0);
+  const oversized = bare.width > region.width || bare.height > region.height;
+  const mat = oversized
+    ? 0
+    : (PICK_MAT_STEPS.find((pad) =>
+        arrangement === "row"
+          ? rowFits(count, width, height, pad, region)
+          : arrangement === "grid"
+            ? gridFits(count, width, height, pad, region)
+            : rowFits(1, width, height, pad, region),
+      ) ?? 0);
+  return {
+    kind: "exact",
+    arrangement,
+    width,
+    height,
+    mat,
+    pixelated: input.display.pixelated === true,
+    oversized,
+  };
+}
+
+/** Where a candidate's rendered media sits inside its `stageWidth × stageHeight` stage box. */
+export function pickDrawnMediaRect(input: {
+  readonly natural: PickRegion | null | undefined;
+  readonly innerBox: PickRegion;
+  readonly layout: PickStageLayout;
+  readonly longSide: number | null;
+}): {
+  readonly left: number;
+  readonly top: number;
+  readonly width: number;
+  readonly height: number;
+} {
+  const { natural, innerBox, layout, longSide } = input;
+  if (natural === null || natural === undefined || natural.width <= 0 || natural.height <= 0) {
+    return {
+      left: layout.mat,
+      top: layout.mat,
+      width: innerBox.width,
+      height: innerBox.height,
+    };
+  }
+  const scale =
+    layout.kind === "exact"
+      ? Math.min(innerBox.width / natural.width, innerBox.height / natural.height)
+      : Math.min(
+          1,
+          (longSide === null ? innerBox.width : Math.min(innerBox.width, longSide)) / natural.width,
+          (longSide === null ? innerBox.height : Math.min(innerBox.height, longSide)) /
+            natural.height,
+        );
+  const width = natural.width * scale;
+  const height = natural.height * scale;
+  return {
+    left: layout.mat + (innerBox.width - width) / 2,
+    top: layout.mat + (innerBox.height - height) / 2,
+    width,
+    height,
+  };
+}
+
+/** What the size chip says: the agent's box, or how default-size media was drawn. */
+export type PickSizeChip =
+  | {
+      readonly _tag: "Exact";
+      readonly width: number;
+      readonly height: number;
+      readonly pixelated: boolean;
+      readonly oversized: boolean;
+    }
+  /** Every option has this natural size and is drawn at it. */
+  | { readonly _tag: "Actual"; readonly width: number; readonly height: number }
+  /** Every option has one natural size, scaled down to this drawn size. */
+  | { readonly _tag: "Scaled"; readonly width: number; readonly height: number }
+  /** Options differ in natural size and are all drawn at this one size. */
+  | { readonly _tag: "Matched"; readonly width: number; readonly height: number }
+  /** Options differ in shape: they share only their longest side. */
+  | { readonly _tag: "Mixed"; readonly side: number; readonly scaled: boolean };
+
+/**
+ * At default size, every option is drawn with this longest side: the stage's, or the smallest
+ * option's own if that is shorter, so options match and none is scaled up. Null for an exact
+ * box, or until some option's size is known.
+ */
+export function pickSharedSide(
+  layout: PickStageLayout,
+  sizes: ReadonlyArray<PickRegion | null> | undefined,
+): number | null {
+  if (layout.kind === "exact" || sizes === undefined) return null;
+  const loaded = positiveSizes(sizes);
+  if (loaded.length === 0) return null;
+  return Math.min(layout.width, ...loaded.map(longestSide));
+}
+
+/**
+ * The inner media box shared by every option card of the question (before adding `layout.mat`).
+ * Exact boxes keep their requested size; default-size options tighten around the largest drawn
+ * option so small images sit close together for side-by-side comparison instead of floating in a
+ * 480 px void, while keeping every card of the question the same size.
+ */
+export function pickStageBox(
+  layout: PickStageLayout,
+  sizes: ReadonlyArray<PickRegion | null> | undefined,
+): PickRegion {
+  if (layout.kind === "exact") {
+    return { width: layout.width, height: layout.height };
+  }
+  return fitInnerBox(layout.width, sizes);
+}
+
+/**
+ * The size chip, from the sizes options are drawn at (see `pickSharedSide`). `sizes` holds each
+ * option's natural size, null for one that failed; undefined until all are known. Never names a
+ * size no option is drawn at.
+ */
+export function pickSizeChip(
+  layout: PickStageLayout,
+  sizes: ReadonlyArray<PickRegion | null> | undefined,
+): PickSizeChip | null {
+  if (layout.kind === "exact") {
+    return {
+      _tag: "Exact",
+      width: layout.width,
+      height: layout.height,
+      pixelated: layout.pixelated,
+      oversized: layout.oversized,
+    };
+  }
+  const side = pickSharedSide(layout, sizes);
+  if (side === null || sizes === undefined) return null;
+  const loaded = positiveSizes(sizes);
+  const drawn = loaded.map((size) => {
+    const long = longestSide(size);
+    return {
+      width: Math.round((size.width * side) / long),
+      height: Math.round((size.height * side) / long),
+      scaled: side < long,
+    };
+  });
+  const same = (list: ReadonlyArray<PickRegion>) =>
+    list.every((size) => size.width === list[0]?.width && size.height === list[0]?.height);
+  const scaled = drawn.some((size) => size.scaled);
+  const [shown] = drawn;
+  if (shown === undefined) return null;
+  const box = { width: shown.width, height: shown.height };
+  if (same(loaded)) return scaled ? { _tag: "Scaled", ...box } : { _tag: "Actual", ...box };
+  if (same(drawn)) return { _tag: "Matched", ...box };
+  return { _tag: "Mixed", side, scaled };
+}
+
+/** One progress cell per question in a row `width` wide: 4 to 24 px, 2 px apart from 8 px up. */
+export function pickStripCells(count: number, width: number) {
+  const fitted = (gap: number) => Math.floor((width - gap * Math.max(count - 1, 0)) / count);
+  const wide = fitted(2);
+  if (wide >= 8) return { cell: Math.min(wide, 24), gap: 2 };
+  return { cell: Math.min(Math.max(fitted(1), 4), 24), gap: 1 };
+}
+
+/** The frame length used when a clip has shown fewer than two frames. */
+export const PICK_FALLBACK_FRAME = 1 / 30;
+/** Clips this close in length, or this far apart in time, count as the same. */
+const PICK_CLIP_TOLERANCE = 0.05;
+
+export interface PickClip {
+  readonly currentTime: number;
+  readonly duration: number;
+}
+
+const PICK_TIMESTAMP_QUANTIZATION_SEC = 0.0011;
+const frameIndex = (time: number, frame: number) =>
+  Math.floor((time + PICK_TIMESTAMP_QUANTIZATION_SEC) / frame);
+const frameCount = (clip: PickClip, frame: number) =>
+  Math.max(Math.round(clip.duration / frame), 1);
+
+/** Clips whose learned frame intervals differ by at most 0.05% play at the same rate (separating 59.94/60, 48/50, 29.97/30, and 23.976/24/25 fps). */
+const PICK_RELATIVE_RATE_TOLERANCE = 0.0005;
+
+/** Each clip's frame length: one not learned yet takes the shortest learned one, or the fallback. */
+export function pickFrameLengths(
+  learned: ReadonlyArray<number | undefined>,
+): ReadonlyArray<number> {
+  const known = learned.filter((frame) => frame !== undefined);
+  const fill = known.length === 0 ? PICK_FALLBACK_FRAME : Math.min(...known);
+  return learned.map((frame) => frame ?? fill);
+}
+
+const sameRate = (frames: ReadonlyArray<number>) => {
+  if (frames.length <= 1) return true;
+  const shortest = Math.min(...frames);
+  const longest = Math.max(...frames);
+  return shortest > 0 && (longest - shortest) / shortest <= PICK_RELATIVE_RATE_TOLERANCE;
+};
+
+/**
+ * Where clips are, given each clip's frame length: a frame count when they share a rate and a
+ * frame count, else the longest clip's seconds, saying whether their rates differ.
+ */
+export function pickPlaybackPosition(
+  clips: ReadonlyArray<PickClip>,
+  frames: ReadonlyArray<number>,
+):
+  | { readonly _tag: "Frame"; readonly current: number; readonly total: number }
+  | {
+      readonly _tag: "Seconds";
+      readonly current: number;
+      readonly total: number;
+      readonly mixedRates: boolean;
+    }
+  | null {
+  const [first] = clips;
+  if (first === undefined || !Number.isFinite(first.duration)) return null;
+  const mixedRates = !sameRate(frames);
+  const frame = frames.length === 0 ? PICK_FALLBACK_FRAME : Math.min(...frames);
+  const leaderIndex = pickLeaderClipIndex(clips, frames) ?? 0;
+  const leader = clips[leaderIndex] ?? first;
+  const leaderFrame = frames[leaderIndex] ?? frame;
+  const total = frameCount(leader, leaderFrame);
+  if (
+    !mixedRates &&
+    clips.every(
+      (clip, idx) =>
+        frameCount(clip, frames[idx] ?? leaderFrame) === total && frameCount(clip, frame) === total,
+    )
+  ) {
+    return {
+      _tag: "Frame",
+      current: Math.min(frameIndex(leader.currentTime, leaderFrame), total - 1) + 1,
+      total,
+    };
+  }
+  const longest = clips.reduce((best, clip) => (clip.duration > best.duration ? clip : best));
+  return { _tag: "Seconds", current: longest.currentTime, total: longest.duration, mixedRates };
+}
+
+/** The time one frame back or forward, wrapping, at the middle of that frame so it shows. */
+export function steppedTime(clip: PickClip, frame: number, delta: -1 | 1): number {
+  const total = frameCount(clip, frame);
+  const target = (((frameIndex(clip.currentTime, frame) + delta) % total) + total) % total;
+  return Math.min((target + 0.5) * frame, Math.max(clip.duration - 0.001, 0));
+}
+
+/** The middle of the clip's own frame that holds `time`, wrapped into the clip's length. */
+function frameTimeAt(clip: PickClip, frame: number, time: number): number {
+  const wrapped = clip.duration > 0 ? ((time % clip.duration) + clip.duration) % clip.duration : 0;
+  return Math.min((frameIndex(wrapped, frame) + 0.5) * frame, Math.max(clip.duration - 0.001, 0));
+}
+
+/**
+ * Elects the drift/readout leader among a question's loaded video clips, independent of shuffled
+ * option order: longest clip first, then finest frame interval, then earliest index.
+ */
+export function pickLeaderClipIndex(
+  clips: ReadonlyArray<PickClip>,
+  frames: ReadonlyArray<number>,
+): number | null {
+  if (clips.length === 0) return null;
+  const frameOf = (place: number) => frames[place] ?? PICK_FALLBACK_FRAME;
+  return clips.reduce((best, clip, place) => {
+    const bestClip = clips[best];
+    if (bestClip === undefined) return place;
+    if (clip.duration > bestClip.duration) return place;
+    if (clip.duration === bestClip.duration && frameOf(place) < frameOf(best)) return place;
+    return best;
+  }, 0);
+}
+
+/**
+ * Whether two clips share the same frame rate and total frame count so they should stay phase-locked
+ * across playback and loop boundaries. Clips differing by even one frame (e.g. 24 vs 25 frames at
+ * 24 fps) return false so the shorter clip never truncates the longer clip's final frame.
+ */
+export function clipsShareFrameLoop(
+  leader: PickClip,
+  leaderFrame: number | undefined,
+  follower: PickClip,
+  followerFrame: number | undefined,
+): boolean {
+  if (
+    !Number.isFinite(leader.duration) ||
+    !Number.isFinite(follower.duration) ||
+    leader.duration <= 0 ||
+    follower.duration <= 0
+  ) {
+    return false;
+  }
+  if (leaderFrame !== undefined && followerFrame !== undefined) {
+    if (!sameRate([leaderFrame, followerFrame])) return false;
+    const sharedFrame = Math.min(leaderFrame, followerFrame);
+    return (
+      frameCount(leader, leaderFrame) === frameCount(follower, followerFrame) &&
+      frameCount(leader, sharedFrame) === frameCount(follower, sharedFrame)
+    );
+  }
+  return Math.abs(follower.duration - leader.duration) <= 0.01;
+}
+
+/**
+ * On pause, aligns compatible clips to the leader's last presented source frame so sub-deadband
+ * phase offsets straddling a frame boundary never freeze candidates on adjacent frames.
+ */
+export function alignPausedClipTimes(
+  leader: PickClip,
+  leaderFrame: number,
+  leaderPresentedTime: number,
+  participants: ReadonlyArray<{
+    readonly clip: PickClip;
+    readonly frame: number | undefined;
+    readonly presentedTime: number;
+  }>,
+): { readonly times: ReadonlyArray<number | null>; readonly playhead: number } {
+  const total = frameCount(leader, leaderFrame);
+  const targetIdx = Math.min(Math.max(frameIndex(leaderPresentedTime, leaderFrame), 0), total - 1);
+  const playhead = Math.min((targetIdx + 0.5) * leaderFrame, Math.max(leader.duration - 0.001, 0));
+  const times = participants.map(({ clip, frame, presentedTime }) => {
+    if (frame === undefined || !clipsShareFrameLoop(leader, leaderFrame, clip, frame)) {
+      return null;
+    }
+    const target = Math.min((targetIdx + 0.5) * frame, Math.max(clip.duration - 0.001, 0));
+    return frameIndex(clip.currentTime, frame) === targetIdx &&
+      frameIndex(presentedTime, frame) === targetIdx
+      ? null
+      : target;
+  });
+  return { times, playhead };
+}
+
+/**
+ * Every clip's time after one frame back or forward, plus the shared playhead. At different
+ * rates the playhead steps through the longest clip at the finest frame interval.
+ */
+export function steppedTimes(
+  clips: ReadonlyArray<PickClip>,
+  frames: ReadonlyArray<number>,
+  delta: -1 | 1,
+  playhead?: number,
+): { readonly times: ReadonlyArray<number>; readonly playhead: number } {
+  const longestIndex = pickLeaderClipIndex(clips, frames);
+  if (longestIndex === null) return { times: [], playhead: 0 };
+  const frameOf = (place: number) => frames[place] ?? PICK_FALLBACK_FRAME;
+  if (sameRate(frames)) {
+    const frame = frames.length === 0 ? PICK_FALLBACK_FRAME : Math.min(...frames);
+    const longest = clips[longestIndex];
+    if (playhead !== undefined && longest !== undefined) {
+      const nextLead = steppedTime(
+        { currentTime: playhead, duration: longest.duration },
+        frame,
+        delta,
+      );
+      const longestFrames = frameCount(longest, frame);
+      const times = clips.map((clip) =>
+        frameCount(clip, frame) === longestFrames
+          ? Math.min(nextLead, Math.max(clip.duration - 0.001, 0))
+          : frameTimeAt(clip, frame, nextLead),
+      );
+      return { times, playhead: nextLead };
+    }
+    const times = clips.map((clip) => steppedTime(clip, frame, delta));
+    return { times, playhead: times[longestIndex] ?? 0 };
+  }
+  const finestFrame = Math.min(...clips.map((_, place) => frameOf(place)));
+  const longest = clips[longestIndex];
+  if (longest === undefined) return { times: [], playhead: 0 };
+  const current = playhead ?? longest.currentTime;
+  const moment = steppedTime(
+    { currentTime: current, duration: longest.duration },
+    finestFrame,
+    delta,
+  );
+  const times = clips.map((clip, place) => frameTimeAt(clip, frameOf(place), moment));
+  return { times, playhead: moment };
+}
+
+const NOMINAL_VIDEO_RATES = [
+  60,
+  60_000 / 1001,
+  50,
+  48,
+  30,
+  30_000 / 1001,
+  25,
+  24,
+  24_000 / 1001,
+  20,
+  15,
+  12,
+  10,
+  8,
+] as const;
+
+export interface PickFrameCadenceState {
+  readonly runStartTime: number | null;
+  readonly runStartPresented: number | null;
+  readonly runSourceSteps: number;
+  readonly lastTime: number | null;
+  readonly lastPresented: number | null;
+  readonly minUnitGap: number | undefined;
+  readonly bestSteps: number;
+  readonly frameDuration: number | undefined;
+}
+
+export const INITIAL_PICK_FRAME_CADENCE: PickFrameCadenceState = {
+  runStartTime: null,
+  runStartPresented: null,
+  runSourceSteps: 0,
+  lastTime: null,
+  lastPresented: null,
+  minUnitGap: undefined,
+  bestSteps: 0,
+  frameDuration: undefined,
+};
+
+export function resetPickFrameCadenceRun(state: PickFrameCadenceState): PickFrameCadenceState {
+  return {
+    ...state,
+    runStartTime: null,
+    runStartPresented: null,
+    runSourceSteps: 0,
+    lastTime: null,
+    lastPresented: null,
+  };
+}
+
+/**
+ * Updates a clip's learned frame duration over a continuous forward playback run, discarding
+ * samples across seeks, loop wraps, stalls, and rate-nudged frames, accounting for dropped source
+ * frames before composition, and snapping 1 ms WebM timestamp quantization (e.g. alternating
+ * 41/42 ms at 24 fps) to the clip's true frame rate.
+ */
+export function observeClipFrameCadence(
+  state: PickFrameCadenceState,
+  sample: {
+    readonly mediaTime: number;
+    readonly presentedFrames: number;
+    readonly duration: number;
+    readonly rateMatches: boolean;
+  },
+): PickFrameCadenceState {
+  if (!sample.rateMatches) {
+    return resetPickFrameCadenceRun(state);
+  }
+  if (state.lastTime === null || state.lastPresented === null) {
+    return {
+      ...state,
+      runStartTime: sample.mediaTime,
+      runStartPresented: sample.presentedFrames,
+      runSourceSteps: 0,
+      lastTime: sample.mediaTime,
+      lastPresented: sample.presentedFrames,
+    };
+  }
+  const stepGap = sample.mediaTime - state.lastTime;
+  const stepFrames = sample.presentedFrames - state.lastPresented;
+  if (stepGap <= 0.001 || stepFrames <= 0 || stepGap / stepFrames > 0.5) {
+    return {
+      ...state,
+      runStartTime: sample.mediaTime,
+      runStartPresented: sample.presentedFrames,
+      runSourceSteps: 0,
+      lastTime: sample.mediaTime,
+      lastPresented: sample.presentedFrames,
+    };
+  }
+  const unitGap = stepGap / stepFrames;
+  const earlierDropPolluted = state.minUnitGap !== undefined && unitGap < state.minUnitGap * 0.75;
+  const nextMinUnitGap = earlierDropPolluted
+    ? unitGap
+    : state.minUnitGap === undefined
+      ? unitGap
+      : Math.min(state.minUnitGap, unitGap);
+  const startTime = earlierDropPolluted ? state.lastTime : (state.runStartTime ?? state.lastTime);
+  const startPresented = earlierDropPolluted
+    ? state.lastPresented
+    : (state.runStartPresented ?? state.lastPresented);
+  const refFrame = earlierDropPolluted ? unitGap : (state.frameDuration ?? nextMinUnitGap);
+  const stepSourceFrames = Math.max(stepFrames, Math.round(stepGap / refFrame));
+  const totalSteps = earlierDropPolluted ? stepFrames : state.runSourceSteps + stepSourceFrames;
+  const effectiveBestSteps = earlierDropPolluted ? 0 : state.bestSteps;
+  const totalGap = sample.mediaTime - startTime;
+  if (totalSteps <= 0 || totalGap <= 0.001 || totalSteps < effectiveBestSteps) {
+    return {
+      ...state,
+      runStartTime: startTime,
+      runStartPresented: startPresented,
+      runSourceSteps: totalSteps,
+      lastTime: sample.mediaTime,
+      lastPresented: sample.presentedFrames,
+      minUnitGap: nextMinUnitGap,
+    };
+  }
+  const rawEstimate = totalGap / totalSteps;
+  // Container timestamps in WebM quantize to 1 ms: snap within ±1.05 ms / totalSteps to the
+  // standard nominal rate whose total clip frame count is closest to an integer.
+  const quantizationBound = 0.00105 / totalSteps;
+  const matchingNominal = NOMINAL_VIDEO_RATES.filter(
+    (rate) => Math.abs(1 / rate - rawEstimate) <= quantizationBound,
+  );
+  const snappedRate =
+    matchingNominal.length === 0
+      ? null
+      : Number.isFinite(sample.duration) && sample.duration > 0
+        ? matchingNominal.reduce((best, rate) => {
+            const bestErr = Math.abs(sample.duration * best - Math.round(sample.duration * best));
+            const rateErr = Math.abs(sample.duration * rate - Math.round(sample.duration * rate));
+            return rateErr < bestErr - 1e-6 ? rate : best;
+          })
+        : matchingNominal.length === 1
+          ? (matchingNominal[0] ?? null)
+          : null;
+  const estimate = snappedRate === null ? rawEstimate : 1 / snappedRate;
+  return {
+    runStartTime: startTime,
+    runStartPresented: startPresented,
+    runSourceSteps: totalSteps,
+    lastTime: sample.mediaTime,
+    lastPresented: sample.presentedFrames,
+    minUnitGap: nextMinUnitGap,
+    bestSteps: totalSteps,
+    frameDuration: estimate,
+  };
+}
+
+/** Signed circular phase difference `followerTime - leaderTime` wrapped into `[-duration/2, duration/2]`. */
+export function circularClipPhaseDiff(
+  leaderTime: number,
+  followerTime: number,
+  duration: number,
+): number {
+  let diff = followerTime - leaderTime;
+  if (Number.isFinite(duration) && duration > 0) {
+    const halfSpan = duration / 2;
+    if (diff > halfSpan) diff -= duration;
+    else if (diff < -halfSpan) diff += duration;
+  }
+  return diff;
+}
+
+/**
+ * When the leader clip wraps: the time to move another clip to so the two stay in step, or null
+ * when it already is within the smooth rate-lock band, or when the clips differ in frame rate or
+ * frame count and so loop on their own.
+ */
+export function inStepTime(
+  leader: PickClip,
+  clip: PickClip,
+  leaderFrame?: number,
+  followerFrame?: number,
+): number | null {
+  if (leaderFrame !== undefined && followerFrame !== undefined) {
+    if (!clipsShareFrameLoop(leader, leaderFrame, clip, followerFrame)) {
+      return null;
+    }
+    const hardThreshold = Math.max(leaderFrame * 2.5, 0.085);
+    return Math.abs(circularClipPhaseDiff(leader.currentTime, clip.currentTime, leader.duration)) >
+      hardThreshold
+      ? leader.currentTime
+      : null;
+  }
+  if (leaderFrame !== undefined || followerFrame !== undefined) return null;
+  if (Math.abs(leader.duration - clip.duration) > PICK_CLIP_TOLERANCE) return null;
+  return Math.abs(circularClipPhaseDiff(leader.currentTime, clip.currentTime, leader.duration)) >
+    PICK_CLIP_TOLERANCE
+    ? leader.currentTime
+    : null;
+}
+
+/** A note as saved: trimmed, and none when blank. */
+export function savedNote(note: string): string | undefined {
+  const trimmed = note.trim();
+  return trimmed.length === 0 ? undefined : trimmed;
+}
+
+/** What a save carries: the choice, the note, or both. */
+export type PickField = "choice" | "note";
+
+export interface PickDraftNote {
+  readonly revision: number;
+  readonly text: string;
+  readonly attempted: boolean;
+}
+
+/**
+ * One batch's saves, one after another, shared by every picker open on it: a save a closed
+ * picker queued still lands before a later one, and Done waits for all of them.
+ */
+export interface PickSaveQueue {
+  /**
+   * Runs `save` after every save before it; resolves to its error, or null. Its outcome
+   * counts only for the fields it carries.
+   */
+  readonly enqueue: (
+    target: { readonly questionIndex: number; readonly fields: ReadonlyArray<PickField> },
+    save: () => Promise<string | null>,
+  ) => Promise<string | null>;
+  /**
+   * Done, in line with the saves: after every save before it, `complete` runs unless some
+   * field's latest save failed; saves queued after it run after it.
+   */
+  readonly finish: <A>(complete: () => Promise<A>) => Promise<PickFinishOutcome<A>>;
+  /** Waits for every queued save and Done; the questions with a field whose latest save failed. */
+  readonly settled: () => Promise<ReadonlySet<number>>;
+  /** Unacknowledged note edits (both unanswered drafts and failed edits/clears on answered questions). */
+  readonly getDraftNotes: () => ReadonlyMap<number, PickDraftNote>;
+  readonly setDraftNote: (questionIndex: number, note: string | undefined) => number | undefined;
+  readonly markDraftNoteAttempted: (questionIndex: number, revision: number) => void;
+  readonly acknowledgeDraftNote: (
+    questionIndex: number,
+    revision: number,
+    savedText?: string,
+  ) => void;
+  readonly clearDraftNotes: () => void;
+}
+
+/** A question whose latest save failed for these fields. */
+export interface PickUnsaved {
+  readonly questionIndex: number;
+  readonly fields: ReadonlySet<PickField>;
+}
+
+export type PickFinishOutcome<A> =
+  | { readonly _tag: "Unsaved"; readonly unsaved: ReadonlyArray<PickUnsaved> }
+  | { readonly _tag: "Completed"; readonly result: A };
+
+export function makePickSaveQueue(): PickSaveQueue {
+  let tail: Promise<unknown> = Promise.resolve();
+  // By question, the fields whose latest save failed: a choice saved later doesn't clear a note.
+  const failed = new Map<number, Set<PickField>>();
+  const drafts = new Map<number, PickDraftNote>();
+  let nextDraftRevision = 0;
+  const unsaved = (): ReadonlyArray<PickUnsaved> =>
+    [...failed.entries()]
+      .filter(([, fields]) => fields.size > 0)
+      .map(([questionIndex, fields]) => ({ questionIndex, fields: new Set(fields) }))
+      .sort((left, right) => left.questionIndex - right.questionIndex);
+  return {
+    enqueue: ({ questionIndex, fields }, save) => {
+      const run = tail.then(save).then((failure) => {
+        const current = failed.get(questionIndex) ?? new Set<PickField>();
+        for (const field of fields) {
+          if (failure === null) current.delete(field);
+          else current.add(field);
+        }
+        failed.set(questionIndex, current);
+        return failure;
+      });
+      // A save that throws fails on its own; the ones after it still run.
+      tail = run.catch(() => undefined);
+      return run;
+    },
+    finish: <A>(complete: () => Promise<A>) => {
+      const run = tail.then(async (): Promise<PickFinishOutcome<A>> => {
+        const pending = unsaved();
+        return pending.length > 0
+          ? { _tag: "Unsaved", unsaved: pending }
+          : { _tag: "Completed", result: await complete() };
+      });
+      tail = run.catch(() => undefined);
+      return run;
+    },
+    settled: () => tail.then(() => new Set(unsaved().map(({ questionIndex }) => questionIndex))),
+    getDraftNotes: () => new Map(drafts),
+    setDraftNote: (questionIndex, note) => {
+      if (note === undefined) {
+        drafts.delete(questionIndex);
+        return undefined;
+      }
+      nextDraftRevision += 1;
+      const revision = nextDraftRevision;
+      drafts.set(questionIndex, { revision, text: note, attempted: false });
+      return revision;
+    },
+    markDraftNoteAttempted: (questionIndex, revision) => {
+      const current = drafts.get(questionIndex);
+      if (current !== undefined && current.revision <= revision && !current.attempted) {
+        drafts.set(questionIndex, { ...current, attempted: true });
+      }
+    },
+    acknowledgeDraftNote: (questionIndex, revision, savedText) => {
+      const current = drafts.get(questionIndex);
+      if (current === undefined) return;
+      if (
+        current.revision <= revision ||
+        (savedText !== undefined && (savedNote(current.text) ?? "") === savedText)
+      ) {
+        drafts.delete(questionIndex);
+      }
+    },
+    clearDraftNotes: () => {
+      drafts.clear();
+    },
+  };
+}
+
+const saveQueues = new Map<string, PickSaveQueue>();
+
+/** The save queue for a batch on an environment, made on first use. */
+export function pickSaveQueue(batch: {
+  readonly environmentId: string;
+  readonly threadId: string;
+  readonly batchId: string;
+}): PickSaveQueue {
+  const key = JSON.stringify([batch.environmentId, batch.threadId, batch.batchId]);
+  const existing = saveQueues.get(key);
+  if (existing !== undefined) return existing;
+  const queue = makePickSaveQueue();
+  saveQueues.set(key, queue);
+  return queue;
+}
