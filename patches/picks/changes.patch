diff --git a/patcher/journeys/picks.mjs b/patcher/journeys/picks.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..836a90fa0a0e9b85d899723d057caa971bb72270
--- /dev/null
+++ b/patcher/journeys/picks.mjs
@@ -0,0 +1,174 @@
+// Journey: an agent asks for picks over the real MCP endpoint, the user answers in the Picks inbox
+// with the keyboard and Done, and the asking thread wakes with every answer. The agent is
+// fixtures/picks-agent.mjs, a provider in the journey's own T3 home; the server's CLI starts it.
+//   T3_PATCHER_APP=<built .app> T3_PATCHER_EVIDENCE=<dir> node patcher/journeys/picks.mjs
+import * as NodeChildProcess from "node:child_process";
+import * as NodeFS from "node:fs";
+import * as NodeOS from "node:os";
+import * as NodePath from "node:path";
+
+import { PICKS_REPLY, PICKS_TITLE } from "./fixtures/picks-batch.mjs";
+import { FIXTURE_DB, STEP_TIMEOUT_MS, journey } from "./support.mjs";
+
+const repoRoot = NodePath.resolve(import.meta.dirname, "../..");
+const agent = NodePath.join(import.meta.dirname, "fixtures/picks-agent.mjs");
+const THREAD_TITLE = "Picks journey";
+
+// The journey's own T3 home, so the provider is in settings before the server starts.
+const parent = process.env.T3_PATCHER_TMP || process.env.TMPDIR || NodeOS.tmpdir();
+NodeFS.mkdirSync(parent, { recursive: true });
+const base = NodeFS.mkdtempSync(NodePath.join(parent, "t3-picks-"));
+const t3Home = NodePath.join(base, "t3");
+const workspace = NodePath.join(base, "workspace");
+NodeFS.mkdirSync(NodePath.join(t3Home, "userdata"), { recursive: true });
+NodeFS.copyFileSync(FIXTURE_DB, NodePath.join(t3Home, "userdata/statev2.sqlite"));
+NodeFS.writeFileSync(
+  NodePath.join(t3Home, "userdata/settings.json"),
+  JSON.stringify({
+    providerInstances: {
+      picksAgent: {
+        displayName: "Picks agent",
+        driver: "acpRegistry",
+        config: { source: "local", commandPath: process.execPath, commandArgs: [agent] },
+      },
+    },
+  }),
+);
+NodeFS.mkdirSync(workspace);
+NodeFS.writeFileSync(NodePath.join(workspace, "README.md"), "Picks journey\n");
+const git = (...args) =>
+  NodeChildProcess.execFileSync("git", args, { cwd: workspace, stdio: "ignore" });
+git("init", "--quiet", "--initial-branch=main");
+git("add", "--all");
+git("-c", "user.name=Journey", "-c", "user.email=journey@example.invalid", "commit", "-qm", "init");
+
+/** The server's own CLI, against the running app's T3 home. */
+function cli(...args) {
+  return NodeChildProcess.execFileSync(
+    process.execPath,
+    ["apps/server/src/bin.ts", ...args, "--base-dir", t3Home],
+    { cwd: repoRoot, encoding: "utf8", timeout: STEP_TIMEOUT_MS * 2 },
+  );
+}
+
+async function untilServerListens() {
+  const runtime = NodePath.join(t3Home, "userdata/server-runtime.json");
+  const deadline = Date.now() + STEP_TIMEOUT_MS;
+  while (!NodeFS.existsSync(runtime)) {
+    if (Date.now() > deadline) throw new Error("the app's server never wrote server-runtime.json");
+    await new Promise((resolve) => setTimeout(resolve, 250));
+  }
+}
+
+try {
+  await journey(
+    "picks",
+    async ({ page, screenshot }, step) => {
+      step("waiting for the app's server");
+      await untilServerListens();
+      step("adding the workspace as a project");
+      cli("project", "add", workspace, "--title", "Picks");
+      step("starting a thread whose agent asks for picks");
+      const started = JSON.parse(
+        cli(
+          "thread",
+          "start",
+          workspace,
+          "Ask me for picks.",
+          "--title",
+          THREAD_TITLE,
+          "--provider",
+          "picksAgent",
+          "--model",
+          "default",
+          "--wait",
+          "--json",
+        ),
+      );
+      console.log(`thread ${started.threadId}`);
+
+      step("finding the waiting batch in the sidebar");
+      const picksButton = page.getByRole("button", { name: "Picks, 1 waiting" });
+      await picksButton.waitFor({ timeout: STEP_TIMEOUT_MS });
+      await picksButton.click();
+      step("opening the inbox");
+      const row = page.getByRole("link", { name: PICKS_TITLE });
+      await row.waitFor({ timeout: STEP_TIMEOUT_MS });
+      await page.getByText("0/3").waitFor({ timeout: STEP_TIMEOUT_MS });
+      console.log(await screenshot("picks-inbox"));
+
+      step("opening the batch");
+      await row.click();
+      const progress = page.getByTestId("picker-progress");
+      await progress
+        .getByText("Question 1 of 3 · 0 answered")
+        .waitFor({ timeout: STEP_TIMEOUT_MS });
+      await page
+        .getByRole("img", { name: "Option 2" })
+        .evaluate((image) => image.decode())
+        .catch(() => {});
+      await page.waitForFunction(
+        () => [...document.querySelectorAll("img")].every((image) => image.complete),
+        undefined,
+        { timeout: STEP_TIMEOUT_MS },
+      );
+      console.log(await screenshot("picks-question"));
+
+      step("answering with the keyboard");
+      await page.keyboard.press("2");
+      await progress
+        .getByText("Question 2 of 3 · 1 answered")
+        .waitFor({ timeout: STEP_TIMEOUT_MS });
+      await page.keyboard.press("0");
+      await progress
+        .getByText("Question 3 of 3 · 2 answered")
+        .waitFor({ timeout: STEP_TIMEOUT_MS });
+      await page.keyboard.press("n");
+      await page.keyboard.type("both loop cleanly");
+      await page.keyboard.press("Escape");
+      await page.waitForFunction(
+        () =>
+          [...document.querySelectorAll("video")].length === 2 &&
+          [...document.querySelectorAll("video")].every((video) => video.readyState >= 2),
+        undefined,
+        { timeout: STEP_TIMEOUT_MS },
+      );
+      console.log(await screenshot("picks-video-question"));
+      await page.keyboard.press("1");
+      await progress
+        .getByText("Question 3 of 3 · 3 answered")
+        .waitFor({ timeout: STEP_TIMEOUT_MS });
+      step("pressing Done");
+      await page.getByTestId("picker").getByRole("button", { name: "Done", exact: true }).click();
+      await page.getByText("These picks are answered.").waitFor({ timeout: STEP_TIMEOUT_MS });
+
+      step("opening the asking thread");
+      await page.goBack();
+      const thread = page.getByTestId("sidebar-row-card").filter({ hasText: THREAD_TITLE });
+      await thread.waitFor({ timeout: STEP_TIMEOUT_MS });
+      await thread.press("Enter");
+      step("waiting for the wake message and the agent's reply");
+      await page.getByText(`Picks answered: ${PICKS_TITLE}`).waitFor({ timeout: STEP_TIMEOUT_MS });
+      await page
+        .getByText(`Answers to picks: ${PICKS_TITLE}`)
+        .waitFor({ timeout: STEP_TIMEOUT_MS });
+      // The agent read the wake's JSON: every question unblinded, the tie, and the note.
+      await page
+        .getByText(
+          new RegExp(
+            `^${PICKS_REPLY} face=(mandelbrot|gradient), sprite=tie, walk=(testsrc|rgb) \\(both loop cleanly\\)\\.$`,
+          ),
+        )
+        .waitFor({ timeout: STEP_TIMEOUT_MS });
+      console.log(await screenshot("picks-woken-thread"));
+    },
+    { seed: false, env: { T3CODE_HOME: t3Home } },
+  );
+} finally {
+  const logs = NodePath.join(t3Home, "userdata/logs");
+  const evidence = process.env.T3_PATCHER_EVIDENCE;
+  if (evidence && NodeFS.existsSync(logs)) {
+    NodeFS.cpSync(logs, NodePath.join(evidence, "picks-logs"), { recursive: true });
+  }
+  NodeFS.rmSync(base, { recursive: true, force: true, maxRetries: 5 });
+}
