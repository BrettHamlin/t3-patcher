+/** Formats when a turn's work ended, or returns null for an unreadable instant. */
+export type WorkEndTimeFormat = (endIso: string) => string | null;
+
+export function workEndTimeFormat(clock: {
+  readonly now: Date;
+  readonly locale?: string;
+  readonly timeZone?: string;
+}): WorkEndTimeFormat {
+  const time: Intl.DateTimeFormatOptions = {
+    hour: "numeric",
+    minute: "2-digit",
+    timeZoneName: "short",
+  };
+  const { locale, timeZone } = clock;
+  const today = new Intl.DateTimeFormat(locale, { ...time, timeZone });
+  const otherDay = new Intl.DateTimeFormat(locale, {
+    ...time,
+    month: "short",
+    day: "numeric",
+    timeZone,
+  });
+  const localDate = new Intl.DateTimeFormat("en-US", { dateStyle: "short", timeZone });
+  const todayDate = localDate.format(clock.now);
+  return (endIso) => {
+    const end = Date.parse(endIso);
+    if (!Number.isFinite(end)) return null;
+    return (localDate.format(end) === todayDate ? today : otherDay).format(end);
+  };
+}
