diff --git a/patcher/journeys/fixtures/work-timestamps-agent.mjs b/patcher/journeys/fixtures/work-timestamps-agent.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a3511622457bae9a5f8c0b6c3814d6040aad2bc9
--- /dev/null
+++ b/patcher/journeys/fixtures/work-timestamps-agent.mjs
@@ -0,0 +1,74 @@
+// A minimal ACP agent for the work-timestamps journey: each turn says a line, runs one finished
+// tool call and replies, so the settled turn folds behind its "Worked for" row. ACP on stdio.
+import * as NodeCrypto from "node:crypto";
+import * as NodeReadline from "node:readline";
+
+const send = (message) =>
+  process.stdout.write(`${JSON.stringify({ jsonrpc: "2.0", ...message })}\n`);
+
+async function prompt(params) {
+  const update = (body) =>
+    send({ method: "session/update", params: { sessionId: params.sessionId, update: body } });
+  const say = (text) =>
+    update({ sessionUpdate: "agent_message_chunk", content: { type: "text", text } });
+  const toolCallId = NodeCrypto.randomUUID();
+  say("Looking at the workspace.");
+  update({
+    sessionUpdate: "tool_call",
+    toolCallId,
+    title: "List files",
+    kind: "execute",
+    status: "in_progress",
+  });
+  await new Promise((resolve) => setTimeout(resolve, 1_500));
+  update({ sessionUpdate: "tool_call_update", toolCallId, status: "completed" });
+  say("Checked the workspace.");
+  return { stopReason: "end_turn" };
+}
+
+async function handle(message) {
+  const params = message.params ?? {};
+  switch (message.method) {
+    case "initialize":
+      return {
+        protocolVersion: 1,
+        agentCapabilities: {
+          loadSession: true,
+          promptCapabilities: { image: false, audio: false, embeddedContext: true },
+          mcpCapabilities: { http: true, sse: false },
+        },
+        authMethods: [],
+        agentInfo: { name: "work-timestamps-journey-agent", version: "1" },
+      };
+    case "session/new":
+    case "session/load":
+      return {
+        ...(message.method === "session/new" ? { sessionId: NodeCrypto.randomUUID() } : {}),
+        models: {
+          currentModelId: "default",
+          availableModels: [{ modelId: "default", name: "Default" }],
+        },
+      };
+    case "session/set_model":
+    case "session/set_mode":
+      return {};
+    case "session/prompt":
+      return prompt(params);
+    default:
+      throw Object.assign(new Error(`Method not found: ${message.method}`), { code: -32601 });
+  }
+}
+
+NodeReadline.createInterface({ input: process.stdin }).on("line", (line) => {
+  if (line.trim() === "") return;
+  const message = JSON.parse(line);
+  if (message.method === undefined || message.id === undefined) return;
+  handle(message).then(
+    (result) => send({ id: message.id, result }),
+    (error) =>
+      send({
+        id: message.id,
+        error: { code: error.code ?? -32603, message: String(error.message) },
+      }),
+  );
+});
diff --git a/patcher/journeys/work-timestamps.mjs b/patcher/journeys/work-timestamps.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..3f50f0dfe4b15cf3dba0f39b007fcbe2c1b284b4
--- /dev/null
+++ b/patcher/journeys/work-timestamps.mjs
@@ -0,0 +1,145 @@
+// Journey: an agent finishes a turn with work in it, and the thread's fold row names how long it
+// worked and when it ended, in this Mac's locale and time zone. The agent is
+// fixtures/work-timestamps-agent.mjs, a provider in the journey's own T3 home.
+//   T3_PATCHER_APP=<built .app> T3_PATCHER_EVIDENCE=<dir> node patcher/journeys/work-timestamps.mjs
+import * as NodeChildProcess from "node:child_process";
+import * as NodeFS from "node:fs";
+import * as NodeOS from "node:os";
+import * as NodePath from "node:path";
+
+import { FIXTURE_DB, STEP_TIMEOUT_MS, journey, journeyCliEnv, serverBinPath } from "./support.mjs";
+
+const repoRoot = NodePath.resolve(import.meta.dirname, "../..");
+const agent = NodePath.join(import.meta.dirname, "fixtures/work-timestamps-agent.mjs");
+const THREAD_TITLE = "Work timestamps journey";
+
+// The journey's own T3 home, so the provider is in settings before the server starts.
+const parent = process.env.T3_PATCHER_TMP || process.env.TMPDIR || NodeOS.tmpdir();
+NodeFS.mkdirSync(parent, { recursive: true });
+const base = NodeFS.mkdtempSync(NodePath.join(parent, "t3-work-timestamps-"));
+const t3Home = NodePath.join(base, "t3");
+const workspace = NodePath.join(base, "workspace");
+NodeFS.mkdirSync(NodePath.join(t3Home, "userdata"), { recursive: true });
+NodeFS.copyFileSync(FIXTURE_DB, NodePath.join(t3Home, "userdata/statev2.sqlite"));
+NodeFS.writeFileSync(
+  NodePath.join(t3Home, "userdata/settings.json"),
+  JSON.stringify({
+    providerInstances: {
+      workAgent: {
+        displayName: "Work agent",
+        driver: "acpRegistry",
+        config: { source: "local", commandPath: process.execPath, commandArgs: [agent] },
+      },
+    },
+  }),
+);
+NodeFS.mkdirSync(workspace);
+NodeFS.writeFileSync(NodePath.join(workspace, "README.md"), "Work timestamps journey\n");
+const git = (...args) =>
+  NodeChildProcess.execFileSync("git", args, { cwd: workspace, stdio: "ignore" });
+git("init", "--quiet", "--initial-branch=main");
+git("add", "--all");
+git("-c", "user.name=Journey", "-c", "user.email=journey@example.invalid", "commit", "-qm", "init");
+
+/** The server's own CLI, against the running app's T3 home. */
+function cli(...args) {
+  return NodeChildProcess.execFileSync(
+    process.execPath,
+    [serverBinPath(), ...args, "--base-dir", t3Home],
+    { cwd: repoRoot, env: journeyCliEnv(), encoding: "utf8", timeout: STEP_TIMEOUT_MS * 2 },
+  );
+}
+
+async function untilServerListens() {
+  const runtime = NodePath.join(t3Home, "userdata/server-runtime.json");
+  const deadline = Date.now() + STEP_TIMEOUT_MS;
+  while (!NodeFS.existsSync(runtime)) {
+    if (Date.now() > deadline) throw new Error("the app's server never wrote server-runtime.json");
+    await new Promise((resolve) => setTimeout(resolve, 50));
+  }
+}
+
+try {
+  await journey(
+    "work-timestamps",
+    async ({ page, screenshot }, step) => {
+      step("waiting for the app's server");
+      await untilServerListens();
+      step("adding the workspace as a project");
+      cli("project", "add", workspace, "--title", "Work timestamps");
+      step("running a turn that does some work");
+      const startedMs = Date.now();
+      const started = JSON.parse(
+        cli(
+          "thread",
+          "start",
+          workspace,
+          "Look at the workspace.",
+          "--title",
+          THREAD_TITLE,
+          "--provider",
+          "workAgent",
+          "--model",
+          "default",
+          "--wait",
+          "--json",
+        ),
+      );
+      const endedMs = Date.now();
+      console.log(`thread ${started.threadId}`);
+
+      step("opening the thread");
+      const thread = page.getByTestId("sidebar-row-card").filter({ hasText: THREAD_TITLE });
+      await thread.waitFor({ timeout: STEP_TIMEOUT_MS });
+      await thread.press("Enter");
+      await page.getByText("Checked the workspace.").waitFor({ timeout: STEP_TIMEOUT_MS });
+
+      step("reading the fold row");
+      const fold = page.getByRole("button", { name: /^Worked for / });
