+        version: 1,
+      },
+    ],
+    installedAt: "2026-11-26T00:00:00.000Z",
+    feed: "https://feed.invalid/patches/index.json",
+  }),
+);
+
+const remotePort = await freePort();
+const remoteLog = NodePath.join(root, "remote-server.log");
+const remoteOut = NodeFS.openSync(remoteLog, "a");
+const remoteServer = NodeChildProcess.spawn(
+  process.execPath,
+  [
+    "apps/server/src/bin.ts",
+    "--mode",
+    "web",
+    "--host",
+    "127.0.0.1",
+    "--port",
+    String(remotePort),
+    "--base-dir",
+    remoteHome,
+    "--no-browser",
+    "--auto-bootstrap-project-from-cwd=false",
+  ],
+  {
+    cwd: repoRoot,
+    env: {
+      ...process.env,
+      T3CODE_HOME: remoteHome,
