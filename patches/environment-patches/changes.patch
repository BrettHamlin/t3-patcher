+  const urlMatch = /http:\/\/127\.0\.0\.1:\d+\/[^\s]+/.exec(pairOutput);
+  if (!urlMatch) {
+    throw new Error(`could not find pairing URL in pair output:\n${pairOutput}`);
+  }
+  const pairingUrl = urlMatch[0];
+
+  await journey(
