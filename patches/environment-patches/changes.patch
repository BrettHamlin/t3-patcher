+import { describe, expect, it } from "vite-plus/test";
+
+import { splitPatchDescription } from "./environmentPatches.logic";
+
+describe("splitPatchDescription", () => {
+  it("uses explicit features when present and keeps the full summary as headline", () => {
+    expect(
+      splitPatchDescription({
+        summary: "Blind A/B comparison inbox inside T3 Code.",
+        features: ["MCP tool request_picks", "Cross-environment /picks inbox"],
+      }),
+    ).toEqual({
+      headline: "Blind A/B comparison inbox inside T3 Code.",
+      included: ["MCP tool request_picks", "Cross-environment /picks inbox"],
+    });
+  });
+
+  it("splits multi-sentence summaries into the first-sentence headline and remaining included bullets", () => {
+    expect(
+      splitPatchDescription({
+        summary:
+          "Agents ask the owner for human judgments in T3 Code itself. A new MCP tool, request_picks, takes 1-200 questions. Done wakes the asking thread with every answer unblinded.",
+      }),
+    ).toEqual({
+      headline: "Agents ask the owner for human judgments in T3 Code itself.",
+      included: [
+        "A new MCP tool, request_picks, takes 1-200 questions.",
+        "Done wakes the asking thread with every answer unblinded.",
+      ],
+    });
+  });
+
+  it("returns only the headline when a summary is a single sentence or empty", () => {
+    expect([
+      splitPatchDescription({ summary: "Launches built apps in an isolated home." }),
+      splitPatchDescription({ summary: "   " }),
+    ]).toEqual([
+      { headline: "Launches built apps in an isolated home.", included: [] },
+      { headline: "", included: [] },
+    ]);
+  });
+});
diff --git a/apps/web/src/components/settings/environmentPatches.logic.ts b/apps/web/src/components/settings/environmentPatches.logic.ts
new file mode 100644
index 0000000000000000000000000000000000000000..016fc2a982827c7286be247f5d8cc8857e078335
--- /dev/null
+++ b/apps/web/src/components/settings/environmentPatches.logic.ts
@@ -0,0 +1,34 @@
+import type { ExecutionEnvironmentPatch } from "@t3tools/contracts";
+
+export interface SplitPatchDescription {
+  readonly headline: string;
+  readonly included: ReadonlyArray<string>;
+}
+
+const SENTENCE_BOUNDARY = /(?<=[.!?])\s+(?=[A-Z0-9"'`(])/;
+
+export function splitPatchDescription(
+  patch: Pick<ExecutionEnvironmentPatch, "summary" | "features">,
+): SplitPatchDescription {
+  const trimmed = patch.summary.trim();
+  const explicit = [
+    ...new Set((patch.features ?? []).map((item) => item.trim()).filter((item) => item !== "")),
+  ];
+  if (explicit.length > 0) {
+    return { headline: trimmed, included: explicit };
+  }
+  if (trimmed === "") {
+    return { headline: "", included: [] };
+  }
+  const sentences = trimmed
+    .split(SENTENCE_BOUNDARY)
+    .map((sentence) => sentence.trim())
+    .filter((sentence) => sentence !== "");
+  if (sentences.length <= 1) {
+    return { headline: trimmed, included: [] };
+  }
+  return {
+    headline: sentences[0]!,
+    included: [...new Set(sentences.slice(1))],
+  };
+}
