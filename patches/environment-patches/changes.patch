diff --git a/apps/server/src/environment/ServerEnvironmentPatches.ts b/apps/server/src/environment/ServerEnvironmentPatches.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ea9e67725542e34cda778b6cb7ab7c2286acf38d
--- /dev/null
+++ b/apps/server/src/environment/ServerEnvironmentPatches.ts
@@ -0,0 +1,81 @@
+import {
+  ExecutionEnvironmentPatch,
+  type ExecutionEnvironmentPatch as EnvironmentPatch,
+} from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Option from "effect/Option";
+import * as Path from "effect/Path";
+import * as Schema from "effect/Schema";
+
+declare const __T3CODE_PATCHES__: string | undefined;
+
+const BakedPatchesSchema = Schema.fromJsonString(Schema.Array(ExecutionEnvironmentPatch));
+const decodeBakedPatches = Schema.decodeUnknownOption(BakedPatchesSchema);
+const decodeEnvironmentPatch = Schema.decodeOption(ExecutionEnvironmentPatch);
+
+const InstalledPatchEntry = Schema.Struct({
+  id: Schema.String.check(Schema.isNonEmpty()),
+  title: Schema.optionalKey(Schema.String),
+  summary: Schema.optionalKey(Schema.String),
+  features: Schema.optionalKey(Schema.Array(Schema.String)),
+  version: Schema.Int.check(Schema.isGreaterThanOrEqualTo(1)),
+});
+
+const InstalledRecordSchema = Schema.fromJsonString(
+  Schema.Struct({
+    t3Version: Schema.String,
+    patches: Schema.Array(InstalledPatchEntry),
+  }),
+);
+const decodeInstalledRecord = Schema.decodeUnknownOption(InstalledRecordSchema);
+
+function parseBakedEnvironmentPatches(
+  raw: string | undefined,
+): ReadonlyArray<EnvironmentPatch> | null {
+  const trimmed = raw?.trim() ?? "";
+  if (trimmed === "") return null;
+  const decoded = decodeBakedPatches(trimmed);
+  return Option.isSome(decoded) ? decoded.value : null;
+}
+
+export const resolveServerEnvironmentPatches = Effect.fn("ServerEnvironment.resolvePatches")(
+  function* (input: {
+    readonly stateDir: string;
+    readonly serverVersion: string;
+    readonly bakedPatchesJson?: string | undefined;
+  }) {
+    const baked = parseBakedEnvironmentPatches(
+      input.bakedPatchesJson !== undefined
+        ? input.bakedPatchesJson
+        : typeof __T3CODE_PATCHES__ === "undefined"
+          ? undefined
+          : __T3CODE_PATCHES__,
+    );
+    if (baked !== null) return baked;
+
+    const fs = yield* FileSystem.FileSystem;
+    const path = yield* Path.Path;
+    const recordPath = path.join(input.stateDir, "patcher", "installed.json");
+    const raw = yield* fs.readFileString(recordPath).pipe(Effect.option);
+    if (Option.isNone(raw)) return [];
+    const decoded = decodeInstalledRecord(raw.value);
+    if (Option.isNone(decoded) || decoded.value.t3Version !== input.serverVersion) return [];
+
+    return decoded.value.patches.flatMap((entry): ReadonlyArray<EnvironmentPatch> => {
+      const id = entry.id.trim();
+      if (id === "") return [];
+      const title = entry.title?.trim() || id;
+      const summary = entry.summary ?? "";
+      const features = entry.features?.map((item) => item.trim()).filter((item) => item.length > 0);
+      const normalized = decodeEnvironmentPatch({
+        id,
+        title,
+        summary,
+        ...(features && features.length > 0 ? { features } : {}),
+        version: entry.version,
+      });
+      return Option.isSome(normalized) ? [normalized.value] : [];
+    });
+  },
+);
