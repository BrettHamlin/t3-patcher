+      await odysseyMapNode.waitFor({ timeout: STEP_TIMEOUT_MS });
+      const macbookMapNode = page
+        .locator("button")
+        .filter({ hasText: "So’s MacBook Air" })
+        .filter({ hasText: `${CURRENT} · ${LOCAL_PATCHES_LABEL}` })
+        .first();
+      await macbookMapNode.waitFor({ timeout: STEP_TIMEOUT_MS });
+
+      await odysseyMapNode.click();
+      const mapDetails = page.locator("#remote-environments");
+      await mapDetails.getByText("Connected", { exact: false }).first().waitFor({
+        timeout: STEP_TIMEOUT_MS,
+      });
+      await mapDetails.getByText(REMOTE_VERSION, { exact: true }).waitFor({
+        timeout: STEP_TIMEOUT_MS,
+      });
+
+      step("expanding remote patches and included features in Map view");
+      const routesBtn = page.getByRole("button", { name: "Routes", exact: true });
+      if ((await routesBtn.getAttribute("aria-expanded")) === "true") {
+        await routesBtn.click();
+      }
+      const odysseyPatchesBtn = page.getByRole("button", { name: "2 patches", exact: true });
+      await odysseyPatchesBtn.waitFor({ timeout: STEP_TIMEOUT_MS });
+      await odysseyPatchesBtn.click();
+
+      const patchesList = page.getByRole("list", {
+        name: "Patches installed on Archduke Avacado Odyssey",
+      });
+      await patchesList.waitFor({ timeout: STEP_TIMEOUT_MS });
+      await patchesList.getByText("Picks", { exact: true }).waitFor({ timeout: STEP_TIMEOUT_MS });
+      await patchesList.getByText("v1", { exact: true }).waitFor({ timeout: STEP_TIMEOUT_MS });
+      await patchesList
+        .getByText("Blind A/B image & video comparison inbox inside T3 Code.")
+        .waitFor({ timeout: STEP_TIMEOUT_MS });
+
+      await patchesList.getByRole("button", { name: "What’s included" }).click();
+      await patchesList
+        .getByText(
+          "A new MCP tool, request_picks, takes 1-200 questions with 2-4 shuffled options.",
+        )
+        .waitFor({ timeout: STEP_TIMEOUT_MS });
+      await page
+        .locator("#remote-environments")
+        .evaluate((el) => el.scrollIntoView({ behavior: "instant", block: "start" }));
+      await settled(page);
+      console.log(await screenshot("environment-patches-map"));
+
+      step("switching to List view and verifying preserved disclosure plus local machine patches");
+      await page
+        .getByRole("group", { name: "Show environments as" })
+        .getByRole("button", { name: "List", exact: true })
+        .click();
+
+      // Local environment row appears under This app in List view with its baked patches.
