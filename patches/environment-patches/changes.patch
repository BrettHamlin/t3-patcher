+
+      step("verifying Map view node subtitles and selecting Archduke Avacado Odyssey");
+      const odysseyMapNode = page
+        .locator("button")
+        .filter({ hasText: "Archduke Avacado Odyssey" })
+        .filter({ hasText: `${REMOTE_VERSION} · 2 patches` })
