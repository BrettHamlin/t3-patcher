diff --git a/patcher/journeys/environment-patches.mjs b/patcher/journeys/environment-patches.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..133f8f85a933ff27a4c65502219896afefcad062
--- /dev/null
+++ b/patcher/journeys/environment-patches.mjs
@@ -0,0 +1,289 @@
+// Journey: Settings → Environments shows each environment's version (even when matching the client)
+// and installed patches with their version and included features in both Map view and List view,
+// preserving disclosure state across Map ↔ List switches.
+//   T3_PATCHER_APP=<built .app> T3_PATCHER_EVIDENCE=<dir> node patcher/journeys/environment-patches.mjs
+import * as NodeChildProcess from "node:child_process";
+import * as NodeFS from "node:fs";
+import * as NodeNet from "node:net";
+import * as NodeOS from "node:os";
+import * as NodePath from "node:path";
+
+import { FIXTURE_DB, STEP_TIMEOUT_MS, evidenceDir, journey, serverBinPath } from "./support.mjs";
+
+const repoRoot = NodePath.resolve(import.meta.dirname, "../..");
+
+const CURRENT = NodeChildProcess.execFileSync(
+  "/usr/libexec/PlistBuddy",
+  [
+    "-c",
+    "Print :CFBundleShortVersionString",
+    NodePath.join(process.env.T3_PATCHER_APP ?? "", "Contents/Info.plist"),
+  ],
+  { encoding: "utf8" },
+).trim();
+const REMOTE_VERSION = JSON.parse(
+  NodeFS.readFileSync(NodePath.join(repoRoot, "apps/server/package.json"), "utf8"),
+).version;
+const LOCAL_PATCH_COUNT = JSON.parse(process.env.T3_PATCHER_PATCHES || "[]").length;
+const LOCAL_PATCHES_LABEL = LOCAL_PATCH_COUNT === 1 ? "1 patch" : `${LOCAL_PATCH_COUNT} patches`;
+
+function freePort() {
+  return new Promise((resolve, reject) => {
+    const srv = NodeNet.createServer();
+    srv.on("error", reject);
+    srv.listen(0, "127.0.0.1", () => {
+      const address = srv.address();
+      const port = typeof address === "object" && address !== null ? address.port : 0;
+      srv.close((err) => (err ? reject(err) : resolve(port)));
+    });
+  });
+}
+
+async function settled(page) {
+  await page.evaluate(() =>
+    Promise.all(document.getAnimations().map((animation) => animation.finished.catch(() => {}))),
+  );
+}
+
+const parent = process.env.T3_PATCHER_TMP || process.env.TMPDIR || NodeOS.tmpdir();
+NodeFS.mkdirSync(parent, { recursive: true });
+const root = NodeFS.mkdtempSync(NodePath.join(parent, "t3-env-patches-"));
+const localHome = NodePath.join(root, "local-t3");
+const remoteHome = NodePath.join(root, "remote-t3");
+NodeFS.mkdirSync(NodePath.join(localHome, "userdata"), { recursive: true });
+NodeFS.copyFileSync(FIXTURE_DB, NodePath.join(localHome, "userdata/statev2.sqlite"));
+
+NodeFS.mkdirSync(NodePath.join(remoteHome, "userdata/patcher"), { recursive: true });
+NodeFS.writeFileSync(
+  NodePath.join(remoteHome, "userdata/patcher/installed.json"),
+  JSON.stringify({
