index 0000000000000000000000000000000000000000..3d32035a3729ddee8816360299841ddf10b12875
--- /dev/null
+++ b/apps/web/src/components/settings/EnvironmentPatchesList.browser.test.tsx
@@ -0,0 +1,250 @@
+import {
+  BearerConnectionProfile,
+  BearerConnectionTarget,
+  PrimaryConnectionTarget,
+} from "@t3tools/client-runtime/connection";
+import { EnvironmentId, type ExecutionEnvironmentPatch, ServerConfig } from "@t3tools/contracts";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+import { useState } from "react";
+import { describe, expect, it, vi } from "vite-plus/test";
+import { userEvent } from "vite-plus/test/browser";
+
+vi.mock(import("~/state/session"), async (importOriginal) => ({
+  ...(await importOriginal()),
+  usePreparedConnection: (() => Option.none()) as never,
+}));
+
+import { APP_VERSION } from "~/branding";
+import type { EnvironmentPresentation } from "~/state/environments";
+import { render } from "../../../test/render";
+import {
+  EnvironmentDisclosureProvider,
+  EnvironmentPatchesList,
+  LocalEnvironmentRow,
+} from "./EnvironmentPatchesList";
+import { SavedBackendListRow } from "./SavedEnvironmentRows";
+
+const LOCAL_ID = EnvironmentId.make("env-local");
+const REMOTE_ID = EnvironmentId.make("env-remote");
+
+const PATCHES: ReadonlyArray<ExecutionEnvironmentPatch> = [
+  {
+    id: "journey-kit",
+    title: "Journey kit",
+    summary: "Launches built apps in an isolated T3 home.",
+    version: 2,
+  },
+  {
+    id: "picks",
+    title: "Picks",
+    summary:
+      "Agents ask the owner for human judgments in T3 Code itself. A new MCP tool, request_picks, takes 1-200 questions with 2-4 shuffled options.",
+    version: 1,
+  },
+];
+
+const decodeServerConfig = Schema.decodeSync(ServerConfig);
+
+function makeServerConfig(
+  environmentId: EnvironmentId,
+  label: string,
+  serverVersion: string,
+  patches?: ReadonlyArray<ExecutionEnvironmentPatch>,
+): ServerConfig {
+  return decodeServerConfig({
+    environment: {
+      environmentId,
+      label,
+      platform: { os: "darwin", arch: "arm64", machine: "mac-mini" },
+      serverVersion,
+      orchestrationProtocolVersion: 2,
+      ...(patches === undefined ? {} : { patches }),
+      capabilities: {},
+    },
+    auth: {
+      policy: "loopback-browser",
+      bootstrapMethods: ["one-time-token"],
+      sessionMethods: ["browser-session-cookie"],
+      sessionCookieName: "t3_session",
+    },
+    cwd: "/workspace",
+    keybindingsConfigPath: "/userdata/keybindings.json",
+    keybindings: [],
+    issues: [],
+    providers: [],
+    availableEditors: [],
+    observability: {
+      logsDirectoryPath: "/workspace/logs",
+      localTracingEnabled: false,
+      otlpTracesEnabled: false,
+      otlpMetricsEnabled: false,
+    },
+    settings: {},
+  });
+}
+
+function makeRemoteEnvironment(options: {
+  readonly enabled?: boolean;
+  readonly phase?: EnvironmentPresentation["connection"]["phase"];
+  readonly serverVersion?: string | null;
+  readonly patches?: ReadonlyArray<ExecutionEnvironmentPatch>;
+}): EnvironmentPresentation {
+  const enabled = options.enabled ?? true;
+  const phase = options.phase ?? "connected";
+  const serverVersion = options.serverVersion === undefined ? APP_VERSION : options.serverVersion;
+  return {
+    environmentId: REMOTE_ID,
+    label: "Archduke Avacado Odyssey",
+    displayUrl: "http://192.168.68.203:3773/",
+    relayManaged: false,
+    entry: {
+      target: new BearerConnectionTarget({
+        environmentId: REMOTE_ID,
+        label: "Archduke Avacado Odyssey",
+        connectionId: "lan",
+      }),
+      profile: Option.some(
+        new BearerConnectionProfile({
+          connectionId: "lan",
+          environmentId: REMOTE_ID,
+          label: "Archduke Avacado Odyssey",
+          httpBaseUrl: "http://192.168.68.203:3773/",
+          wsBaseUrl: "ws://192.168.68.203:3773/",
+        }),
+      ),
+      alternateRoutes: [],
+      enabled,
+    },
+    connection: { phase, error: null, traceId: null },
+    serverConfig:
+      serverVersion === null
+        ? null
+        : makeServerConfig(REMOTE_ID, "Archduke Avacado Odyssey", serverVersion, options.patches),
+    refusedRouteIds: [],
+  };
+}
+
+describe("EnvironmentPatchesList & environment rows", () => {
+  it("keeps a remote environment's version visible even when matching APP_VERSION, and expands patches and included features across view switches", async () => {
+    const remote = makeRemoteEnvironment({
+      serverVersion: APP_VERSION,
+      patches: PATCHES,
+    });
+    const local: EnvironmentPresentation = {
+      environmentId: LOCAL_ID,
+      label: "So’s MacBook Air",
+      displayUrl: null,
+      relayManaged: false,
+      entry: {
+        target: new PrimaryConnectionTarget({
+          environmentId: LOCAL_ID,
+          label: "So’s MacBook Air",
+          httpBaseUrl: "http://127.0.0.1:3773/",
+          wsBaseUrl: "ws://127.0.0.1:3773/",
+        }),
+        profile: Option.none(),
+        alternateRoutes: [],
+        enabled: true,
+      },
+      connection: { phase: "connected", error: null, traceId: null },
+      serverConfig: makeServerConfig(LOCAL_ID, "So’s MacBook Air", APP_VERSION, PATCHES),
+      refusedRouteIds: [],
+    };
+
+    function Harness() {
+      const [view, setView] = useState<"map" | "list">("map");
+      return (
+        <EnvironmentDisclosureProvider>
+          <button type="button" onClick={() => setView((v) => (v === "map" ? "list" : "map"))}>
+            Switch view ({view})
+          </button>
+          {view === "list" ? <LocalEnvironmentRow environment={local} /> : null}
+          <SavedBackendListRow
+            key={`${view}-${remote.environmentId}`}
+            environment={remote}
+            removingEnvironmentId={null}
+            onSetEnabled={() => undefined}
+            onRemove={() => undefined}
+            onAddRoute={() => undefined}
+          />
+        </EnvironmentDisclosureProvider>
+      );
+    }
+
+    await using screen = await render(<Harness />);
+
+    await expect.element(screen.getByText("http://192.168.68.203:3773/ · Connected")).toBeVisible();
+    await expect.element(screen.getByText(APP_VERSION, { exact: true })).toBeVisible();
+
+    const patchesButton = screen.getByRole("button", { name: "2 patches" });
+    await expect.element(patchesButton).toHaveAttribute("aria-expanded", "false");
+    await userEvent.click(patchesButton);
+    await expect.element(patchesButton).toHaveAttribute("aria-expanded", "true");
+
+    await expect.element(screen.getByText("Journey kit")).toBeVisible();
+    await expect.element(screen.getByText("v2")).toBeVisible();
+    await expect.element(screen.getByText("Picks")).toBeVisible();
+    await expect
+      .element(screen.getByText("Agents ask the owner for human judgments in T3 Code itself."))
+      .toBeVisible();
+
+    const whatsIncluded = screen.getByRole("button", { name: "What’s included" });
+    await userEvent.click(whatsIncluded);
+    await expect
+      .element(
+        screen.getByText(
+          "A new MCP tool, request_picks, takes 1-200 questions with 2-4 shuffled options.",
+        ),
+      )
+      .toBeVisible();
+
+    // Switching from Map to List remounts the row and keeps disclosure + expanded feature state.
+    await userEvent.click(screen.getByRole("button", { name: "Switch view (map)" }));
+    await expect.element(screen.getByText("This machine · Connected")).toBeVisible();
+    expect(screen.getByText(APP_VERSION, { exact: true }).elements()).toHaveLength(2);
+    await expect
+      .element(
+        screen.getByText(
+          "A new MCP tool, request_picks, takes 1-200 questions with 2-4 shuffled options.",
+        ),
+      )
+      .toBeVisible();
+    await userEvent.click(screen.getByRole("button", { name: "Hide included features" }));
+    expect(
+      screen
+        .getByText(
+          "A new MCP tool, request_picks, takes 1-200 questions with 2-4 shuffled options.",
+        )
+        .elements(),
+    ).toHaveLength(0);
+  });
+
+  it("shows empty states for offline and connected-unpatched environments", async () => {
+    await using offline = await render(
+      <EnvironmentPatchesList
+        environmentLabel="omarchy"
+        connected={false}
+        descriptorKnown={false}
+        patches={[]}
+        expandedPatchIds={[]}
+        onTogglePatchDetail={() => undefined}
+      />,
+    );
+    await expect.element(offline.getByText("Connect to view installed patches.")).toBeVisible();
