+      T3CODE_TELEMETRY_ENABLED: "false",
+    },
+    stdio: ["ignore", remoteOut, remoteOut],
+  },
+);
+
+async function waitForRemoteRuntime() {
+  const runtimePath = NodePath.join(remoteHome, "userdata/server-runtime.json");
+  const deadline = Date.now() + STEP_TIMEOUT_MS;
+  while (!NodeFS.existsSync(runtimePath)) {
+    if (remoteServer.exitCode !== null) {
+      throw new Error(
+        `remote server exited (${remoteServer.exitCode}):\n${NodeFS.readFileSync(remoteLog, "utf8")}`,
+      );
+    }
+    if (Date.now() > deadline) {
+      throw new Error(
+        `remote server never wrote server-runtime.json:\n${NodeFS.readFileSync(remoteLog, "utf8")}`,
+      );
+    }
+    await new Promise((resolve) => setTimeout(resolve, 50));
+  }
+}
+
+try {
+  await waitForRemoteRuntime();
+  const pairOutput = NodeChildProcess.execFileSync(
+    process.execPath,
+    [serverBinPath(), "pair", "--base-dir", remoteHome],
+    {
+      cwd: repoRoot,
