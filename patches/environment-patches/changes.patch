diff --git a/apps/web/src/components/settings/EnvironmentPatchesList.tsx b/apps/web/src/components/settings/EnvironmentPatchesList.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..944147b071ea6a259d860e84307f8c2f3f4de09b
--- /dev/null
+++ b/apps/web/src/components/settings/EnvironmentPatchesList.tsx
@@ -0,0 +1,270 @@
+import { connectionStatusTitle } from "@t3tools/client-runtime/connection";
+import {
+  type EnvironmentId,
+  type ExecutionEnvironmentPatch,
+  resolveEnvironmentMachineKind,
+} from "@t3tools/contracts";
+import { T, useGT, useMessages } from "gt-react";
+import { ChevronRightIcon } from "lucide-react";
+import { createContext, type ReactNode, useContext, useState } from "react";
+
+import { cn } from "~/lib/utils";
+import type { EnvironmentPresentation } from "~/state/environments";
+import { EnvironmentRow, EnvironmentTransportLabel } from "./EnvironmentRow";
+import { splitPatchDescription } from "./environmentPatches.logic";
+
+export const EMPTY_ENVIRONMENT_PATCHES: ReadonlyArray<ExecutionEnvironmentPatch> = [];
+
+interface EnvironmentDisclosureEntry {
+  readonly patchesOpen: boolean;
+  readonly expandedPatchIds: ReadonlyArray<string>;
+}
+
+const DEFAULT_DISCLOSURE_ENTRY: EnvironmentDisclosureEntry = {
+  patchesOpen: false,
+  expandedPatchIds: [],
+};
+
+interface EnvironmentDisclosureStore {
+  readonly entries: ReadonlyMap<EnvironmentId, EnvironmentDisclosureEntry>;
+  readonly update: (
+    environmentId: EnvironmentId,
+    updater: (current: EnvironmentDisclosureEntry) => EnvironmentDisclosureEntry,
+  ) => void;
+}
+
+const EnvironmentDisclosureContext = createContext<EnvironmentDisclosureStore | null>(null);
+
+export function EnvironmentDisclosureProvider({ children }: { readonly children: ReactNode }) {
+  const [entries, setEntries] = useState<ReadonlyMap<EnvironmentId, EnvironmentDisclosureEntry>>(
+    () => new Map(),
+  );
+  const update = (
+    environmentId: EnvironmentId,
+    updater: (current: EnvironmentDisclosureEntry) => EnvironmentDisclosureEntry,
+  ) => {
+    setEntries((prev) => {
+      const current = prev.get(environmentId) ?? DEFAULT_DISCLOSURE_ENTRY;
+      const next = new Map(prev);
+      next.set(environmentId, updater(current));
+      return next;
+    });
+  };
+  return (
+    <EnvironmentDisclosureContext value={{ entries, update }}>
+      {children}
+    </EnvironmentDisclosureContext>
+  );
+}
+
+export function useEnvironmentDisclosure(environmentId: EnvironmentId) {
+  const store = useContext(EnvironmentDisclosureContext);
+  const [localEntry, setLocalEntry] =
+    useState<EnvironmentDisclosureEntry>(DEFAULT_DISCLOSURE_ENTRY);
+
+  const entry = store ? (store.entries.get(environmentId) ?? DEFAULT_DISCLOSURE_ENTRY) : localEntry;
+  const apply = (updater: (current: EnvironmentDisclosureEntry) => EnvironmentDisclosureEntry) => {
+    if (store) {
+      store.update(environmentId, updater);
+    } else {
+      setLocalEntry(updater);
+    }
+  };
+
+  return {
+    patchesOpen: entry.patchesOpen,
+    expandedPatchIds: entry.expandedPatchIds,
+    setPatchesOpen: (next: boolean | ((open: boolean) => boolean)) =>
+      apply((current) => ({
+        ...current,
+        patchesOpen: typeof next === "function" ? next(current.patchesOpen) : next,
+      })),
+    togglePatchDetail: (patchId: string) =>
+      apply((current) => ({
+        ...current,
+        expandedPatchIds: current.expandedPatchIds.includes(patchId)
+          ? current.expandedPatchIds.filter((id) => id !== patchId)
+          : [...current.expandedPatchIds, patchId],
+      })),
+  };
+}
+
+export function EnvironmentPatchesToggle({
+  panelId,
+  open,
+  patchCount,
+  showCount,
+  onToggle,
+}: {
+  readonly panelId: string;
+  readonly open: boolean;
+  readonly patchCount: number;
+  readonly showCount: boolean;
+  readonly onToggle: () => void;
+}) {
+  const gt = useGT();
+  return (
+    <>
+      <span aria-hidden className="shrink-0">
+        ·
+      </span>
+      <button
+        type="button"
+        aria-expanded={open}
+        aria-controls={panelId}
+        onClick={onToggle}
+        className="inline-flex shrink-0 items-center gap-0.5 rounded-sm text-muted-foreground outline-none hover:text-foreground focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-ring"
+      >
+        {showCount && patchCount > 0 ? (
+          gt("{count, plural, one {# patch} other {# patches}}", { count: patchCount })
+        ) : (
+          <T>Patches</T>
+        )}
+        <ChevronRightIcon
+          aria-hidden
+          className={cn(
+            "size-3 shrink-0 transition-transform duration-150 motion-reduce:transition-none",
+            open && "rotate-90",
+          )}
+        />
+      </button>
+    </>
+  );
+}
+
+export function EnvironmentPatchesList({
+  environmentLabel,
+  connected,
+  descriptorKnown,
+  patches,
+  expandedPatchIds,
+  onTogglePatchDetail,
+}: {
+  readonly environmentLabel: string;
+  readonly connected: boolean;
+  readonly descriptorKnown: boolean;
+  readonly patches: ReadonlyArray<ExecutionEnvironmentPatch>;
+  readonly expandedPatchIds: ReadonlyArray<string>;
+  readonly onTogglePatchDetail: (patchId: string) => void;
+}) {
+  const gt = useGT();
+  if (!connected && !descriptorKnown) {
+    return (
+      <p className="py-3 text-xs text-muted-foreground">
+        <T>Connect to view installed patches.</T>
+      </p>
+    );
+  }
+  if (patches.length === 0) {
+    return (
+      <p className="py-3 text-xs text-muted-foreground">
+        <T>No patches installed on this environment.</T>
+      </p>
+    );
+  }
+  return (
+    <ol
+      aria-label={gt("Patches installed on {environment}", {
+        environment: environmentLabel,
+      })}
+      className="divide-y divide-border/40 py-1"
+    >
+      {patches.map((patch) => {
+        const { headline, included } = splitPatchDescription(patch);
+        const expanded = expandedPatchIds.includes(patch.id);
+        return (
+          <li key={patch.id} className="py-2">
+            <p className="flex flex-wrap items-center gap-1.5 text-xs font-medium text-foreground">
+              <span>{patch.title}</span>
+              <span className="rounded-sm bg-muted px-1 font-mono text-2xs font-normal text-muted-foreground">
+                v{patch.version}
+              </span>
+              <span className="font-mono text-2xs font-normal text-muted-foreground">
+                {patch.id}
+              </span>
+            </p>
+            {headline !== "" ? (
+              <p className="mt-0.5 text-2xs leading-relaxed text-muted-foreground">{headline}</p>
+            ) : null}
+            {expanded && included.length > 0 ? (
+              <ul className="mt-1.5 list-disc space-y-1 pl-4 text-2xs text-muted-foreground">
+                {included.map((feature) => (
+                  <li key={feature}>{feature}</li>
+                ))}
+              </ul>
+            ) : null}
+            {included.length > 0 ? (
+              <button
+                type="button"
+                aria-expanded={expanded}
+                className="mt-1 inline-block rounded-xs text-2xs text-muted-foreground underline underline-offset-2 outline-none hover:text-foreground focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-ring"
+                onClick={() => onTogglePatchDetail(patch.id)}
+              >
+                {expanded ? gt("Hide included features") : gt("What’s included")}
+              </button>
+            ) : null}
+          </li>
+        );
+      })}
+    </ol>
+  );
+}
+
+export function LocalEnvironmentRow({
+  environment,
+}: {
+  readonly environment: EnvironmentPresentation;
+}) {
+  const m = useMessages();
+  const { patchesOpen, setPatchesOpen, expandedPatchIds, togglePatchDetail } =
+    useEnvironmentDisclosure(environment.environmentId);
+  const descriptor = environment.serverConfig?.environment ?? null;
+  const patches = descriptor?.patches ?? EMPTY_ENVIRONMENT_PATCHES;
+  const isConnected = environment.connection.phase === "connected";
+  const panelId = `environment-patches-${environment.environmentId}`;
+
+  return (
+    <EnvironmentRow
+      kind={resolveEnvironmentMachineKind(environment.serverConfig)}
+      label={environment.label}
+      subtitle={
+        <span className="flex min-w-0 flex-wrap items-center gap-1">
+          <span className="min-w-0 truncate">
+            <EnvironmentTransportLabel environment={environment} />
+            {" · "}
+            {connectionStatusTitle(environment.connection, m)}
+          </span>
+          {descriptor ? (
+            <>
+              <span aria-hidden className="shrink-0">
+                ·
+              </span>
+              <span className="shrink-0">{descriptor.serverVersion}</span>
+            </>
+          ) : null}
+          <EnvironmentPatchesToggle
+            panelId={panelId}
+            open={patchesOpen}
+            patchCount={patches.length}
+            showCount={isConnected || descriptor !== null}
+            onToggle={() => setPatchesOpen((open) => !open)}
+          />
+        </span>
+      }
+      detail={
+        patchesOpen ? (
+          <div id={panelId} className="mt-2 border-t border-border/50">
+            <EnvironmentPatchesList
+              environmentLabel={environment.label}
+              connected={isConnected}
+              descriptorKnown={descriptor !== null}
+              patches={patches}
+              expandedPatchIds={expandedPatchIds}
+              onTogglePatchDetail={togglePatchDetail}
+            />
+          </div>
+        ) : null
+      }
+    />
+  );
+}
