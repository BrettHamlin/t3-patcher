diff --git a/apps/web/src/state/desktopPatchUpdate.test.ts b/apps/web/src/state/desktopPatchUpdate.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..248e9cf4728d836aa04b6233ef26645b90da4f98
--- /dev/null
+++ b/apps/web/src/state/desktopPatchUpdate.test.ts
@@ -0,0 +1,53 @@
+import type { DesktopPatchUpdateState } from "@t3tools/contracts";
+import * as AsyncResult from "effect/reactivity/AsyncResult";
+import { AtomRegistry } from "effect/reactivity";
+import { describe, expect, it, vi } from "vite-plus/test";
+
+import { createDesktopPatchUpdateStateAtom } from "./desktopPatchUpdate";
+
+const idle: DesktopPatchUpdateState = {
+  status: "idle",
+  updates: [],
+  t3Version: null,
+  steps: [],
+  message: null,
+  errorContext: null,
+  logPath: null,
+  checkedAt: null,
+};
+
+describe("desktopPatchUpdateStateAtom", () => {
+  it("starts from the main process's state, then follows each change it sends", async () => {
+    let listener: ((state: DesktopPatchUpdateState) => void) | undefined;
+    const atom = createDesktopPatchUpdateStateAtom(() => ({
+      getPatchUpdateState: () => Promise.resolve(idle),
+      onPatchUpdateState: (next) => {
+        listener = next;
+        return () => undefined;
+      },
+    }));
+    const registry = AtomRegistry.make();
+    registry.mount(atom);
+    const current = () => AsyncResult.getOrElse(registry.get(atom), () => null);
+
+    await vi.waitFor(() => expect(current()).toEqual(idle));
+    const available: DesktopPatchUpdateState = {
+      ...idle,
+      status: "available",
+      updates: [{ id: "picks", title: "Picks", installedVersion: 1, availableVersion: 2 }],
+    };
+    listener?.(available);
+    await vi.waitFor(() => expect(current()).toEqual(available));
+    registry.dispose();
+  });
+
+  it("is null outside the desktop app", async () => {
+    const atom = createDesktopPatchUpdateStateAtom(() => undefined);
+    const registry = AtomRegistry.make();
+    registry.mount(atom);
+    await vi.waitFor(() =>
+      expect(AsyncResult.getOrElse(registry.get(atom), () => idle)).toEqual(null),
+    );
+    registry.dispose();
+  });
+});
diff --git a/apps/web/src/state/desktopPatchUpdate.ts b/apps/web/src/state/desktopPatchUpdate.ts
new file mode 100644
index 0000000000000000000000000000000000000000..95b07c57cf156aa40dfb5287412735d8e6e54620
--- /dev/null
+++ b/apps/web/src/state/desktopPatchUpdate.ts
@@ -0,0 +1,96 @@
+import { useAtomValue } from "@effect/atom-react";
+import type { DesktopBridge, DesktopPatchUpdateState } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Queue from "effect/Queue";
+import * as Schema from "effect/Schema";
+import * as Stream from "effect/Stream";
+import * as AsyncResult from "effect/reactivity/AsyncResult";
+import { Atom } from "effect/reactivity";
+import { msg } from "gt-react";
+
+import { m } from "../i18n/messages";
+
+type DesktopPatchUpdateBridge = Pick<DesktopBridge, "getPatchUpdateState" | "onPatchUpdateState">;
+
+const INITIAL_STATE_READ_ATTEMPT_COUNT = 3;
+
+export class DesktopPatchUpdateStateReadError extends Schema.TaggedError<DesktopPatchUpdateStateReadError>()(
+  "DesktopPatchUpdateStateReadError",
+  {
+    attemptCount: Schema.Number,
+    cause: Schema.Defect(),
+  },
+) {
+  override get message(): string {
+    return m(
+      msg("Failed to read the initial patch update state after {count} attempts.", {
+        count: this.attemptCount,
+      }),
+    );
+  }
+}
+
+function getDesktopPatchUpdateBridge(): DesktopPatchUpdateBridge | undefined {
+  return typeof window === "undefined" ? undefined : window.desktopBridge;
+}
+
+export function createDesktopPatchUpdateStateAtom(
+  getBridge: () => DesktopPatchUpdateBridge | undefined,
+) {
+  const updates = Stream.callback<DesktopPatchUpdateState | null>((queue) =>
+    Effect.gen(function* () {
+      const bridge = getBridge();
+      if (!bridge) {
+        Queue.offerUnsafe(queue, null);
+        return yield* Effect.never;
+      }
+
+      let receivedUpdate = false;
+      yield* Effect.acquireRelease(
+        Effect.sync(() =>
+          bridge.onPatchUpdateState((state) => {
+            receivedUpdate = true;
+            Queue.offerUnsafe(queue, state);
+          }),
+        ),
+        (unsubscribe) => Effect.sync(unsubscribe),
+      );
+
+      const initialState = yield* Effect.tryPromise({
+        try: () => bridge.getPatchUpdateState(),
+        catch: (cause) =>
+          new DesktopPatchUpdateStateReadError({
+            attemptCount: INITIAL_STATE_READ_ATTEMPT_COUNT,
+            cause,
+          }),
+      }).pipe(
+        Effect.retry({ times: INITIAL_STATE_READ_ATTEMPT_COUNT - 1 }),
+        Effect.catchTags({
+          DesktopPatchUpdateStateReadError: (error) =>
+            Effect.logError(error.message, {
+              error,
+              errorTag: error._tag,
+              attemptCount: error.attemptCount,
+            }).pipe(Effect.as(null)),
+        }),
+      );
+      if (!receivedUpdate && initialState !== null) {
+        Queue.offerUnsafe(queue, initialState);
+      }
+
+      return yield* Effect.never;
+    }),
+  );
+
+  return Atom.make(updates, { initialValue: null }).pipe(
+    Atom.keepAlive,
+    Atom.withLabel("desktop:patch-update-state"),
+  );
+}
+
+const desktopPatchUpdateStateAtom = createDesktopPatchUpdateStateAtom(getDesktopPatchUpdateBridge);
+
+/** Patch updates on a build made by T3 Patcher; null before the first read, or outside the desktop app. */
+export function useDesktopPatchUpdateState(): DesktopPatchUpdateState | null {
+  return AsyncResult.getOrElse(useAtomValue(desktopPatchUpdateStateAtom), () => null);
+}
