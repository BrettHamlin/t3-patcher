+import { assert, describe, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+
+import type * as DesktopPatchUpdates from "./DesktopPatchUpdates.ts";
+import * as DesktopUpdates from "./DesktopUpdates.ts";
+import { flushCallbacks, makeHarness } from "./updatesTestHarness.ts";
+
+const patched: DesktopPatchUpdates.InstalledRecord = {
+  t3Version: "1.2.3",
+  patches: [{ id: "journey-kit", version: 1 }],
+  installedAt: "2026-11-24T10:00:00.000Z",
+  feed: "https://raw.githubusercontent.com/BrettHamlin/t3-patcher/main/patches/index.json",
+  update: { command: ["/usr/bin/python3", "/repo/scripts/patcher.py", "update"], cwd: "/repo" },
+};
+
+// No app-update.yml and no mock feed, as in a build the patcher made.
+const noMockFeed = { T3CODE_DESKTOP_MOCK_UPDATES: "false" };
+
+describe("DesktopUpdates on a patched build", () => {
+  it.effect(
+    "checks T3 Code's GitHub releases, which a patched build has no app-update.yml for",
+    () => {
+      const harness = makeHarness({ patched, env: noMockFeed });
+      return Effect.scoped(
+        Effect.gen(function* () {
+          const updates = yield* DesktopUpdates.DesktopUpdates;
+          yield* updates.configure;
+          const checked = yield* updates.check("web-ui");
+          const state = yield* updates.getState;
+          assert.deepStrictEqual(
+            {
+              feeds: harness.feedUrls(),
+              checked: checked.checked,
+              checks: harness.checkCount(),
+              enabled: state.enabled,
+            },
+            {
+              feeds: [{ provider: "github", owner: "pingdotgg", repo: "t3code" }],
+              checked: true,
+              checks: 1,
+              enabled: true,
+            },
+          );
+        }),
+      ).pipe(Effect.provide(harness.layer));
+    },
+  );
+
+  it.effect(
+    "installs an offered T3 Code version through the patcher, never electron-updater's download or install",
+    () => {
+      const harness = makeHarness({ patched, env: noMockFeed });
+      return Effect.scoped(
+        Effect.gen(function* () {
+          const updates = yield* DesktopUpdates.DesktopUpdates;
+          yield* updates.configure;
+          harness.emit("update-available", { version: "1.2.4" });
+          yield* flushCallbacks;
+          const download = yield* updates.download;
+          const install = yield* updates.install;
+          const prepared = yield* updates.installPrepared("1.2.4");
+          assert.deepStrictEqual(
+            {
+              results: [download, install, prepared].map((result) => [
+                result.accepted,
+                result.completed,
+                result.state.status,
+                result.state.availableVersion,
+              ]),
+              patcherRuns: harness.patcherRuns,
+              downloads: harness.downloadCount(),
+              quitAndInstalls: harness.quitAndInstalls(),
+              installSteps: harness.installSteps,
+              restartMarkers: [...harness.updateRestartMarkers],
+            },
+            {
+              results: [
+                [true, false, "available", "1.2.4"],
+                [true, false, "available", "1.2.4"],
+                [true, false, "available", "1.2.4"],
+              ],
+              patcherRuns: ["1.2.4", "1.2.4", "1.2.4"],
+              downloads: 0,
+              quitAndInstalls: 0,
+              installSteps: ["patcher", "patcher", "patcher"],
+              restartMarkers: [],
+            },
+          );
+        }),
+      ).pipe(Effect.provide(harness.layer));
+    },
+  );
+
+  it.effect("leaves an unpatched build without a feed off, as before", () => {
+    const harness = makeHarness({ env: noMockFeed });
+    return Effect.scoped(
+      Effect.gen(function* () {
+        const updates = yield* DesktopUpdates.DesktopUpdates;
+        yield* updates.configure;
+        const state = yield* updates.getState;
+        assert.deepStrictEqual(
+          { status: state.status, message: state.message, feeds: harness.feedUrls() },
+          {
+            status: "disabled",
+            message: "Automatic updates are not available because no update feed is configured.",
+            feeds: [],
+          },
+        );
+      }),
+    ).pipe(Effect.provide(harness.layer));
+  });
+});
