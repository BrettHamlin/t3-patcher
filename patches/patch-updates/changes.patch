index 0000000000000000000000000000000000000000..d9ffd83c75a772c0c25034f3878da245685d8686
--- /dev/null
+++ b/apps/web/src/components/sidebar/patchUpdate.logic.ts
@@ -0,0 +1,68 @@
+import type {
+  DesktopPatchUpdateState,
+  DesktopPatchUpdateStep,
+  DesktopUpdateState,
+} from "@t3tools/contracts";
+
+/** One thing the patcher's update changes: T3 Code or a patch, from one version to another. */
+export interface PatchUpdateRow {
+  readonly key: string;
+  readonly name: string;
+  readonly from: string;
+  readonly to: string;
+}
+
+/** The T3 Code version the app's own check offers, or null when it offers none. */
+export function offeredAppVersion(app: DesktopUpdateState | null): string | null {
+  if (app === null || (app.status !== "available" && app.status !== "downloaded")) return null;
+  return app.downloadedVersion ?? app.availableVersion;
+}
+
+/**
+ * Whether a patched build's pill shows the patcher's update: a patch or T3 Code update is offered, one is running,
+ * or the last one failed. Unpatched builds (disabled) keep the app's own pill.
+ */
+export function showsPatchUpdates(
+  patch: DesktopPatchUpdateState | null,
+  app: DesktopUpdateState | null,
+): patch is DesktopPatchUpdateState {
+  if (patch === null || patch.status === "disabled") return false;
+  return (
+    patch.updates.length > 0 ||
+    patch.status === "updating" ||
+    patch.errorContext === "update" ||
+    offeredAppVersion(app) !== null
+  );
+}
+
+/** T3 Code first, when its version changes, then each patch: "Picks 1 → 2". */
+export function patchUpdateRows(
+  patch: DesktopPatchUpdateState,
+  app: DesktopUpdateState | null,
+): ReadonlyArray<PatchUpdateRow> {
+  const appVersion = patch.status === "updating" ? patch.t3Version : offeredAppVersion(app);
+  return [
+    ...(appVersion === null || app === null
+      ? []
+      : [{ key: "t3code", name: "T3 Code", from: app.currentVersion, to: appVersion }]),
+    ...patch.updates.map((update) => ({
+      key: `patch:${update.id}`,
+      name: update.title,
+      from: String(update.installedVersion),
+      to: String(update.availableVersion),
+    })),
+  ];
+}
+
+/** Steps finished (passed, failed or skipped) out of all the run's steps. */
+export function patchUpdateProgress(steps: ReadonlyArray<DesktopPatchUpdateStep>): {
+  readonly done: number;
+  readonly total: number;
+} {
+  return {
+    done: steps.filter(
+      (step) => step.status === "passed" || step.status === "failed" || step.status === "skipped",
+    ).length,
+    total: steps.length,
+  };
+}
