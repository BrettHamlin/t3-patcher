+      patchUpdateRows({ ...offered, status: "updating", changes }, app("available", "0.1.12")),
+      patchUpdateRows({ ...offered, status: "error", errorContext: "update", changes }, null),
+      patchUpdateRows({ ...offered, status: "updating" }, app("available", "0.1.12")),
+      patchUpdateRows({ ...offered, status: "updating", changes: [] }, app("available", "0.1.12")),
+      patchUpdateRows(
+        { ...offered, status: "updating", changes: [{ name: "notes", from: "", to: "2" }] },
+        null,
+      ),
+    ]).toEqual([
+      expected,
+      expected,
+      [
+        {
+          key: "t3code",
+          name: "T3 Code",
+          from: "0.1.11",
+          to: "0.1.12",
+          added: false,
+          removed: false,
+        },
+        { key: "patch:picks", name: "Picks", from: "1", to: "2", added: false, removed: false },
+      ],
+      [],
+      [{ key: "change:notes", name: "notes", from: "", to: "2", added: true, removed: false }],
+    ]);
+  });
+
+  it("counts finished steps out of all of them", () => {
+    const step = (status: "pending" | "running" | "passed" | "failed" | "skipped") => ({
+      kind: "check",
+      name: status,
+      status,
+      note: "",
+    });
+    expect(
+      patchUpdateProgress([
+        step("passed"),
+        step("failed"),
+        step("skipped"),
+        step("running"),
+        step("pending"),
+      ]),
+    ).toEqual({ done: 3, total: 5 });
+  });
+});
diff --git a/apps/web/src/components/sidebar/patchUpdate.logic.ts b/apps/web/src/components/sidebar/patchUpdate.logic.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b96dbccac489b96c43fd3737a85ce157472f6a19
--- /dev/null
+++ b/apps/web/src/components/sidebar/patchUpdate.logic.ts
@@ -0,0 +1,99 @@
+import type {
+  DesktopPatchUpdateState,
+  DesktopPatchUpdateStep,
+  DesktopUpdateState,
+} from "@t3tools/contracts";
+
+/** One thing the patcher's update changes: T3 Code or a patch, from one version to another, added or removed. */
+export interface PatchUpdateRow {
+  readonly key: string;
+  readonly name: string;
+  readonly from: string;
+  readonly to: string;
+  readonly added: boolean;
+  readonly removed: boolean;
+}
+
+/** What to run when the installed record has no update command. */
+export const COMMAND_LINE_UPDATE = "python3 scripts/patcher.py update";
+
+/** The T3 Code version the app's own check offers, or null when it offers none. */
+export function offeredAppVersion(app: DesktopUpdateState | null): string | null {
+  if (app === null || (app.status !== "available" && app.status !== "downloaded")) return null;
+  return app.downloadedVersion ?? app.availableVersion;
+}
+
+/**
+ * Whether a patched build's pill shows the patcher's update: a patch or T3 Code update is offered, one is running,
+ * or the last one failed. Unpatched builds (disabled) keep the app's own pill.
+ */
+export function showsPatchUpdates(
+  patch: DesktopPatchUpdateState | null,
+  app: DesktopUpdateState | null,
+): patch is DesktopPatchUpdateState {
+  if (patch === null || patch.status === "disabled") return false;
+  return (
+    patch.updates.length > 0 ||
+    patch.status === "updating" ||
+    patch.errorContext === "update" ||
+    offeredAppVersion(app) !== null
+  );
+}
+
+/**
+ * T3 Code first, when its version changes, then each patch: "Picks 1 → 2". Once a run has said what it updates
+ * (which can differ from the offer: a newer version, or a patch removed since), that's what's listed.
+ */
+export function patchUpdateRows(
+  patch: DesktopPatchUpdateState,
+  app: DesktopUpdateState | null,
+): ReadonlyArray<PatchUpdateRow> {
+  const ran = patch.status === "updating" || patch.errorContext === "update";
+  // A run's report says what it changes, even when that's nothing; until it does, the offer stands.
+  if (ran && patch.changes !== null) {
+    return patch.changes.map((change) => ({
+      key: `change:${change.name}`,
+      name: patch.updates.find((update) => update.id === change.name)?.title ?? change.name,
+      from: change.from,
+      to: change.to,
+      added: change.from === "",
+      removed: change.to === "removed",
+    }));
+  }
+  const appVersion = patch.status === "updating" ? patch.t3Version : offeredAppVersion(app);
+  return [
+    ...(appVersion === null || app === null
+      ? []
+      : [
+          {
+            key: "t3code",
+            name: "T3 Code",
+            from: app.currentVersion,
+            to: appVersion,
+            added: false,
+            removed: false,
+          },
+        ]),
+    ...patch.updates.map((update) => ({
+      key: `patch:${update.id}`,
+      name: update.title,
+      from: update.installedVersion === null ? "" : String(update.installedVersion),
+      to: String(update.availableVersion),
+      added: update.installedVersion === null,
+      removed: false,
+    })),
+  ];
+}
+
+/** Steps finished (passed, failed or skipped) out of all the run's steps. */
+export function patchUpdateProgress(steps: ReadonlyArray<DesktopPatchUpdateStep>): {
+  readonly done: number;
+  readonly total: number;
+} {
+  return {
+    done: steps.filter(
+      (step) => step.status === "passed" || step.status === "failed" || step.status === "skipped",
+    ).length,
+    total: steps.length,
+  };
+}
