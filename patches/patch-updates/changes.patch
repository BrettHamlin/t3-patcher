+vi.mock("../../state/desktopPatchUpdate", () => ({
+  useDesktopPatchUpdateState: () => mocks.patch,
+}));
+vi.mock("../../state/desktopUpdate", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../../state/desktopUpdate")>()),
+  useDesktopUpdateState: () => mocks.app,
+}));
+vi.mock("../../env", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../../env")>()),
+  isElectron: true,
+}));
+
+const idle: DesktopPatchUpdateState = {
+  status: "idle",
+  updates: [],
+  t3Version: null,
+  steps: [],
+  message: null,
+  errorContext: null,
+  logPath: null,
+  checkedAt: null,
+};
+
+const t3Available: DesktopUpdateState = {
+  enabled: true,
+  status: "available",
+  channel: "latest",
+  currentVersion: "0.1.11",
+  hostArch: "arm64",
+  appArch: "arm64",
+  runningUnderArm64Translation: false,
+  availableVersion: "0.1.12",
+  downloadedVersion: null,
+  releaseNotes: [],
+  omittedReleaseCount: 0,
+  downloadPercent: null,
+  checkedAt: null,
+  message: null,
+  errorContext: null,
+  canRetry: false,
+};
+
+/** The desktop bridge's runPatchUpdate on the window, until disposed. */
+function bridgeWith(runPatchUpdate: () => Promise<DesktopPatchUpdateActionResult>) {
+  Object.assign(window, { desktopBridge: { runPatchUpdate } });
+  return {
+    [Symbol.dispose]: () => {
+      Reflect.deleteProperty(window, "desktopBridge");
+    },
+  };
+}
+
+const texts = (testId: string) =>
+  [...document.querySelectorAll(`[data-testid="${testId}"]`)].map((element) =>
+    element.textContent?.trim(),
+  );
+
+describe("SidebarUpdatePill on a patched build", () => {
+  it("lists the T3 Code and patch updates, and Update runs the patcher for all of them", async () => {
+    mocks.app = t3Available;
+    mocks.patch = {
+      ...idle,
+      status: "available",
+      updates: [{ id: "picks", title: "Picks", installedVersion: 1, availableVersion: 2 }],
+    };
+    const runPatchUpdate = vi.fn<() => Promise<DesktopPatchUpdateActionResult>>(() =>
+      Promise.resolve({ accepted: true, state: { ...idle, status: "updating" } }),
