--- /dev/null
+++ b/apps/desktop/src/ipc/methods/patchUpdates.ts
@@ -0,0 +1,36 @@
+import {
+  DesktopPatchUpdateActionResultSchema,
+  DesktopPatchUpdateStateSchema,
+} from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Schema from "effect/Schema";
+
+import * as DesktopPatchUpdates from "../../updates/DesktopPatchUpdates.ts";
+import * as DesktopUpdates from "../../updates/DesktopUpdates.ts";
+import * as IpcChannels from "../channels.ts";
+import * as DesktopIpc from "../DesktopIpc.ts";
+
+export const getPatchUpdateState = DesktopIpc.makeIpcMethod({
+  channel: IpcChannels.PATCH_UPDATE_GET_STATE_CHANNEL,
+  payload: Schema.Void,
+  result: DesktopPatchUpdateStateSchema,
+  handler: Effect.fn("desktop.ipc.patchUpdates.getState")(function* () {
+    const patchUpdates = yield* DesktopPatchUpdates.DesktopPatchUpdates;
+    return yield* patchUpdates.getState;
+  }),
+});
+
+/** Every patch update, with the T3 Code update the app's own check offers, if any. */
+export const runPatchUpdate = DesktopIpc.makeIpcMethod({
+  channel: IpcChannels.PATCH_UPDATE_RUN_CHANNEL,
+  payload: Schema.Void,
+  result: DesktopPatchUpdateActionResultSchema,
+  handler: Effect.fn("desktop.ipc.patchUpdates.run")(function* () {
+    const patchUpdates = yield* DesktopPatchUpdates.DesktopPatchUpdates;
+    const app = yield* (yield* DesktopUpdates.DesktopUpdates).getState;
+    const offered = app.status === "available" || app.status === "downloaded";
+    return yield* patchUpdates.run({
+      t3Version: offered ? (app.downloadedVersion ?? app.availableVersion) : null,
+    });
+  }),
+});
