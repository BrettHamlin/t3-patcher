+      .launch({
+        command: update.command[0],
+        args: patcherUpdateArgs(update.command, options.t3Version, process.pid),
+        cwd: update.cwd,
+        path: update.path,
+        log: logPath,
+      })
+      .pipe(Effect.result);
+    if (launched._tag === "Failure") {
+      const failed: DesktopPatchUpdateState = {
+        ...updating,
+        status: "error",
+        message: launched.failure.message,
+        errorContext: "update",
+        logPath,
+      };
+      yield* setState(failed);
