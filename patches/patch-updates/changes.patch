+      Effect.catchCause((cause) =>
+        Cause.hasInterruptsOnly(cause)
+          ? Effect.void
+          : logWarning("lost track of the patcher's update"),
+      ),
+      Effect.forkDetach,
+    );
+    return { accepted: true, state: updating };
+  });
