@@ -0,0 +1,150 @@
+import type { DesktopPatchUpdateState, DesktopUpdateState } from "@t3tools/contracts";
+import { thrownErrorMessage } from "@t3tools/client-runtime/errors";
+import { T, useGT, Var } from "gt-react";
+import { useState } from "react";
+
+import { m } from "../../i18n/messages";
+import { cn } from "../../lib/utils";
+import { Button } from "../ui/button";
+import { Popover, PopoverPopup, PopoverTrigger } from "../ui/popover";
+import { SidebarMenuItem } from "../ui/sidebar";
+import { stackedThreadToast, toastManager } from "../ui/toast";
+import { DesktopUpdateStatusIcon } from "./DesktopUpdateStatusIcon";
+import { patchUpdateProgress, patchUpdateRows } from "./patchUpdate.logic";
+
+const STEP_MARK = {
+  pending: "○",
+  running: "◐",
+  passed: "✓",
+  failed: "✕",
+  skipped: "–",
+} as const;
+
+/**
+ * A patched build's update pill: its popover lists the patch updates, and the T3 Code update when there is one,
+ * with one Update button that runs T3 Patcher for all of them and shows its steps as they go.
+ */
+export function SidebarPatchUpdatePill({
+  patch,
+  app,
+}: {
+  readonly patch: DesktopPatchUpdateState;
+  readonly app: DesktopUpdateState | null;
+}) {
+  const gt = useGT();
+  const [isStarting, setIsStarting] = useState(false);
+  const rows = patchUpdateRows(patch, app);
+  const updating = patch.status === "updating";
+  const failed = patch.errorContext === "update" && patch.status === "error";
+  const progress = patchUpdateProgress(patch.steps);
+  const label = updating ? gt("Updating with T3 Patcher…") : gt("Updates available");
+
+  const update = async () => {
+    const bridge = window.desktopBridge;
+    if (!bridge || updating || isStarting) return;
+    setIsStarting(true);
+    const outcome = await bridge.runPatchUpdate().then(
+      (result) => ({ started: result.accepted, reason: result.state.message }),
+      (error: unknown) => ({ started: false, reason: thrownErrorMessage(error, m) ?? null }),
+    );
+    setIsStarting(false);
+    if (outcome.started) return;
+    toastManager.add(
+      stackedThreadToast({
+        type: "error",
+        title: gt("Could not start the update"),
+        description: outcome.reason ?? gt("An unexpected error occurred."),
+      }),
+    );
+  };
+
+  return (
+    <SidebarMenuItem className="ml-auto shrink-0">
+      <Popover>
+        <PopoverTrigger
+          render={
+            <button
+              aria-label={label}
+              className="inline-flex size-8 cursor-pointer items-center justify-center rounded-full bg-sidebar-control-surface text-sidebar-foreground outline-hidden ring-ring transition-colors hover:bg-sidebar-row-hover focus-visible:ring-2 focus-visible:ring-inset"
+              data-testid="patch-update-pill"
+              type="button"
+            >
+              <DesktopUpdateStatusIcon status={updating ? "downloading" : "everything"} />
+            </button>
+          }
+        />
+        <PopoverPopup align="center" aria-label={label} side="top" tooltipStyle>
+          <div
+            className="flex w-fit min-w-56 max-w-[min(24rem,calc(100vw-2rem))] flex-col gap-2 px-1 text-left"
+            data-testid="patch-update-popover"
+          >
+            <div className="text-sm leading-5 font-medium">{label}</div>
+            {rows.length > 0 ? (
+              <ul className="space-y-1 text-xs leading-5">
+                {rows.map((row) => (
+                  <li
+                    className="flex justify-between gap-4"
+                    data-testid="patch-update-row"
+                    key={row.key}
+                  >
+                    <span className="truncate">{row.name}</span>
+                    <span className="shrink-0 text-muted-foreground tabular-nums">
+                      {`${row.from} → ${row.to}`}
+                    </span>
+                  </li>
+                ))}
+              </ul>
+            ) : null}
+            {patch.steps.length > 0 ? (
+              <div className="flex flex-col gap-1">
+                <div className="text-xs leading-4 text-muted-foreground tabular-nums">
+                  <T>
+                    Step <Var>{progress.done}</Var> of <Var>{progress.total}</Var>
+                  </T>
+                </div>
+                <ol className="max-h-48 space-y-0.5 overflow-y-auto text-xs leading-4">
+                  {patch.steps.map((step) => (
+                    <li
+                      className={cn(
+                        "flex gap-1.5",
+                        step.status === "failed" ? "text-destructive-foreground" : undefined,
+                        step.status === "pending" || step.status === "skipped"
+                          ? "text-muted-foreground"
+                          : undefined,
+                      )}
+                      data-testid="patch-update-step"
+                      key={`${step.kind} ${step.name}`}
+                    >
+                      <span aria-hidden>{STEP_MARK[step.status]}</span>
+                      <span className="truncate">{`${step.kind} ${step.name}`}</span>
+                    </li>
+                  ))}
+                </ol>
+              </div>
+            ) : null}
+            {failed && patch.message ? (
+              <div className="text-xs leading-4 text-destructive-foreground" role="alert">
+                <div className="break-words">{patch.message}</div>
+                {patch.logPath ? (
+                  <div className="mt-1 break-all text-muted-foreground">
+                    <T>
+                      Log: <Var>{patch.logPath}</Var>
+                    </T>
+                  </div>
+                ) : null}
+              </div>
+            ) : null}
+            <Button
+              data-testid="patch-update-button"
+              disabled={updating || isStarting}
+              onClick={() => void update()}
+              size="sm"
+            >
+              {updating ? <T>Updating…</T> : <T>Update</T>}
+            </Button>
+          </div>
+        </PopoverPopup>
+      </Popover>
+    </SidebarMenuItem>
+  );
+}
