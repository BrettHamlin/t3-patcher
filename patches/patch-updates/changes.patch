+// Patch updates on a build made by T3 Patcher, which writes <T3 home>/userdata/patcher/installed.json. Only then
+// are the feed's newer versions of the installed patches offered; the patcher's update rebuilds and installs the
+// app, quitting it first and opening it again after.
+import type {
+  DesktopPatchUpdateItem,
+  DesktopPatchUpdateState,
+  DesktopPatchUpdateStep,
+} from "@t3tools/contracts";
+import { DesktopPatchUpdateChangeSchema, DesktopPatchUpdateStepSchema } from "@t3tools/contracts";
+import * as Cause from "effect/Cause";
+import * as Context from "effect/Context";
+import * as DateTime from "effect/DateTime";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Ref from "effect/Ref";
+import * as Schema from "effect/Schema";
+import * as Scope from "effect/Scope";
+import * as HttpClient from "effect/http/HttpClient";
+import * as HttpClientResponse from "effect/http/HttpClientResponse";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+
+import * as DesktopConfig from "../app/DesktopConfig.ts";
+import * as DesktopEnvironment from "../app/DesktopEnvironment.ts";
+import * as DesktopObservability from "../app/DesktopObservability.ts";
+import * as ElectronWindow from "../electron/ElectronWindow.ts";
+import * as IpcChannels from "../ipc/channels.ts";
+
+const STARTUP_DELAY = "15 seconds";
+const POLL_INTERVAL = "4 hours";
+const FEED_TIMEOUT = "20 seconds";
+const REPORT_POLL_INTERVAL = "500 millis";
+
+/** <T3 home>/userdata/patcher/installed.json, as the patcher writes it. */
+export const InstalledRecord = Schema.Struct({
+  t3Version: Schema.String,
+  patches: Schema.Array(Schema.Struct({ id: Schema.String, version: Schema.Number })),
+  installedAt: Schema.String,
+  feed: Schema.String,
+  /** Missing when the patcher was installed without a command to update it: update from the command line. */
+  update: Schema.optionalKey(
+    Schema.Struct({
+      command: Schema.NonEmptyArray(Schema.String),
+      cwd: Schema.String,
+      /** The PATH the patcher ran with, which the command runs with. */
+      path: Schema.String,
+    }),
+  ),
+});
+export type InstalledRecord = typeof InstalledRecord.Type;
+
+/** patches/index.json on the patcher's main branch. */
+export const PatchFeed = Schema.Struct({
+  patches: Schema.Array(
+    Schema.Struct({
+      id: Schema.String,
+      title: Schema.String,
+      summary: Schema.String,
+      version: Schema.Number,
+    }),
+  ),
+});
+export type PatchFeed = typeof PatchFeed.Type;
+
+/** <userdata>/stack.json: which patches are explicitly turned on or off on this machine. */
+const SavedStack = Schema.Struct({
+  entries: Schema.Array(Schema.Struct({ id: Schema.String, enabled: Schema.Boolean })),
+});
+
+/** <userdata>/last-run.json: the patcher's report of its run, rewritten as each step changes. */
+const RunReport = Schema.Struct({
+  version: Schema.String,
+  install: Schema.Boolean,
+  updating: Schema.optionalKey(Schema.Array(DesktopPatchUpdateChangeSchema)),
+  steps: Schema.Array(DesktopPatchUpdateStepSchema),
+});
+const decodeInstalledRecord = Schema.decodeUnknownEffect(Schema.fromJsonString(InstalledRecord));
+const decodeSavedStack = Schema.decodeUnknownEffect(Schema.fromJsonString(SavedStack));
+const decodeRunReport = Schema.decodeUnknownEffect(Schema.fromJsonString(RunReport));
+
+export class PatcherLaunchError extends Schema.TaggedError<PatcherLaunchError>()(
+  "PatcherLaunchError",
+  { command: Schema.String, cause: Schema.Defect() },
+) {
+  override get message(): string {
+    return `Could not start T3 Patcher (${this.command}).`;
+  }
+}
+
+/** Starts the patcher's update so it outlives this app: the patcher quits the app before replacing it. */
+export class PatcherLauncher extends Context.Service<
+  PatcherLauncher,
+  {
+    /**
+     * Starts `command` with `args` in `cwd` and `path` as its PATH, its output appended to `log`; `exited` waits for
+     * its exit code.
+     */
+    readonly launch: (input: {
+      readonly command: string;
+      readonly args: ReadonlyArray<string>;
+      readonly cwd: string;
+      readonly path: string;
+      readonly log: string;
+    }) => Effect.Effect<{ readonly exited: Effect.Effect<number> }, PatcherLaunchError>;
+  }
+>()("@t3tools/desktop/updates/DesktopPatchUpdates/PatcherLauncher") {}
+
+/**
+ * A detached process in its own scope that nothing closes, so the app's shutdown never kills it. `/bin/sh` appends
+ * its output to the log and execs it.
+ */
+export const layerPatcherLauncher = Layer.effect(
+  PatcherLauncher,
+  Effect.gen(function* () {
+    const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
+    return PatcherLauncher.of({
+      launch: Effect.fn("desktop.patchUpdates.launch")(function* (input) {
+        const outliving = yield* Scope.make();
+        const handle = yield* spawner
+          .spawn(
+            ChildProcess.make(
+              "/bin/sh",
+              [
+                "-c",
+                'log=$1; shift; exec "$@" >>"$log" 2>&1',
+                "sh",
+                input.log,
+                input.command,
+                ...input.args,
+              ],
+              {
+                cwd: input.cwd,
+                // The PATH the patcher ran with: this app's own (from Finder, /usr/bin:/bin) lacks its tools.
+                env: { PATH: input.path },
+                extendEnv: true,
+                detached: true,
+                stdin: "ignore",
+                stdout: "ignore",
+                stderr: "ignore",
+              },
+            ),
+          )
+          .pipe(
+            Scope.provide(outliving),
+            Effect.mapError((cause) => new PatcherLaunchError({ command: input.command, cause })),
+          );
+        return { exited: handle.exitCode.pipe(Effect.orElseSucceed(() => -1)) };
+      }),
+    });
+  }),
+);
+
+export class DesktopPatchUpdates extends Context.Service<
+  DesktopPatchUpdates,
+  {
+    /** The patcher's installed record: present only on a patched build. */
+    readonly installed: Option.Option<InstalledRecord>;
+    readonly getState: Effect.Effect<DesktopPatchUpdateState>;
+    /** Starts the feed checks: 15 seconds after start, then every 4 hours, as for app updates. */
+    readonly configure: Effect.Effect<void, never, Scope.Scope>;
+    readonly check: (reason: string) => Effect.Effect<DesktopPatchUpdateState>;
+    /**
+     * Runs the patcher's update for every patch update, and for T3 Code `t3Version` when given. Refused (not
+     * accepted) on an unpatched build; accepted without starting another while one runs.
+     */
+    readonly run: (options: {
+      readonly t3Version: string | null;
+    }) => Effect.Effect<{ readonly accepted: boolean; readonly state: DesktopPatchUpdateState }>;
+  }
+>()("@t3tools/desktop/updates/DesktopPatchUpdates") {}
+
+const { logInfo, logWarning } = DesktopObservability.makeComponentLogger("desktop-patch-updates");
+
+/** Without an update command in the installed record, the popover says to run this instead. */
+export const COMMAND_LINE_UPDATE = "python3 scripts/patcher.py update";
+
+const disabledPatchUpdateState: DesktopPatchUpdateState = {
+  status: "disabled",
+  updates: [],
+  runnable: false,
+  t3Version: null,
+  changes: null,
+  steps: [],
+  message: null,
+  errorContext: null,
+  logPath: null,
+  checkedAt: null,
+};
+
+/**
+ * Newer versions of installed patches, plus newly published patches not yet installed, except any patch explicitly
+ * turned off in `stack.json`.
+ */
+function patchUpdatesFrom(
+  installed: InstalledRecord,
+  feed: PatchFeed,
+  disabled: ReadonlySet<string> = new Set(),
+): ReadonlyArray<DesktopPatchUpdateItem> {
+  const installedIds = new Set(installed.patches.map((patch) => patch.id));
+  const bumped = installed.patches.flatMap((patch) => {
+    if (disabled.has(patch.id)) return [];
+    const published = feed.patches.find((entry) => entry.id === patch.id);
+    return published !== undefined && published.version > patch.version
+      ? [
+          {
+            id: patch.id,
+            title: published.title,
+            installedVersion: patch.version,
+            availableVersion: published.version,
+          },
+        ]
+      : [];
+  });
+  const added = feed.patches
+    .filter((entry) => !installedIds.has(entry.id) && !disabled.has(entry.id))
+    .map((published) => ({
+      id: published.id,
+      title: published.title,
+      installedVersion: null,
+      availableVersion: published.version,
+    }));
+  return [...bumped, ...added];
+}
+
+/** The arguments the update runs with: the record's command, the T3 Code version to build, and this app's pid. */
+function patcherUpdateArgs(
+  command: ReadonlyArray<string>,
+  t3Version: string | null,
+  pid: number,
+): ReadonlyArray<string> {
+  return [
+    ...command.slice(1),
+    ...(t3Version === null ? [] : ["--t3", t3Version]),
+    "--relaunch",
+    String(pid),
+  ];
+}
+
+/** The last `count` lines of `text` with something on them, joined. */
+function lastLines(text: string, count: number): string {
+  return text
+    .split("\n")
+    .filter((line) => line.trim() !== "")
+    .slice(-count)
+    .join("\n");
+}
+
+/** "failed at <step>: <note>", or null while no step has failed. */
+function failedStepMessage(steps: ReadonlyArray<DesktopPatchUpdateStep>): string | null {
+  const failed = steps.find((step) => step.status === "failed");
+  return failed === undefined ? null : `failed at ${failed.name}: ${failed.note}`;
+}
+
+const make = Effect.gen(function* () {
+  const config = yield* DesktopConfig.DesktopConfig;
+  const environment = yield* DesktopEnvironment.DesktopEnvironment;
+  const fileSystem = yield* FileSystem.FileSystem;
+  const httpClient = yield* HttpClient.HttpClient;
+  const launcher = yield* PatcherLauncher;
+  const electronWindow = yield* ElectronWindow.ElectronWindow;
+  const path = environment.path;
+
+  const userdata = path.join(environment.baseDir, "userdata", "patcher");
+  const installed = yield* fileSystem
+    .readFileString(path.join(userdata, "installed.json"))
+    .pipe(Effect.flatMap(decodeInstalledRecord), Effect.option);
+  const feedUrl = Option.map(installed, (record) =>
+    Option.getOrElse(config.patchUpdateFeed, () => record.feed),
+  );
+  const reportPath = path.join(userdata, "last-run.json");
+  const logPath = path.join(userdata, "update.log");
+
+  const initial: DesktopPatchUpdateState = Option.isNone(installed)
+    ? disabledPatchUpdateState
+    : config.disableAutoUpdate
+      ? {
+          ...disabledPatchUpdateState,
+          message: "Patch updates are disabled by the T3CODE_DISABLE_AUTO_UPDATE setting.",
+        }
+      : {
+          ...disabledPatchUpdateState,
+          status: "idle",
+          runnable: installed.value.update !== undefined,
+        };
+  // The state, and its generation: each update run starts a new one, and a check started in an earlier one is out of
+  // date when it ends. One Ref, so a run's reservation and a check's start or result are each one atomic step.
+  const core = yield* Ref.make({ state: initial, generation: 0 });
+  const getState = Ref.get(core).pipe(Effect.map(({ state }) => state));
+  const publish = (state: DesktopPatchUpdateState) =>
+    electronWindow.sendAll(IpcChannels.PATCH_UPDATE_STATE_CHANNEL, state);
+  const setState = (state: DesktopPatchUpdateState) =>
+    Ref.update(core, (held) => ({ ...held, state })).pipe(Effect.andThen(publish(state)));
+  const now = DateTime.now.pipe(Effect.map(DateTime.formatIso));
+
+  const check = Effect.fn("desktop.patchUpdates.check")(function* (reason: string) {
+    if (Option.isNone(installed) || Option.isNone(feedUrl)) return yield* getState;
+    // Not while a run is reserved or going; otherwise "checking", in this generation.
+    const started = yield* Ref.modify(core, (held) => {
+      if (held.state.status === "disabled" || held.state.status === "updating")
+        return [undefined, held];
+      const checking: DesktopPatchUpdateState = { ...held.state, status: "checking" };
+      return [
+        { generation: held.generation, state: checking },
+        { ...held, state: checking },
+      ];
+    });
+    if (started === undefined) return yield* getState;
+    yield* publish(started.state);
+    yield* logInfo("checking for patch updates", { reason });
