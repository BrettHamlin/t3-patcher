+          failed: shown,
+          afterExit: shown,
+          args: [
+            [
+              "/repo/scripts/patcher.py",
+              "update",
+              "--userdata",
+              "/u",
+              "--relaunch",
+              String(process.pid),
+            ],
+          ],
+        },
+      );
+    }),
+  );
+
+  it.effect("says the patcher stopped when it exits before reporting a result", () =>
+    Effect.gen(function* () {
+      const { service, exit } = yield* setup({ installed: installedRecord });
+      yield* service.run({ t3Version: null });
+      yield* Deferred.succeed(exit, 2);
+      yield* Effect.yieldNow;
+      assert.deepStrictEqual(withoutTime(yield* service.getState), {
