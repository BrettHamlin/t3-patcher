diff --git a/apps/desktop/src/updates/DesktopPatchUpdates.test.ts b/apps/desktop/src/updates/DesktopPatchUpdates.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0cae54d43da02cb5da75f616e88d8e1b80c1df18
--- /dev/null
+++ b/apps/desktop/src/updates/DesktopPatchUpdates.test.ts
@@ -0,0 +1,446 @@
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { assert, describe, it } from "@effect/vitest";
+import type { DesktopPatchUpdateState, DesktopPatchUpdateStep } from "@t3tools/contracts";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as PlatformError from "effect/PlatformError";
+import * as HttpClient from "effect/http/HttpClient";
+import * as HttpClientResponse from "effect/http/HttpClientResponse";
+import * as TestClock from "effect/testing/TestClock";
+
+import * as DesktopConfig from "../app/DesktopConfig.ts";
+import * as DesktopEnvironment from "../app/DesktopEnvironment.ts";
+import * as ElectronWindow from "../electron/ElectronWindow.ts";
+import * as DesktopPatchUpdates from "./DesktopPatchUpdates.ts";
+
+const FEED = "https://raw.githubusercontent.com/BrettHamlin/t3-patcher/main/patches/index.json";
+const HOME = "/t3-home";
+const USERDATA = `${HOME}/userdata/patcher`;
+const REPORT = `${USERDATA}/last-run.json`;
+const LOG = `${USERDATA}/update.log`;
+
+const installedRecord: DesktopPatchUpdates.InstalledRecord = {
+  t3Version: "0.1.11",
+  patches: [
+    { id: "journey-kit", version: 1 },
+    { id: "picks", version: 1 },
+  ],
+  installedAt: "2026-11-24T10:00:00.000Z",
+  feed: FEED,
+  update: {
+    command: [
+      "/opt/homebrew/bin/python3",
+      "/repo/scripts/patcher.py",
+      "update",
+      "--userdata",
+      "/u",
+    ],
+    cwd: "/repo",
+  },
+};
+
+const feedOf = (versions: Record<string, number>) => ({
+  patches: Object.entries(versions).map(([id, version]) => ({
+    id,
+    title: `Title ${id}`,
+    summary: `Summary ${id}`,
+    version,
+  })),
+});
+
+interface Launch {
+  readonly command: string;
+  readonly args: ReadonlyArray<string>;
+  readonly cwd: string;
+  readonly log: string;
+}
+
+const idle: DesktopPatchUpdateState = {
+  status: "idle",
+  updates: [],
+  t3Version: null,
+  steps: [],
+  message: null,
+  errorContext: null,
+  logPath: null,
+  checkedAt: null,
+};
+
+/** A T3 home in memory, with `installed` as the patcher's record, and fakes for the feed and the launch. */
+const setup = Effect.fn("setup")(function* (options: {
+  readonly installed?: DesktopPatchUpdates.InstalledRecord;
+  readonly feed?: () => Response;
+  readonly env?: Record<string, string>;
+}) {
+  const files = new Map<string, string>();
+  if (options.installed !== undefined) {
+    files.set(`${USERDATA}/installed.json`, JSON.stringify(options.installed));
+  }
+  const fetched: string[] = [];
+  const launches: Launch[] = [];
+  const sent: DesktopPatchUpdateState[] = [];
+  const exit = yield* Deferred.make<number>();
+  const env = { T3CODE_HOME: HOME, ...options.env };
+  const layer = DesktopPatchUpdates.layer.pipe(
+    Layer.provide(
+      FileSystem.layerNoop({
+        readFileString: (path) => {
+          const text = files.get(path);
+          return text === undefined
+            ? Effect.fail(
+                PlatformError.systemError({
+                  module: "FileSystem",
+                  method: "readFileString",
+                  _tag: "NotFound",
+                  pathOrDescriptor: path,
+                }),
+              )
+            : Effect.succeed(text);
+        },
+        makeDirectory: () => Effect.void,
+      }),
+    ),
+    Layer.provide(
+      Layer.succeed(
+        HttpClient.HttpClient,
+        HttpClient.make((request) =>
+          Effect.sync(() => {
+            fetched.push(request.url);
+            return HttpClientResponse.fromWeb(
+              request,
+              options.feed?.() ?? Response.json(feedOf({ "journey-kit": 1, picks: 1 })),
+            );
+          }),
+        ),
+      ),
+    ),
+    Layer.provide(
+      Layer.succeed(DesktopPatchUpdates.PatcherLauncher, {
+        launch: (input) =>
+          Effect.sync(() => {
+            launches.push(input);
+            return { exited: Deferred.await(exit) };
+          }),
+      }),
+    ),
+    Layer.provide(
+      Layer.mock(ElectronWindow.ElectronWindow, {
+        sendAll: (_channel, state) =>
+          Effect.sync(() => {
+            sent.push(state as DesktopPatchUpdateState);
+          }),
+      }),
+    ),
+    Layer.provide(
+      DesktopEnvironment.layer({
+        dirname: "/repo/apps/desktop/src",
+        homeDirectory: HOME,
+        platform: "darwin",
+        processArch: "arm64",
+        appVersion: "0.1.11",
+        appPath: "/repo",
+        isPackaged: true,
+        resourcesPath: "/missing/resources",
+        runningUnderArm64Translation: false,
+      }).pipe(Layer.provide(Layer.mergeAll(NodeServices.layer, DesktopConfig.layerTest(env)))),
+    ),
+    Layer.provide(DesktopConfig.layerTest(env)),
+  );
+  const service = yield* DesktopPatchUpdates.DesktopPatchUpdates.pipe(Effect.provide(layer));
+  const writeReport = (report: unknown) => files.set(REPORT, JSON.stringify(report));
+  /** Lets the report follower read once more, and run what that wakes. */
+  const poll = TestClock.adjust("500 millis").pipe(Effect.andThen(Effect.yieldNow));
+  return { service, fetched, launches, sent, exit, writeReport, poll };
+});
+
+const withoutTime = (state: DesktopPatchUpdateState): DesktopPatchUpdateState => ({
+  ...state,
+  checkedAt: null,
+});
+
+const step = (
+  kind: string,
+  name: string,
+  status: DesktopPatchUpdateStep["status"],
+  note = "",
+): DesktopPatchUpdateStep => ({
+  kind,
+  name,
+  status,
+  note,
+});
+
+describe("DesktopPatchUpdates", () => {
+  it.effect("is off on a build the patcher didn't install: no record, nothing checked or run", () =>
+    Effect.gen(function* () {
+      const { service, fetched, launches } = yield* setup({});
+      const checked = yield* service.check("web-ui");
+      const ran = yield* service.run({ t3Version: "0.1.12" });
+      assert.deepStrictEqual(
+        { installed: service.installed, checked, ran: ran.accepted, fetched, launches },
+        {
+          installed: Option.none(),
+          checked: { ...idle, status: "disabled" },
+          ran: false,
+          fetched: [],
+          launches: [],
+        },
+      );
+    }),
+  );
+
+  it.effect("offers the feed's newer versions of installed patches only", () =>
+    Effect.gen(function* () {
+      const { service, fetched, sent } = yield* setup({
+        installed: installedRecord,
+        feed: () => Response.json(feedOf({ "journey-kit": 1, picks: 2, "not-installed": 5 })),
+      });
+      const checked = yield* service.check("web-ui");
+      const offered: DesktopPatchUpdateState = {
+        ...idle,
+        status: "available",
+        updates: [{ id: "picks", title: "Title picks", installedVersion: 1, availableVersion: 2 }],
+      };
+      assert.deepStrictEqual(
+        {
+          installed: service.installed,
+          checked: withoutTime(checked),
+          sent: sent.map(withoutTime),
+          fetched,
+        },
+        {
+          installed: Option.some(installedRecord),
+          checked: offered,
+          sent: [{ ...idle, status: "checking" }, offered],
+          fetched: [FEED],
+        },
+      );
+      assert.isTrue(checked.checkedAt !== null && !Number.isNaN(Date.parse(checked.checkedAt)));
+    }),
+  );
+
+  it.effect(
+    "is up to date when the feed has no newer versions, and reads the feed the env names",
+    () =>
+      Effect.gen(function* () {
+        const { service, fetched } = yield* setup({
+          installed: installedRecord,
+          env: { T3CODE_PATCH_UPDATE_FEED: "http://127.0.0.1:9/index.json" },
+        });
+        const checked = yield* service.check("web-ui");
+        assert.deepStrictEqual(
+          { checked: withoutTime(checked), fetched },
+          {
+            checked: { ...idle, status: "up-to-date" },
+            fetched: ["http://127.0.0.1:9/index.json"],
+          },
+        );
+      }),
+  );
+
+  it.effect("shows a feed that fails or isn't a feed as a quiet check error", () =>
+    Effect.gen(function* () {
+      const failing = yield* setup({
+        installed: installedRecord,
+        feed: () => new Response("nope", { status: 500 }),
+      });
+      const malformed = yield* setup({
+        installed: installedRecord,
+        feed: () => Response.json({ patches: "no" }),
+      });
+      const checkError: DesktopPatchUpdateState = {
+        ...idle,
+        status: "error",
+        message: "Could not check for patch updates.",
+        errorContext: "check",
+      };
+      assert.deepStrictEqual(
+        [
+          withoutTime(yield* failing.service.check("web-ui")),
+          withoutTime(yield* malformed.service.check("web-ui")),
+        ],
+        [checkError, checkError],
+      );
+    }),
+  );
+
+  it.effect("checks 15 seconds after start, then every 4 hours", () =>
+    Effect.gen(function* () {
+      const { service, fetched } = yield* setup({ installed: installedRecord });
+      yield* service.configure;
+      const counts = [fetched.length];
+      yield* TestClock.adjust("15 seconds");
+      counts.push(fetched.length);
+      yield* TestClock.adjust("4 hours");
+      counts.push(fetched.length);
+      assert.deepStrictEqual(counts, [0, 1, 2]);
+    }).pipe(Effect.scoped),
+  );
+
+  it.effect("stays off when auto-update checks are disabled", () =>
+    Effect.gen(function* () {
+      const { service, fetched } = yield* setup({
+        installed: installedRecord,
+        env: { T3CODE_DISABLE_AUTO_UPDATE: "true" },
+      });
+      yield* service.configure;
+      yield* TestClock.adjust("15 seconds");
+      assert.deepStrictEqual(
+        { state: yield* service.getState, fetched },
+        {
+          state: {
+            ...idle,
+            status: "disabled",
+            message: "Patch updates are disabled by the T3CODE_DISABLE_AUTO_UPDATE setting.",
+          },
+          fetched: [],
+        },
+      );
+    }).pipe(Effect.scoped),
+  );
+
+  it.effect(
+    "runs the record's update command with the T3 version and its pid, and shows the report's steps until it passes",
+    () =>
+      Effect.gen(function* () {
+        const { service, launches, exit, writeReport, poll } = yield* setup({
+          installed: installedRecord,
+          feed: () => Response.json(feedOf({ "journey-kit": 2, picks: 1 })),
+        });
+        writeReport({ version: "0.1.10", install: true, steps: [step("source", "old", "passed")] });
+        yield* service.check("web-ui");
+        const ran = yield* service.run({ t3Version: "0.1.12" });
+        const again = yield* service.run({ t3Version: null });
+        const updates = [
+          {
+            id: "journey-kit",
+            title: "Title journey-kit",
+            installedVersion: 1,
+            availableVersion: 2,
+          },
+        ];
+        const updating: DesktopPatchUpdateState = {
+          ...idle,
+          status: "updating",
+          updates,
+          t3Version: "0.1.12",
+          logPath: LOG,
+        };
+        assert.deepStrictEqual(
+          { ran: { ...ran, state: withoutTime(ran.state) }, again: again.accepted, launches },
+          {
+            ran: { accepted: true, state: updating },
+            again: true,
+            launches: [
+              {
+                command: "/opt/homebrew/bin/python3",
+                args: [
+                  "/repo/scripts/patcher.py",
+                  "update",
+                  "--userdata",
+                  "/u",
+                  "--t3",
+                  "0.1.12",
+                  "--relaunch",
+                  String(process.pid),
+                ],
+                cwd: "/repo",
+                log: LOG,
+              },
+            ],
+          },
+        );
+
+        // The report left by an earlier run isn't this one's.
+        yield* poll;
+        yield* poll;
+        const unchanged = withoutTime(yield* service.getState);
+        const running = [
+          step("pull", "patches", "passed", "abc → def"),
+          step("build", "app", "running"),
+        ];
+        writeReport({ version: "0.1.12", install: true, steps: running });
+        yield* poll;
+        const following = withoutTime(yield* service.getState);
+        const done = [step("pull", "patches", "passed"), step("install", "install", "passed")];
+        writeReport({ version: "0.1.12", install: true, steps: done });
+        yield* Deferred.succeed(exit, 0);
+        yield* Effect.yieldNow;
+        assert.deepStrictEqual(
+          { unchanged, following, finished: withoutTime(yield* service.getState) },
+          {
+            unchanged: updating,
+            following: { ...updating, steps: running },
+            finished: { ...updating, status: "up-to-date", updates: [], steps: done },
+          },
+        );
+      }),
+  );
+
+  it.effect("shows the failed step and the log when the update fails", () =>
+    Effect.gen(function* () {
+      const { service, launches, exit, writeReport, poll } = yield* setup({
+        installed: installedRecord,
+      });
+      yield* service.run({ t3Version: null });
+      const steps = [
+        step("pull", "patches", "passed"),
+        step("build", "app", "failed", "app failed (exit 1; log /w/logs/app.log): boom"),
+        step("install", "install", "skipped"),
+      ];
+      writeReport({ version: "0.1.11", install: true, steps });
+      yield* poll;
+      const failed = withoutTime(yield* service.getState);
+      yield* Deferred.succeed(exit, 1);
+      yield* Effect.yieldNow;
