+
+/** The desktop bridge's runPatchUpdate on the window, until disposed. */
+function bridgeWith(runPatchUpdate: () => Promise<DesktopPatchUpdateActionResult>) {
+  Object.assign(window, { desktopBridge: { runPatchUpdate } });
+  return {
+    [Symbol.dispose]: () => {
+      Reflect.deleteProperty(window, "desktopBridge");
+    },
+  };
