+  return DesktopPatchUpdates.of({
+    installed,
+    getState,
+    configure: Effect.gen(function* () {
+      const state = yield* getState;
+      if (state.status === "disabled") return;
+      yield* Effect.sleep(STARTUP_DELAY).pipe(
+        Effect.andThen(check("startup")),
+        Effect.andThen(
