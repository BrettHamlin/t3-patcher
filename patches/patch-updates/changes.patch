+        { kind: "journey", name: "picks: answers", status: "skipped", note: "" },
+        { kind: "save", name: "save patches", status: "skipped", note: "" },
+        { kind: "install", name: "install", status: "skipped", note: "" },
+      ],
+      message: "failed at app: boom",
+      logPath: "/home/.t3/userdata/patcher/update.log",
+    };
+    await using screen = await render(<SidebarUpdatePill />);
+
+    await userEvent.click(screen.getByRole("button", { name: "Updates available" }));
+    await expect.element(page.getByText("Step 9 of 9")).toBeVisible();
+    expect(texts("patch-update-step")).toEqual([
+      "✓Get patches",
+      "✓Get T3 Code 0.1.12 source",
+      "✓Apply Picks",
+      "✓Apply journey-kit",
+      "✓Check changed files",
+      "✕Build app",
+      "–Run journey picks: answers",
+      "–Save rebased patches",
+      "–Install",
+    ]);
+    await expect
+      .element(page.getByRole("alert"))
+      .toHaveTextContent("failed at app: boomLog: /home/.t3/userdata/patcher/update.log");
+  });
+
+  it("lists what the running update itself changes, removals included", async () => {
+    mocks.app = t3Available;
+    mocks.patch = {
+      ...idle,
+      status: "updating",
+      updates: [{ id: "picks", title: "Picks", installedVersion: 1, availableVersion: 2 }],
+      changes: [
+        { name: "picks", from: "1", to: "3" },
+        { name: "notes", from: "", to: "2" },
+        { name: "journey-kit", from: "1", to: "removed" },
+      ],
+    };
+    await using screen = await render(<SidebarUpdatePill />);
+    await userEvent.click(screen.getByRole("button", { name: "Updating with T3 Patcher…" }));
+    await expect.element(page.getByTestId("patch-update-popover")).toBeVisible();
+    expect(texts("patch-update-row")).toEqual([
+      "Picks1 → 3",
+      "notesadded, version 2",
+      "journey-kit1 → removed",
+    ]);
