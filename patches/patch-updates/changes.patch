diff --git a/patcher/journeys/patch-updates.mjs b/patcher/journeys/patch-updates.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c53348457b16579c3c97d3a26a45351682d80882
--- /dev/null
+++ b/patcher/journeys/patch-updates.mjs
@@ -0,0 +1,192 @@
+// Journey: a patched build's update pill offers a newer patch and T3 Code version; Update runs the patcher's command
+// with both and shows its steps. Both feeds are served here and the command is a stub, so nothing is installed.
+//   T3_PATCHER_APP=<built .app> T3_PATCHER_EVIDENCE=<dir> node patcher/journeys/patch-updates.mjs
+import * as NodeFS from "node:fs";
+import * as NodeHttp from "node:http";
+import * as NodeOS from "node:os";
+import * as NodePath from "node:path";
+
+import { FIXTURE_DB, STEP_TIMEOUT_MS, evidenceDir, journey } from "./support.mjs";
+
+function assertEqual(actual, expected, what) {
+  const [a, e] = [JSON.stringify(actual), JSON.stringify(expected)];
+  if (a !== e) throw new Error(`${what}: expected ${e}, got ${a}`);
+}
+
+async function waitFor(check, what, timeout = STEP_TIMEOUT_MS) {
+  const deadline = Date.now() + timeout;
+  for (;;) {
+    const value = check();
+    if (value !== undefined) return value;
+    if (Date.now() > deadline) throw new Error(`timed out waiting for ${what}`);
+    await new Promise((resolve) => setTimeout(resolve, 200));
+  }
+}
+
+const parent = process.env.T3_PATCHER_TMP || process.env.TMPDIR || NodeOS.tmpdir();
+const root = NodeFS.mkdtempSync(NodePath.join(parent, "t3-patch-updates-"));
+const t3Home = NodePath.join(root, "t3");
+const userdata = NodePath.join(t3Home, "userdata/patcher");
+const argvFile = NodePath.join(root, "stub-argv.json");
+NodeFS.mkdirSync(userdata, { recursive: true });
+NodeFS.copyFileSync(FIXTURE_DB, NodePath.join(t3Home, "userdata/statev2.sqlite"));
+
+// The two feeds: patches/index.json with a newer journey-kit, and T3 Code's latest-mac.yml offering 0.1.12.
+const requests = [];
+const server = NodeHttp.createServer((request, response) => {
+  const path = new URL(request.url ?? "/", "http://localhost").pathname;
+  requests.push(path);
+  if (path === "/index.json") {
+    response.setHeader("content-type", "application/json");
+    response.end(
+      JSON.stringify({
+        patches: [
+          { id: "journey-kit", title: "Journey kit", summary: "Launches built apps.", version: 2 },
+          { id: "patch-updates", title: "Patch updates", summary: "This.", version: 1 },
+          { id: "not-installed", title: "Not installed", summary: "Never offered.", version: 9 },
+        ],
+      }),
+    );
+  } else if (path === "/latest-mac.yml") {
+    response.end(
+      [
+        "version: 0.1.12",
+        "files:",
+        "  - url: T3-Code-0.1.12-arm64.zip",
+        "    sha512: AAAA",
+        "    size: 1",
+        "path: T3-Code-0.1.12-arm64.zip",
+        "sha512: AAAA",
+        "releaseDate: '2026-11-24T00:00:00.000Z'",
+        "",
+      ].join("\n"),
+    );
+  } else {
+    response.statusCode = 404;
+    response.end();
+  }
+});
+await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
+const port = server.address().port;
+const feed = `http://127.0.0.1:${port}/index.json`;
+
+// The update command: records its arguments, then reports a run the way the patcher does, step by step.
+const report = (steps) => JSON.stringify({ version: "0.1.12", install: true, steps });
+const running = [
+  { kind: "pull", name: "patches", status: "passed", note: "1111111 → 2222222" },
+  { kind: "source", name: "T3 Code source", status: "passed", note: "0.1.12 (v0.1.12)" },
+  { kind: "build", name: "app", status: "running", note: "" },
+  { kind: "install", name: "install", status: "pending", note: "" },
+];
+const passed = running.map((step) => ({ ...step, status: "passed" }));
+const stub = NodePath.join(root, "patcher-stub.sh");
+NodeFS.writeFileSync(
+  stub,
+  [
+    "#!/bin/sh",
+    `printf '%s\n' "$@" > '${argvFile}.tmp' && mv '${argvFile}.tmp' '${argvFile}'`,
+    `printf '%s' '${report(running)}' > '${userdata}/last-run.json'`,
+    "sleep 6",
+    `printf '%s' '${report(passed)}' > '${userdata}/last-run.json'`,
+    "",
+  ].join("\n"),
+);
+NodeFS.chmodSync(stub, 0o755);
+NodeFS.writeFileSync(
+  NodePath.join(userdata, "installed.json"),
+  JSON.stringify({
+    t3Version: "0.1.11",
+    patches: [
+      { id: "journey-kit", version: 1 },
+      { id: "patch-updates", version: 1 },
+    ],
+    installedAt: "2026-11-24T10:00:00.000Z",
+    feed: "https://feed.invalid/patches/index.json",
+    update: { command: ["/bin/sh", stub, "update", "--userdata", userdata], cwd: root },
+  }),
+);
+
+try {
+  await journey(
+    "patch-updates",
+    async ({ app, page, screenshot }, step) => {
+      step("waiting for the update pill to offer the patcher's update");
+      const pill = page.getByTestId("patch-update-pill");
+      // The first checks run 15 seconds after start.
+      await pill.waitFor({ timeout: STEP_TIMEOUT_MS });
+      step("opening the popover");
+      await pill.click();
+      const popover = page.getByTestId("patch-update-popover");
+      await popover.waitFor({ timeout: STEP_TIMEOUT_MS });
+      // The patch feed and T3 Code's feed are checked side by side; wait for both rows.
+      await page.getByTestId("patch-update-row").nth(1).waitFor({ timeout: STEP_TIMEOUT_MS });
+      const rows = await page.getByTestId("patch-update-row").allTextContents();
+      assertEqual(rows, ["T3 Code0.1.11 → 0.1.12", "Journey kit1 → 2"], "the listed updates");
+      console.log(await screenshot("patch-updates-available"));
+
+      step("tapping Update");
+      await page.getByTestId("patch-update-button").click();
+      const argv = await waitFor(
+        () =>
+          NodeFS.existsSync(argvFile)
+            ? NodeFS.readFileSync(argvFile, "utf8").trimEnd().split("\n")
+            : undefined,
+        "the update command to run",
+      );
+      assertEqual(
+        argv,
+        [
+          "update",
+          "--userdata",
+          userdata,
+          "--t3",
+          "0.1.12",
+          "--relaunch",
+          String(app.process().pid),
+        ],
+        "the update command's arguments",
+      );
+
+      step("following the run's steps");
+      await page.getByText("Step 2 of 4").waitFor({ timeout: STEP_TIMEOUT_MS });
+      assertEqual(
+        await page.getByTestId("patch-update-step").allTextContents(),
+        ["✓pull patches", "✓source T3 Code source", "◐build app", "○install install"],
+        "the steps while running",
+      );
+      console.log(await screenshot("patch-updates-progress"));
+      await page.getByText("Step 4 of 4").waitFor({ timeout: STEP_TIMEOUT_MS });
+      assertEqual(
+        await page.getByTestId("patch-update-step").allTextContents(),
+        ["✓pull patches", "✓source T3 Code source", "✓build app", "✓install install"],
+        "the steps once passed",
+      );
+      console.log(await screenshot("patch-updates-passed"));
+
+      step("checking only the local feeds were read");
+      assertEqual(
+        [...new Set(requests)].toSorted(),
+        ["/index.json", "/latest-mac.yml"],
+        "the feeds read",
+      );
+    },
+    {
+      seed: false,
+      env: {
+        T3CODE_HOME: t3Home,
+        // Update checks on, against this journey's feeds only.
+        T3CODE_DISABLE_AUTO_UPDATE: "false",
+        T3CODE_DESKTOP_MOCK_UPDATES: "true",
+        T3CODE_DESKTOP_MOCK_UPDATE_SERVER_PORT: String(port),
+        T3CODE_PATCH_UPDATE_FEED: feed,
+      },
+    },
+  );
+} finally {
+  server.close();
+  const logs = NodePath.join(t3Home, "userdata/logs");
+  if (NodeFS.existsSync(logs)) {
+    NodeFS.cpSync(logs, NodePath.join(evidenceDir(), "logs"), { recursive: true });
+  }
+  NodeFS.rmSync(root, { recursive: true, force: true, maxRetries: 5 });
+}
