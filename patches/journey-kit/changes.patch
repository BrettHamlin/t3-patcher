new file mode 100644
index 0000000000000000000000000000000000000000..22df24b98c0ee9f7a7dd2dd0867eaa0e732e312a
--- /dev/null
+++ b/patcher/check.mjs
@@ -0,0 +1,122 @@
+#!/usr/bin/env node
+// Runs patch manifest checks without repeating Vitest files or i18n catalog scans that already
+// passed against the exact same working tree and node_modules state earlier in the run.
+import * as NodeChildProcess from "node:child_process";
+import * as NodeCrypto from "node:crypto";
+import * as NodeFS from "node:fs";
+import * as NodePath from "node:path";
+
+const repoRoot = NodePath.resolve(import.meta.dirname, "..");
+const cacheDir = NodePath.join(repoRoot, "node_modules/.cache");
+const checkChangedReceiptPath = NodePath.join(cacheDir, "patcher-check-changed.json");
+const i18nReceiptPath = NodePath.join(cacheDir, "patcher-i18n.json");
+
+export function computePatcherTreeDigest(root = repoRoot) {
+  const head = NodeChildProcess.execFileSync("git", ["rev-parse", "HEAD"], {
+    cwd: root,
+    encoding: "utf8",
+  }).trim();
+  const status = NodeChildProcess.execFileSync(
+    "git",
+    ["-c", "core.quotePath=false", "status", "--porcelain=v1", "-z", "--untracked-files=all"],
+    { cwd: root },
+  );
+  const hash = NodeCrypto.createHash("sha256");
+  hash.update(`${process.version}\0${head}\0`);
+  hash.update(status);
+
+  const entries = status.toString("utf8").split("\0").filter(Boolean);
+  for (let i = 0; i < entries.length; i += 1) {
+    const entry = entries[i];
+    const code = entry.slice(0, 2);
+    const file = entry.slice(3);
+    if (code.includes("R") || code.includes("C")) {
+      i += 1;
+    }
+    const full = NodePath.join(root, file);
+    hash.update(`\0${file}\0`);
+    try {
+      const stat = NodeFS.statSync(full);
+      if (stat.isFile()) {
+        hash.update(NodeFS.readFileSync(full));
+      }
+    } catch {}
+  }
+
+  for (const meta of ["node_modules/.modules.yaml", "pnpm-lock.yaml"]) {
+    const full = NodePath.join(root, meta);
+    hash.update(`\0${meta}\0`);
+    try {
+      hash.update(NodeFS.readFileSync(full));
+    } catch {}
+  }
+  return hash.digest("hex");
+}
+
+function readJsonSafe(filePath) {
+  try {
+    return JSON.parse(NodeFS.readFileSync(filePath, "utf8"));
+  } catch {
+    return undefined;
+  }
+}
+
+function writeJsonAtomic(filePath, data) {
+  NodeFS.mkdirSync(NodePath.dirname(filePath), { recursive: true });
+  const tmp = `${filePath}.${process.pid}`;
+  NodeFS.writeFileSync(tmp, `${JSON.stringify(data)}\n`);
+  NodeFS.renameSync(tmp, filePath);
+}
+
+function runCommand(command, args, cwd = repoRoot) {
+  const res = NodeChildProcess.spawnSync(command, args, {
+    cwd,
+    stdio: "inherit",
+    env: process.env,
+  });
+  if (res.error) throw res.error;
+  return res.status ?? 1;
+}
+
+if (import.meta.main) {
+  const [subcommand, ...rest] = process.argv.slice(2);
+  if (subcommand === "vitest") {
+    const requested = rest.map((file) =>
+      NodePath.relative(repoRoot, NodePath.resolve(process.cwd(), file))
+        .split(NodePath.sep)
+        .join("/"),
+    );
+    const digest = computePatcherTreeDigest();
+    const receipt = readJsonSafe(checkChangedReceiptPath);
+    const covered =
+      receipt && receipt.treeDigest === digest && Array.isArray(receipt.vitestTests)
+        ? new Set(receipt.vitestTests)
+        : new Set();
+    const remaining = requested.filter((file) => !covered.has(file));
+    if (remaining.length === 0) {
+      console.log(
+        `patcher/check: all ${requested.length} test file(s) already passed in check:changed (${digest.slice(0, 12)}).`,
+      );
+      process.exit(0);
+    }
+    const vpBin = NodePath.join(repoRoot, "node_modules/.bin/vp");
+    process.exit(runCommand(vpBin, ["test", "run", ...remaining], repoRoot));
+  } else if (subcommand === "i18n") {
+    const digest = computePatcherTreeDigest();
+    const receipt = readJsonSafe(i18nReceiptPath);
+    if (receipt && receipt.treeDigest === digest) {
+      console.log(`patcher/check: i18n catalogs already verified for ${digest.slice(0, 12)}.`);
+      process.exit(0);
+    }
+    const code = runCommand(process.execPath, [NodePath.join(repoRoot, "scripts/i18n-check.ts")]);
+    if (code === 0 && computePatcherTreeDigest() === digest) {
+      try {
+        writeJsonAtomic(i18nReceiptPath, { treeDigest: digest });
+      } catch {}
+    }
+    process.exit(code);
+  } else {
+    console.error(`usage: node patcher/check.mjs <vitest|i18n> [files...]`);
+    process.exit(2);
+  }
+}
