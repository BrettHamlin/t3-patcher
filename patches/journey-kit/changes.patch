diff --git a/apps/desktop/src/patcherBackground.test.ts b/apps/desktop/src/patcherBackground.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..603b1de6ce75d138fc0433eeac080a8b2c346282
--- /dev/null
+++ b/apps/desktop/src/patcherBackground.test.ts
@@ -0,0 +1,125 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import {
+  type BackgroundElectronTarget,
+  type BackgroundIpcHost,
+  type BackgroundWindowTarget,
+  installBackgroundHooks,
+} from "./patcherBackground.ts";
+
+describe("installBackgroundHooks", () => {
+  it("hides the Dock, suppresses window activation, locks background throttling off, and answers IPC requests", async () => {
+    let dockHideCalls = 0;
+    let quitCalls = 0;
+    let windowListener: ((_event: unknown, window: BackgroundWindowTarget) => void) | undefined;
+    let messageListener: ((message: unknown) => void) | undefined;
+    let unrefCalls = 0;
+    const replies: Array<unknown> = [];
+    const throttlingCalls: Array<boolean> = [];
+    const resized: Array<readonly [number, number]> = [];
+    let showHandler: (() => void) | undefined;
+
+    const proto: Record<string, unknown> = {
+      show: () => {
+        throw new Error("window.show should be suppressed");
+      },
+      focus: () => {
+        throw new Error("window.focus should be suppressed");
+      },
+    };
+
+    const windowTarget: BackgroundWindowTarget = {
+      isDestroyed: () => false,
+      isVisible: () => false,
+      setContentSize: (width, height) => {
+        resized.push([width, height]);
+      },
+      on: (_event, listener) => {
+        showHandler = listener;
+      },
+      webContents: {
+        setBackgroundThrottling: (allowed) => {
+          throttlingCalls.push(allowed);
+        },
+      },
+    };
+
+    const target: BackgroundElectronTarget = {
+      app: {
+        dock: {
+          hide: () => {
+            dockHideCalls += 1;
+          },
+        },
+        focus: () => {
+          throw new Error("app.focus should be suppressed");
+        },
+        whenReady: () => Promise.resolve(),
+        on: (_event, listener) => {
+          windowListener = listener;
+        },
+        quit: () => {
+          quitCalls += 1;
+        },
+      },
+      BrowserWindow: {
+        prototype: proto,
+        getAllWindows: () => [windowTarget],
+      },
+      dialog: {
+        showErrorBox: () => {
+          throw new Error("dialog.showErrorBox should be suppressed");
+        },
+      },
+    };
+
+    const env: Record<string, string | undefined> = { NODE_CHANNEL_FD: "3" };
+    const host: BackgroundIpcHost = {
+      env,
+      channel: {
+        unref: () => {
+          unrefCalls += 1;
+        },
+      },
+      send: (message) => {
+        replies.push(message);
+        return true;
+      },
+      on: (_event, listener) => {
+        messageListener = listener;
+      },
+    };
+
+    const state = installBackgroundHooks(target, host);
+    await Promise.resolve();
+
+    expect(env.NODE_CHANNEL_FD).toBeUndefined();
+    expect(unrefCalls).toBe(1);
+    expect(dockHideCalls).toBe(2);
+
+    target.app.focus();
+    target.dialog.showErrorBox("Boom", "Ignored");
+    (proto.show as () => void)();
+    (proto.focus as () => void)();
+
+    windowListener?.({}, windowTarget);
+    windowTarget.webContents.setBackgroundThrottling(true);
+    expect(throttlingCalls).toEqual([false]);
+
+    messageListener?.({ id: "1", type: "visibility" });
+    messageListener?.({ id: "2", type: "set-content-size", width: 1100, height: 780 });
+    showHandler?.();
+    messageListener?.({ id: "3", type: "visibility" });
+    messageListener?.({ id: "4", type: "quit" });
+
+    expect(state.wasWindowShown()).toBe(true);
+    expect(resized).toEqual([[1100, 780]]);
+    expect(quitCalls).toBe(1);
+    expect(replies).toEqual([
+      { id: "1", ok: true, shown: false },
+      { id: "2", ok: true, count: 1 },
+      { id: "3", ok: true, shown: true },
+      { id: "4", ok: true },
+    ]);
+  });
+});
diff --git a/apps/desktop/src/patcherBackground.ts b/apps/desktop/src/patcherBackground.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c6a10b6797b68b81d542a90e8948cdb2f246e35e
--- /dev/null
+++ b/apps/desktop/src/patcherBackground.ts
@@ -0,0 +1,150 @@
+import type * as Electron from "electron";
+
+export interface BackgroundElectronTarget {
+  readonly app: {
+    readonly dock?: { readonly hide: () => void } | undefined;
+    focus: (...args: ReadonlyArray<never>) => void;
+    readonly whenReady: () => Promise<unknown>;
+    readonly on: (
+      event: "browser-window-created",
+      listener: (_event: unknown, window: BackgroundWindowTarget) => void,
+    ) => unknown;
+    readonly quit: () => void;
+  };
+  readonly BrowserWindow: {
+    readonly prototype: Record<string, unknown>;
+    readonly getAllWindows: () => ReadonlyArray<BackgroundWindowTarget>;
+  };
+  readonly dialog: {
+    showErrorBox: (title: string, content: string) => void;
+  };
+}
+
+export interface BackgroundWindowTarget {
+  readonly isDestroyed: () => boolean;
+  readonly isVisible: () => boolean;
+  readonly setContentSize: (width: number, height: number) => void;
+  readonly on: (event: "show", listener: () => void) => unknown;
+  readonly webContents: {
+    setBackgroundThrottling: (allowed: boolean) => void;
+  };
+}
+
+export interface BackgroundIpcHost {
+  readonly env: Record<string, string | undefined>;
+  readonly channel?: { readonly unref?: () => void } | undefined;
+  readonly send?: ((message: unknown) => boolean) | undefined;
+  readonly on: (event: "message", listener: (message: unknown) => void) => unknown;
+}
+
+const SUPPRESSED_WINDOW_METHODS = [
+  "show",
+  "showInactive",
+  "focus",
+  "moveTop",
+  "maximize",
+  "restore",
+] as const;
+
+const isRecord = (value: unknown): value is Readonly<Record<string, unknown>> =>
+  typeof value === "object" && value !== null;
+
+/**
+ * Keeps `--background` journey launches completely out of the user's way on macOS (no Dock icon,
+ * no window ever shown or focused, background throttling off so hidden windows keep painting)
+ * and answers a small fixed IPC protocol on Node's inherited stdio channel without inspector flags.
+ */
+export function installBackgroundHooks(
+  target: BackgroundElectronTarget,
+  host: BackgroundIpcHost,
+): { readonly wasWindowShown: () => boolean } {
+  delete host.env.NODE_CHANNEL_FD;
+  host.channel?.unref?.();
+
+  let windowShown = false;
+
+  target.app.dock?.hide();
+  void target.app.whenReady().then(
+    () => {
+      target.app.dock?.hide();
+    },
+    () => {},
+  );
+  target.app.focus = () => {};
+  target.dialog.showErrorBox = () => {};
+
+  for (const method of SUPPRESSED_WINDOW_METHODS) {
+    target.BrowserWindow.prototype[method] = () => {};
+  }
+
+  target.app.on("browser-window-created", (_event, window) => {
+    window.webContents.setBackgroundThrottling(false);
+    window.webContents.setBackgroundThrottling = () => {};
+    window.on("show", () => {
+      windowShown = true;
+    });
+  });
+
+  if (typeof host.send === "function") {
+    const reply = host.send.bind(host);
+    host.on("message", (raw) => {
+      if (!isRecord(raw) || typeof raw.id !== "string" || typeof raw.type !== "string") {
+        return;
+      }
+      switch (raw.type) {
+        case "visibility": {
+          const shown =
+            windowShown ||
+            target.BrowserWindow.getAllWindows().some(
+              (window) => !window.isDestroyed() && window.isVisible(),
+            );
+          reply({ id: raw.id, ok: true, shown });
+          return;
+        }
+        case "set-content-size": {
+          const width = typeof raw.width === "number" ? Math.trunc(raw.width) : 0;
+          const height = typeof raw.height === "number" ? Math.trunc(raw.height) : 0;
+          if (width <= 0 || height <= 0) {
+            reply({ id: raw.id, ok: false, error: "invalid dimensions" });
+            return;
+          }
+          let count = 0;
+          for (const window of target.BrowserWindow.getAllWindows()) {
+            if (!window.isDestroyed()) {
+              window.setContentSize(width, height);
+              count += 1;
+            }
+          }
+          reply({ id: raw.id, ok: true, count });
+          return;
+        }
+        case "quit": {
+          reply({ id: raw.id, ok: true });
+          target.app.quit();
+          return;
+        }
+        default:
+          reply({ id: raw.id, ok: false, error: `unknown request: ${raw.type}` });
+      }
+    });
+  }
+
+  return {
+    wasWindowShown: () =>
+      windowShown ||
+      target.BrowserWindow.getAllWindows().some(
+        (window) => !window.isDestroyed() && window.isVisible(),
+      ),
+  };
+}
+
+export function installPatcherBackgroundMode(): void {
+  if (process.env.ELECTRON_RUN_AS_NODE === "1" || !process.argv.includes("--background")) {
+    return;
+  }
+  const electron = require("electron") as typeof Electron;
+  installBackgroundHooks(
+    electron as unknown as BackgroundElectronTarget,
+    process as unknown as BackgroundIpcHost,
+  );
+}
