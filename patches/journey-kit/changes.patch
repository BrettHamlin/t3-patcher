   return ["vp", [...args]];
 }
+
+const CHECK_INPUT_PATTERN = /(^|\/)\.(generated|astro)\/|\.d\.ts$|(^|\/)\.env[^/]*$/;
+// Build outputs aren't check inputs (tests run from source), so a build running alongside the checks keeps receipts valid.
+const SKIPPED_IGNORED_DIR =
+  /(^|\/)(?:node_modules|release|release-mock)\/|^apps\/[^/]+\/(?:dist|dist-electron)\/|^native\/[^/]+\/build\//;
+
+function gitBytesSync(cwd: string, args: ReadonlyArray<string>, env: NodeJS.ProcessEnv): Buffer {
+  return NodeChildProcess.execFileSync("git", ["-c", "core.quotePath=false", ...args], {
+    cwd,
+    env,
+    stdio: ["ignore", "pipe", "pipe"],
+    maxBuffer: 64 * 1024 * 1024,
+  });
+}
+
+function ignoredCheckInputsSync(root: string, env: NodeJS.ProcessEnv): Array<string> {
+  const list = (args: ReadonlyArray<string>) =>
+    gitBytesSync(root, ["ls-files", "-z", ...args], env)
+      .toString("utf8")
+      .split("\0")
+      .filter(Boolean);
+  const ignored = ["--others", "--ignored", "--exclude-standard"];
+  const listed = list([...ignored, "--directory"]);
+  const replaced = list(["-k", "--directory"]);
+  const entries = [...new Set([...listed, ...replaced])].sort();
+  const directories = entries.filter(
+    (entry, index) =>
+      entry.endsWith("/") &&
+      !SKIPPED_IGNORED_DIR.test(entry) &&
+      !entries[index + 1]?.startsWith(entry),
+  );
+  const files = entries.filter((entry) => !entry.endsWith("/"));
+  const longest = directories.reduce((max, dir) => Math.max(max, dir.length), 0);
+  const size = Math.max(1, Math.floor(30_000 / (longest + 16)));
+  for (let start = 0; start < directories.length; start += size) {
+    const batch = directories.slice(start, start + size).map((dir) => `:(literal)${dir}`);
+    files.push(...list([...ignored, "--", ":(literal).git/", ...batch]));
+  }
+  return files
+    .filter(
+      (file) =>
+        !SKIPPED_IGNORED_DIR.test(file) && (file.endsWith("/") || CHECK_INPUT_PATTERN.test(file)),
+    )
+    .sort();
+}
+
+export function computePatcherVerificationDigest(
+  root: string,
+  env: NodeJS.ProcessEnv = process.env,
+): string {
+  // Single git status --porcelain=v2 --branch -z call yields both HEAD (# branch.oid) and working-tree paths.
+  const status = gitBytesSync(
+    root,
+    ["status", "--porcelain=v2", "--branch", "-z", "--untracked-files=all"],
+    env,
+  );
+  const tokens = status.toString("utf8").split("\0");
+  let head = "";
+  const statusFiles: Array<string> = [];
+  for (let i = 0; i < tokens.length; i += 1) {
+    const token = tokens[i];
+    if (!token) continue;
+    if (token.startsWith("# branch.oid ")) {
+      head = token.slice("# branch.oid ".length).trim();
+    } else if (token.startsWith("1 ") || token.startsWith("u ")) {
+      const fieldCount = token.startsWith("1 ") ? 8 : 10;
+      let spaceAt = -1;
+      let seen = 0;
+      for (let pos = 0; pos < token.length; pos += 1) {
+        if (token[pos] === " ") {
+          seen += 1;
+          if (seen === fieldCount) {
+            spaceAt = pos;
+            break;
+          }
+        }
+      }
+      if (spaceAt !== -1) statusFiles.push(token.slice(spaceAt + 1));
+    } else if (token.startsWith("2 ")) {
+      let spaceAt = -1;
+      let seen = 0;
+      for (let pos = 0; pos < token.length; pos += 1) {
+        if (token[pos] === " ") {
+          seen += 1;
+          if (seen === 9) {
+            spaceAt = pos;
+            break;
+          }
+        }
+      }
+      if (spaceAt !== -1) statusFiles.push(token.slice(spaceAt + 1));
+      i += 1;
+    } else if (token.startsWith("? ")) {
+      statusFiles.push(token.slice(2));
+    }
+  }
+  if (!head || head === "(initial)") {
+    head = gitBytesSync(root, ["rev-parse", "HEAD"], env).toString("utf8").trim();
+  }
+
+  const hash = NodeCrypto.createHash("sha256");
+  hash.update(
+    `${process.version}\0${head}\0${env.CI ?? ""}\0${env.BSTACK_VERIFY_WORKERS ?? ""}\0${env.VITEST_MAX_WORKERS ?? ""}\0`,
+  );
+  hash.update(status);
+
+  const ignored = ignoredCheckInputsSync(root, env);
+  const allFiles = [
+    ...new Set([
+      ...statusFiles,
+      ...ignored,
+      "node_modules/.modules.yaml",
+      "node_modules/.pnpm/lock.yaml",
+      "pnpm-lock.yaml",
+    ]),
+  ].sort();
+
+  for (const file of allFiles) {
+    const full = NodePath.join(root, file);
+    hash.update(`\0path:${file}\0`);
+    try {
+      const stat = NodeFS.statSync(full);
+      if (stat.isFile()) {
+        hash.update("file\0");
+        hash.update(NodeFS.readFileSync(full));
+      } else {
+        hash.update("other\0");
+      }
+    } catch {
+      hash.update("missing\0");
+    }
+  }
+
+  return hash.digest("hex");
+}
+
+function realOrResolved(targetPath: string): string {
+  try {
+    return NodeFS.realpathSync.native(targetPath);
+  } catch {
+    return NodePath.resolve(targetPath);
+  }
+}
+
+export function normalizeRepoRelativePath(repoRoot: string, filePath: string): string {
+  const canonicalRoot = realOrResolved(repoRoot);
+  const resolved = NodePath.resolve(canonicalRoot, filePath);
+  const canonicalFile = realOrResolved(resolved);
+  return NodePath.relative(canonicalRoot, canonicalFile).split(NodePath.sep).join("/");
+}
+
+const isRecord = (value: unknown): value is Readonly<Record<string, unknown>> =>
+  typeof value === "object" && value !== null;
+
+export function readPassedVitestFiles(reportPath: string, repoRoot: string): Array<string> {
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(NodeFS.readFileSync(reportPath, "utf8"));
+  } catch {
+    return [];
+  }
+  if (!isRecord(parsed) || parsed.success !== true || !Array.isArray(parsed.testResults)) {
+    return [];
+  }
+  const passed = new Set<string>();
+  for (const entry of parsed.testResults) {
+    if (
+      isRecord(entry) &&
+      entry.status === "passed" &&
+      typeof entry.name === "string" &&
+      Array.isArray(entry.assertionResults) &&
+      entry.assertionResults.some(
+        (assertion) => isRecord(assertion) && assertion.status === "passed",
+      )
+    ) {
+      const rel = normalizeRepoRelativePath(repoRoot, entry.name);
+      if (rel !== "" && !rel.startsWith("../") && !NodePath.isAbsolute(rel)) {
+        passed.add(rel);
+      }
+    }
+  }
+  return [...passed].sort();
+}
