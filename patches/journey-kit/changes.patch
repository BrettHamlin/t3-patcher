new file mode 100644
index 0000000000000000000000000000000000000000..5be2249dc3375717bee632ef9e0ac6d35805bb5d
--- /dev/null
+++ b/patcher/check.mjs
@@ -0,0 +1,152 @@
+#!/usr/bin/env node
+// Runs patch manifest checks without repeating Vitest files or i18n catalog scans that already
+// passed against the exact same verification inputs earlier in the run.
+import * as NodeChildProcess from "node:child_process";
+import * as NodeFS from "node:fs";
+import * as NodeOS from "node:os";
+import * as NodePath from "node:path";
+
+import {
+  computePatcherVerificationDigest,
+  normalizeRepoRelativePath,
+  readPassedVitestFiles,
+} from "../scripts/check-changed-command.ts";
+
+const repoRoot = NodePath.resolve(import.meta.dirname, "..");
+const cacheDir = NodePath.join(repoRoot, "node_modules/.cache");
+const checkChangedReceiptPath = NodePath.join(cacheDir, "patcher-check-changed.json");
+const i18nReceiptPath = NodePath.join(cacheDir, "patcher-i18n.json");
+
+export { computePatcherVerificationDigest as computePatcherTreeDigest };
+
+function readJsonSafe(filePath) {
+  try {
+    return JSON.parse(NodeFS.readFileSync(filePath, "utf8"));
+  } catch {
+    return undefined;
+  }
+}
+
+function writeJsonAtomic(filePath, data) {
+  NodeFS.mkdirSync(NodePath.dirname(filePath), { recursive: true });
+  const tmp = `${filePath}.${process.pid}`;
+  NodeFS.writeFileSync(tmp, `${JSON.stringify(data)}\n`);
+  NodeFS.renameSync(tmp, filePath);
+}
+
+// Vitest runs started together race to rebuild node_modules/.vitest-cache (ENOTEMPTY), and the patcher runs patch
+// checks side by side: Vitest runs under an exclusive flock on a lock file, which the kernel releases when it exits.
+const VITEST_LOCK = NodePath.join(cacheDir, "patcher-vitest.lock");
+const FLOCKED_EXEC = [
+  "import fcntl, os, sys",
+  "fd = os.open(sys.argv[1], os.O_RDWR | os.O_CREAT, 0o644)",
+  "fcntl.flock(fd, fcntl.LOCK_EX)",
+  "os.set_inheritable(fd, True)",
+  "os.execvp(sys.argv[2], sys.argv[2:])",
+].join("\n");
+
+function runLocked(command, args, cwd = repoRoot) {
+  NodeFS.mkdirSync(cacheDir, { recursive: true });
+  return runCommand("python3", ["-c", FLOCKED_EXEC, VITEST_LOCK, command, ...args], cwd);
+}
+
+function runCommand(command, args, cwd = repoRoot) {
+  const res = NodeChildProcess.spawnSync(command, args, {
+    cwd,
+    stdio: "inherit",
+    env: process.env,
+  });
+  if (res.error) throw res.error;
+  return res.status ?? 1;
+}
+
+if (import.meta.main) {
+  const [subcommand, ...rest] = process.argv.slice(2);
+  if (subcommand === "vitest") {
+    const requested = [
+      ...new Set(
+        rest.map((file) =>
+          normalizeRepoRelativePath(repoRoot, NodePath.resolve(process.cwd(), file)),
+        ),
+      ),
+    ];
+    if (requested.length === 0) {
+      console.error("patcher/check: vitest requires at least one test file.");
+      process.exit(2);
+    }
+    const digest = computePatcherVerificationDigest(repoRoot);
+    const receipt = readJsonSafe(checkChangedReceiptPath);
+    const covered =
+      receipt && receipt.treeDigest === digest && Array.isArray(receipt.vitestTests)
+        ? new Set(receipt.vitestTests)
+        : new Set();
+    const remaining = requested.filter((file) => !covered.has(file));
+    if (remaining.length === 0) {
+      console.log(
+        `patcher/check: all ${requested.length} test file(s) already passed in check:changed (${digest.slice(0, 12)}).`,
+      );
+      process.exit(0);
+    }
+    const reportDir = NodeFS.mkdtempSync(NodePath.join(NodeOS.tmpdir(), "t3-patcher-vitest-"));
+    const reportPath = NodePath.join(reportDir, "report.json");
+    const vpBin = NodePath.join(repoRoot, "node_modules/.bin/vp");
+    let code = 1;
+    let executedPassed = [];
+    try {
+      code = runLocked(
+        vpBin,
+        [
+          "test",
+          "run",
+          "--reporter=default",
+          "--reporter=json",
+          `--outputFile.json=${reportPath}`,
+          ...remaining,
+        ],
+        repoRoot,
+      );
+      if (code === 0) {
+        executedPassed = readPassedVitestFiles(reportPath, repoRoot);
+      }
+    } finally {
+      NodeFS.rmSync(reportDir, { recursive: true, force: true });
+    }
+    if (code !== 0) {
+      process.exit(code);
+    }
+    const passedSet = new Set(executedPassed);
+    const omitted = remaining.filter((file) => !passedSet.has(file));
+    if (omitted.length > 0) {
+      console.error(
+        `patcher/check: Vitest did not execute passing assertions for: ${omitted.join(", ")}`,
+      );
+      process.exit(1);
+    }
+    if (computePatcherVerificationDigest(repoRoot) === digest) {
+      try {
+        writeJsonAtomic(checkChangedReceiptPath, {
+          treeDigest: digest,
+          vitestTests: [...new Set([...covered, ...executedPassed])].sort(),
+        });
+      } catch {}
+    }
+    process.exit(0);
+  } else if (subcommand === "i18n") {
+    const digest = computePatcherVerificationDigest(repoRoot);
+    const receipt = readJsonSafe(i18nReceiptPath);
+    if (receipt && receipt.treeDigest === digest) {
+      console.log(`patcher/check: i18n catalogs already verified for ${digest.slice(0, 12)}.`);
+      process.exit(0);
+    }
+    const code = runCommand(process.execPath, [NodePath.join(repoRoot, "scripts/i18n-check.ts")]);
+    if (code === 0 && computePatcherVerificationDigest(repoRoot) === digest) {
+      try {
+        writeJsonAtomic(i18nReceiptPath, { treeDigest: digest });
+      } catch {}
+    }
+    process.exit(code);
+  } else {
+    console.error(`usage: node patcher/check.mjs <vitest|i18n> [files...]`);
+    process.exit(2);
+  }
+}
